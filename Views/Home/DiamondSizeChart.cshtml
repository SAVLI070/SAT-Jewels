                ["7.7 x 5.7 mm", "1.00 ct"],
                ["8.2 x 6.0 mm", "1.25 ct"],
                ["8.5 x 6.5 mm", "1.50 ct"],
                ["9.0 x 7.0 mm", "2.00 ct"],
                ["10.0 x 7.5 mm", "2.50 ct"],
                ["10.5 x 7.5 mm", "3.00 ct"],
                ["11.5 x 8.5 mm", "4.00 ct"],
                ["12.0 x 9.0 mm", "5.00 ct"]
            ]
        },
        emerald: {
            title: "Emerald Diamond Size Chart",
            rows: [
                ["5.5 x 3.5 mm", "0.50 ct"],
                ["6.5 x 4.5 mm", "0.75 ct"],
                ["7.0 x 5.0 mm", "1.00 ct"],
                ["7.5 x 5.2 mm", "1.25 ct"],
                ["8.0 x 5.5 mm", "1.50 ct"],
                ["8.5 x 6.5 mm", "2.00 ct"],
