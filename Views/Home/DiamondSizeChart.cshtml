                ["7.2 x 7.2 mm", "2.00 ct"],
                ["7.8 x 7.8 mm", "2.50 ct"],
                ["8.2 x 8.2 mm", "3.00 ct"],
                ["9.0 x 9.0 mm", "4.00 ct"],
                ["9.8 x 9.8 mm", "5.00 ct"]
            ]
        }
    };

    function updateDiamondSizeChart(shapeKey) {
        const data = diamondChartData[shapeKey];
        if (!data) return;

        document.getElementById('dynamicShapeTitle').innerText = data.title;

        const tbody = document.getElementById('dscTableBody');
        tbody.innerHTML = '';
        data.rows.forEach(r => {
            const tr = document.createElement('tr');
            tr.innerHTML = `<td style="font-weight:700;">${r[0]}</td><td>${r[1]}</td>`;
            tbody.appendChild(tr);
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateDiamondSizeChart('round');
    });
</script>
