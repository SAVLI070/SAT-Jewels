                ["11.0 x 8.0 mm", "4.00 ct"],
                ["12.0 x 9.0 mm", "5.00 ct"]
            ]
        },
        radiant: {
            title: "Radiant Diamond Size Chart",
            rows: [
                ["5.5 x 4.0 mm", "0.50 ct"],
                ["6.5 x 4.5 mm", "0.75 ct"],
                ["7.0 x 5.0 mm", "1.00 ct"],
                ["7.5 x 5.5 mm", "1.25 ct"],
                ["8.0 x 6.0 mm", "1.50 ct"],
                ["8.5 x 6.5 mm", "2.00 ct"],
                ["9.5 x 7.0 mm", "2.50 ct"],
                ["10.0 x 7.5 mm", "3.00 ct"],
                ["11.0 x 8.0 mm", "4.00 ct"],
                ["12.0 x 9.0 mm", "5.00 ct"]
            ]
        },
        pear: {
