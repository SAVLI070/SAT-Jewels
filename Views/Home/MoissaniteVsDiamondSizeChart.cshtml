    function switchShape(shapeKey, btnEl) {
        document.querySelectorAll('.moiss-tab-btn').forEach(b => b.classList.remove('active'));
        btnEl.classList.add('active');

        const data = shapeData[shapeKey];
        if (!data) return;

        document.getElementById('activeShapeTitle').innerText = data.title;
        document.getElementById('activeShapeSvg').innerHTML = data.svg;

        const tbody = document.getElementById('moissTableBody');
        tbody.innerHTML = '';
        data.rows.forEach(r => {
            const tr = document.createElement('tr');
            tr.innerHTML = `<td style="font-weight:700;">${r[0]}</td><td>${r[1]}</td><td>${r[2]}</td>`;
            tbody.appendChild(tr);
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        switchShape('round', document.querySelector('.moiss-tab-btn.active'));
    });
</script>
