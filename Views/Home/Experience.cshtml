@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="~/js/scrub-engine.js"></script>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            background: #0A0E17;
            color: #F5F7FA;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }
        #world {
            position: relative;
            width: 100%;
            min-height: 100vh;
        }
        .back-nav {
            position: fixed;
            top: 24px;
            left: 24px;
            z-index: 100;
        }
        .back-nav a {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #D4AF37;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 10px 18px;
            border-radius: 999px;
            background: rgba(10, 14, 23, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(212, 175, 55, 0.4);
            transition: all 0.3s ease;
        }
        .back-nav a:hover {
            color: #FFF;
            background: rgba(212, 175, 55, 0.2);
            border-color: #D4AF37;
            transform: translateX(-3px);
        }
    </style>
</head>
<body>
    <div class="back-nav">
        <a href="/">← Return to Store</a>
    </div>

    <div id="world"></div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            mountLetsScroll(document.getElementById('world'), {
                brand: { name: 'SAT JEWELS', href: '/' },
                diveScroll: 1.4,
                connScroll: 1.0,
                hint: 'SCROLL TO FLY THROUGH THE WORLD',
                nav: true,
                atmosphere: true,
                sections: [
                    {
                        id: 'mine-craft',
                        label: '1. DIAMOND CRAFT',
                        still: 'https://res.cloudinary.com/ktznlodb/image/upload/v1787584835/sat_jewels/1/cjxfsnkygbfib2u8xqki.jpg',
                        accent: '#D4AF37',
                        scroll: 1.6,
                        linger: 0.4,
                        eyebrow: 'SUSTAINABLE LUXURY',
                        title: 'Lab Diamond Growth & Artistry',
                        body: 'Step into the realm where advanced science meets master gemology. Zero carbon footprint, VVS1 clarity, and ethical perfection in every stone.',
                        tags: ['Eco-Friendly', 'GIA Certified', '100% Conflict-Free']
                    },
                    {
                        id: 'master-studio',
                        label: '2. SOLITAIRE SANCTUARY',
                        still: 'https://res.cloudinary.com/ktznlodb/image/upload/v1787585318/sat_jewels/666/c7uiuokcowxkgxga0qxv.jpg',
                        accent: '#E5C158',
                        scroll: 1.5,
                        linger: 0.35,
                        eyebrow: 'HANDCRAFTED PRECISION',
                        title: 'Precision Cut & Polish',
                        body: 'Each facet is individually hand-carved by master jewelers to achieve optimal light performance, sparkle, and fire.',
                        tags: ['Ideal Cut', 'Hand Polished', 'Micro-Pave']
                    },
                    {
                        id: 'ring-world',
                        label: '3. ICONIC RINGS',
                        still: 'https://res.cloudinary.com/ktznlodb/image/upload/v1787587036/sat_jewels/2462/fxfoy6sclf39qtx9hjg5.jpg',
                        accent: '#D4AF37',
                        scroll: 1.5,
                        linger: 0.3,
                        eyebrow: 'SIGNATURE DESIGNS',
                        title: 'Solitaires & Hidden Halos',
                        body: 'Discover our world-famous solitaire engagement rings and curved matching bands in 18K solid gold and platinum 950.',
                        tags: ['18K Solid Gold', 'Platinum 950', 'Custom Fit']
                    },
                    {
                        id: 'luxury-fine',
                        label: '4. FINE JEWELRY',
                        still: 'https://res.cloudinary.com/ktznlodb/image/upload/v1787587339/sat_jewels/2868/mo3sysawn083ozvc0tt1.jpg',
                        accent: '#E5C158',
                        scroll: 1.5,
                        linger: 0.3,
                        eyebrow: 'TIMELESS ELEGANCE',
                        title: 'Bracelets & High Jewelry',
                        body: 'Statement tennis bracelets, cluster diamond bands, and custom pendants crafted to celebrate your life milestones.',
                        tags: ['Tennis Bracelets', 'Pendants', 'Bespoke Sets']
                    },
                    {
                        id: 'vault-cta',
                        label: '5. FLAGSHIP VAULT',
                        still: 'https://res.cloudinary.com/ktznlodb/image/upload/v1787587344/sat_jewels/2866/fbn7v7kxumnkfsvthykj.png',
                        accent: '#D4AF37',
                        scroll: 1.8,
                        linger: 0.5,
                        eyebrow: 'YOUR DREAM PIECE',
                        title: 'Begin Your Custom Journey',
                        body: 'Work directly with our lead gemologists to bring your vision to life. Worldwide insured shipping & lifetime warranty.',
                        tags: ['Lifetime Warranty', 'Insured Shipping', 'Custom Design'],
                        cta: {
                            primary: { label: 'Explore Catalog', href: '/Product/Category/1' },
                            secondary: { label: 'Design Custom Ring', href: '/Home/CustomRings' }
                        }
                    }
                ]
            });
        });
    </script>
</body>
</html>
