    .sat-3d-shapes-track {
      display: flex;
      justify-content: center;
      gap: 22px;
      min-width: max-content;
      margin: 0 auto;
      padding: 0 16px;
    }
    .sat-3d-shape-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      gap: 10px;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .sat-3d-shape-icon {
      width: 66px;
      height: 66px;
      border-radius: 50%;
      background: rgba(22, 20, 24, 0.7);
      border: 1px solid rgba(212, 184, 120, 0.28);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.35s ease;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    }
    .sat-3d-shape-icon img {
      width: 40px;
      height: 40px;
      object-fit: contain;
      filter: drop-shadow(0 0 6px rgba(212, 184, 120, 0.4));
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
    }
    .sat-3d-shape-label {
      font-size: 12.5px;
      color: var(--muted);
      font-weight: 600;
      letter-spacing: 0.05em;
      transition: color 0.3s ease;
