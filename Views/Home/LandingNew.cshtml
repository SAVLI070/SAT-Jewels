      }
      .sat-header-icon-btn {
        width: 36px !important;
        height: 36px !important;
      }
      .sat-split-sec { grid-template-columns: 1fr; }
      .sat-split-sec.reverse .sat-split-copy { order: 0 !important; }
      .sat-split-media { min-height: 50vh; }
      .sat-3d-cats-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
      .sat-gallery-grid { grid-template-columns: 1fr; }
      .sat-3d-figs { gap: 32px; }
    }
    @@media (max-width: 560px) {
      .sat-3d-cats-grid { grid-template-columns: 1fr; }
