@{
    Layout = null;
    ViewData["Title"] = "SAT Jewel — Fine Jewelry | Mastery in Every Cut";
    var catCounts = ViewBag.CategoryCountsByNumericId as Dictionary<long, int> ?? new Dictionary<long, int>();
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>@ViewData["Title"]</title>
  <meta name="description" content="Mastery in Every Cut. Redefining luxury fine jewelry with 3D diamond caustics, certified lab grown gems, and bespoke studio craftsmanship." />

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Favicon / Tab Icons (Golden SJ Emblem) -->
  <link rel="icon" type="image/png" href="/assets/sat_logo_transparent.png" />
  <link rel="shortcut icon" type="image/png" href="/assets/sat_logo_transparent.png" />
  <link rel="apple-touch-icon" href="/assets/sat_logo_transparent.png" />

  <!-- Global Base CSS -->
  <link rel="stylesheet" href="~/css/style.css" />

  <style>
    /* ==========================================================================
       3D SCROLLABLE DESIGN THEME & STYLES (LUMIÈRE x SAT JEWEL)
       ========================================================================== */
    :root {
      --ink: #f1eee8;
      --muted: rgba(241, 238, 232, 0.65);
      --gold: #d4b878;
      --gold-glow: rgba(212, 184, 120, 0.45);
      --bg: #07070a;
      --glass: rgba(22, 20, 24, 0.44);
      --stroke: rgba(241, 238, 232, 0.13);
      --font-serif-luxury: 'Playfair Display', Georgia, serif;
      --font-sans-luxury: 'Plus Jakarta Sans', system-ui, sans-serif;
    }

    html {
      scroll-behavior: auto !important;
      overflow-x: clip !important;
      overflow-y: visible !important;
      height: auto !important;
    }

    body {
      background: var(--bg) !important;
      color: var(--ink);
      font-family: var(--font-sans-luxury);
      font-weight: 300;
      -webkit-font-smoothing: antialiased;
      overflow-x: clip !important;
      overflow-y: visible !important;
      margin: 0 !important;
      padding: 0 !important;
      position: relative !important;
      min-height: 100vh;
    }



    /* 3D Themed Navigation Bar (Clean Floating Layout - Center Pill Only) */
    .sat-3d-navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 99999;
      padding: 16px 0;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: none;
      transition: all 0.35s ease;
      pointer-events: none;
    }
    .sat-3d-navbar .nav-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 16px;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 24px;
      width: 100%;
      pointer-events: auto;
    }

    .sat-3d-navbar .sat-nav-brand-wrap {
      justify-self: start;
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .sat-3d-navbar .nav-links {
      justify-self: center;
      display: flex;
      align-items: center;
      gap: 4px;
      background: var(--glass);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      padding: 5px 8px;
      border-radius: 100px;
      border: 1px solid var(--stroke);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
      margin: 0 auto;
    }

    .sat-3d-navbar .nav-link {
      padding: 7px 16px;
      font-size: 13px;
      font-weight: 500;
      color: rgba(241, 238, 232, 0.8);
      border-radius: 100px;
      text-decoration: none;
      transition: all 0.25s ease;
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }
    .sat-3d-navbar .nav-link:hover,
    .sat-3d-navbar .nav-link.active {
      color: #ffffff;
      background: rgba(212, 184, 120, 0.18);
      border: 1px solid rgba(212, 184, 120, 0.4);
    }

    .sat-3d-navbar .nav-actions {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 18px;
    }

    /* Luxury Dark-Glass Account Dropdown Menu */
    .account-menu-dropdown {
      position: absolute;
      top: calc(100% + 12px);
      right: 0;
      min-width: 240px;
      background: rgba(18, 16, 20, 0.95);
      border: 1px solid rgba(212, 184, 120, 0.35);
      border-radius: 14px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 10px;
      display: none;
      z-index: 100000;
    }
    .account-menu.open .account-menu-dropdown {
      display: block;
      animation: satMenuFade 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @@keyframes satMenuFade {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .account-menu-head {
      padding: 10px 12px 12px;
      border-bottom: 1px solid rgba(241, 238, 232, 0.1);
      margin-bottom: 6px;
    }
    .account-menu-hello {
      font-size: 13.5px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: 0.02em;
    }
    .account-menu-email {
      font-size: 11.5px;
      color: rgba(212, 184, 120, 0.85);
      margin-top: 2px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .account-menu-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      color: rgba(241, 238, 232, 0.85);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .account-menu-item:hover {
      background: rgba(212, 184, 120, 0.16);
      color: #ffffff;
      transform: translateX(3px);
    }
    .account-menu-item i {
      width: 16px;
      color: var(--gold);
      font-size: 13px;
    }
    .account-menu-divider {
      height: 1px;
      background: rgba(241, 238, 232, 0.08);
      margin: 6px 0;
    }
    .account-menu-logout {
      color: #f87171 !important;
    }
    .account-menu-logout i {
      color: #f87171 !important;
    }
    .account-menu-logout:hover {
      background: rgba(239, 68, 68, 0.15) !important;
    }

    /* Floating WhatsApp Widget */
    .sat-floating-whatsapp-wrap {
      position: fixed;
      bottom: 28px;
      right: 28px;
      z-index: 999999;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
    }
    .sat-wa-badge-popup {
      background: #0f172a;
      color: #ffffff;
      font-size: 0.85rem;
      font-weight: 700;
      padding: 7px 14px;
      border-radius: 20px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      animation: waBounce 2.5s infinite ease-in-out;
    }
    .sat-wa-close-btn {
      background: none;
      border: none;
      color: #9ca3af;
      font-size: 1.1rem;
      line-height: 1;
      cursor: pointer;
      padding: 0;
      margin-left: 2px;
    }
    .sat-wa-float-btn {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #25d366;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      text-decoration: none;
      box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sat-wa-float-btn:hover {
      transform: scale(1.12);
      box-shadow: 0 12px 30px rgba(37, 211, 102, 0.6);
      color: #ffffff;
    }
    @@keyframes waBounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    /* Enterprise Craft Specs Luxury Card */
    .sat-specs-section {
      position: relative;
      background: #06070a;
      padding: 70px 24px 130px;
      z-index: 20;
      overflow: hidden;
    }
    .sat-enterprise-specs-card {
      position: relative;
      z-index: 2;
      background: rgba(14, 13, 16, 0.72);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border: 1px solid rgba(212, 184, 120, 0.32);
      border-radius: 28px;
      padding: clamp(28px, 4vw, 44px) clamp(24px, 4vw, 50px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 36px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    /* =========================================================
       GLOBAL LIVE SEARCH MODAL (Fixed Viewport Center Overlay)
       ========================================================= */
    .sat-search-modal-backdrop {
      position: fixed !important;
      inset: 0 !important;
      background: rgba(6, 7, 10, 0.85) !important;
      backdrop-filter: blur(20px) !important;
      -webkit-backdrop-filter: blur(20px) !important;
      z-index: 9999999 !important;
      display: flex !important;
      justify-content: center !important;
      align-items: flex-start !important;
      padding: 90px 20px 40px !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s !important;
      overflow-y: auto !important;
    }
    .sat-search-modal-backdrop.open {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
    .sat-search-modal-card {
      width: 100%;
      max-width: 740px;
      background: rgba(14, 13, 16, 0.96);
      backdrop-filter: blur(32px);
      -webkit-backdrop-filter: blur(32px);
      border: 1px solid rgba(212, 184, 120, 0.38);
      border-radius: 20px;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.9), 0 0 50px rgba(212, 184, 120, 0.15);
      padding: 24px;
      position: relative;
      animation: satSearchScale 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @@keyframes satSearchScale {
      from { transform: scale(0.95) translateY(-10px); opacity: 0; }
      to { transform: scale(1) translateY(0); opacity: 1; }
    }
    .sat-search-input-box {
      position: relative;
      display: flex;
      align-items: center;
      margin-bottom: 16px;
    }
    .sat-search-input-icon {
      position: absolute;
      left: 18px;
      color: var(--gold);
      font-size: 17px;
      pointer-events: none;
    }
    #satSearchInput {
      width: 100%;
      box-sizing: border-box;
      padding: 16px 50px 16px 52px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(241, 238, 232, 0.16);
      border-radius: 14px;
      color: #ffffff;
      font-size: 15px;
      font-family: var(--font-sans-luxury);
      outline: none;
      transition: all 0.25s ease;
    }
    #satSearchInput:focus {
      background: rgba(255, 255, 255, 0.08);
      border-color: var(--gold);
      box-shadow: 0 0 20px rgba(212, 184, 120, 0.35);
    }
    .sat-search-close-btn {
      position: absolute;
      right: 14px;
      background: transparent;
      border: none;
      color: var(--muted);
      font-size: 24px;
      cursor: pointer;
      line-height: 1;
      padding: 6px 10px;
      border-radius: 8px;
      transition: color 0.2s;
    }
    .sat-search-close-btn:hover {
      color: #ffffff;
    }
    .sat-search-chips-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(241, 238, 232, 0.08);
      margin-bottom: 16px;
    }
    .sat-chip-title {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-right: 4px;
    }
    .sat-search-chip {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(241, 238, 232, 0.12);
      padding: 6px 14px;
      border-radius: 100px;
      font-size: 12px;
      color: rgba(241, 238, 232, 0.85);
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: var(--font-sans-luxury);
    }
    .sat-search-chip:hover {
      background: rgba(212, 184, 120, 0.16);
      border-color: rgba(212, 184, 120, 0.4);
      color: #ffffff;
      transform: translateY(-1px);
    }
    .sat-search-results-wrap {
      max-height: 380px;
      overflow-y: auto;
    }
    .sat-search-empty-state {
      text-align: center;
      padding: 36px 20px;
      color: var(--muted);
      font-size: 13.5px;
    }
    .sat-search-items-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px;
    }
    .sat-search-item-card {
      display: flex;
      flex-direction: column;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(241, 238, 232, 0.1);
      border-radius: 12px;
      padding: 10px;
      text-decoration: none;
      transition: all 0.25s ease;
    }
    .sat-search-item-card:hover {
      background: rgba(212, 184, 120, 0.12);
      border-color: rgba(212, 184, 120, 0.45);
      transform: translateY(-3px);
    }
    .sat-search-item-img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 8px;
      margin-bottom: 8px;
    }
    .sat-search-item-title {
      font-size: 12.5px;
      font-weight: 600;
      color: #ffffff;
      line-height: 1.4;
      margin-bottom: 4px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .sat-search-item-meta {
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .sat-search-item-price {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--gold);
    }
    .sat-enterprise-specs-card:hover {
      border-color: rgba(212, 184, 120, 0.55);
      box-shadow: 0 25px 70px rgba(0, 0, 0, 0.8), 0 0 35px rgba(212, 184, 120, 0.16);
    }
    .sat-specs-intro {
      flex: 1;
      min-width: 260px;
    }
    .sat-specs-title {
      font-family: var(--font-serif-luxury);
      font-size: clamp(24px, 2.5vw, 32px);
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 8px;
      letter-spacing: 0.02em;
    }
    .sat-specs-sub {
      font-size: 13.5px;
      color: var(--muted);
      margin: 0;
      line-height: 1.6;
    }
    .sat-specs-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      flex: 1.6;
      justify-content: flex-end;
    }
    .sat-spec-pill {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(241, 238, 232, 0.15);
      padding: 10px 20px;
      border-radius: 100px;
      font-size: 12.5px;
      font-weight: 600;
      color: #f1eee8;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all 0.25s ease;
      white-space: nowrap;
      text-decoration: none;
    }
    .sat-spec-pill:hover {
      background: rgba(212, 184, 120, 0.18);
      border-color: rgba(212, 184, 120, 0.5);
      color: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    }
    .sat-spec-icon {
      color: var(--gold);
      font-size: 13.5px;
      display: inline-flex;
      align-items: center;
    }
    @@media (max-width: 992px) {
      .sat-enterprise-specs-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
      }
      .sat-specs-grid {
        justify-content: flex-start;
      }
    }

    /* 3D Video Hero Scrubbing Stage */
    .sat-hero-3d {
      position: relative !important;
      height: calc(100vh + 7000px) !important;
      background: #04050a !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .sat-hero-stage {
      position: -webkit-sticky !important;
      position: sticky !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100vh !important;
      max-height: 100vh !important;
      overflow: hidden !important;
      background: #04050a !important;
      z-index: 10 !important;
    }
    .sat-hero-stage video {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      display: block !important;
    }
    .sat-hero-scrim {
      position: absolute !important;
      inset: 0 !important;
      background: radial-gradient(130% 90% at 50% 12%, transparent 35%, rgba(0,0,0,0.65) 100%),
                  linear-gradient(180deg, rgba(4,5,10,0.4) 0%, transparent 25%, transparent 65%, rgba(4,5,10,0.85) 100%) !important;
      pointer-events: none !important;
    }

    /* Typography Captions Overlay */
    .sat-3d-cap {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0 clamp(24px, 8vw, 140px);
      opacity: 0;
      pointer-events: none;
      transform: translateY(24px);
      transition: opacity 0.2s ease, transform 0.2s ease;
      will-change: opacity, transform;
    }
    .sat-3d-cap.cap-center {
      align-items: center;
      text-align: center;
    }
    .sat-3d-cap.cap-left {
      align-items: flex-start;
      text-align: left;
    }
    .sat-3d-cap.cap-right {
      align-items: flex-end;
      text-align: right;
    }

    .sat-3d-cap .eyebrow {
      font-size: 11px;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 8px;
    }
    .sat-3d-cap h1 {
      font-family: var(--font-serif-luxury);
      font-size: clamp(38px, 6.5vw, 92px);
      font-weight: 500;
      line-height: 1.05;
      letter-spacing: -0.01em;
      color: #ffffff;
      max-width: 16ch;
      margin: 12px 0 16px;
      text-shadow: 0 4px 30px rgba(0, 0, 0, 0.8);
    }
    .sat-3d-cap p {
      max-width: 46ch;
      font-size: clamp(15px, 1.4vw, 19px);
      line-height: 1.65;
      color: var(--muted);
      margin-bottom: 24px;
    }
    .sat-3d-cap .cap-cta {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      border: 1px solid rgba(244, 241, 234, 0.4);
      border-radius: 100px;
      padding: 14px 32px;
      font-size: 12.5px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #ffffff;
      text-decoration: none;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      background: rgba(22, 20, 24, 0.5);
      transition: all 0.3s ease;
    }
    .sat-3d-cap .cap-cta:hover {
      background: var(--ink);
      color: #04050a;
      border-color: var(--ink);
      transform: translateY(-2px);
    }

    .sat-scroll-hint {
      position: absolute;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 10.5px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--muted);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      animation: hintFloat 2s infinite ease-in-out;
      pointer-events: none;
    }
    @@keyframes hintFloat {
      0%, 100% { transform: translate(-50%, 0); opacity: 0.6; }
      50% { transform: translate(-50%, 6px); opacity: 1; }
    }

    /* Split Story Section */
    .sat-split-sec {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      min-height: 88vh;
      background: #06070a;
      position: relative;
      z-index: 20;
    }
    .sat-split-copy {
      padding: clamp(40px, 7vw, 120px);
    }
    .sat-split-copy .eyebrow {
      font-size: 11px;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
    }
    .sat-split-copy h2 {
      font-family: var(--font-serif-luxury);
      font-size: clamp(32px, 4.2vw, 56px);
      margin: 16px 0 20px;
      max-width: 16ch;
      color: #ffffff;
      line-height: 1.1;
    }
    .sat-split-copy p {
      color: var(--muted);
      line-height: 1.7;
      max-width: 48ch;
      font-size: 16px;
    }
    .sat-3d-spec {
      list-style: none;
      display: flex;
      gap: 38px;
      margin-top: 36px;
      padding: 0;
    }
    .sat-3d-spec li {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .sat-3d-spec b {
      font-family: var(--font-serif-luxury);
      font-size: 34px;
      color: var(--gold);
      font-weight: 500;
    }
    .sat-3d-spec span {
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .sat-split-media {
      min-height: 88vh;
      background-size: cover;
      background-position: center;
    }
    .sat-split-media.m-facade {
