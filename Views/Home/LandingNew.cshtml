  <!-- 3D Video Scrubbing Controller & Lenis Smooth Scroller -->
  <script type="module">
    import Lenis from "/assets/3d/_lib/lenis.mjs";
    if (matchMedia("(pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let armed = false;
      const arm = () => {
        if (armed || document.documentElement.scrollHeight <= innerHeight + 80) return;
        armed = true;
        const lenis = new Lenis({ smoothWheel: true });
        const raf = (t) => { lenis.raf(t); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
        document.documentElement.style.scrollBehavior = "auto";
      };
      addEventListener("load", () => { setTimeout(arm, 600); setTimeout(arm, 2000); });
    }
  </script>

  <script>
    (function () {
      'use strict';

      const video = document.getElementById('satHero3dVideo');
      const container = document.getElementById('top');

      window.scrollCatSlider = function (offset) {
        const track = document.getElementById('mainCatTrack');
        if (track) {
          track.scrollBy({ left: offset, behavior: 'smooth' });
        }
      };

      // Caption definitions with exact normalized scroll windows
      const caps = [
        { el: document.getElementById('cap0'), from: 0.00, to: 0.12 },
        { el: document.getElementById('cap1'), from: 0.15, to: 0.27 },
        { el: document.getElementById('cap2'), from: 0.30, to: 0.43 },
        { el: document.getElementById('cap3'), from: 0.46, to: 0.58 },
        { el: document.getElementById('cap4'), from: 0.61, to: 0.74 },
        { el: document.getElementById('cap5'), from: 0.78, to: 1.00 }
      ];

      function clamp(val, min, max) {
        return Math.max(min, Math.min(max, val));
      }

      function calcOpacity(progress, from, to) {
        if (progress < from - 0.02 || progress > to + 0.02) return 0;
        const range = to - from;
        const fadeIn = from <= 0.001 ? 1 : clamp((progress - from) / (range * 0.22), 0, 1);
        const fadeOut = to >= 0.999 ? 1 : clamp(1 - (progress - (to - range * 0.22)) / (range * 0.22), 0, 1);
        return Math.max(0, Math.min(fadeIn, fadeOut));
      }

      let targetTime = 0;
      let currentTime = 0;

      function onScroll() {
        if (!container) return;
        const maxScroll = container.offsetHeight - window.innerHeight;
        if (maxScroll <= 0) return;

        const scrolled = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
        const progress = clamp(scrolled / maxScroll, 0, 1);



        // Update video target time
        if (video && video.duration && !isNaN(video.duration) && video.duration > 0) {
          targetTime = progress * video.duration;
        }

        // Update Captions
        caps.forEach(cap => {
          if (!cap.el) return;
          const op = calcOpacity(progress, cap.from, cap.to);
          cap.el.style.opacity = op;
          cap.el.style.transform = 'translateY(' + ((1 - op) * 24) + 'px)';
          cap.el.style.pointerEvents = op > 0.5 ? 'auto' : 'none';
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      // Smooth RAF Lerp loop for video time
      const LERP_FACTOR = 0.16;
      function scrubLoop() {
        if (video && video.duration && !isNaN(video.duration) && video.duration > 0) {
          currentTime += (targetTime - currentTime) * LERP_FACTOR;
          if (Math.abs(targetTime - currentTime) < 0.0005) {
            currentTime = targetTime;
          }
          const bounded = clamp(currentTime, 0, video.duration - 0.001);
          if (Math.abs(video.currentTime - bounded) > 0.002) {
            try {
              if (typeof video.fastSeek === 'function') {
                video.fastSeek(bounded);
              } else {
                video.currentTime = bounded;
              }
            } catch (_) {
              try { video.currentTime = bounded; } catch (e) {}
            }
          }
        }
        requestAnimationFrame(scrubLoop);
      }

      if (video) {
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;
        try { video.pause(); } catch (_) {}
        video.addEventListener('loadedmetadata', onScroll);
        video.addEventListener('loadeddata', onScroll);
        video.addEventListener('canplay', onScroll);
        video.addEventListener('durationchange', onScroll);
        try { video.load(); } catch (_) {}
      }

      requestAnimationFrame(scrubLoop);
      setTimeout(onScroll, 100);
      setTimeout(onScroll, 500);
    })();
  </script>

  <!-- Global Live Search & WhatsApp Floating Controller Scripts -->
  <script>
    let satSearchDebounceTimer = null;

    function openSatGlobalSearch(e) {
      if (e) e.preventDefault();
      const modal = document.getElementById('satSearchModal');
      if (modal) {
        modal.classList.add('open');
        const input = document.getElementById('satSearchInput');
        if (input) {
          input.focus();
          if (input.value.trim()) {
            handleSatLiveSearch(input.value);
          }
        }
      }
    }

    function closeSatGlobalSearch(e) {
      if (e) e.preventDefault();
      const modal = document.getElementById('satSearchModal');
      if (modal) {
        modal.classList.remove('open');
      }
    }

    function applySearchQuery(query) {
      const input = document.getElementById('satSearchInput');
      if (input) {
        input.value = query;
        handleSatLiveSearch(query);
      }
    }

    function handleSatLiveSearch(val) {
      clearTimeout(satSearchDebounceTimer);
      const container = document.getElementById('satSearchResults');
      if (!container) return;

      if (!val || val.trim().length < 2) {
        container.innerHTML = `
          <div class="sat-search-empty-state">
            <i class="fa-solid fa-gem" style="font-size: 2rem; color: #cbd5e1; margin-bottom: 8px;"></i>
            <p>Type to search SAT Jewel's fine jewelry collection...</p>
          </div>`;
        return;
      }

      satSearchDebounceTimer = setTimeout(async () => {
        container.innerHTML = `<div class="sat-search-empty-state"><i class="fa-solid fa-spinner fa-spin" style="font-size: 1.8rem; color: #d4b270;"></i><p>Searching collections...</p></div>`;
        try {
          const res = await fetch(`/api/CatalogApi/search?q=${encodeURIComponent(val.trim())}`);
          const data = await res.json();

          if (data.success && data.results && data.results.length > 0) {
            let html = '<div class="sat-search-items-grid">';
            data.results.forEach(item => {
              const price = item.priceUSD ? `$${item.priceUSD.toLocaleString()}` : '$1,299';
              const img = item.imageUrl || '/assets/categories/cat_engagement_rings.png';
              html += `
                <a href="/Product/Details/${item.id}" class="sat-search-item-card">
                  <img src="${img}" alt="${item.name}" class="sat-search-item-img" />
                  <div class="sat-search-item-info">
                    <span class="sat-search-item-title">${item.name}</span>
                    <span class="sat-search-item-meta">${item.categoryName || 'Fine Jewelry'} · ${item.gemstoneType || 'Diamond'}</span>
                    <span class="sat-search-item-price">${price}</span>
                  </div>
                </a>`;
            });
            html += '</div>';
            container.innerHTML = html;
          } else {
            container.innerHTML = `
              <div class="sat-search-empty-state">
                <i class="fa-regular fa-face-frown" style="font-size: 2rem; color: #94a3b8; margin-bottom: 8px;"></i>
                <p>No fine jewelry found matching "<strong>${val}</strong>". Try another keyword or shape.</p>
              </div>`;
          }
        } catch (err) {
          container.innerHTML = `<div class="sat-search-empty-state"><p>Unable to retrieve search results. Please try again.</p></div>`;
        }
      }, 250);
    }

    function dismissWaWidget(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      const badge = document.querySelector('.sat-wa-badge-popup');
      if (badge) badge.style.display = 'none';
    }

    // Keyboard ESC listener to close search
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSatGlobalSearch();
      }
    });
  </script>

