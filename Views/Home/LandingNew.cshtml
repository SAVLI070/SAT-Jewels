      .sat-3d-navbar .sat-nav-brand-wrap {
        flex: 1 1 auto;
        min-width: 0;
        gap: 8px;
      }
      .sat-3d-navbar .official-sat-logo-nav {
        height: 28px !important;
      }
      .sat-3d-navbar .nav-logo-slot span:first-child {
        font-size: 17px !important;
      }
      .sat-3d-navbar .nav-logo-slot span:last-child {
        font-size: 7.5px !important;
        letter-spacing: 0.16em !important;
      }
      .sat-3d-navbar .nav-links { display: none; }
      .sat-3d-navbar .nav-actions {
        flex-shrink: 0;
        display: flex !important;
        align-items: center !important;
