      color: var(--gold);
      font-weight: 500;
    }
    .sat-3d-figs span {
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* 4-Image Atelier Gallery */
    .sat-gallery-sec {
      padding: clamp(70px, 9vw, 130px) 24px;
      background: var(--bg);
      position: relative;
      z-index: 20;
    }
    .sat-gallery-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      max-width: 1200px;
      margin: 0 auto;
    }
    .sat-gallery-fig {
      position: relative;
      height: 46vh;
      min-height: 340px;
      border-radius: 16px;
      overflow: hidden;
      background-size: cover;
      background-position: center;
      border: 1px solid var(--stroke);
      transition: all 0.35s ease;
    }
    .sat-gallery-fig::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(6,7,10,0.8) 0%, transparent 55%);
