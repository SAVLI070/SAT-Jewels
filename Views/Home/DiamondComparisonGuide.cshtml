@{
    ViewData["Title"] = "Moissanite vs Lab Grown Diamond vs Diamond — SAT Jewel";
}

<div class="comp-guide-page">
    <!-- Breadcrumb & Header Section -->
    <div class="comp-header-section">
        <div class="comp-breadcrumb"><a href="/">Home</a> &rsaquo; <span>Moissanite vs Lab Grown Diamond vs Diamond</span></div>
        <h1 class="comp-main-title">Moissanite vs Lab Grown Diamond vs Diamond</h1>
        <p class="comp-subtitle">Comparing Moissanite, Lab-Grown Diamonds, and Natural Diamonds: Understanding the Variations in Brilliance, Price, and Sustainability</p>
    </div>

    <div class="comp-container">
        <!-- Section 1: Understanding the Difference (Screenshot 1 - Video Player on Left, Text on Right) -->
        <div class="comp-split-row align-center">
            <div class="comp-media-col">
                <div class="comp-video-wrapper">
                    <video controls autoplay muted loop playsinline poster="/assets/guide/understanding_difference.jpg" class="comp-video-player">
                        <source src="/assets/videos/ring_360.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
            <div class="comp-text-col">
                <h2 class="comp-section-heading">Understanding the Difference</h2>
                <p class="comp-text-para">
                    Moissanite, lab-grown diamonds, and natural diamonds each offer unique qualities. Moissanite, a silicon carbide gemstone, stands out with exceptional brilliance and fire, often outshining diamonds. Lab-grown diamonds, while chemically identical to natural diamonds, offer eco-friendly and cost-effective alternatives. Natural diamonds, treasured for centuries, are valued for their rarity and traditional appeal.
                </p>
                <p class="comp-text-para">
                    Understanding these differences helps in making an informed choice, whether seeking sustainable luxury or timeless natural beauty. Choose based on personal values, whether it's environmental consciousness or a preference for natural rarity.
                </p>
            </div>
        </div>

        <!-- Property Comparison Table -->
        <div class="comp-table-section">
            <h2 class="comp-table-heading">Property Comparison Matrix</h2>
            <div class="comp-table-wrap">
                <table class="comp-table">
                    <thead>
                        <tr>
                            <th>Diamond Element Properties</th>
                            <th>Moissanite</th>
                            <th>Lab Grown Diamond</th>
                            <th>Diamond (Natural)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="prop-name">Mining</td>
                            <td>Mining Free</td>
                            <td>Mining Free</td>
                            <td>Mined Diamonds</td>
                        </tr>
                        <tr>
                            <td class="prop-name">Eco-Friendly</td>
                            <td><span class="badge-yes">Yes</span></td>
                            <td><span class="badge-yes">Yes</span></td>
                            <td><span class="badge-no">No</span></td>
                        </tr>
                        <tr>
                            <td class="prop-name">Refractive Index</td>
                            <td>2.65 - 2.96</td>
                            <td>2.42</td>
                            <td>2.42</td>
                        </tr>
                        <tr>
                            <td class="prop-name">Hardness (Mohs Scale)</td>
                            <td>9.25 - 9.50</td>
                            <td>10 (Hardest)</td>
                            <td>10 (Hardest)</td>
                        </tr>
                        <tr>
                            <td class="prop-name">Conflict Free</td>
                            <td><span class="badge-yes">Yes</span></td>
                            <td><span class="badge-yes">Yes</span></td>
                            <td>May Be</td>
                        </tr>
                        <tr>
                            <td class="prop-name">Fire (Dispersion)</td>
                            <td>0.104 (Higher Fire)</td>
                            <td>0.044</td>
                            <td>0.044</td>
                        </tr>
                        <tr>
                            <td class="prop-name">Luster</td>
                            <td>20.40%</td>
                            <td>17.20%</td>
                            <td>17.20%</td>
                        </tr>
                        <tr>
                            <td class="prop-name">Certificate</td>
                            <td>SAT Jewel / IGI</td>
                            <td>IGI / GIA</td>
                            <td>IGI / GIA</td>
                        </tr>
                        <tr>
                            <td class="prop-name">Price Value</td>
                            <td><strong class="price-val">$</strong></td>
                            <td><strong class="price-val">$$</strong></td>
                            <td><strong class="price-val">$$$$</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 2: What is Moissanite? (Screenshot 2 - Text on Left, Tweezers Image on Right) -->
        <div class="comp-split-row align-center">
            <div class="comp-text-col">
                <h2 class="comp-section-heading">What is Moissanite?</h2>
                <p class="comp-text-para">
                    Moissanite is a gemstone composed of silicon carbide, first discovered in 1893 by scientist Henri Moissan in a meteor crater. Initially mistaken for diamonds, moissanite is now recognized for its unique qualities. It's renowned for its exceptional brilliance and fire, often exceeding that of diamonds. Durable and hard, ranking close to diamonds on the Mohs scale, it's a popular choice for jewelry.
                </p>
                <p class="comp-text-para">
                    Moissanite is typically lab-created, making it an environmentally friendly and cost-effective alternative to traditional diamonds. Its sparkling appearance and sustainability make it a favored choice for modern, conscious consumers.
                </p>
            </div>
            <div class="comp-media-col">
                <div class="comp-image-wrapper">
                    <img src="/assets/guide/what_is_moissanite.jpg" alt="What is Moissanite Gemstone" class="comp-img-fit" />
                </div>
            </div>
        </div>

        <!-- Section 3: What is Lab Grown Diamond? (Screenshot 3 - Image on Left, Text on Right) -->
        <div class="comp-split-row align-center alt-bg">
            <div class="comp-media-col">
                <div class="comp-image-wrapper">
                    <img src="/assets/guide/what_is_lab_grown_diamond.jpg" alt="What is Lab Grown Diamond" class="comp-img-fit" />
                </div>
            </div>
            <div class="comp-text-col">
                <h2 class="comp-section-heading">What is Lab Grown Diamond?</h2>
                <p class="comp-text-para">
                    Lab-created diamonds, also known as man-made diamonds, match natural diamonds in appearance but are more budget-friendly. Created using advanced technology like HPHT or CVD, these diamonds replicate the physical, chemical, and optical characteristics of mined diamonds, making them visually indistinguishable. Their conflict-free and ethical sourcing provides an added advantage, appealing to eco-conscious consumers.
                </p>
                <p class="comp-text-para">
                    Lab-created diamonds thus offer a responsible, cost-effective alternative for those seeking the luxury and beauty of diamonds without the ethical and financial implications of natural diamond mining. This makes them a favored choice in modern jewelry markets.
                </p>
            </div>
        </div>

        <!-- Section 4: What is Diamond? (Screenshot 4 - Text on Left, Tweezers Image on Right) -->
        <div class="comp-split-row align-center">
            <div class="comp-text-col">
                <h2 class="comp-section-heading">What is Diamond?</h2>
                <p class="comp-text-para">
                    Diamonds are nature's marvels, formed deep within the Earth's mantle. These precious gems result from carbon subjected to extreme heat and pressure over millions of years.
                </p>
                <p class="comp-text-para">
                    Diamonds, while stunning, come with a hidden cost. Diamond mining often harms the environment, disturbing ecosystems and landscapes. Additionally, some diamonds, known as "conflict diamonds," fuel violence and exploitation in war-torn areas. These gems, traded illicitly, fund armed conflicts, violating human rights.
                </p>
                <p class="comp-text-para">
                    Responsible sourcing and ethical practices in the diamond industry are vital for a more sustainable and humane approach.
                </p>
            </div>
            <div class="comp-media-col">
                <div class="comp-image-wrapper dark-frame">
                    <img src="/assets/guide/what_is_diamond.jpg" alt="What is Natural Diamond" class="comp-img-fit" />
                </div>
            </div>
        </div>

        <!-- Section 5: Lab Grown Diamond & Moissanite Jewelry (Screenshot 5 - Grid of 2 Cards) -->
        <div class="comp-jewelry-section">
            <h2 class="comp-jewelry-main-heading">Lab Grown Diamond &amp; Moissanite Jewelry</h2>
            <div class="comp-jewelry-grid">
                <!-- Card 1 -->
                <a href="/Product/Category?id=5" class="comp-jcard-item">
                    <div class="comp-jcard-img-holder">
                        <img src="/assets/ivevar/Bridel_set.png" alt="All Hip Hop Lab Grown Diamonds Jewelry" />
                    </div>
                    <div class="comp-jcard-caption">
                        <h3>All Hip Hop Lab Grown Diamonds Jewelry</h3>
                    </div>
                </a>

                <!-- Card 2 -->
                <a href="/Product/Category?id=1" class="comp-jcard-item">
                    <div class="comp-jcard-img-holder">
                        <img src="/assets/ivevar/Men_s_ring.png" alt="All Moissanite Diamond Ring" />
                    </div>
                    <div class="comp-jcard-caption">
                        <h3>All Moissanite Diamond Ring</h3>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

