@{
    ViewData["Title"] = "Jewelry Education & Lab Diamond Insights — SAT Jewel Blog";
}

<div class="sat-blog-page">
    <!-- Header Banner -->
    <div class="sat-blog-header">
        <div class="sat-blog-header-inner">
            <span class="sat-blog-badge">Jewelry Insights &amp; Education</span>
            <h1 class="sat-blog-title">The Sat Jewels Journal</h1>
            <p class="sat-blog-subtitle">Expert guides, gemstone comparisons, and buying advice from master diamond artisans.</p>
        </div>
    </div>

    <div class="sat-blog-container">
        <!-- Featured Articles Grid -->
        <div class="sat-blog-grid">
            <!-- Article 1 -->
            <div class="sat-blog-card">
                <div class="sat-blog-img-wrap">
                    <img src="/assets/ivevar/backup-article-557101154492.jpg" alt="Lab-Grown Diamonds Guide" />
                    <span class="sat-blog-category">Education</span>
                </div>
                <div class="sat-blog-card-body">
                    <span class="sat-blog-date">August 22, 2026</span>
                    <h3 class="sat-blog-heading">Lab-Grown Diamonds vs. Mined Diamonds: The Complete Buying Guide</h3>
                    <p class="sat-blog-excerpt">Discover why lab-grown diamonds offer identical chemical, physical, and optical brilliance at up to 70% better value.</p>
                    <a href="/Home/DiamondComparisonGuide" class="sat-blog-link">Read Guide &rarr;</a>
                </div>
            </div>

            <!-- Article 2 -->
            <div class="sat-blog-card">
                <div class="sat-blog-img-wrap">
                    <img src="/assets/ivevar/fashion-jewelry-vs-fine-jewelry-grand-rapids-mi.jpg" alt="Engagement Ring Shapes" />
                    <span class="sat-blog-category">Buying Guide</span>
                </div>
                <div class="sat-blog-card-body">
                    <span class="sat-blog-date">August 18, 2026</span>
                    <h3 class="sat-blog-heading">How to Choose the Perfect Diamond Shape for Your Engagement Ring</h3>
                    <p class="sat-blog-excerpt">From timeless Round Solitaires to vintage Asscher and modern Oval cuts, find the ideal shape for your love story.</p>
                    <a href="/Catalog" class="sat-blog-link">Explore Shapes &rarr;</a>
                </div>
            </div>

            <!-- Article 3 -->
            <div class="sat-blog-card">
                <div class="sat-blog-img-wrap">
                    <img src="/assets/ivevar/exclusive_regal_star_diamond_ring.jpg" alt="Moissanite vs Lab Diamond" />
                    <span class="sat-blog-category">Gemology</span>
                </div>
                <div class="sat-blog-card-body">
                    <span class="sat-blog-date">August 12, 2026</span>
                    <h3 class="sat-blog-heading">Moissanite vs. Lab Diamond: Which Gemstone Fits Your Style &amp; Budget?</h3>
                    <p class="sat-blog-excerpt">Uncover the fire index, hardness rating, and visual differences between Moissanite and Lab-Grown Diamonds.</p>
                    <a href="/Home/MoissaniteVsDiamondSizeChart" class="sat-blog-link">Read Comparison &rarr;</a>
                </div>
            </div>

            <!-- Article 4 -->
            <div class="sat-blog-card">
                <div class="sat-blog-img-wrap">
                    <img src="/assets/ivevar/modern_wedding_ring_band_be1024e1-bb04-457c-83d2-7acda4fc55b4.png" alt="14K Gold Standards" />
                    <span class="sat-blog-category">Craftsmanship</span>
                </div>
                <div class="sat-blog-card-body">
                    <span class="sat-blog-date">August 05, 2026</span>
                    <h3 class="sat-blog-heading">Why 14K Gold is the Gold Standard for Fine Engagement Rings</h3>
                    <p class="sat-blog-excerpt">Learn how 14K Yellow, White, and Rose Gold balance durability, rich color tone, and daily wear resistance.</p>
                    <a href="/Home/JewelryCare" class="sat-blog-link">Read Article &rarr;</a>
                </div>
            </div>

            <!-- Article 5 -->
            <div class="sat-blog-card">
                <div class="sat-blog-img-wrap">
                    <img src="/assets/ivevar/radiant_emerlad_shiny_ring_ba059c3b-0120-43e0-8275-5c9bce94cf98.jpg" alt="Diamond 4Cs Guide" />
                    <span class="sat-blog-category">Education</span>
                </div>
                <div class="sat-blog-card-body">
                    <span class="sat-blog-date">July 28, 2026</span>
                    <h3 class="sat-blog-heading">The Ultimate 4Cs Guide: Cut, Color, Clarity &amp; Carat Weight Explained</h3>
                    <p class="sat-blog-excerpt">Master the 4Cs before purchasing your diamond ring to ensure maximum brilliance and certified quality.</p>
                    <a href="/Home/DiamondSizeChart" class="sat-blog-link">View 4Cs Chart &rarr;</a>
                </div>
            </div>

            <!-- Article 6 -->
            <div class="sat-blog-card">
                <div class="sat-blog-img-wrap">
                    <img src="/assets/ivevar/round_floral_cluster_diamond_ring_41298c3e-e25f-4180-b5af-f7bf458ffc72.jpg" alt="Jewelry Care at Home" />
                    <span class="sat-blog-category">Maintenance</span>
                </div>
                <div class="sat-blog-card-body">
                    <span class="sat-blog-date">July 15, 2026</span>
                    <h3 class="sat-blog-heading">How to Safely Clean &amp; Maintain Your Diamond Ring at Home</h3>
                    <p class="sat-blog-excerpt">Simple step-by-step instructions to remove lotion buildup, oils, and restore original diamond luster safely.</p>
                    <a href="/Home/JewelryCare" class="sat-blog-link">Read Care Guide &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .sat-blog-page {
        background-color: #faf8f5;
        color: #1a1a1a;
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 80px;
    }

    .sat-blog-header {
        text-align: center;
        padding: 70px 20px 40px;
        background: #ffffff;
        border-bottom: 1px solid #f0ede6;
    }

    .sat-blog-badge {
        display: inline-block;
        background: #fdf8f0;
        color: #b45309;
        padding: 6px 18px;
        border-radius: 20px;
        font-size: 0.82rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 16px;
        border: 1px solid #fce8cc;
    }

    .sat-blog-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 2.8rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 12px;
    }

    .sat-blog-subtitle {
        font-size: 1.05rem;
        color: #6b7280;
        max-width: 680px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .sat-blog-container {
        max-width: 1200px;
        margin: 50px auto 0;
        padding: 0 24px;
    }

    .sat-blog-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .sat-blog-card {
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #f0ede6;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .sat-blog-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 28px rgba(0,0,0,0.08);
    }

    .sat-blog-img-wrap {
        position: relative;
        width: 100%;
        height: 220px;
        overflow: hidden;
    }

    .sat-blog-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .sat-blog-category {
        position: absolute;
        top: 14px;
        left: 14px;
        background: rgba(15, 23, 42, 0.85);
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        backdrop-filter: blur(4px);
    }

    .sat-blog-card-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .sat-blog-date {
        font-size: 0.8rem;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .sat-blog-heading {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 10px;
        line-height: 1.4;
    }

    .sat-blog-excerpt {
        font-size: 0.92rem;
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 18px;
        flex-grow: 1;
    }

    .sat-blog-link {
        font-size: 0.88rem;
        font-weight: 700;
        color: #b45309;
        text-decoration: none;
    }

    .sat-blog-link:hover {
        text-decoration: underline;
    }

    @@media (max-width: 992px) {
        .sat-blog-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .sat-blog-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
