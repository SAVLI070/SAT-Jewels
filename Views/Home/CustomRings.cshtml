@{
    Layout = null;
    ViewData["Title"] = "Design Your Own Custom Engagement Ring — SAT Jewel Sanctuary";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/style.css" />
  <style>
    body {
      background: #06070a;
      color: #ffffff;
      font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
      margin: 0;
      min-height: 100vh;
    }

    /* 1. HERO TITLE HEADER */
    .bespoke-hero-header {
      text-align: center;
      padding: 75px 24px 55px;
      background: radial-gradient(circle at 50% 30%, #16141a 0%, #06070a 100%);
      border-bottom: 1px solid rgba(212, 178, 112, 0.25);
    }
    .bespoke-main-title {
      font-family: var(--font-serif, 'Playfair Display', serif);
      font-size: 44px;
      font-weight: 500;
      color: #ffffff;
      margin: 0 0 18px;
      letter-spacing: -0.3px;
    }
    .bespoke-main-subtitle {
      max-width: 920px;
      margin: 0 auto;
      font-size: 14.5px;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.82);
      font-weight: 400;
    }

    /* 2. MADE FOR YOU SECTION (SPLIT TWO COLUMN) */
    .bespoke-section {
      max-width: 1280px;
      margin: 0 auto;
      padding: 80px 24px;
    }
    .bespoke-split-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .bespoke-split-grid.reverse {
      grid-template-columns: 1fr 1fr;
    }
    .bespoke-text-box {
      padding: 10px 0;
    }
    .bespoke-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--champagne-gold, #d4b270);
      margin-bottom: 16px;
    }
    .bespoke-heading {
      font-family: var(--font-serif, 'Playfair Display', serif);
      font-size: 38px;
      font-weight: 400;
      line-height: 1.25;
      color: #ffffff;
      margin: 0 0 24px;
      letter-spacing: -0.2px;
    }
    .bespoke-paragraph {
      font-size: 14px;
      line-height: 1.85;
      color: rgba(255, 255, 255, 0.8);
      font-weight: 400;
      margin-bottom: 34px;
    }
    .bespoke-img-card {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid rgba(212, 178, 112, 0.3);
      box-shadow: 0 20px 50px rgba(0,0,0,0.8);
      background: #0e0d10;
    }
    .bespoke-img-card img {
      width: 100%;
      height: 480px;
      object-fit: cover;
      display: block;
      transition: transform 0.6s ease;
    }
    .bespoke-img-card:hover img {
      transform: scale(1.03);
    }

    /* BUTTON STYLING */
    .btn-sat-gold {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: var(--champagne-gold, #d4b270);
      color: #060c14;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 16px 36px;
      border-radius: 40px;
      box-shadow: 0 10px 30px rgba(212, 178, 112, 0.3);
      transition: all 0.3s ease;
      cursor: pointer;
      border: none;
    }
    .btn-sat-gold:hover {
      background: #ffffff;
      color: #000000;
      box-shadow: 0 15px 40px rgba(255, 255, 255, 0.3);
      transform: translateY(-2px);
    }
    .btn-sat-outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(14, 13, 16, 0.6);
      color: #ffffff;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 16px 36px;
      border-radius: 4px;
      border: 1px solid rgba(212, 178, 112, 0.5);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .btn-sat-outline:hover {
      background: var(--champagne-gold, #d4b270);
      color: #060c14;
      border-color: var(--champagne-gold, #d4b270);
      transform: translateY(-2px);
    }

    /* 3. WORK PROCESS HEADER */
    .process-main-header {
      text-align: center;
      padding: 70px 24px 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
    .process-main-title {
      font-family: var(--font-serif, 'Playfair Display', serif);
      font-size: 42px;
      font-weight: 400;
      color: #ffffff;
      margin: 0;
      letter-spacing: -0.2px;
    }

    /* PROCESS STEP ROW STYLES */
    .step-row-bg-dark {
      background: #030712;
      border-top: 1px solid rgba(212, 178, 112, 0.15);
      border-bottom: 1px solid rgba(212, 178, 112, 0.15);
    }
    .step-row-bg-light {
      background: #0e0d10;
    }

    /* 4. BOTTOM CONSULTATION CTA BANNER */
    .bespoke-cta-banner {
      text-align: center;
      padding: 90px 24px;
      background: radial-gradient(circle at 50% 50%, #16141a 0%, #06070a 100%);
      border-top: 1px solid rgba(212, 178, 112, 0.3);
      position: relative;
    }
    .cta-banner-title {
      font-family: var(--font-serif, 'Playfair Display', serif);
      font-size: 40px;
      font-weight: 400;
      color: #ffffff;
      margin: 0 0 16px;
    }
    .cta-banner-desc {
      font-size: 15px;
      color: rgba(255, 255, 255, 0.8);
      max-width: 680px;
      margin: 0 auto 36px;
      line-height: 1.7;
    }
    .cta-btn-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    /* RESPONSIVE BREAKPOINTS (MATCHING BIANCA CHIARA MOBILE LAYOUT) */
    @@media (max-width: 992px) {
      .bespoke-split-grid,
      .bespoke-split-grid.reverse {
        grid-template-columns: 1fr !important;
        gap: 36px !important;
      }
      .bespoke-split-grid.reverse .bespoke-img-card {
        order: -1;
      }
      .bespoke-main-title {
        font-size: 32px;
      }
      .bespoke-heading {
        font-size: 30px;
      }
      .process-main-title {
        font-size: 32px;
      }
      .bespoke-img-card img {
        height: 380px;
      }
    }

    @@media (max-width: 768px) {
      .bespoke-hero-header {
        padding: 38px 18px 30px !important;
      }
      .bespoke-main-title {
        font-size: 26px !important;
        line-height: 1.25 !important;
        margin-bottom: 12px !important;
      }
      .bespoke-main-subtitle {
        font-size: 13.5px !important;
        line-height: 1.7 !important;
      }
      .bespoke-section {
        padding: 0 0 30px 0 !important;
        max-width: 100% !important;
      }
      .bespoke-split-grid,
      .bespoke-split-grid.reverse {
        display: flex !important;
        flex-direction: column !important;
        gap: 0 !important;
      }
      .bespoke-img-card {
        order: -1 !important;
        width: 100% !important;
        border-radius: 0 !important;
        border: none !important;
        border-bottom: 1px solid rgba(212, 178, 112, 0.25) !important;
        box-shadow: none !important;
        margin: 0 !important;
      }
      .bespoke-img-card img {
        height: 320px !important;
        width: 100% !important;
        object-fit: cover !important;
        border-radius: 0 !important;
      }
      .bespoke-text-box {
        padding: 24px 18px 16px !important;
        text-align: left !important;
      }
      .bespoke-badge {
        font-size: 10.5px !important;
        letter-spacing: 0.2em !important;
        margin-bottom: 10px !important;
      }
      .bespoke-heading {
        font-size: 24px !important;
        line-height: 1.25 !important;
        margin-bottom: 14px !important;
      }
      .bespoke-paragraph {
        font-size: 13.5px !important;
        line-height: 1.75 !important;
        margin-bottom: 0 !important;
      }
      .process-main-header {
        padding: 40px 18px 20px !important;
      }
      .process-main-title {
        font-size: 24px !important;
      }
      .bespoke-cta-banner {
        padding: 50px 18px !important;
      }
      .cta-banner-title {
        font-size: 24px !important;
      }
    }
  </style>
</head>
<body>

  <!-- SAT Jewel Navigation Bar (Unified Luxury Header - As Designed) -->
  <header style="position:fixed; top:0; left:0; right:0; z-index:9999; background:rgba(7,7,10,0.96); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border-bottom:1px solid rgba(212,184,120,0.25); height:64px;">
    <div style="max-width:1280px; margin:0 auto; padding:0 20px; height:100%; display:flex; align-items:center; justify-content:space-between; gap:16px;">
      <div style="display:flex; align-items:center; gap:14px; flex-shrink:0;">
        <a href="javascript:void(0);" onclick="if(window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" style="display:inline-flex; align-items:center; gap:6px; color:rgba(255,255,255,0.85); font-size:13px; font-weight:600; text-decoration:none; cursor:pointer;" title="Go Back">
          <span class="material-symbols-outlined" style="font-size:20px;">arrow_back</span>
          <span class="mobile-hidden">Back</span>
        </a>
        <div style="height:16px; width:1px; background:rgba(255,255,255,0.2);"></div>
        <a href="/" style="display:flex; align-items:center; gap:10px; text-decoration:none;">
          <img src="/assets/sat_emblem_clean.png" alt="SAT Jewels Emblem" style="width:34px; height:34px; border-radius:50%; object-fit:contain; border:1px solid rgba(212,184,120,0.4);" />
          <div style="display:flex; flex-direction:column; line-height:1.1;">
            <span style="font-family:var(--font-serif, 'Playfair Display', serif); font-size:18px; font-weight:700; color:#ffffff; letter-spacing:0.03em; white-space:nowrap;">SAT <span style="margin-left:3px; color:#d4b878;">Jewel</span></span>
            <span style="font-size:8px; font-weight:600; color:rgba(212,184,120,0.8); letter-spacing:0.18em; text-transform:uppercase;">Fine Jewelry</span>
          </div>
        </a>
      </div>

      <div style="display:flex; align-items:center; gap:12px; flex-shrink:0;">
        <button type="button" onclick="openSatGlobalSearch(event)" style="background:transparent; border:none; color:rgba(255,255,255,0.85); width:36px; height:36px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; cursor:pointer;" title="Search">
          <span class="material-symbols-outlined" style="font-size:20px;">search</span>
        </button>
        <a href="/Product/Cart" style="position:relative; color:rgba(255,255,255,0.85); width:36px; height:36px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; text-decoration:none;" title="Shopping Cart">
          <span class="material-symbols-outlined" style="font-size:20px;">shopping_bag</span>
          <span id="navCartBadge" class="sat-cart-count-badge" style="position:absolute; top:2px; right:2px; min-width:16px; height:16px; border-radius:8px; background:#d4b878; color:#060c14; font-size:10px; font-weight:800; display:flex; align-items:center; justify-content:center; padding:0 3px; line-height:1;">0</span>
        </a>
        <a href="/Account/MyAccount" style="width:34px; height:34px; border-radius:50%; background:linear-gradient(135deg, #d4b878, #b8944d); color:#060c14; font-size:13px; font-weight:700; display:inline-flex; align-items:center; justify-content:center; text-decoration:none;" title="My Account">
          <span class="material-symbols-outlined" style="font-size:18px;">person</span>
        </a>
      </div>
    </div>
  </header>

  <!-- PAGE BREADCRUMB NAVIGATION BAR -->
  <nav class="cat-breadcrumb-nav" style="background:#08111e; border-bottom:1px solid rgba(255,255,255,0.1); padding:14px 0; margin-top:64px;">
    <div class="cat-container" style="max-width:1280px; margin:0 auto; padding:0 24px; display:flex; align-items:center; justify-content:space-between;">
      <div style="font-size:13px; color:rgba(255,255,255,0.7); display:flex; align-items:center; gap:8px;">
        <a href="/" style="color:#ffffff; text-decoration:none;">Home</a>
        <span>/</span>
        <span style="color:var(--champagne-gold, #d4b878);">Custom Engagement Rings</span>
      </div>
      <div>
        <a href="javascript:void(0);" onclick="if(window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" style="color:var(--champagne-gold, #d4b878); font-size:13px; font-weight:600; text-decoration:none; display:flex; align-items:center; gap:6px; cursor:pointer;" title="Go Back">
          <i class="fa-solid fa-arrow-left" style="font-size:11px;"></i> <span>Back</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- 1. HERO TITLE HEADER -->
  <header class="bespoke-hero-header">
    <div style="max-width: 1080px; margin: 0 auto;">
      <h1 class="bespoke-main-title">Design Your Own Engagement Ring</h1>
      <p class="bespoke-main-subtitle">
        Start your Bespoke Engagement Ring Design today with a SAT Jewel Bespoke Design package. Each of our beautiful custom made engagement rings is meticulously crafted with utmost care and attention to detail. From concept to creation, we'll create your perfect ring.
      </p>
    </div>
  </header>

  <!-- 2. MADE FOR YOU SECTION -->
  <section class="bespoke-section">
    <div class="bespoke-split-grid">
      <!-- Left Column Text -->
      <div class="bespoke-text-box">
        <span class="bespoke-badge">MADE FOR YOU</span>
        <h2 class="bespoke-heading">Bespoke Jewellery Service Made For The One You Love</h2>
        <p class="bespoke-paragraph">
          Jewellery is often considered very personal. Many pieces, for example, are associated with important life events or milestones in our lives or the lives of those we love. We are talking about, for instance, engagements, anniversaries, birthdays, and other significant moments. Because these events have a unique emotional value, the jewellery becomes a reminder of those moments. Jewellery is also often given as a gift, so it represents a strong emotional connection. And, of course, there is also an expression of individuality and symbolic meanings to rings, bracelets, necklaces, and other jewellery choices. Now, sometimes, it can be difficult to find the perfect piece. This is why many people turn to bespoke jewellery services, as they let you design your rings exactly how you want them.
        </p>
      </div>

      <!-- Right Column Image -->
      <div class="bespoke-img-card">
        <img src="/assets/bespoke/bespoke_craftsman.jpg" alt="Master Jeweler Hand Setting Custom Ring" />
      </div>
    </div>
  </section>

  <!-- 3. THE BESPOKE JEWELLERY WORK PROCESS SECTION -->
  <div class="process-main-header">
    <h2 class="process-main-title">The Bespoke Jewellery Work Process</h2>
  </div>

  <!-- STEP 1: IDEAS -->
  <section class="step-row-bg-dark">
    <div class="bespoke-section">
      <div class="bespoke-split-grid reverse">
        <!-- Left Image -->
        <div class="bespoke-img-card">
          <img src="/assets/bespoke/bespoke_ideas.jpg" alt="Step 1 Ideas Showroom Consultation" />
        </div>
        <!-- Right Text -->
        <div class="bespoke-text-box">
          <span class="bespoke-badge">STEP 1</span>
          <h3 class="bespoke-heading">Ideas</h3>
          <p class="bespoke-paragraph">
            The first thing is to decide what you would like your dream ring to look like. Next, look through our extensive online catalogue to get some inspiration and then bring your ideas to your exclusive one-on-one session with one of our experts. We'll talk you through a whole host of ideas and find the one that will be on your partner's finger for a lifetime.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- STEP 2: THE BASIC DESIGN -->
  <section class="step-row-bg-light">
    <div class="bespoke-section">
      <div class="bespoke-split-grid">
        <!-- Left Text -->
        <div class="bespoke-text-box">
          <span class="bespoke-badge">STEP 2</span>
          <h3 class="bespoke-heading">The Basic Design</h3>
          <p class="bespoke-paragraph">
            Your consultant will create a basic design with your primary ideas roughed out. This serves as a price estimate whilst we work with you to finalise the design so that it is exactly how you want it to be before we start finalising the design.
          </p>
        </div>
        <!-- Right Image -->
        <div class="bespoke-img-card">
          <img src="/assets/bespoke/bespoke_sketch.jpg" alt="Step 2 Hand Sketching Custom Ring Blueprint" />
        </div>
      </div>
    </div>
  </section>

  <!-- STEP 3: THE STONE -->
  <section class="step-row-bg-dark">
    <div class="bespoke-section">
      <div class="bespoke-split-grid reverse">
        <!-- Left Image -->
        <div class="bespoke-img-card">
          <img src="/assets/bespoke/bespoke_stones.jpg" alt="Step 3 Loose GIA Diamonds Selection" />
        </div>
        <!-- Right Text -->
        <div class="bespoke-text-box">
          <span class="bespoke-badge">STEP 3</span>
          <h3 class="bespoke-heading">The Stone</h3>
          <p class="bespoke-paragraph">
            No engagement ring would be complete without a diamond or a gemstone to catch the eye. With over 100,000 options to choose from, your consultant will be invaluable in helping you find the one that your partner has waited so long for. Once you've found the one your heart desires, we'll add it to the design and move on to step 4.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- STEP 4: HANDCRAFTING & PERFECTION -->
  <section class="step-row-bg-light">
    <div class="bespoke-section">
      <div class="bespoke-split-grid">
        <!-- Left Text -->
        <div class="bespoke-text-box">
          <span class="bespoke-badge">STEP 4</span>
          <h3 class="bespoke-heading">Handcrafting &amp; Perfection</h3>
          <p class="bespoke-paragraph">
            Once the design and stone are finalized, our master goldsmiths begin handcrafting your bespoke ring in our workshop using 100% solid 18k gold or platinum. Every diamond is hand-set under high magnification to ensure enduring brilliance, security, and a flawless finish for a lifetime of love.
          </p>
        </div>
        <!-- Right Image -->
        <div class="bespoke-img-card">
          <img src="/assets/ivevar/WhatsApp_Image_2025-05-21_at_10.12.58_8a278462.jpg" alt="Step 4 Master Jeweler Handcrafting Engagement Ring" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4. BOTTOM CONSULTATION CTA BANNER -->
  <section class="bespoke-cta-banner">
    <div style="max-width: 900px; margin: 0 auto;">
      <span class="bespoke-badge" style="letter-spacing: 0.3em;">BEGIN YOUR STORY</span>
      <h2 class="cta-banner-title">Ready to Create Your Bespoke Ring?</h2>
      <p class="cta-banner-desc">
        Schedule a private 1-on-1 consultation with our master jewelry artisans and turn your vision into a breathtaking heirloom piece.
      </p>
      <div class="cta-btn-group">
        <button type="button" onclick="openCustomDesignModal()" class="btn-sat-gold" style="display:inline-flex; align-items:center; gap:8px;">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          <span>Share Design &amp; Custom Details</span>
        </button>
        <a href="/Product/Category?id=1" class="btn-sat-outline" style="display:inline-flex; align-items:center; gap:8px;">
          <i class="fa-solid fa-gem"></i>
          <span>Explore Ready Designs</span>
        </a>
      </div>
    </div>
  </section>

  <!-- BESPOKE CUSTOMIZATION & IMAGE SHARING MODAL -->
  <div id="customDesignModal" style="display:none; position:fixed; inset:0; background:rgba(6,7,10,0.85); backdrop-filter:blur(16px); z-index:999999; align-items:center; justify-content:center; padding:20px;">
    <div style="background:#121118; border:1px solid rgba(212,178,112,0.4); border-radius:24px; max-width:640px; width:100%; max-height:90vh; overflow-y:auto; padding:32px; box-shadow:0 30px 80px rgba(0,0,0,0.9); position:relative;">
      <button type="button" onclick="closeCustomDesignModal()" style="position:absolute; top:20px; right:20px; background:none; border:none; color:#94a3b8; font-size:22px; cursor:pointer; padding:4px;"><i class="fa-solid fa-xmark"></i></button>

      <div style="text-align:center; margin-bottom:24px;">
        <span class="bespoke-badge" style="letter-spacing:0.25em;">BESPOKE ATELIER</span>
        <h3 style="font-family:var(--font-serif, 'Playfair Display', serif); font-size:26px; font-weight:600; color:#ffffff; margin:8px 0 6px;">Request Custom Jewelry Design</h3>
        <p style="font-size:13.5px; color:rgba(255,255,255,0.7); margin:0; line-height:1.6;">Share your dream jewelry sketch, photo, or reference details. Our master artisans in India will craft it to perfection.</p>
      </div>

      <div id="customModalAlert" style="display:none; padding:12px 16px; border-radius:12px; font-size:13px; font-weight:600; margin-bottom:18px;"></div>

      <form id="customDesignForm" onsubmit="handleCustomDesignSubmit(event)" style="display:flex; flex-direction:column; gap:16px;">
        <!-- Full Name & Email -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div>
            <label style="display:block; font-size:11.5px; font-weight:700; color:#d4b270; text-transform:uppercase; margin-bottom:6px; letter-spacing:0.5px;">Your Name *</label>
            <input type="text" id="custName" required placeholder="e.g. Sophia Miller"
                   style="width:100%; box-sizing:border-box; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; color:#ffffff; font-size:13.5px; outline:none;" />
          </div>
          <div>
            <label style="display:block; font-size:11.5px; font-weight:700; color:#d4b270; text-transform:uppercase; margin-bottom:6px; letter-spacing:0.5px;">Your Email *</label>
            <input type="email" id="custEmail" required placeholder="sophia@example.com"
                   style="width:100%; box-sizing:border-box; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; color:#ffffff; font-size:13.5px; outline:none;" />
          </div>
        </div>

        <!-- Phone / WhatsApp & Jewelry Type -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div>
            <label style="display:block; font-size:11.5px; font-weight:700; color:#d4b270; text-transform:uppercase; margin-bottom:6px; letter-spacing:0.5px;">WhatsApp / Phone</label>
            <input type="tel" id="custPhone" placeholder="+1 (555) 000-0000"
                   style="width:100%; box-sizing:border-box; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; color:#ffffff; font-size:13.5px; outline:none;" />
          </div>
          <div>
            <label style="display:block; font-size:11.5px; font-weight:700; color:#d4b270; text-transform:uppercase; margin-bottom:6px; letter-spacing:0.5px;">Jewelry Category</label>
            <select id="custCategory" style="width:100%; box-sizing:border-box; background:#1c1a24; border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; color:#ffffff; font-size:13.5px; outline:none;">
              <option value="Custom Engagement Ring">Engagement Ring</option>
              <option value="Wedding Band">Wedding Band</option>
              <option value="Diamond Pendant / Necklace">Diamond Pendant / Necklace</option>
              <option value="Tennis Bracelet / Bangle">Tennis Bracelet / Bangle</option>
              <option value="Earrings / Studs">Earrings / Studs</option>
              <option value="Complete Custom Piece">Other Custom Piece</option>
            </select>
          </div>
        </div>

        <!-- Metal & Target Budget -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div>
            <label style="display:block; font-size:11.5px; font-weight:700; color:#d4b270; text-transform:uppercase; margin-bottom:6px; letter-spacing:0.5px;">Preferred Metal</label>
            <select id="custMetal" style="width:100%; box-sizing:border-box; background:#1c1a24; border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; color:#ffffff; font-size:13.5px; outline:none;">
              <option value="18K Yellow Gold">18K Yellow Gold</option>
              <option value="18K White Gold">18K White Gold</option>
              <option value="18K Rose Gold">18K Rose Gold</option>
              <option value="14K Yellow Gold">14K Yellow Gold</option>
              <option value="14K White Gold">14K White Gold</option>
              <option value="950 Platinum">950 Platinum</option>
              <option value="925 Sterling Silver">925 Sterling Silver</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-size:11.5px; font-weight:700; color:#d4b270; text-transform:uppercase; margin-bottom:6px; letter-spacing:0.5px;">Target Budget (USD)</label>
            <input type="text" id="custBudget" placeholder="e.g. $1,500 - $3,000"
                   style="width:100%; box-sizing:border-box; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; color:#ffffff; font-size:13.5px; outline:none;" />
          </div>
        </div>

        <!-- Item Details & Description -->
        <div>
          <label style="display:block; font-size:11.5px; font-weight:700; color:#d4b270; text-transform:uppercase; margin-bottom:6px; letter-spacing:0.5px;">Design Details &amp; Custom Requirements *</label>
          <textarea id="custDetails" required rows="3" placeholder="Describe the center stone shape, prong style, ring size, engraving, or specific dimensions you want..."
                    style="width:100%; box-sizing:border-box; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; color:#ffffff; font-size:13.5px; outline:none; resize:vertical;"></textarea>
        </div>

        <!-- Image Upload Box -->
        <div>
          <label style="display:block; font-size:11.5px; font-weight:700; color:#d4b270; text-transform:uppercase; margin-bottom:6px; letter-spacing:0.5px;">Attach Reference Image / Sketch</label>
          <div style="border:1.5px dashed rgba(212,178,112,0.4); border-radius:12px; padding:18px; text-align:center; background:rgba(255,255,255,0.02); cursor:pointer;" onclick="document.getElementById('custImageInput').click()">
            <input type="file" id="custImageInput" accept="image/*" style="display:none;" onchange="previewCustImage(this)" />
            <i class="fa-solid fa-cloud-arrow-up" style="font-size:24px; color:#d4b270; margin-bottom:8px;"></i>
            <div id="custUploadText" style="font-size:13px; color:#ffffff;">Click to choose an image file (PNG, JPG, WEBP)</div>
            <div style="font-size:11px; color:#94a3b8; margin-top:4px;">You can upload reference jewelry photos, sketches, or CAD drawings</div>
            <img id="custImgPreview" style="display:none; max-height:140px; max-width:100%; margin:12px auto 0; border-radius:8px; border:1px solid rgba(212,178,112,0.3); object-fit:contain;" alt="Preview" />
          </div>
        </div>

        <!-- Action Buttons -->
        <div style="display:flex; flex-direction:column; gap:10px; margin-top:8px;">
          <!-- Submit online -->
          <button type="submit" id="btnSubmitCustom"
                  style="width:100%; background:linear-gradient(135deg, #d4b270, #b45309); color:#060c14; font-weight:800; border:none; padding:14px; border-radius:40px; font-size:14px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; box-shadow:0 8px 24px rgba(212,178,112,0.35);">
            <i class="fa-solid fa-gem"></i> Submit Custom Request Online
          </button>

          <!-- WhatsApp Chat -->
          <button type="button" onclick="sendCustomOnWhatsApp()"
                  style="width:100%; background:#25d366; color:#ffffff; font-weight:800; border:none; padding:13px; border-radius:40px; font-size:13.5px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; box-shadow:0 4px 16px rgba(37,211,102,0.3);">
            <i class="fa-brands fa-whatsapp" style="font-size:17px;"></i> Chat &amp; Share Photo on WhatsApp
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openCustomDesignModal() {
      document.getElementById('customDesignModal').style.display = 'flex';
      document.getElementById('custName').focus();
    }

    function closeCustomDesignModal() {
      document.getElementById('customDesignModal').style.display = 'none';
    }

    function previewCustImage(input) {
      const file = input.files && input.files[0];
      const preview = document.getElementById('custImgPreview');
      const uploadText = document.getElementById('custUploadText');
      if (file) {
        uploadText.innerText = 'Selected: ' + file.name;
        const reader = new FileReader();
        reader.onload = function(e) {
          preview.src = e.target.result;
          preview.style.display = 'block';
        };
        reader.readAsDataURL(file);
      } else {
        preview.style.display = 'none';
        uploadText.innerText = 'Click to choose an image file (PNG, JPG, WEBP)';
      }
    }

    function sendCustomOnWhatsApp() {
      const name = document.getElementById('custName').value.trim() || 'Valued Customer';
      const category = document.getElementById('custCategory').value;
      const metal = document.getElementById('custMetal').value;
      const budget = document.getElementById('custBudget').value.trim();
      const details = document.getElementById('custDetails').value.trim();

      let msg = `Hello SAT Jewel! I would like to order a custom jewelry piece.\n\n` +
                `*Name:* ${name}\n` +
                `*Item:* ${category}\n` +
                `*Metal:* ${metal}\n`;
      if (budget) msg += `*Target Budget:* ${budget}\n`;
      if (details) msg += `*Details/Specs:* ${details}\n`;
      msg += `\nI have attached my reference image and would love to discuss crafting this with your master jewelers!`;

      const waUrl = `https://wa.me/918320972779?text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank');
    }

    function handleCustomDesignSubmit(e) {
      e.preventDefault();
      const alertBox = document.getElementById('customModalAlert');
      const btn = document.getElementById('btnSubmitCustom');
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';

      setTimeout(() => {
        alertBox.style.display = 'block';
        alertBox.style.background = 'rgba(34, 197, 94, 0.2)';
        alertBox.style.border = '1px solid #22c55e';
        alertBox.style.color = '#86efac';
        alertBox.innerHTML = '<i class="fa-solid fa-circle-check"></i> Thank you! Your bespoke jewelry design request has been received. Our concierge team will reach out with 3D renderings and estimates within 24 hours.';
        
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Request Submitted!';
        
        setTimeout(() => {
          closeCustomDesignModal();
          alertBox.style.display = 'none';
          document.getElementById('customDesignForm').reset();
          document.getElementById('custImgPreview').style.display = 'none';
          document.getElementById('custUploadText').innerText = 'Click to choose an image file (PNG, JPG, WEBP)';
          btn.innerHTML = '<i class="fa-solid fa-gem"></i> Submit Custom Request Online';
        }, 3000);
    function syncCartBadge() {
      try {
        const email = '@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value?.ToLower()?.Trim() ?? "")';
        const key = email ? ('sat_cart_' + encodeURIComponent(email)) : 'sat_cart_guest';
        const saved = localStorage.getItem(key);
        const items = saved ? JSON.parse(saved) : [];
        const count = items.reduce((sum, i) => sum + (Number(i.quantity) || 1), 0);
        document.querySelectorAll('#navCartBadge, #navCartCount, .auth-nav-cart-count, .sat-cart-count-badge').forEach(el => {
          el.textContent = String(count);
        });
      } catch (_) {}
    }
    document.addEventListener('DOMContentLoaded', syncCartBadge);
    syncCartBadge();
  </script>
  <!-- SAT Jewel Search Modal -->
  <partial name="_SearchModal" />
  <!-- SAT Jewel Signature Diamond Loader -->
  <partial name="_DiamondLoader" />
</body>
</html>
