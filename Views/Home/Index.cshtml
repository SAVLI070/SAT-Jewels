@{
    ViewData["Title"] = "Fine Jewelry & AI Diamond Intelligence";
}

<!-- Intro Animation Overlay -->
<div id="intro-overlay"></div>

<!-- Centered Official Emblem Logo that animates to Top-Left Navbar on Load -->
<div id="intro-logo-container">
  <div class="sat-logo-emblem">
    <img src="~/assets/sat_emblem_clean.png" class="official-sat-logo-img" alt="SAT Jewel Official Logo" />
  </div>
</div>

<!-- FULL PAGE BACKGROUND IMAGE SLIDER -->
<div class="hero-slider-bg">
  <div class="hero-slider">
    <img class="active" src="~/assets/sat_jewels_shop_bg.jpg" alt="Sat Jewels Storefront & Diamond Showroom" loading="eager" />
    <img src="~/assets/hero_1.jpg" alt="Model wearing SAT Jewel diamond necklace and ring" loading="lazy" />
    <img src="~/assets/hero_2.jpg" alt="Macro shot of sparkling raw crystals and gold" loading="lazy" />
    <img src="~/assets/hero_3.jpg" alt="Macro raw diamonds and emerald crystals" loading="lazy" />
  </div>
  <div class="hero-image-overlay"></div>
</div>

<!-- Animated Background Orbs -->
<div class="page-bg" aria-hidden="true">
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>
  <div class="bg-orb bg-orb-3"></div>
  <div class="bg-orb bg-orb-4"></div>
</div>

<!-- Navbar — Single Horizontal Line -->
<nav class="navbar" id="navbar">
  <div class="container nav-inner">
    <!-- Target Slot where centered logo lands -->
    <div class="nav-logo-slot"></div>

    <!-- Navigation Bar Links -->
    <div class="nav-links">
      <div class="nav-indicator"></div>
      <a href="#hero" class="nav-link active">
        <i class="fa-solid fa-house"></i>
        <span>Home</span>
      </a>
      <a href="#collections" class="nav-link">
        <i class="fa-solid fa-gem"></i>
        <span>Collections</span>
      </a>
      <a href="#how-it-works" class="nav-link">
        <i class="fa-solid fa-hammer"></i>
        <span>Craft Process</span>
      </a>
      <a href="#ai-features" class="nav-link">
        <i class="fa-solid fa-chart-line"></i>
        <span>AI Valuer</span>
      </a>
      <a href="#why" class="nav-link">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Why SAT Jewel</span>
      </a>
    </div>

    <div class="nav-actions">
      <!-- Auto-Detected Location & Currency Badge -->
      <div class="location-currency-badge" id="locationCurrencyBadge" title="Auto-detected location currency">
        <span id="userFlag">🇮🇳</span> <span id="userCurrCode">INR (₹)</span>
      </div>

      <!-- Single Clean Contact Us Button -->
      <a href="#cta" class="btn-primary">
        <i class="fa-solid fa-envelope"></i> Contact Us
      </a>

      <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Drawer Menu -->
<div class="mobile-menu" id="mobileMenu">
  <a href="#hero" class="mobile-nav-link" onclick="toggleMenu()">
    <i class="fa-solid fa-house"></i>
    <span>Home</span>
  </a>
  <a href="#collections" class="mobile-nav-link" onclick="toggleMenu()">
    <i class="fa-solid fa-gem"></i>
    <span>Collections</span>
  </a>
  <a href="#how-it-works" class="mobile-nav-link" onclick="toggleMenu()">
    <i class="fa-solid fa-hammer"></i>
    <span>Craft Process</span>
  </a>
  <a href="#ai-features" class="mobile-nav-link" onclick="toggleMenu()">
    <i class="fa-solid fa-chart-line"></i>
    <span>AI Valuer</span>
  </a>
  <a href="#why" class="mobile-nav-link" onclick="toggleMenu()">
    <i class="fa-solid fa-shield-halved"></i>
    <span>Why SAT Jewel</span>
  </a>
  <a href="#cta" class="mobile-nav-link" onclick="toggleMenu()">
    <i class="fa-solid fa-envelope"></i>
    <span>Contact Us</span>
  </a>
</div>

<!-- Hero Section -->
<section id="hero">
  <div class="container hero-content-container">
    <div class="hero-eyebrow">
      <span class="section-badge badge-gold">
        <i class="fa-solid fa-certificate"></i>
        <span>GIA Certified Fine Jewelry</span>
      </span>
    </div>

    <h1 class="hero-h1">
      <span id="typewriter-line1" class="typewriter-line"></span><br />
      <span id="typewriter-line2" class="typewriter-line accent-gold"></span>
      <span class="typewriter-cursor">|</span>
    </h1>

    <p class="hero-sub">
      Redefining luxury jewelry with AI-driven diamond valuation, conflict-free GIA certified gems, and bespoke 3D studio craftsmanship.
    </p>

    <div class="hero-ctas">
      <a href="#collections" class="btn-hero-primary">
        <i class="fa-solid fa-gem"></i>
        <span>Explore SAT Collections</span>
      </a>
    </div>

    <div class="hero-trust">
      <div class="trust-avatars">
        <div class="trust-avatar trust-avatar-gold">SAT</div>
        <div class="trust-avatar trust-avatar-emerald">GIA</div>
        <div class="trust-avatar">IGI</div>
      </div>
      <div class="trust-text">
        Over <strong>12,000+</strong> Certified Diamonds Delivered
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <i class="fa-solid fa-shield-check"></i>
        <span>100% Conflict Free</span>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="scroll-indicator">
    <div class="mouse">
      <div class="wheel"></div>
    </div>
    <span class="scroll-text">SCROLL TO EXPLORE</span>
  </div>
</section>

<!-- Stats Band Section -->
<section id="stats">
  <div class="container">
    <div class="stats-band reveal">
      <div class="stat-item">
        <div class="stat-num" data-target="15000" data-suffix="+">0</div>
        <div class="stat-label">Unique Bespoke Designs</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" data-target="99" data-suffix="%">0</div>
        <div class="stat-label">GIA Grade Accuracy</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" data-target="500" data-prefix="₹" data-suffix="Cr+">0</div>
        <div class="stat-label">Diamond Portfolio Value</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" data-target="24" data-suffix="+">0</div>
        <div class="stat-label">Global Boutiques</div>
      </div>
    </div>
  </div>
</section>

<!-- MOST SELLING COLLECTIONS SHOWCASE -->
<section id="collections">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge badge-gold">Best Sellers</span>
      <h2 class="section-title">Most Selling Collections</h2>
      <p class="section-sub">Click any category below to view our full catalog of GIA-certified rings, necklaces, earrings, and bracelets.</p>
    </div>

    <div class="collections-grid">
      <!-- 1. Rings Section -->
      <div class="collection-card reveal" onclick="openCollectionModal('rings')">
        <div class="collection-img-wrap">
          <img src="~/assets/ring_1.jpg" alt="Rings Collection" />
          <span class="collection-card-badge">Top Selling</span>
        </div>
        <div class="collection-body">
          <div class="collection-title">Rings Collection</div>
          <div class="collection-count" id="count-rings">4 Listed Designs | Solitaires & Halos</div>
          <div class="btn-explore-collection">
            Explore Rings Listing <i class="fa-solid fa-arrow-right"></i>
          </div>
        </div>
      </div>

      <!-- 2. Necklaces Section -->
      <div class="collection-card reveal" style="transition-delay:0.1s" onclick="openCollectionModal('necklaces')">
        <div class="collection-img-wrap">
          <img src="~/assets/necklace_1.jpg" alt="Necklaces Collection" />
          <span class="collection-card-badge">Popular</span>
        </div>
        <div class="collection-body">
          <div class="collection-title">Necklaces Section</div>
          <div class="collection-count" id="count-necklaces">3 Listed Designs | Chokers & Pendants</div>
          <div class="btn-explore-collection">
            Explore Necklaces Listing <i class="fa-solid fa-arrow-right"></i>
          </div>
        </div>
      </div>

      <!-- 3. Earrings Section -->
      <div class="collection-card reveal" style="transition-delay:0.2s" onclick="openCollectionModal('earrings')">
        <div class="collection-img-wrap">
          <img src="~/assets/earring_card.jpg" alt="Earrings Collection" />
          <span class="collection-card-badge">Trending</span>
        </div>
        <div class="collection-body">
          <div class="collection-title">Earrings Section</div>
          <div class="collection-count" id="count-earrings">2 Listed Designs | Studs & Drops</div>
          <div class="btn-explore-collection">
            Explore Earrings Listing <i class="fa-solid fa-arrow-right"></i>
          </div>
        </div>
      </div>

      <!-- 4. Bracelets Section -->
      <div class="collection-card reveal" style="transition-delay:0.3s" onclick="openCollectionModal('bracelets')">
        <div class="collection-img-wrap">
          <img src="~/assets/bracelet_card.jpg" alt="Bracelets Collection" />
          <span class="collection-card-badge">Featured</span>
        </div>
        <div class="collection-body">
          <div class="collection-title">Bracelets Section</div>
          <div class="collection-count" id="count-bracelets">2 Listed Designs | Tennis & Bangles</div>
          <div class="btn-explore-collection">
            Explore Bracelets Listing <i class="fa-solid fa-arrow-right"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- How It Works (Bespoke Crafting Process) -->
<section id="how-it-works">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge badge-terracotta">Master Craftsmanship</span>
      <h2 class="section-title">Four Steps from Mine to Masterpiece</h2>
      <p class="section-sub">Every gemstone is hand-selected, GIA verified, 3D modeled, and meticulously set by SAT Jewel master artisans.</p>
    </div>

    <div style="position:relative;">
      <div class="how-connector"></div>
      <div class="how-grid">
        <div class="how-step reveal" style="transition-delay:0.1s">
          <div class="how-step-num">
            <i class="fa-solid fa-magnifying-glass-location how-step-icon"></i>
          </div>
          <div class="how-step-title">1. Discover & Select</div>
          <div class="how-step-desc">Browse GIA-certified diamonds & rare colored gemstones with real-time AI valuation and RAPAPORT price tracking.</div>
          <span class="how-step-badge">Step 1</span>
        </div>

        <div class="how-step reveal" style="transition-delay:0.2s">
          <div class="how-step-num">
            <i class="fa-solid fa-cube how-step-icon"></i>
          </div>
          <div class="how-step-title">2. 3D Custom Fitting</div>
          <div class="how-step-desc">Customize your metal alloy (18K Gold, Platinum), diamond cut, and setting in our interactive 3D studio.</div>
          <span class="how-step-badge">Step 2</span>
        </div>

        <div class="how-step reveal" style="transition-delay:0.3s">
          <div class="how-step-num">
            <i class="fa-solid fa-hammer how-step-icon"></i>
          </div>
          <div class="how-step-title">3. Artisan Handcrafting</div>
          <div class="how-step-desc">Master jewelers forge, set, and polish your unique piece with traditional techniques and microscopic precision.</div>
          <span class="how-step-badge">Step 3</span>
        </div>

        <div class="how-step reveal" style="transition-delay:0.4s">
          <div class="how-step-num">
            <i class="fa-solid fa-shield-heart how-step-icon"></i>
          </div>
          <div class="how-step-title">4. Insured Vault Delivery</div>
          <div class="how-step-desc">Dispatched in tamper-proof security cases with digital blockchain provenance certificates and full transit insurance.</div>
          <span class="how-step-badge">Step 4</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AI Diamond Intelligence Section -->
<section id="ai-features">
  <div class="container">
    <div class="ai-grid">
      <!-- Visual Mock Dashboard -->
      <div class="ai-visual reveal-left">
        <div class="ai-dashboard-mock">
          <div class="ai-dash-header">
            <div class="ai-dash-title">
              <i class="fa-solid fa-robot"></i> RAPAPORT Live Carat Index
            </div>
            <div class="ai-dash-live">
              <div class="status-dot"></div>
              <span>Live Market Stream</span>
            </div>
          </div>

          <!-- Sparkline Chart SVG -->
          <div class="ai-chart-area">
            <svg class="chart-svg" viewBox="0 0 400 130" preserveAspectRatio="none">
              <defs>
                <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#d4b270" stop-opacity="0.4" />
                  <stop offset="100%" stop-color="#d4b270" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path d="M0,100 C30,85 60,65 100,55 C130,48 160,75 200,50 C240,25 270,18 310,30 C340,40 370,25 400,15" fill="none" stroke="#d4b270" stroke-width="2.5" stroke-linecap="round" />
              <path d="M0,100 C30,85 60,65 100,55 C130,48 160,75 200,50 C240,25 270,18 310,30 C340,40 370,25 400,15 L400,130 L0,130 Z" fill="url(#chartGrad)" />
              <circle cx="200" cy="50" r="5" fill="#d4b270" stroke="white" stroke-width="2" />
              <circle cx="310" cy="30" r="5" fill="#d4b270" stroke="white" stroke-width="2" />
              <circle cx="400" cy="15" r="5" fill="#e2ca94" stroke="white" stroke-width="2" />
            </svg>
          </div>

          <!-- Gemstone Ticker List -->
          <div class="ai-crop-list">
            <div class="crop-row">
              <span class="crop-emoji">💎</span>
              <span class="crop-name">Solitaire 1.5 Carat (VVS1, E)</span>
              <span class="crop-trend up"><i class="fa-solid fa-arrow-trend-up"></i>+6.4%</span>
              <span class="crop-price">₹12,40,000</span>
            </div>
            <div class="crop-row">
              <span class="crop-emoji">🔷</span>
              <span class="crop-name">Sapphire Royal Blue 2.0ct</span>
              <span class="crop-trend up"><i class="fa-solid fa-arrow-trend-up"></i>+4.2%</span>
              <span class="crop-price">₹8,50,000</span>
            </div>
            <div class="crop-row">
              <span class="crop-emoji">🟢</span>
              <span class="crop-name">Emerald Colombian 1.8ct</span>
              <span class="crop-trend down"><i class="fa-solid fa-arrow-trend-down"></i>-1.2%</span>
              <span class="crop-price">₹6,80,000</span>
            </div>
            <div class="crop-row">
              <span class="crop-emoji">✨</span>
              <span class="crop-name">Oval Diamond 2.2ct (IF, D)</span>
              <span class="crop-trend up"><i class="fa-solid fa-arrow-trend-up"></i>+8.1%</span>
              <span class="crop-price">₹22,10,000</span>
            </div>
          </div>
        </div>
      </div>

      <!-- AI Content Column -->
      <div class="ai-content reveal-right">
        <span class="section-badge badge-gold">AI Diamond Intelligence</span>
        <h2 class="section-title" style="text-align:left;margin:12px 0 14px;">Precision Gemological Analytics</h2>
        <p class="section-sub" style="text-align:left;max-width:100%;">Eliminating market opacity with machine-learning algorithms trained on over 500,000 GIA diamond auctions.</p>

        <div class="ai-features-list">
          <div class="ai-feat-item">
            <div class="ai-feat-icon">
              <i class="fa-solid fa-chart-pie"></i>
            </div>
            <div>
              <div class="ai-feat-title">AI Diamond Market Price Predictor</div>
              <div class="ai-feat-desc">Analyses market trends across international bourses to calculate fair carat pricing and future value trajectory.</div>
            </div>
          </div>

          <div class="ai-feat-item">
            <div class="ai-feat-icon">
              <i class="fa-solid fa-sliders"></i>
            </div>
            <div>
              <div class="ai-feat-title">Dynamic Custom Quote Estimator</div>
              <div class="ai-feat-desc">Instant live quotes based on real-time gold spot prices, platinum weight, and setting complexity.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Why Choose Us Grid -->
<section id="why">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge badge-terracotta">The SAT Standard</span>
      <h2 class="section-title">Why Choose SAT Jewel?</h2>
      <p class="section-sub">Built upon a century of gemstone heritage and modern ethical transparency.</p>
    </div>

    <div class="why-grid">
      <div class="why-card reveal" style="transition-delay:0.05s">
        <div class="why-icon-wrap">
          <i class="fa-solid fa-hand-holding-hand"></i>
        </div>
        <div class="why-title">100% Conflict Free</div>
        <div class="why-desc">Ethically sourced directly from Kimberley Process compliant mines with full digital origin tracking.</div>
        <div class="why-highlight">Kimberley Verified</div>
      </div>

      <div class="why-card reveal" style="transition-delay:0.1s">
        <div class="why-icon-wrap">
          <i class="fa-solid fa-award"></i>
        </div>
        <div class="why-title">GIA Triple Excellent</div>
        <div class="why-desc">Only top 1% of diamonds evaluated for Cut, Polish, and Symmetry are selected for our fine jewelry collections.</div>
        <div class="why-highlight">Top 1% Quality</div>
      </div>

      <div class="why-card reveal" style="transition-delay:0.15s">
        <div class="why-icon-wrap">
          <i class="fa-solid fa-infinity"></i>
        </div>
        <div class="why-title">Lifetime Warranty</div>
        <div class="why-desc">Complimentary annual claw tightening, ultrasonic polishing, and size adjustments for life.</div>
        <div class="why-highlight">Lifetime Care</div>
      </div>

      <div class="why-card reveal" style="transition-delay:0.2s">
        <div class="why-icon-wrap">
          <i class="fa-solid fa-coins"></i>
        </div>
        <div class="why-title">Direct Mine-To-Market</div>
        <div class="why-desc">Eliminating middleman markups to offer unmatched value for high-carat certified gemstones.</div>
        <div class="why-highlight">Unmatched Value</div>
      </div>

      <div class="why-card reveal" style="transition-delay:0.25s">
        <div class="why-icon-wrap">
          <i class="fa-solid fa-link"></i>
        </div>
        <div class="why-title">Blockchain Provenance</div>
        <div class="why-desc">Immutable digital passport securing your diamond's grading report, ownership transfer, and origin.</div>
        <div class="why-highlight">Digital Passport</div>
      </div>

      <div class="why-card reveal" style="transition-delay:0.3s">
        <div class="why-icon-wrap">
          <i class="fa-solid fa-building-columns"></i>
        </div>
        <div class="why-title">Private Showroom Access</div>
        <div class="why-desc">VIP appointments in our Geneva, London, Paris, and Mumbai private showrooms with expert gemologists.</div>
        <div class="why-highlight">VIP Showrooms</div>
      </div>
    </div>
  </div>
</section>

<!-- Craftsmanship Tech Stack Band -->
<section id="tech">
  <div class="container">
    <div class="tech-band reveal">
      <div>
        <div class="tech-intro-title">Enterprise Craft Specs</div>
        <div class="tech-intro-sub">Standards of perfection powering our 3D Studio & Diamond Exchange.</div>
      </div>
      <div class="tech-stack-grid">
        <div class="tech-pill"><span class="tech-pill-icon"><i class="fa-solid fa-certificate"></i></span> GIA & IGI Certified</div>
        <div class="tech-pill"><span class="tech-pill-icon"><i class="fa-solid fa-crown"></i></span> 18K Solid Gold & Platinum 950</div>
        <div class="tech-pill"><span class="tech-pill-icon"><i class="fa-solid fa-cube"></i></span> Real-time WebGL 3D Configurator</div>
        <div class="tech-pill"><span class="tech-pill-icon"><i class="fa-solid fa-shield"></i></span> Blockchain Digital Passport</div>
        <div class="tech-pill"><span class="tech-pill-icon"><i class="fa-solid fa-truck-fast"></i></span> Malca-Amit Armed Transit</div>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section id="cta">
  <div class="container">
    <div class="cta-box reveal">
      <h2 class="cta-title">Begin Your SAT Jewel Journey</h2>
      <p class="cta-sub">Schedule a private consultation with our Master Gemologists or explore our live 3D Studio.</p>
      <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
        <a href="#" class="btn-hero-primary" onclick="alert('Contact Request Received! Our concierge will connect with you immediately.')">
          <i class="fa-solid fa-envelope"></i> Contact Us Now
        </a>
        <a href="#" class="btn-ghost" onclick="alert('Redirecting to 3D Configurator Studio...')">
          <i class="fa-solid fa-cubes"></i> Open 3D Studio
        </a>
      </div>
    </div>
  </div>
</section>

<!-- COLLECTION LISTING MODAL -->
<div class="collection-modal" id="collectionModal">
  <div class="modal-content">
    <button class="modal-close-btn" onclick="closeCollectionModal()">&times;</button>
    <div class="modal-header">
      <h2 class="modal-category-title" id="modalTitle">Collection Listing</h2>
      <p id="modalSubtitle" style="color: var(--cream-surface);">Explore multiple options and GIA-certified designs.</p>

      <div class="modal-filters">
        <button class="filter-chip active">All Cuts</button>
        <button class="filter-chip">18K Gold</button>
        <button class="filter-chip">Platinum 950</button>
        <button class="filter-chip">Solitaires</button>
        <button class="filter-chip">GIA VVS1</button>
      </div>
    </div>

    <div class="product-grid" id="productGrid">
      <!-- Products dynamically injected via script.js -->
    </div>
  </div>
</div>

<!-- CHECKOUT MODAL -->
<div class="collection-modal" id="checkoutModal">
  <div class="modal-content" style="max-width: 650px;">
    <button class="modal-close-btn" onclick="closeCheckoutModal()">&times;</button>
    
    <div class="modal-header" style="margin-bottom: 16px;">
      <span class="section-badge badge-gold"><i class="fa-solid fa-lock"></i> Secure Gateway</span>
      <h2 class="modal-category-title" style="margin-top:8px;">Instant Checkout</h2>
    </div>

    <!-- Price Summary Card -->
    <div class="price-summary-box">
      <div style="display:flex; align-items:center; gap:12px;">
        <img id="checkoutItemImg" src="" style="width:50px;height:50px;border-radius:8px;object-fit:cover;" />
        <div>
          <div id="checkoutItemTitle" style="font-family:var(--font-serif);font-weight:700;color:#fff;"></div>
          <div style="font-size:12px;color:var(--taupe-beige);">GIA Certified & Fully Insured</div>
        </div>
      </div>
      <div style="text-align:right;">
        <div id="checkoutItemPriceINR" style="font-family:var(--font-serif);font-size:18px;font-weight:700;color:var(--champagne-gold);"></div>
        <div id="checkoutItemPriceUSD" style="font-size:12px;color:var(--terracotta-light);"></div>
      </div>
    </div>

    <!-- Payment Currency Tabs -->
    <div class="payment-tabs">
      <button class="pay-tab-btn active" id="tab-usd-btn" onclick="switchPaymentTab('usd')">
        <i class="fa-solid fa-earth-americas"></i> International Card / SWIFT
      </button>
      <button class="pay-tab-btn" id="tab-inr-btn" onclick="switchPaymentTab('inr')">
        <i class="fa-solid fa-indian-rupee-sign"></i> India Local UPI / NetBanking
      </button>
