@inject SAT1.BAL.CatalogBal CatalogBal
@inject SAT1.BAL.ReviewBal ReviewBal
@{
    ViewData["Title"] = "Fine Jewelry & AI Diamond Intelligence";
    var catCounts = ViewBag.CategoryCountsByNumericId as Dictionary<long, int> ?? new Dictionary<long, int>();
    var publicCategories = await CatalogBal.GetPublicCategoriesAsync();
    var googleReviews = await ReviewBal.GetStorefrontPhotoReviewsAsync();
}

<!-- Intro Animation Overlay -->
<div id="intro-overlay">
  <div class="intro-bg-glow"></div>
</div>

<!-- Centered Animated Shop Name (S-A-T Jewel) that lands beside logo in Navbar -->
<div id="intro-logo-container">
  <div class="sat-logo-text-wrap" style="display: flex; flex-direction: column; position: relative; overflow: hidden;">
    <div class="sat-intro-shimmer-bar"></div>
    <div class="sat-logo-brand" style="font-family: var(--font-serif, 'Playfair Display', serif); font-size: 26px; font-weight: 700; color: #ffffff; letter-spacing: 0.12em; line-height: 1; white-space: nowrap; display: flex; align-items: center;">
      <span class="sat-letter sat-letter-s">S</span>
      <span class="sat-letter sat-letter-a" style="margin-left: 2px;">A</span>
      <span class="sat-letter sat-letter-t" style="margin-left: 2px;">T</span>
      <span class="sat-brand-script sat-word-jewel" style="margin-left: 8px; font-size: 28px;">Jewel</span>
    </div>
    <div class="sat-logo-tagline" style="font-size: 9.5px; font-weight: 600; color: rgba(255, 255, 255, 0.75); letter-spacing: 0.22em; text-transform: uppercase; margin-top: 3px;">Fine Jewelry</div>
  </div>
</div>

<!-- FULL PAGE BACKGROUND IMAGE SLIDER -->
<div class="hero-slider-bg">
  <div class="hero-slider">
    <img class="active" src="~/assets/hero_slider_1_solitaire.jpg" alt="Midnight Silk Solitaire Diamond Ring" loading="eager" />
    <img src="~/assets/hero_slider_8_ring_pair.jpg" alt="Twin Diamond Pavé Eternity Rings on Silk" loading="lazy" />
    <img src="~/assets/hero_slider_2_highjewelry.jpg" alt="Haute Joaillerie Royal Diamond Choker" loading="lazy" />
    <img src="~/assets/hero_slider_9_emerald_drop.jpg" alt="Yellow Gold Floral & Emerald Drop High Jewelry Necklace" loading="lazy" />
    <img src="~/assets/hero_slider_3_gold_choker.jpg" alt="Antique Royal Gold Floral Choker" loading="lazy" />
    <img src="~/assets/hero_slider_4_emerald_set.jpg" alt="Royal Emerald Silk & Diamond Cascade Set" loading="lazy" />
    <img src="~/assets/hero_slider_5_bokeh_blossom.jpg" alt="Iridescent Blossom Cocktail Ring & Golden Bokeh" loading="lazy" />
    <img src="~/assets/hero_slider_6_red_carpet.jpg" alt="Red Carpet Bridal Diamond Suite" loading="lazy" />
    <img src="~/assets/hero_slider_7_maroon_floral.jpg" alt="Maroon Silk Diamond Earrings & Floral Gold" loading="lazy" />
  </div>
  <div class="hero-image-overlay"></div>
</div>

<!-- Animated Background Orbs -->
<div class="page-bg" aria-hidden="true">
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>
  <div class="bg-orb bg-orb-3"></div>
  <div class="bg-orb bg-orb-4"></div>
</div>

<!-- Navbar — Single Horizontal Line -->
<nav class="navbar" id="navbar">
  <div class="container nav-inner">
    <!-- Navbar Brand Wrap: Shop Logo Emblem + Shop Name -->
    <a href="/" class="sat-nav-brand-wrap">
      <img src="~/assets/sat_emblem_clean.png" asp-append-version="true" class="official-sat-logo-nav" alt="SAT Jewels Official Logo" />
      <div class="nav-logo-slot">
        <span style="font-family: var(--font-serif, 'Playfair Display', serif); font-size: 21px; font-weight: 700; color: #ffffff; letter-spacing: 0.03em; line-height: 1; white-space: nowrap; display: flex; align-items: center;">SAT <span class="sat-brand-script" style="margin-left: 4px; color: var(--champagne-gold, #d4b270);">Jewel</span></span>
        <span style="font-size: 8.5px; font-weight: 600; color: rgba(212, 178, 112, 0.85); letter-spacing: 0.22em; text-transform: uppercase; margin-top: 3px;">Fine Jewelry</span>
      </div>
    </a>

    <!-- Navigation Bar Links -->
    <div class="nav-links">
      <div class="nav-indicator"></div>
      <a href="#hero" class="nav-link active">
        <i class="fa-solid fa-house"></i>
        <span>Home</span>
      </a>
      <div class="sat-nav-dropdown-wrap" onmouseenter="openSatMegaDropdown()" onmouseleave="closeSatMegaDropdown()">
        <a href="#collections" class="nav-link" onclick="if(window.innerWidth <= 992) { openSatMobileDrawer(); return false; }">
          <i class="fa-solid fa-gem"></i>
          <span>Collections</span>
          <i class="fa-solid fa-chevron-down" style="font-size: 10px; margin-left: 4px; opacity: 0.8;"></i>
        </a>
      </div>

