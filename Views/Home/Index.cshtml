<script>
  function scrollCatSlider(offset) {
    const track = document.getElementById('mainCatTrack');
    if (track) {
      track.scrollBy({ left: offset, behavior: 'smooth' });
    }
  }
</script>

<script>
  function switchDiamondTab(tabType) {
    const labBtn = document.getElementById('tab-lab-grown');
    const moisBtn = document.getElementById('tab-moissanite');
    const labGrid = document.getElementById('grid-lab-grown');
    const moisGrid = document.getElementById('grid-moissanite');

    if (!labBtn || !moisBtn || !labGrid || !moisGrid) return;

    if (tabType === 'lab-grown') {
      labBtn.style.background = 'rgba(212, 178, 112, 0.18)';
      labBtn.style.color = '#fef08a';
      labBtn.style.border = '1.5px solid #d4b270';
      labBtn.style.boxShadow = '0 0 20px rgba(212, 178, 112, 0.35)';

      moisBtn.style.background = 'rgba(10, 20, 38, 0.5)';
      moisBtn.style.color = '#cbd5e1';
      moisBtn.style.border = '1px solid rgba(212, 178, 112, 0.3)';
      moisBtn.style.boxShadow = 'none';

      labGrid.style.display = 'grid';
      moisGrid.style.display = 'none';
    } else {
      moisBtn.style.background = 'rgba(212, 178, 112, 0.18)';
      moisBtn.style.color = '#fef08a';
      moisBtn.style.border = '1.5px solid #d4b270';
      moisBtn.style.boxShadow = '0 0 20px rgba(212, 178, 112, 0.35)';

      labBtn.style.background = 'rgba(10, 20, 38, 0.5)';
      labBtn.style.color = '#cbd5e1';
      labBtn.style.border = '1px solid rgba(212, 178, 112, 0.3)';
      labBtn.style.boxShadow = 'none';

      moisGrid.style.display = 'grid';
      labGrid.style.display = 'none';
    }
  }
  window.switchDiamondTab = switchDiamondTab;
</script>

