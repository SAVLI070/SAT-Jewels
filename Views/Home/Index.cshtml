        <div class="tech-pill"><span class="tech-pill-icon"><i class="fa-solid fa-shield"></i></span> Blockchain Digital Passport</div>
        <div class="tech-pill"><span class="tech-pill-icon"><i class="fa-solid fa-truck-fast"></i></span> Malca-Amit Armed Transit</div>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section id="cta">
  <div class="container">
    <div class="cta-box reveal">
      <h2 class="cta-title">Begin Your SAT Jewel Journey</h2>
      <p class="cta-sub">Schedule a private consultation with our Master Gemologists or explore our live 3D Studio.</p>
      <h2 class="cta-title">Acquire Your Masterpiece</h2>
      <p class="cta-sub">Consult with our master gemologists for bespoke designs, rare solitaire acquisitions, and portfolio curation.</p>
      <div class="cta-buttons">
        <a href="mailto:concierge@satjewels.com" class="btn-primary" style="padding:14px 32px;font-size:16px;">
          <i class="fa-solid fa-calendar-check"></i> Book Private Viewing
        </a>
        <a href="tel:+18005557285" class="btn-secondary" style="padding:14px 32px;font-size:16px;">
          <i class="fa-solid fa-phone"></i> +1 (800) 555-SATJ
        </a>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCTS / COLLECTION VIEW MODAL -->
<div class="collection-modal" id="collectionModal" onclick="handleModalBackdropClick(event, 'collectionModal')">
  <div class="modal-content">
    <button class="modal-close-btn" onclick="closeCollectionModal()" aria-label="Close">&times;</button>
    <div class="modal-header">
      <span class="section-badge badge-gold">Certified Collection</span>
      <h2 class="modal-category-title" id="modalTitle">Jewelry Collection</h2>
      <p class="modal-sub" id="modalSubtitle">Displaying GIA-certified designs in USD ($).</p>
    </div>
    <div class="product-grid" id="productGrid">
      <!-- Injected Dynamically by JavaScript in USD -->
    </div>
  </div>
</div>

<!-- CHECKOUT / INQUIRY PAYMENT MODAL (USD ($) Exclusively) -->
<div class="collection-modal" id="checkoutModal" onclick="handleModalBackdropClick(event, 'checkoutModal')">
  <div class="modal-content" style="max-width:540px;">
    <button class="modal-close-btn" onclick="closeCheckoutModal()" aria-label="Close">&times;</button>
    <div class="modal-header">
      <span class="section-badge badge-gold">Global USD Checkout</span>
      <h2 class="modal-category-title" style="margin-top:8px;">Instant Checkout</h2>
    </div>

    <!-- Price Summary Card -->
    <div class="price-summary-box">
      <div style="display:flex; align-items:center; gap:12px;">
        <img id="checkoutItemImg" src="" style="width:52px;height:52px;border-radius:10px;object-fit:cover;" />
        <div>
          <div id="checkoutItemTitle" style="font-family:var(--font-serif);font-weight:700;color:#fff;"></div>
          <div style="font-size:12px;color:var(--taupe-beige);">GIA Certified & Fully Insured</div>
        </div>
      </div>
      <div style="text-align:right;">
