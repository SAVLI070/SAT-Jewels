<section id="customer-reviews" class="sat-customer-reviews-section">
  <!-- Carousel Area with Left & Right Arrow Buttons -->
  <div class="sat-reviews-carousel-outer">
    <button type="button" class="sat-carousel-arrow sat-arrow-left" onclick="scrollSatReviews(-1)" aria-label="Previous Reviews">
      <i class="fa-solid fa-chevron-left"></i>
    </button>

    <div class="sat-reviews-viewport" id="satReviewsViewport">
      <div class="sat-reviews-track" id="satReviewsTrack">
        @if (googleReviews != null && googleReviews.Count > 0)
        {
          foreach (var rev in googleReviews)
          {
            var initial = !string.IsNullOrEmpty(rev.CustomerName) ? rev.CustomerName.Trim().Substring(0, 1).ToUpper() : "C";
            var bgCol = "#5b9e4d";
            if (initial == "H") bgCol = "#795548";
            else if (initial == "M") bgCol = "#78909c";
            else if (initial == "S") bgCol = "#1976d2";
            else if (initial == "J") bgCol = "#7b1fa2";
            else if (initial == "V") bgCol = "#d32f2f";
            else if (initial == "K") bgCol = "#f57c00";
            else if (initial == "G") bgCol = "#00897b";
            else if (initial == "A") bgCol = "#c2185b";

            <div class="sat-google-review-card">
              <!-- Top Row: Avatar + Name/Date + Google Logo -->
              <div class="sat-card-top-row">
                <div class="sat-card-user-meta">
                  <div class="sat-user-avatar-circle" style="background-color: @bgCol;">@initial</div>
                  <div class="sat-user-text">
                    <div class="sat-user-name">@rev.CustomerName</div>
                    <div class="sat-user-time">@(string.IsNullOrEmpty(rev.RelativeTime) ? "last year" : rev.RelativeTime)</div>
                  </div>
                </div>
                <!-- Official Multi-Color Google G Logo -->
                <div class="sat-google-g-badge">
                  <svg viewBox="0 0 24 24" width="22" height="22">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                  </svg>
                </div>
              </div>

              <!-- Rating Row: 5 Gold Stars + Blue Verified Check Badge -->
              <div class="sat-card-stars-row">
                <div class="sat-gold-stars">
                  @for (int s = 0; s < rev.Rating; s++)
                  {
                    <i class="fa-solid fa-star"></i>
                  }
                </div>
                <div class="sat-verified-check-badge" title="Google Verified Buyer">
                  <i class="fa-solid fa-circle-check"></i>
                </div>
              </div>

              <!-- Content Row: Review text on left, Photo thumbnail on right -->
              <div class="sat-card-content-row">
                <div class="sat-review-text-wrap">
                  <p class="sat-review-p">@rev.ReviewText</p>
                </div>
                @if (!string.IsNullOrEmpty(rev.PhotoUrl))
                {
                  <div class="sat-card-thumb-slot" onclick="openPhotoLightbox('@rev.PhotoUrl', '@rev.CustomerName')" title="Click to view full photo">
                    <img src="@rev.PhotoUrl" alt="@rev.CustomerName review photo" loading="lazy" />
                  </div>
                }
              </div>
            </div>
          }
        }
      </div>
    </div>

    <button type="button" class="sat-carousel-arrow sat-arrow-right" onclick="scrollSatReviews(1)" aria-label="Next Reviews">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>
</section>

