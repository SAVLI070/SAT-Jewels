        <i class="fa-solid fa-hammer"></i>
        <span>Craft Process</span>
      </a>
      <a href="#why" class="nav-link">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Why SAT Jewel</span>
      </a>
    </div>

    <div class="nav-actions">
      <!-- Dynamic Auth & Cart Nav Cluster (Search, User, Cart Icons) -->
      <partial name="_AuthNav" />

      <button class="hamburger desktop-hidden" onclick="openSatMobileDrawer()" aria-label="Menu">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Drawer Menu -->
