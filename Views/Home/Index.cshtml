<style>
/* ==========================================================================
   SAT JEWELS - BENTO CATEGORY GRID (INSPIRED BY IMAGE 1)
   ========================================================================== */
.sat-bento-grid {
  display: grid;
  grid-template-columns: 1.18fr 1fr 1fr;
  grid-template-rows: repeat(3, minmax(200px, 220px));
  gap: 18px;
  width: 100%;
}

.sat-bento-card {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  background: #090c13;
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 24px;
  transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), 
              border-color 0.4s ease, 
              box-shadow 0.4s ease;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.sat-bento-card:hover {
  transform: translateY(-4px);
  border-color: rgba(212, 178, 112, 0.45);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7), 0 0 25px rgba(212, 178, 112, 0.15);
}

/* 1. Main Left Rings Card - Spans 3 rows */
.sat-bento-card-main-ring {
  grid-column: 1;
  grid-row: 1 / span 3;
  justify-content: space-between;
  padding: 36px 32px;
  background: radial-gradient(circle at 80% 20%, rgba(212, 178, 112, 0.08) 0%, #07090f 70%);
}

.sat-bento-img-wrap {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  overflow: hidden;
}

.sat-bento-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.sat-bento-card:hover .sat-bento-img-wrap img {
  transform: scale(1.06);
}

/* Gradients for text contrast */
.sat-bento-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(6, 9, 15, 0.95) 0%, rgba(6, 9, 15, 0.55) 50%, rgba(6, 9, 15, 0.3) 100%);
  transition: opacity 0.3s ease;
}

.sat-bento-overlay-ring {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(6, 9, 15, 0.92) 0%, rgba(6, 9, 15, 0.75) 45%, rgba(6, 9, 15, 0.4) 100%);
}

.sat-bento-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.sat-bento-content-main {
  height: 100%;
  justify-content: space-between;
}

.sat-bento-badge {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2.2px;
  text-transform: uppercase;
  color: #a0aec0;
  margin-bottom: 14px;
}

.sat-bento-title-main {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 32px;
  font-weight: 500;
  line-height: 1.25;
  color: #ffffff;
  margin: 0 0 12px;
  letter-spacing: 0.3px;
}

.sat-bento-italic-gold {
  font-style: italic;
  font-family: var(--font-serif, 'Playfair Display', serif);
  color: var(--champagne-gold, #d4b270);
  font-weight: 400;
}

