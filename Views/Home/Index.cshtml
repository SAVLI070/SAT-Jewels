  background: rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 22px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: all 0.2s;
}
.sat-lightbox-close:hover {
  background: rgba(220, 38, 38, 0.8);
  border-color: #ef4444;
}

@@media (max-width: 768px) {
  .sat-reviews-carousel-outer {
    padding: 0 40px;
  }
  .sat-google-review-card {
    width: 310px;
    min-width: 310px;
    max-width: 310px;
    padding: 18px 20px;
  }
}
</style>

<script>
function scrollSatReviews(direction) {
  const container = document.getElementById('satReviewsViewport');
  if (!container) return;
  const scrollAmount = 400 * direction;
  container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
}

function openPhotoLightbox(photoUrl, customerName) {
  const modal = document.getElementById('satPhotoLightbox');
  const img = document.getElementById('satLightboxImg');
  const caption = document.getElementById('satLightboxCaption');
  if (!modal || !img) return;
  img.src = photoUrl;
  if (caption) caption.textContent = `Client Jewelry Creation — ${customerName}`;
  modal.style.display = 'flex';
}

function closePhotoLightbox(e) {
  if (e && e.target && e.target.closest('.sat-lightbox-inner') && !e.target.classList.contains('sat-lightbox-close')) {
    return;
  }
  const modal = document.getElementById('satPhotoLightbox');
  if (modal) modal.style.display = 'none';
}
</script>

<!-- PRODUCTS / COLLECTION VIEW MODAL -->
<div class="collection-modal" id="collectionModal" onclick="handleModalBackdropClick(event, 'collectionModal')">
