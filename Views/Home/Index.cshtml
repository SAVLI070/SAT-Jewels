@{
    ViewData["Title"] = "Fine Jewelry & AI Diamond Intelligence";
    var catCounts = ViewBag.CategoryCountsByNumericId as Dictionary<long, int> ?? new Dictionary<long, int>();
}

<!-- Intro Animation Overlay with Golden Pulse Halo -->
<div id="intro-overlay">
  <div class="intro-orbital-spinner"></div>
</div>

<!-- Centered Official Luxury Emblem Logo & Shop Name that animates to Top-Left Navbar on Load -->
<div id="intro-logo-container">
  <div class="sat-logo-emblem">
    <div class="emblem-shimmer-sweep"></div>
    <img src="~/assets/sat_emblem_clean.png" class="official-sat-logo-img" alt="SAT Jewel Official Logo" />
  </div>
  <div class="sat-logo-text-wrap">
    <div class="sat-logo-brand">SAT <span>Jewel</span></div>
    <div class="sat-logo-tagline">Fine Jewelry</div>
  </div>
</div>

<!-- FULL PAGE BACKGROUND IMAGE SLIDER -->
<div class="hero-slider-bg">
  <div class="hero-slider">
    <img class="active" src="~/assets/sat_jewels_shop_bg.jpg" alt="Sat Jewels Storefront & Diamond Showroom" loading="eager" />
    <img src="~/assets/hero_1.jpg" alt="Model wearing SAT Jewel diamond necklace and ring" loading="lazy" />
    <img src="~/assets/hero_2.jpg" alt="Macro shot of sparkling raw crystals and gold" loading="lazy" />
    <img src="~/assets/hero_3.jpg" alt="Macro raw diamonds and emerald crystals" loading="lazy" />
  </div>
  <div class="hero-image-overlay"></div>
</div>

<!-- Animated Background Orbs -->
<div class="page-bg" aria-hidden="true">
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>
  <div class="bg-orb bg-orb-3"></div>
  <div class="bg-orb bg-orb-4"></div>
</div>

<!-- Navbar — Single Horizontal Line -->
<nav class="navbar" id="navbar">
  <div class="container nav-inner">
    <!-- Target Slot where centered logo lands -->
    <div class="nav-logo-slot"></div>

    <!-- Navigation Bar Links -->
    <div class="nav-links">
      <div class="nav-indicator"></div>
      <a href="#hero" class="nav-link active">
        <i class="fa-solid fa-house"></i>
        <span>Home</span>
      </a>
      <a href="#collections" class="nav-link">
        <i class="fa-solid fa-gem"></i>
        <span>Collections</span>
      </a>
      <a href="#how-it-works" class="nav-link">
        <i class="fa-solid fa-hammer"></i>
        <span>Craft Process</span>
      </a>
      <a href="#ai-features" class="nav-link">
        <i class="fa-solid fa-chart-line"></i>
        <span>AI Valuer</span>
      </a>
      <a href="#why" class="nav-link">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Why SAT Jewel</span>
      </a>
    </div>

    <div class="nav-actions">
      <!-- Dynamic Auth & Cart Nav Cluster -->
      <partial name="_AuthNav" />

      @if (User.Identity?.IsAuthenticated != true)
      {
        <!-- Single Clean Contact Us Button (Guests only) -->
        <a href="#cta" class="btn-primary">
          <i class="fa-solid fa-envelope"></i> Contact Us
        </a>
      }

      <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Drawer Menu -->
<div class="mobile-menu" id="mobileMenu">
  <a href="#hero" class="mobile-link" onclick="toggleMenu()">
    <i class="fa-solid fa-house"></i> Home
  </a>
  <a href="#collections" class="mobile-link" onclick="toggleMenu()">
    <i class="fa-solid fa-gem"></i> Best Sellers
  </a>
  <a href="#process" class="mobile-link" onclick="toggleMenu()">
    <i class="fa-solid fa-wand-magic-sparkles"></i> Craft Process
  </a>
  <a href="#ai-features" class="mobile-link" onclick="toggleMenu()">
    <i class="fa-solid fa-chart-line"></i> AI Valuer
  </a>
  <a href="#why" class="mobile-link" onclick="toggleMenu()">
    <i class="fa-solid fa-shield-halved"></i> Why SAT Jewel
  </a>
  <div style="padding: 16px 24px; border-top: 1px solid var(--border-glass); margin-top: 10px; display:flex; flex-direction:column; gap:10px;">
    <a href="/Account/SignIn" class="btn-auth-nav" style="width: 100%; justify-content: center; text-align:center; box-sizing:border-box;">
      <i class="fa-regular fa-user"></i> Sign In / Sign Up
    </a>
    <a href="#cta" class="btn-primary" onclick="toggleMenu()" style="width: 100%; justify-content: center;">
      <i class="fa-solid fa-envelope"></i> Contact Us
    </a>
  </div>
</div>

<!-- Hero Section -->
<section id="hero">
  <div class="container hero-content-container">
    <div class="hero-eyebrow">
      <span class="section-badge badge-gold">
        <i class="fa-solid fa-certificate"></i>
        <span>GIA Certified Fine Jewelry</span>
      </span>
    </div>

    <h1 class="hero-h1">
      <span id="typewriter-line1" class="typewriter-line"></span><br />
      <span id="typewriter-line2" class="typewriter-line accent-gold"></span>
      <span class="typewriter-cursor">|</span>
    </h1>

    <p class="hero-sub">
      Redefining luxury jewelry with AI-driven diamond valuation, conflict-free GIA certified gems, and bespoke 3D studio craftsmanship.
    </p>

    <div class="hero-ctas">
      <a href="#collections" class="btn-hero-primary">
        <i class="fa-solid fa-gem"></i>
        <span>Explore SAT Collections</span>
      </a>
    </div>

    <div class="hero-trust">
      <div class="trust-avatars">
        <div class="trust-avatar trust-avatar-gold">SAT</div>
        <div class="trust-avatar trust-avatar-emerald">GIA</div>
        <div class="trust-avatar">IGI</div>
      </div>
      <div class="trust-text">
        Over <strong>12,000+</strong> Certified Diamonds Delivered
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <i class="fa-solid fa-shield-check"></i>
        <span>100% Conflict Free</span>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="scroll-indicator">
    <div class="mouse">
      <div class="wheel"></div>
    </div>
    <span class="scroll-text">SCROLL TO EXPLORE</span>
  </div>
</section>

<!-- Stats Band Section (Located properly Below Hero Section) -->
<section id="stats">
  <div class="container">
    <div class="stats-band reveal">
      <div class="stat-item">
        <div class="stat-num" data-target="15000" data-suffix="+">0</div>
        <div class="stat-label">Unique Bespoke Designs</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" data-target="99" data-suffix="%">0</div>
        <div class="stat-label">GIA Grade Accuracy</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" data-target="60" data-prefix="$" data-suffix="M+">0</div>
        <div class="stat-label">Diamond Portfolio Value</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" data-target="24" data-suffix="+">0</div>
        <div class="stat-label">Global Boutiques</div>
      </div>
    </div>
  </div>
</section>

<!-- MOST SELLING COLLECTIONS SHOWCASE (IVEVAR.COM STYLE DYNAMIC 12-CATEGORY GRID) -->
<section id="collections" style="padding: 60px 0; background: transparent; position: relative; z-index: 10;">
  <div class="container" style="position: relative; z-index: 20;">
    <!-- Top Toggle Switch (Transparent background container with luxury gold pill buttons matching Image 2) -->
    <div style="display: flex; justify-content: center; margin-bottom: 36px; position: relative; z-index: 100;">
      <div style="background: transparent; padding: 0; display: inline-flex; align-items: center; gap: 16px;">
        <button type="button" id="tab-lab-grown" onclick="switchDiamondTab('lab-grown')" style="padding: 12px 28px; background: rgba(212, 178, 112, 0.18); color: #fef08a; border: 1.5px solid #d4b270; font-weight: 700; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; border-radius: 9999px; outline: none; pointer-events: auto; font-family: var(--font-sans); box-shadow: 0 0 20px rgba(212, 178, 112, 0.35); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: all 0.3s ease;">
          <i class="fa-solid fa-gem" style="margin-right: 6px; color: #d4b270;"></i> LAB-GROWN DIAMOND
        </button>
        <button type="button" id="tab-moissanite" onclick="switchDiamondTab('moissanite')" style="padding: 12px 28px; background: rgba(10, 20, 38, 0.5); color: #cbd5e1; border: 1px solid rgba(212, 178, 112, 0.3); font-weight: 700; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; border-radius: 9999px; outline: none; pointer-events: auto; font-family: var(--font-sans); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: all 0.3s ease;">
          <i class="fa-solid fa-sparkles" style="margin-right: 6px; color: var(--taupe-beige);"></i> MOISSANITE
        </button>
      </div>
    </div>

    <!-- 1. LAB-GROWN DIAMOND GRID (Default Active) -->
    <div id="grid-lab-grown" style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px;" class="ivevar-grid-wrap">
      <!-- 1. Anniversary Ring (CategoryId = 2) -->
      <a href="/Product/Category?id=2" style="text-decoration:none; color:inherit;">
        <div style="background: rgba(10, 20, 38, 0.45); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border-radius: 12px; border: 1px solid rgba(212, 178, 112, 0.25); overflow: hidden; text-align: center; padding-bottom: 16px; transition: transform 0.3s ease, border-color 0.3s ease; box-shadow: 0 10px 30px rgba(0,0,0,0.4);" onmouseover="this.style.transform='translateY(-6px)'; this.style.borderColor='var(--champagne-gold)';" onmouseout="this.style.transform='none'; this.style.borderColor='rgba(212, 178, 112, 0.25)';">
          <div style="width:100%; padding-top:100%; position:relative; background:transparent;">
            <img src="/assets/ivevar/exclusive_regal_star_diamond_ring.jpg" alt="Anniversary Ring" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover;" />
          </div>
          <div class="cat-card-title">Anniversary Ring</div>
          <div class="cat-card-count">@(catCounts.GetValueOrDefault(2, 186)) items</div>
        </div>
      </a>

      <!-- 2. Antique Cut (CategoryId = 4) -->
      <a href="/Product/Category?id=4" style="text-decoration:none; color:inherit;">
        <div style="background: rgba(10, 20, 38, 0.45); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border-radius: 12px; border: 1px solid rgba(212, 178, 112, 0.25); overflow: hidden; text-align: center; padding-bottom: 16px; transition: transform 0.3s ease, border-color 0.3s ease; box-shadow: 0 10px 30px rgba(0,0,0,0.4);" onmouseover="this.style.transform='translateY(-6px)'; this.style.borderColor='var(--champagne-gold)';" onmouseout="this.style.transform='none'; this.style.borderColor='rgba(212, 178, 112, 0.25)';">
          <div style="width:100%; padding-top:100%; position:relative; background:transparent;">
            <img src="/assets/ivevar/ivevar-luxury-rings-925-silver-0-80-ct-sparkling-antique-shape-moissanite-silhouette-diamond-ring-vintage-fine-jewelry-44619076403505_c18db5d1-09b7-41c4-8fd4-f72a5a00aa4a.png" alt="Antique Cut" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover;" />
