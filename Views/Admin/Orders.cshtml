<script>
  function autoFillTrackingUrl() {
    const courier = (document.getElementById('trackingModalCourier').value || '').trim().toLowerCase();
    const awb = (document.getElementById('trackingModalAwb').value || '').trim();
    const urlInput = document.getElementById('trackingModalUrl');
    if (!awb) return;

    const cur = urlInput.value.trim().toLowerCase();
    const isAuto = !cur || cur.includes('dhl.com') || cur.includes('fedex.com') || cur.includes('indiapost.gov.in') || cur.includes('bluedart.com') || cur.includes('ups.com') || cur.includes('aramex.com') || cur.includes('dtdc.in');

    if (isAuto) {
      if (courier.includes('dhl')) {
        urlInput.value = `https://www.dhl.com/en/express/tracking.html?AWB=${encodeURIComponent(awb)}`;
      } else if (courier.includes('fedex')) {
        urlInput.value = `https://www.fedex.com/fedextrack/?trknbr=${encodeURIComponent(awb)}`;
      } else if (courier.includes('india post') || courier.includes('indiapost') || courier.includes('ems')) {
        urlInput.value = `https://www.indiapost.gov.in/_layouts/15/dpt.ptc.trackandtrace/trackandtrace.aspx?awb=${encodeURIComponent(awb)}`;
      } else if (courier.includes('blue dart') || courier.includes('bluedart')) {
        urlInput.value = `https://www.bluedart.com/tracking?track=${encodeURIComponent(awb)}`;
      } else if (courier.includes('ups')) {
        urlInput.value = `https://www.ups.com/track?tracknum=${encodeURIComponent(awb)}`;
      } else if (courier.includes('aramex')) {
        urlInput.value = `https://www.aramex.com/track/results?shipmentNumber=${encodeURIComponent(awb)}`;
      } else if (courier.includes('dtdc')) {
        urlInput.value = `https://www.dtdc.in/tracking/shipment-tracking.asp?awb=${encodeURIComponent(awb)}`;
      }
    }
  }

  function autoFillHubTrackingUrl() {
    const courier = (document.getElementById('hubCarrier').value || '').trim().toLowerCase();
    const awb = (document.getElementById('hubAwb').value || '').trim();
    const urlInput = document.getElementById('hubTrackingUrl');
    if (!awb) return;

    const cur = urlInput.value.trim().toLowerCase();
    const isAuto = !cur || cur.includes('dhl.com') || cur.includes('fedex.com') || cur.includes('indiapost.gov.in') || cur.includes('bluedart.com') || cur.includes('ups.com') || cur.includes('aramex.com') || cur.includes('dtdc.in');

    if (isAuto) {
      if (courier.includes('dhl')) {
        urlInput.value = `https://www.dhl.com/en/express/tracking.html?AWB=${encodeURIComponent(awb)}`;
      } else if (courier.includes('fedex')) {
        urlInput.value = `https://www.fedex.com/fedextrack/?trknbr=${encodeURIComponent(awb)}`;
      } else if (courier.includes('india post') || courier.includes('indiapost') || courier.includes('ems')) {
        urlInput.value = `https://www.indiapost.gov.in/_layouts/15/dpt.ptc.trackandtrace/trackandtrace.aspx?awb=${encodeURIComponent(awb)}`;
      } else if (courier.includes('blue dart') || courier.includes('bluedart')) {
        urlInput.value = `https://www.bluedart.com/tracking?track=${encodeURIComponent(awb)}`;
      } else if (courier.includes('ups')) {
        urlInput.value = `https://www.ups.com/track?tracknum=${encodeURIComponent(awb)}`;
      } else if (courier.includes('aramex')) {
        urlInput.value = `https://www.aramex.com/track/results?shipmentNumber=${encodeURIComponent(awb)}`;
      } else if (courier.includes('dtdc')) {
        urlInput.value = `https://www.dtdc.in/tracking/shipment-tracking.asp?awb=${encodeURIComponent(awb)}`;
      }
    }
  }

  function buildWhatsAppUrl(phone, orderNumber, customerName, courier, awb, url, hasCert, stage) {
    let cleanPhone = (phone || '').replace(/[^\d]/g, '');
    if (cleanPhone.length === 10) {
      cleanPhone = '1' + cleanPhone; // standard default country code if 10-digit
    }
    
    let courierName = courier || 'Courier';
    let greeting = `Hello ${customerName || 'Valued Customer'}! `;
    let stageMsg = '';

    switch (stage) {
      case 'OrderPlaced':
        stageMsg = `Your SAT Fine Jewelry order #${orderNumber} is confirmed and is currently being handcrafted in our workshop.`;
        break;
      case 'ShipmentBooked':
        stageMsg = `Your SAT Fine Jewelry order #${orderNumber} has been packaged, certified, and booked for dispatch via ${courierName}.`;
        break;
      case 'CustomsClearance':
        stageMsg = `Transit Update: Your SAT Fine Jewelry parcel for order #${orderNumber} has arrived at destination customs for clearance.`;
        break;
      case 'OutForDelivery':
        stageMsg = `Great news! Your SAT Fine Jewelry order #${orderNumber} is OUT FOR DELIVERY TODAY with your local ${courierName} courier. Please keep your phone available.`;
        break;
      case 'Delivered':
        stageMsg = `Your SAT Fine Jewelry order #${orderNumber} has been delivered! We hope you cherish your exquisite fine jewelry.`;
        break;
      case 'InTransit':
      default:
        stageMsg = `Your SAT Fine Jewelry order #${orderNumber} has been dispatched and is in transit via ${courierName}.`;
        break;
    }

    let msg = greeting + stageMsg;
    if (awb) {
      msg += ` Tracking Number: ${awb}.`;
    }
    if (url) {
      msg += ` Track your parcel live here: ${url}.`;
    }
    if (hasCert) {
      msg += ` Your official sealed physical GIA Gemological Certificate is enclosed inside your package.`;
    }
    msg += ` Thank you for choosing SAT Fine Jewelry!`;

    return `https://wa.me/${cleanPhone}?text=${encodeURIComponent(msg)}`;
  }

  function openTrackingModalFromBtn(btn) {
    const id = btn.dataset.id;
    const num = btn.dataset.number;
    const name = btn.dataset.name;
    const email = btn.dataset.email;
    const phone = btn.dataset.phone;
    const city = btn.dataset.city;
    const carrier = btn.dataset.carrier;
    const awb = btn.dataset.awb;
    const url = btn.dataset.url;
    const sent = btn.dataset.sent;
    const cert = btn.dataset.cert;
    const status = btn.dataset.status || 'InTransit';

    document.getElementById('trackingModalOrderId').value = id;
    document.getElementById('trackingModalOrderNumber').value = num;
    document.getElementById('trackingModalCustomerName').value = name;
    document.getElementById('trackingModalPhone').value = phone;

    const statusSelect = document.getElementById('trackingModalStatus');
    if (statusSelect) {
      if ([...statusSelect.options].some(o => o.value === status)) {
        statusSelect.value = status;
      } else {
        statusSelect.value = 'InTransit';
      }
    }

    // Show/hide GIA certificate packing reminder
    const certBox = document.getElementById('modalCertNotice');
    if (certBox) {
      certBox.style.display = (cert === 'true') ? 'flex' : 'none';
    }
    btn.dataset.hasCert = cert;

    document.getElementById('modalOrderTitle').innerText = `Order #${num} — Tracking`;
    document.getElementById('modalCustomerInfo').innerText = `${name || 'Customer'} • ${email || ''} • ${city || ''} ${phone ? '• ' + phone : ''}`;

    document.getElementById('trackingModalCourier').value = carrier || 'DHL Express';
    document.getElementById('trackingModalAwb').value = awb || '';
    document.getElementById('trackingModalUrl').value = url || '';

    const sentBox = document.getElementById('modalSentInfo');
    const sentText = document.getElementById('modalSentInfoText');
    if (sent) {
      sentBox.style.display = 'flex';
      sentText.innerText = `Tracking info was sent to customer via email on ${sent}.`;
    } else {
      sentBox.style.display = 'none';
    }

    const alertBox = document.getElementById('trackingModalAlert');
    alertBox.style.display = 'none';

    const btnSaveAndEmail = document.getElementById('btnSaveAndEmail');
    btnSaveAndEmail.disabled = false;
    btnSaveAndEmail.innerHTML = '<i class="fa-solid fa-paper-plane" style="color: #d4b270;"></i> Save &amp; Email Customer';

    const btnSaveOnly = document.getElementById('btnSaveOnly');
    btnSaveOnly.disabled = false;
    btnSaveOnly.innerHTML = 'Save Only';

    document.getElementById('trackingModal').style.display = 'flex';
  }

  function closeTrackingModal() {
    document.getElementById('trackingModal').style.display = 'none';
  }

  function testTrackingLink() {
    const url = document.getElementById('trackingModalUrl').value.trim();
    if (!url) {
      alert('Please enter a tracking URL first.');
      return;
    }
    window.open(url, '_blank');
  }

  function sendWhatsAppFromModal() {
    const phone = document.getElementById('trackingModalPhone').value;
    if (!phone || phone.replace(/[^\d]/g, '').length < 7) {
      alert('This order does not have a valid mobile phone number on file.');
      return;
    }

    const num = document.getElementById('trackingModalOrderNumber').value;
    const name = document.getElementById('trackingModalCustomerName').value;
    const courier = document.getElementById('trackingModalCourier').value.trim();
    const awb = document.getElementById('trackingModalAwb').value.trim();
    const url = document.getElementById('trackingModalUrl').value.trim();
    const stage = document.getElementById('trackingModalStatus') ? document.getElementById('trackingModalStatus').value : 'InTransit';
    const certBox = document.getElementById('modalCertNotice');
    const hasCert = certBox && certBox.style.display !== 'none';

    const waUrl = buildWhatsAppUrl(phone, num, name, courier, awb, url, hasCert, stage);
    window.open(waUrl, '_blank');
  }

  function sendWhatsAppFromBtn(btn) {
    const phone = btn.dataset.phone;
    if (!phone || phone.replace(/[^\d]/g, '').length < 7) {
      alert('This order does not have a valid mobile phone number on file.');
      return;
    }
    const num = btn.dataset.number;
    const name = btn.dataset.name;
    const courier = btn.dataset.carrier;
    const awb = btn.dataset.awb;
    const url = btn.dataset.url;
    const stage = btn.dataset.status || 'InTransit';
    const hasCert = btn.dataset.cert === 'true';

    const waUrl = buildWhatsAppUrl(phone, num, name, courier, awb, url, hasCert, stage);
    window.open(waUrl, '_blank');
  }

  async function saveTrackingDetails(sendEmail) {
    const orderId = document.getElementById('trackingModalOrderId').value;
    const trackingStatus = document.getElementById('trackingModalStatus').value;
    const courier = document.getElementById('trackingModalCourier').value.trim();
    const trackingNo = document.getElementById('trackingModalAwb').value.trim();
    const trackingUrl = document.getElementById('trackingModalUrl').value.trim();
    const alertBox = document.getElementById('trackingModalAlert');
    const btn = sendEmail ? document.getElementById('btnSaveAndEmail') : document.getElementById('btnSaveOnly');

    btn.disabled = true;
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
    alertBox.style.display = 'none';

    try {
      const res = await fetch('/admin/orders/save-tracking', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          orderId: orderId,
          courierName: courier,
          trackingNumber: trackingNo,
          trackingUrl: trackingUrl,
          trackingStatus: trackingStatus,
          sendEmail: sendEmail
        })
      });
      const data = await res.json();
      if (data.success) {
        alertBox.style.display = 'block';
        alertBox.style.background = '#dcfce7';
        alertBox.style.color = '#15803d';
        alertBox.innerText = data.message;
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      } else {
        alertBox.style.display = 'block';
        alertBox.style.background = '#fee2e2';
        alertBox.style.color = '#b91c1c';
        alertBox.innerText = data.message || 'Error saving tracking information.';
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    } catch (err) {
      alertBox.style.display = 'block';
      alertBox.style.background = '#fee2e2';
      alertBox.style.color = '#b91c1c';
      alertBox.innerText = 'Network error communicating with server.';
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  }

  // --- DEDICATED CUSTOMER CONTACT HUB LOGIC ---
  function openCustomerContactHub(btn) {
    const num = btn.dataset.number || '';
    const name = btn.dataset.name || 'Valued Customer';
    const email = btn.dataset.email || '';
    const phone = btn.dataset.phone || '';
    const carrier = btn.dataset.carrier || 'DHL Express';
    const awb = btn.dataset.awb || '';
    const url = btn.dataset.url || '';
    const cert = btn.dataset.cert;
    const status = btn.dataset.status || 'InTransit';

    document.getElementById('hubOrderNumber').value = num;
    document.getElementById('hubCustomerName').value = name;
    document.getElementById('hubEmail').value = email;
    document.getElementById('hubPhone').value = phone;
    document.getElementById('hubCarrier').value = carrier;
    document.getElementById('hubAwb').value = awb;
    document.getElementById('hubTrackingUrl').value = url;
    document.getElementById('hubHasCert').value = cert === 'true' ? 'true' : 'false';

    const hubStatus = document.getElementById('hubTrackingStatus');
    if (hubStatus) {
      if ([...hubStatus.options].some(o => o.value === status)) {
        hubStatus.value = status;
      } else {
        hubStatus.value = 'InTransit';
      }
    }

    document.getElementById('hubModalTitle').innerText = `Order #${num} — Contact Customer`;
    document.getElementById('hubCustomerSubtitle').innerText = `${name} • ${phone ? phone : 'No Phone'} • ${email ? email : 'No Email'}`;

    updateContactHubPreview();
    document.getElementById('contactHubModal').style.display = 'flex';
  }

  function closeContactHubModal(e) {
    document.getElementById('contactHubModal').style.display = 'none';
  }

  function getContactHubMessage() {
    const name = document.getElementById('hubCustomerName').value || 'Valued Customer';
    const num = document.getElementById('hubOrderNumber').value || '';
    const carrier = document.getElementById('hubCarrier').value.trim() || 'Courier';
    const awb = document.getElementById('hubAwb').value.trim();
    const url = document.getElementById('hubTrackingUrl').value.trim();
    const status = document.getElementById('hubTrackingStatus') ? document.getElementById('hubTrackingStatus').value : 'InTransit';
    const hasCert = document.getElementById('hubHasCert').value === 'true';

    let greeting = `Hello ${name}! Greetings from SAT Fine Jewelry.\n\n`;
    let stageMsg = '';

    switch(status) {
      case 'OrderPlaced':
        stageMsg = `Your bespoke jewelry order #${num} is confirmed and is currently being handcrafted by our master artisans in our workshop.`;
        break;
      case 'ShipmentBooked':
        stageMsg = `Your bespoke order #${num} has been packaged, certified, and booked for dispatch via ${carrier}.`;
        break;
      case 'CustomsClearance':
        stageMsg = `Status update on your order #${num}: Your luxury jewelry package has arrived in your destination country and is currently undergoing official customs clearance.`;
        break;
      case 'OutForDelivery':
        stageMsg = `Great news! Your SAT Fine Jewelry order #${num} is OUT FOR DELIVERY TODAY with your local ${carrier} delivery agent. Please keep your phone available.`;
        break;
      case 'Delivered':
        stageMsg = `Delivered! Your SAT Fine Jewelry parcel for order #${num} has been successfully delivered. We hope you cherish your exquisite fine jewelry piece!`;
        break;
      case 'InTransit':
      default:
        stageMsg = `Your bespoke order #${num} has departed and is securely en route to your shipping address via ${carrier}.`;
        break;
    }

    let msg = greeting + stageMsg;
    if (awb) {
      msg += `\nTracking ID: ${awb}`;
    }
    if (url) {
      msg += `\nTrack your delivery: ${url}`;
    }
    if (hasCert) {
      msg += `\nYour official sealed physical GIA Gemological Certificate is safely enclosed inside your parcel.`;
    }
    msg += `\n\nThank you for choosing SAT Jewel! Should you have any questions, our concierge team is always here to assist.`;
    return msg;
  }

  function updateContactHubPreview() {
    const preview = document.getElementById('hubMessagePreview');
    if (preview) {
      preview.innerText = getContactHubMessage();
    }
  }

  function sendContactHubWhatsApp() {
    const phone = document.getElementById('hubPhone').value.trim();
    if (!phone || phone.replace(/[^\d]/g, '').length < 7) {
      alert('Please enter a valid mobile number with country code for WhatsApp.');
      return;
    }
    let cleanPhone = phone.replace(/[^\d]/g, '');
    if (cleanPhone.length === 10) {
      cleanPhone = '1' + cleanPhone;
    }
    const msg = getContactHubMessage();
    const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(msg)}`;
    window.open(waUrl, '_blank');
  }

  function sendContactHubEmail() {
    const email = document.getElementById('hubEmail').value.trim();
    if (!email || !email.includes('@@')) {
      alert('Please enter a valid email address.');
      return;
    }
    const num = document.getElementById('hubOrderNumber').value || '';
    const status = document.getElementById('hubTrackingStatus') ? document.getElementById('hubTrackingStatus').value : 'InTransit';
    let subject = `Your SAT Jewel Order #${num} Status Update`;
    switch(status) {
      case 'OrderPlaced': subject = `💎 Order Confirmed: #${num} is in Production - SAT Jewel`; break;
      case 'ShipmentBooked': subject = `📦 Shipment Booked: #${num} Prepared for Dispatch - SAT Jewel`; break;
      case 'CustomsClearance': subject = `🛃 International Transit Update: #${num} - SAT Jewel`; break;
      case 'OutForDelivery': subject = `🚚 Out For Delivery Today: Order #${num} - SAT Jewel`; break;
      case 'Delivered': subject = `✨ Delivered: Order #${num} - SAT Fine Jewelry`; break;
      case 'InTransit':
      default:
        subject = `✈️ Dispatched & In Transit: Order #${num} - SAT Jewel`; break;
    }
    const msg = getContactHubMessage();
    const mailtoUrl = `mailto:${encodeURIComponent(email)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(msg)}`;
    window.location.href = mailtoUrl;
  }
</script>
