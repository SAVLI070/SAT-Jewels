@model SAT1.BAL.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var stats = Model ?? new SAT1.BAL.DashboardStatsDto();
}

<style>
  .dash-stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }

  @@media (max-width: 900px) {
    .dash-stat-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 12px !important;
      margin-bottom: 20px !important;
    }
  }

  @@media (max-width: 520px) {
    .dash-stat-grid {
      grid-template-columns: 1fr !important;
    }
  }

  .dash-stat-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    gap: 16px;
    color: #0f172a;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .dash-stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .dash-stat-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(180, 83, 9, 0.08);
    border: 1px solid rgba(180, 83, 9, 0.2);
    color: #b45309;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dash-stat-val {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 800;
    color: #b45309;
    line-height: 1;
    margin-bottom: 4px;
  }

  .dash-stat-lbl {
    font-size: 13px;
    color: #64748b;
    font-weight: 600;
  }

  .dash-action-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @@media (max-width: 900px) {
    .dash-action-grid {
      grid-template-columns: 1fr !important;
      gap: 16px !important;
    }
  }

  .dash-action-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    text-decoration: none;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    color: #0f172a;
  }

  .dash-action-card:hover {
    transform: translateY(-4px);
    border-color: #b45309;
    box-shadow: 0 12px 35px rgba(180, 83, 9, 0.15);
  }

  .dash-action-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 700;
    color: #0f172a;
    margin: 12px 0 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dash-action-desc {
    font-size: 13px;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
  }
</style>

<div style="max-width: 1240px; margin: 0 auto;">
  
  <!-- Welcome Banner -->
  <div style="background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%); border: 1px solid #e2e8f0; border-radius: 20px; padding: 32px; margin-bottom: 32px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
    <div>
      <h2 style="font-family: var(--font-serif); font-size: 26px; font-weight: 800; color: #0f172a; margin: 0 0 6px;">
        Welcome to SAT Jewel Admin Portal
      </h2>
      <p style="font-size: 14px; color: #64748b; margin: 0; max-width: 600px;">
        Manage your fine jewelry collections, main categories, product variants, and dynamic diamond carat pricing with real-time AWS RDS PostgreSQL synchronization.
      </p>
    </div>
    <a href="/Admin/AddProduct" style="padding: 12px 24px; background: linear-gradient(135deg, #d4b270 0%, #b45309 100%); border-radius: 12px; color: #ffffff; text-decoration: none; font-weight: 700; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 16px rgba(180, 83, 9, 0.25);">
      <i class="fa-solid fa-plus-circle"></i> Publish New Product
    </a>
  </div>

  <!-- Real-time Stats Grid -->
  <div class="dash-stat-grid">
    <div class="dash-stat-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-gem"></i></div>
      <div>
        <div class="dash-stat-val">@stats.TotalProducts.ToString("N0")</div>
        <div class="dash-stat-lbl">Total Fine Jewelry Products</div>
      </div>
    </div>

    <div class="dash-stat-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-layer-group"></i></div>
      <div>
        <div class="dash-stat-val">@stats.TotalCategories</div>
        <div class="dash-stat-lbl">Main Collection Categories</div>
      </div>
    </div>

    <div class="dash-stat-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-ring"></i></div>
      <div>
        <div class="dash-stat-val">@stats.TotalMetals</div>
        <div class="dash-stat-lbl">Supported Metal Types</div>
      </div>
    </div>

    <div class="dash-stat-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-database"></i></div>
      <div>
        <div class="dash-stat-val" style="color: #16a34a;">Active</div>
        <div class="dash-stat-lbl">AWS RDS PostgreSQL Sync</div>
      </div>
    </div>
  </div>

  <!-- Quick Action Navigation Cards -->
  <h3 style="font-family: var(--font-serif); font-size: 20px; font-weight: 700; color: #0f172a; margin-bottom: 16px;">
    Quick Administration Actions
  </h3>

  <div class="dash-action-grid">
    <a href="/Admin/Categories" class="dash-action-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-layer-group"></i></div>
      <div class="dash-action-title">
        Manage Categories <i class="fa-solid fa-arrow-right" style="font-size: 14px; color: #b45309;"></i>
      </div>
      <p class="dash-action-desc">
        Organize root collections, sub-categories, diamond shapes, and supported metal/carat filters.
      </p>
    </a>

    <a href="/Admin/Catalog" class="dash-action-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-gem"></i></div>
      <div class="dash-action-title">
        Jewelry Catalog <i class="fa-solid fa-arrow-right" style="font-size: 14px; color: #b45309;"></i>
      </div>
      <p class="dash-action-desc">
        View, search, filter, and remove catalog items across all 6 main collections in real-time.
      </p>
    </a>

    <a href="/Admin/AddProduct" class="dash-action-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
      <div class="dash-action-title">
        Publish New Item <i class="fa-solid fa-arrow-right" style="font-size: 14px; color: #b45309;"></i>
      </div>
      <p class="dash-action-desc">
        4-Step Guided Wizard with Photo Studio, Metal × Carat Availability Matrix, and Live Storefront Preview.
      </p>
    </a>
  </div>

</div>
