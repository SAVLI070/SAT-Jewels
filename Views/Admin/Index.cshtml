@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
  .dash-stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }

  @@media (max-width: 900px) {
    .dash-stat-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 12px !important;
      margin-bottom: 20px !important;
    }
  }

  @@media (max-width: 520px) {
    .dash-stat-grid {
      grid-template-columns: 1fr !important;
    }
  }

  .dash-stat-card {
    background: rgba(8, 17, 34, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(212, 178, 112, 0.3);
    border-radius: var(--radius-xl);
    padding: 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    gap: 16px;
    color: #ffffff;
  }

  .dash-stat-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(212, 178, 112, 0.15);
    border: 1px solid var(--border-gold);
    color: var(--champagne-gold);
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dash-stat-val {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 700;
    color: var(--champagne-gold);
    line-height: 1;
    margin-bottom: 4px;
  }

  .dash-stat-lbl {
    font-size: 13px;
    color: var(--taupe-beige);
    font-weight: 600;
  }

  .dash-action-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @@media (max-width: 900px) {
    .dash-action-grid {
      grid-template-columns: 1fr !important;
      gap: 16px !important;
    }
  }

  .dash-action-card {
    background: rgba(8, 17, 34, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(212, 178, 112, 0.3);
    border-radius: var(--radius-xl);
    padding: 28px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    color: #ffffff;
  }

  .dash-action-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 25px rgba(212, 178, 112, 0.3);
    border-color: var(--champagne-gold);
  }

  .dash-action-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(212, 178, 112, 0.15);
    border: 1px solid var(--border-gold);
    color: var(--champagne-gold);
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .dash-action-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 8px;
  }

  .dash-action-desc {
    font-size: 13px;
    color: var(--taupe-beige);
    margin: 0 0 20px;
    line-height: 1.5;
    flex-grow: 1;
  }

  .dash-action-btn {
    font-size: 13px;
    font-weight: 700;
    color: var(--champagne-gold);
    display: flex;
    align-items: center;
    gap: 6px;
  }
</style>

<div style="max-width:1160px;margin:0 auto;">
  <div style="margin-bottom:28px;">
    <h1 style="font-family:var(--font-serif);color:#ffffff;margin:0 0 6px;font-size:28px;">Admin Dashboard Overview</h1>
    <p style="color:var(--taupe-beige);font-size:14px;margin:0;">Welcome to the SAT Jewel Bespoke Storefront Administration Portal.</p>
  </div>

  <!-- Stat Cards Grid -->
  <div class="dash-stat-grid">
    <div class="dash-stat-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-layer-group"></i></div>
      <div>
        <div class="dash-stat-val" id="statCategoryCount">4</div>
        <div class="dash-stat-lbl">Storefront Categories</div>
      </div>
    </div>

    <div class="dash-stat-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-gem"></i></div>
      <div>
        <div class="dash-stat-val" id="statItemCount">5</div>
        <div class="dash-stat-lbl">Catalog Products</div>
      </div>
    </div>

    <div class="dash-stat-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-eye"></i></div>
      <div>
        <div class="dash-stat-val" id="statActiveCount">4</div>
        <div class="dash-stat-lbl">Visible Categories</div>
      </div>
    </div>

    <div class="dash-stat-card">
      <div class="dash-stat-icon"><i class="fa-solid fa-dollar-sign"></i></div>
      <div>
        <div class="dash-stat-val">USD ($)</div>
        <div class="dash-stat-lbl">Live Store Currency</div>
      </div>
    </div>
  </div>

  <!-- Quick Action Navigation Grid -->
  <div class="dash-action-grid">
    <a href="/Admin/Categories" class="dash-action-card">
      <div class="dash-action-icon"><i class="fa-solid fa-layer-group"></i></div>
      <h3 class="dash-action-title">Manage Categories</h3>
      <p class="dash-action-desc">Add new collection categories, toggle storefront landing page visibility, or adjust display order.</p>
      <div class="dash-action-btn">Open Categories <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <a href="/Admin/Catalog" class="dash-action-card">
      <div class="dash-action-icon"><i class="fa-solid fa-gem"></i></div>
      <h3 class="dash-action-title">Jewelry Catalog</h3>
      <p class="dash-action-desc">View products grouped section-wise by category. Manage prices, specs, and add items per section.</p>
      <div class="dash-action-btn">View Catalog Sections <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <a href="/Admin/AddProduct" class="dash-action-card">
      <div class="dash-action-icon"><i class="fa-solid fa-circle-plus"></i></div>
      <h3 class="dash-action-title">Publish New Item</h3>
      <p class="dash-action-desc">Publish a new bespoke jewelry item directly to the live store and Neon PostgreSQL database.</p>
      <div class="dash-action-btn">Publish Item Now <i class="fa-solid fa-arrow-right"></i></div>
    </a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const [catRes, itemRes] = await Promise.all([
        fetch('/api/catalogapi/admin-categories'),
        fetch('/api/catalogapi/items')
      ]);

      const categories = await catRes.json();
      const items = await itemRes.json();

      if (categories && Array.isArray(categories)) {
        document.getElementById('statCategoryCount').textContent = categories.length;
        document.getElementById('statActiveCount').textContent = categories.filter(c => c.isActive).length;
      }

      if (items && Array.isArray(items)) {
        document.getElementById('statItemCount').textContent = items.length;
      }
    } catch (err) {
      console.error('Error loading dashboard stats:', err);
    }
  });
</script>
