@{
    ViewData["Title"] = "Jewelry Catalog Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
  /* Collapsible Accordion & Square Card Grid Styling */
  .cat-section-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    margin-bottom: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    color: #0f172a;
    overflow: hidden;
  }

  .cat-accordion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 22px;
    background: #ffffff;
    cursor: pointer;
    user-select: none;
    transition: background 0.2s ease;
    border-bottom: 1px solid transparent;
    gap: 12px;
  }

  .cat-accordion-header:hover {
    background: #f8fafc;
  }

  .cat-accordion-header.active {
    border-bottom-color: #e2e8f0;
    background: #f8fafc;
  }

  .cat-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
  }

  .cat-arrow-icon {
    color: #64748b;
    font-size: 13px;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .cat-title-block {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cat-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cat-icon-accent {
    color: #b45309;
    font-size: 16px;
    flex-shrink: 0;
  }

  .cat-name-text {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
  }

  .cat-meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .cat-badge-tag {
    font-size: 11px;
    font-weight: 700;
    background: rgba(180, 83, 9, 0.08);
    color: #b45309;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(180, 83, 9, 0.2);
  }

  .cat-count-tag {
    font-size: 11px;
    font-weight: 700;
    background: #f1f5f9;
    color: #475569;
    padding: 2px 8px;
    border-radius: 12px;
  }

  .cat-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .cat-filter-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 16px 20px;
    border-radius: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .cat-filter-select {
    padding: 10px 16px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 600;
    outline: none;
  }

  .btn-sync-category {
    padding: 7px 14px;
    background: #f0fdf4;
    border: 1px solid #86efac;
    color: #16a34a;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-sync-category:hover {
    background: #16a34a;
    color: #ffffff;
  }

  .btn-add-section-item {
    padding: 8px 16px;
    background: rgba(180, 83, 9, 0.08);
    border: 1px solid #b45309;
    border-radius: 20px;
    color: #b45309;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .btn-add-section-item:hover {
    background: #b45309;
    color: #ffffff;
  }

  .cat-accordion-body {
    padding: 20px;
    background: #fafafa;
  }

  /* Square Box Product Grid Design */
  .product-square-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .product-square-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    position: relative;
  }

  .product-square-card:hover {
    border-color: #b45309;
    box-shadow: 0 8px 24px rgba(180, 83, 9, 0.12);
    transform: translateY(-3px);
  }

  .product-square-img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow: hidden;
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    margin-bottom: 10px;
  }

  .product-square-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-square-card:hover .product-square-img {
    transform: scale(1.04);
  }

  .product-square-title {
    color: #0f172a;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 34px;
  }

  .product-square-spec {
    font-size: 11.5px;
    color: #64748b;
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-square-price {
    font-size: 14.5px;
    font-weight: 800;
    color: #b45309;
  }

  .product-square-card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: 10px;
  }

  .btn-card-edit {
    padding: 7px 10px;
    background: #f0fdf4;
    border: 1px solid #86efac;
    color: #16a34a;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .btn-card-edit:hover {
    background: #16a34a;
    color: #ffffff;
  }

  .btn-card-delete {
    padding: 7px 10px;
    background: #fef2f2;
    border: 1px solid #fca5a5;
    color: #dc2626;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .btn-card-delete:hover {
    background: #dc2626;
    color: #ffffff;
  }

  /* RESPONSIVE MOBILE OPTIMIZATION (< 768px) */
  @@media (max-width: 768px) {
    .cat-accordion-header {
      padding: 12px 14px;
      gap: 8px;
    }

    .cat-header-left {
      gap: 8px;
    }

    .cat-name-text {
      font-size: 14.5px;
    }

    .cat-badge-tag, .cat-count-tag {
      font-size: 10px;
      padding: 1px 6px;
    }

    .btn-sync-category {
      padding: 5px 9px;
      font-size: 11px;
      gap: 4px;
    }

    .btn-add-section-item {
      padding: 5px 9px;
      font-size: 11px;
      gap: 4px;
    }

    .cat-accordion-body {
      padding: 10px !important;
    }

    /* 2-Column Mobile Product Grid */
    .product-square-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 10px !important;
    }

    .product-square-card {
      padding: 8px !important;
      border-radius: 12px !important;
    }

    .product-square-img-wrap {
      border-radius: 8px !important;
      margin-bottom: 6px !important;
    }

    .product-square-title {
      font-size: 11.5px !important;
      line-height: 1.25 !important;
      min-height: 29px !important;
      margin-bottom: 2px !important;
    }

    .product-square-spec {
      display: none !important;
    }

    .product-square-price {
      font-size: 12.5px !important;
    }

    .status-pill-badge {
      font-size: 9px !important;
      padding: 1px 4px !important;
    }

    .product-square-card-actions {
      gap: 4px !important;
      margin-top: 6px !important;
    }

    .btn-card-edit, .btn-card-delete {
      padding: 5px 4px !important;
      font-size: 10.5px !important;
      border-radius: 6px !important;
      gap: 3px !important;
    }
  }
</style>
</style>

<div style="max-width: 1240px; margin: 0 auto;">
  
  <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; flex-wrap:wrap; gap:16px;">
    <div>
      <h2 style="font-family:var(--font-serif); font-size:24px; font-weight:800; color:#0f172a; margin:0 0 4px;">
        Jewelry Catalog Management
      </h2>
      <p style="font-size:13px; color:#64748b; margin:0;">
        Manage, filter, sync, and review catalog items grouped by category in clean square box grids.
      </p>
    </div>
    <a href="/Admin/AddProduct" style="padding:12px 24px; background:linear-gradient(135deg, #d4b270 0%, #b45309 100%); border-radius:12px; color:#ffffff; text-decoration:none; font-weight:700; font-size:14px; display:inline-flex; align-items:center; gap:8px; box-shadow:0 4px 16px rgba(180, 83, 9, 0.25);">
      <i class="fa-solid fa-plus"></i> + Add New Jewelry Item
    </a>
  </div>

  <!-- Filter & Search Bar -->
  <div class="cat-filter-bar">
    <div style="display:flex; align-items:center; gap:8px;">
      <i class="fa-solid fa-filter" style="color:#b45309;"></i>
      <span style="font-size:13px; font-weight:700; color:#0f172a;">Filter Catalog:</span>
    </div>

    <select id="filterCategory" class="cat-filter-select" onchange="filterCatalogTable()">
      <option value="all" selected>All Main Categories</option>
      <option value="1">1. Engagement Rings</option>
      <option value="2">2. Wedding Rings</option>
      <option value="3">3. Men's Wedding Bands</option>
      <option value="4">4. Earrings</option>
      <option value="5">5. Bracelets</option>
      <option value="6">6. Necklaces</option>
    </select>

    <div style="flex:1; min-width:240px; position:relative;">
      <input type="text" id="searchCatalog" placeholder="Search product name..." oninput="filterCatalogTable()" style="width:100%; box-sizing:border-box; padding:10px 16px; background:#f8fafc; border:1px solid #cbd5e1; border-radius:10px; color:#0f172a; font-size:13px; outline:none;" />
    </div>
  </div>

  <!-- Container where all collapsible category accordions render -->
  <div id="catalogSectionsContainer">
    <div style="background:#ffffff; border:1px solid #e2e8f0; padding:40px; border-radius:16px; text-align:center; color:#64748b; box-shadow:0 4px 20px rgba(0,0,0,0.04);">
      <i class="fa-solid fa-spinner fa-spin" style="font-size:28px; color:#b45309; margin-bottom:12px; display:block;"></i>
      <div style="font-weight:700; font-size:15px; color:#0f172a;">Loading Jewelry Catalog from Neon DB...</div>
    </div>
  </div>

</div>

<script>
  let allCatalogItems = [];
  let allCategories = [];
  const loadedCategoryItems = {};

  function fixImgUrl(path) {
    if (!path) return '/assets/ivevar/exclusive_regal_star_diamond_ring.jpg';
    if (path.startsWith('http://') || path.startsWith('https://')) return path;
    if (path.startsWith('~/')) return '/' + path.substring(2);
    if (!path.startsWith('/')) return '/' + path;
    return path;
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadGroupedCatalog();
  });

  async function loadGroupedCatalog() {
    const container = document.getElementById('catalogSectionsContainer');
    if (!container) return;

    try {
      // Step 1: Instant load categories & real counts (<100ms)
      const catRes = await fetch('/api/catalogapi/admin-categories');
      allCategories = await catRes.json();

      renderInitialCategoryHeaders(allCategories);

      // Step 2: Background prefetch items for instant search filtering
      fetch('/api/catalogapi/items')
        .then(res => res.json())
        .then(items => {
          allCatalogItems = items;
          // Cache by category & update live count badges
          allCategories.forEach(cat => {
            const cKey = cat.id.toString().toLowerCase();
            const catSlug = (cat.slug || '').toLowerCase();
            const catName = (cat.name || '').toLowerCase();
            const matched = items.filter(it => {
              const itCat = (it.categoryId || '').toLowerCase();
              return itCat === cKey || itCat === catSlug || itCat === catName;
            });
            loadedCategoryItems[cKey] = matched;
            const countTag = document.getElementById(`cat-count-${cat.id}`);
            if (countTag && matched.length > 0) {
              countTag.textContent = `${matched.length} items`;
            }
          });
        })
        .catch(e => console.warn('Background items prefetch error:', e));

    } catch (err) {
      console.error('Error loading grouped catalog:', err);
      container.innerHTML = '<div style="background:#ffffff;padding:32px;border-radius:16px;text-align:center;color:#ef4444;border:1px solid #e2e8f0;">Failed to load catalog data from Neon DB database.</div>';
    }
  }

  function renderInitialCategoryHeaders(categories) {
    const container = document.getElementById('catalogSectionsContainer');
    if (!container) return;

    if (!categories || categories.length === 0) {
      container.innerHTML = '<div style="background:#ffffff;padding:32px;border-radius:16px;text-align:center;color:#64748b;border:1px solid #e2e8f0;">No categories found in database.</div>';
      return;
    }

    const iconMap = {
      1: 'fa-gem', 2: 'fa-ring', 3: 'fa-user-tie',
      4: 'fa-sparkles', 5: 'fa-link', 6: 'fa-crown'
    };

    container.innerHTML = categories.map(cat => {
      const icon = iconMap[cat.id] || 'fa-gem';
      const count = cat.itemCount || 0;

      return `
        <div class="cat-section-card" id="cat-card-${cat.id}">
          <div class="cat-accordion-header" id="cat-header-${cat.id}" onclick="toggleCategoryAccordion('${cat.id}')">
            <div class="cat-header-left">
              <i class="fa-solid fa-chevron-right cat-arrow-icon" id="cat-arrow-${cat.id}"></i>
              <div class="cat-title-block">
                <div class="cat-title-row">
                  <i class="fa-solid ${icon} cat-icon-accent"></i>
                  <span class="cat-name-text">${cat.name}</span>
                </div>
                <div class="cat-meta-row">
                  <span class="cat-badge-tag">${cat.badge || 'Popular'}</span>
                  <span class="cat-count-tag" id="cat-count-${cat.id}">${count} items</span>
                </div>
              </div>
            </div>

            <div class="cat-header-actions" onclick="event.stopPropagation();">
              <button type="button" class="btn-sync-category" onclick="syncCategoryDone('${cat.id}', '${cat.name}', event)">
                <i class="fa-solid fa-rotate-right"></i> <span>Sync</span>
              </button>
              <a href="/Admin/AddProduct?categoryId=${cat.id}" class="btn-add-section-item">
                <i class="fa-solid fa-plus"></i> <span>Add</span>
              </a>
            </div>
          </div>

          <!-- COLLAPSED BY DEFAULT -->
          <div class="cat-accordion-body" id="cat-body-${cat.id}" style="display: none;">
            <div id="cat-grid-${cat.id}" style="padding:20px; text-align:center; color:#64748b;">
              <i class="fa-solid fa-spinner fa-spin" style="color:#b45309;"></i> Loading ${cat.name} collection...
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function renderCategoryItemsGrid(catId, catItems) {
    const countTag = document.getElementById(`cat-count-${catId}`);
    if (countTag && catItems) {
      countTag.textContent = `${catItems.length} items`;
    }

    const gridContainer = document.getElementById(`cat-grid-${catId}`);
    if (!gridContainer) return;

    if (!catItems || catItems.length === 0) {
      gridContainer.innerHTML = `
        <div style="padding:24px;text-align:center;color:#64748b;font-size:13px;background:#ffffff;border-radius:12px;border:1px solid #e2e8f0;">
          No jewelry items in this section. Click <strong style="color:#b45309;">+ Add</strong> to list one.
        </div>
      `;
      return;
    }

    gridContainer.innerHTML = `
      <div class="product-square-grid">
        ${catItems.map(item => `
          <div class="product-square-card">
            <div class="product-square-img-wrap">
              <img src="${fixImgUrl(item.imageUrl)}" class="product-square-img" onerror="this.src='/assets/ivevar/exclusive_regal_star_diamond_ring.jpg'" alt="${item.name}" loading="lazy" />
            </div>
            
            <h4 class="product-square-title" title="${item.name}">${item.name}</h4>
            <div class="product-square-spec">${item.spec || ''}</div>
            
            <div style="display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:6px;border-top:1px solid #f1f5f9;">
              <span class="product-square-price">$${Number(item.priceUSD || item.price || 0).toLocaleString()}</span>
              <span class="status-pill-badge" style="font-weight:700;padding:2px 6px;border-radius:8px;background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;">Active</span>
            </div>

            <div class="product-square-card-actions">
              <a href="/Admin/AddProduct?editId=${item.id}" class="btn-card-edit" onclick="event.stopPropagation();">
                <i class="fa-solid fa-pen-to-square"></i> Edit
              </a>
              <button type="button" class="btn-card-delete" onclick="deleteCatalogItem('${item.id}', '${(item.name || '').replace(/'/g, "\\'")}', event)">
                <i class="fa-solid fa-trash"></i> Delete
              </button>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  }

  async function toggleCategoryAccordion(catId) {
    const body = document.getElementById(`cat-body-${catId}`);
    const header = document.getElementById(`cat-header-${catId}`);
    const arrow = document.getElementById(`cat-arrow-${catId}`);

    if (!body) return;

    if (body.style.display === 'none' || !body.style.display) {
      body.style.display = 'block';
      header.classList.add('active');
      arrow.style.transform = 'rotate(90deg)';

      // Fetch or render items on demand
      const cKey = catId.toString().toLowerCase();
      if (loadedCategoryItems[cKey]) {
        renderCategoryItemsGrid(catId, loadedCategoryItems[cKey]);
      } else {
        try {
          const res = await fetch(`/api/catalogapi/category-items/${catId}`);
          const items = await res.json();
          loadedCategoryItems[cKey] = items;
          renderCategoryItemsGrid(catId, items);
        } catch (e) {
          console.error(e);
        }
      }
    } else {
      body.style.display = 'none';
      header.classList.remove('active');
      arrow.style.transform = 'rotate(0deg)';
    }
  }

  function syncCategoryDone(id, name, event) {
    if (event) event.stopPropagation();
    if (typeof showToast === 'function') {
      showToast(`Category "${name}" is fully synchronized with Neon DB database!`, 'success', 'Sync Completed ✓');
    }
  }

  function filterCatalogTable() {
    const selectedCat = document.getElementById('filterCategory').value.toLowerCase();
    const query = document.getElementById('searchCatalog').value.toLowerCase().trim();

    if (!allCatalogItems || allCatalogItems.length === 0) return;

    allCategories.forEach(cat => {
      const cKey = cat.id.toString().toLowerCase();
      const catItems = allCatalogItems.filter(i => (i.categoryId || '').toLowerCase() === cKey);
      const filtered = catItems.filter(item => {
        const matchesCat = selectedCat === 'all' || cKey === selectedCat;
        const matchesSearch = !query || (item.name || '').toLowerCase().includes(query) || (item.spec || '').toLowerCase().includes(query);
        return matchesCat && matchesSearch;
      });

      const body = document.getElementById(`cat-body-${cat.id}`);
      const header = document.getElementById(`cat-header-${cat.id}`);
      const arrow = document.getElementById(`cat-arrow-${cat.id}`);

      if (selectedCat !== 'all' || query) {
        if (filtered.length > 0 && (selectedCat === 'all' || selectedCat === cKey)) {
          if (body) body.style.display = 'block';
          if (header) header.classList.add('active');
          if (arrow) arrow.style.transform = 'rotate(90deg)';
          renderCategoryItemsGrid(cat.id, filtered);
        } else {
          if (body) body.style.display = 'none';
          if (header) header.classList.remove('active');
          if (arrow) arrow.style.transform = 'rotate(0deg)';
        }
      } else {
        renderCategoryItemsGrid(cat.id, catItems);
      }
    });
  }

  async function deleteCatalogItem(id, name, event) {
    if (event) event.stopPropagation();

    if (typeof Swal !== 'undefined') {
      const result = await Swal.fire({
        title: 'Delete Product?',
        text: `Are you sure you want to delete "${name}" from Neon DB?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Yes, Delete Product',
        background: '#ffffff',
        color: '#0f172a'
      });

      if (!result.isConfirmed) return;
    } else {
      if (!confirm(`Are you sure you want to delete product "${name}" from Neon DB?`)) return;
    }

    try {
      const res = await fetch(`/api/catalogapi/items/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        if (typeof showToast === 'function') {
          showToast(`Deleted product "${name}" from database.`, 'success', 'Deleted');
        }
        loadGroupedCatalog();
      }
    } catch (err) {
      console.error('Error deleting catalog item:', err);
      if (typeof showToast === 'function') {
        showToast('Error deleting item from database.', 'error');
      }
    }
  }
</script>
