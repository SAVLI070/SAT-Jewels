@{
    ViewData["Title"] = "Publish New Collection Item";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
  .add-prod-panel {
    max-width: 840px;
    margin: 0 auto;
    background: rgba(8, 17, 34, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(212, 178, 112, 0.3);
    border-radius: var(--radius-xl);
    padding: 36px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    color: #ffffff;
  }

  .form-group {
    margin-bottom: 22px;
  }

  .form-label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--champagne-gold);
    margin-bottom: 6px;
  }

  .form-input, .form-select {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 16px;
    background: rgba(10, 20, 38, 0.95);
    border: 1px solid rgba(212, 178, 112, 0.4);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    outline: none;
    transition: all 0.25s ease;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--champagne-gold);
    box-shadow: 0 0 16px rgba(212, 178, 112, 0.4);
  }

  .form-select option {
    background: #081122;
    color: #ffffff;
  }

  /* Upload Dropzone Box */
  .upload-dropzone {
    border: 2px dashed rgba(212, 178, 112, 0.4);
    border-radius: var(--radius-lg);
    padding: 28px;
    text-align: center;
    background: rgba(10, 20, 38, 0.6);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .upload-dropzone:hover {
    border-color: var(--champagne-gold);
    background: rgba(212, 178, 112, 0.12);
  }

  .upload-icon {
    font-size: 32px;
    color: var(--champagne-gold);
    margin-bottom: 10px;
  }

  .upload-preview-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 16px;
  }

  .upload-preview-card {
    height: 90px;
    border-radius: 10px;
    border: 1px solid var(--border-gold-soft);
    overflow: hidden;
    position: relative;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
  }

  .upload-preview-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .btn-submit-item {
    padding: 14px 32px;
    background: linear-gradient(135deg, #d4b270 0%, #b45309 100%);
    border: none;
    border-radius: var(--radius-full);
    color: #060d0a;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 4px 20px rgba(212, 178, 112, 0.35);
    transition: all 0.3s ease;
  }

  .btn-submit-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(212, 178, 112, 0.6);
    background: linear-gradient(135deg, #fcebc5 0%, #d4b270 100%);
  }
</style>

<div class="add-prod-panel">
  <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid rgba(255, 255, 255, 0.1);">
    <div style="width:48px;height:48px;border-radius:12px;background:rgba(212,178,112,0.15);border:1px solid var(--border-gold);color:var(--champagne-gold);display:flex;align-items:center;justify-content:center;font-size:22px;">
      <i class="fa-solid fa-gem"></i>
    </div>
    <div>
      <h2 style="font-family:var(--font-serif);color:#ffffff;margin:0 0 4px;font-size:24px;">+ Publish New Item to Live Store</h2>
      <p style="color:var(--taupe-beige);font-size:13px;margin:0;">Item will immediately be active and available for luxury buyers on the storefront.</p>
    </div>
  </div>

  <form id="adminAddProductForm" onsubmit="handleAddNewProduct(event)">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
      <div class="form-group">
        <label class="form-label">Target Collection Category *</label>
        <select id="adminProdCat" class="form-select" required>
          <option value="rings">Rings Collection</option>
          <option value="necklaces">Necklaces Section</option>
          <option value="earrings">Earrings Section</option>
          <option value="bracelets">Bracelets Section</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Item Title / Name *</label>
        <input type="text" id="adminProdName" class="form-input" placeholder="e.g. Royal Solitaire Emerald Ring" required />
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Metal & Diamond Specifications *</label>
      <input type="text" id="adminProdSpec" class="form-input" placeholder="e.g. 18K Yellow Gold | 2.0ct GIA VVS1 | Brilliant Cut" required />
    </div>

    <div class="form-group">
      <label class="form-label">Price in USD ($) *</label>
      <input type="number" id="adminProdPriceUSD" class="form-input" placeholder="e.g. 2200" min="1" required />
    </div>

    <!-- MULTI-IMAGE UPLOAD ZONE (Max 10 images, max 10MB per image) -->
    <div class="form-group">
      <label class="form-label">Upload High-Res Product Photos (Max 10 Images, 10MB per file) *</label>
      
      <div class="upload-dropzone" onclick="document.getElementById('adminUploadFiles').click()">
        <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>
        <div style="font-weight:700;color:#ffffff;font-size:15px;margin-bottom:4px;">Click or Drag & Drop Product Images</div>
        <div style="font-size:12px;color:var(--taupe-beige);">Upload up to 10 photos per item (max 10MB per file, max 100MB total). First image will be main thumbnail.</div>
        <input type="file" id="adminUploadFiles" multiple accept="image/*" style="display:none;" onchange="previewUploadFiles(this)" />
      </div>

      <div id="uploadStatusText" style="font-size:12px;font-weight:600;color:var(--champagne-gold);margin-top:8px;"></div>
      <div class="upload-preview-grid" id="uploadPreviewGrid"></div>
    </div>

    <!-- PRESET ASSETS FALLBACK -->
    <div class="form-group">
      <label class="form-label">Or Choose Preset AI Studio Image Asset (Optional Fallback)</label>
      <select id="adminProdImgSelect" class="form-select">
        <option value="">-- None (Use Uploaded Images Above) --</option>
        <option value="assets/ring_main.png">Royal Solitaire Ring (assets/ring_main.png)</option>
        <option value="assets/ring_angle.png">Halo Cushion Ring (assets/ring_angle.png)</option>
        <option value="assets/necklace_main.png">Imperial Diamond Necklace (assets/necklace_main.png)</option>
        <option value="assets/necklace_detail.png">Floral Diamond Detail (assets/necklace_detail.png)</option>
        <option value="assets/earring_main.png">Chandelier Earrings (assets/earring_main.png)</option>
        <option value="assets/bracelet_main.png">Tennis Bracelet (assets/bracelet_main.png)</option>
        <option value="assets/ring_whitegold.png">Platinum White Gold (assets/ring_whitegold.png)</option>
        <option value="assets/ring_rosegold.png">Rose Gold Solitaire (assets/ring_rosegold.png)</option>
      </select>
    </div>

    <div style="margin-top:32px;text-align:right;">
      <button type="submit" class="btn-submit-item" id="btnSubmitItem">
        <i class="fa-solid fa-paper-plane"></i> Save to Neon DB & Publish Live
      </button>
    </div>
  </form>
</div>

<script>
  let selectedFiles = [];

  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get('categoryId');
    if (catParam) {
      const catSelect = document.getElementById('adminProdCat');
      if (catSelect) catSelect.value = catParam.toLowerCase();
    }
  });

  function previewUploadFiles(input) {
    const files = Array.from(input.files);
    const statusText = document.getElementById('uploadStatusText');
    const previewGrid = document.getElementById('uploadPreviewGrid');

    if (files.length > 10) {
      alert('Maximum 10 images allowed per item.');
      input.value = '';
      return;
    }

    const maxFileSize = 10 * 1024 * 1024; // 10MB
    for (let f of files) {
      if (f.size > maxFileSize) {
        alert(`File "${f.name}" exceeds the 10 MB limit. Please select smaller files.`);
        input.value = '';
        return;
      }
    }

    selectedFiles = files;
    const totalMB = (files.reduce((sum, f) => sum + f.size, 0) / (1024 * 1024)).toFixed(1);
    statusText.textContent = `Selected ${files.length} image(s) — Total Payload Size: ${totalMB} MB`;

    previewGrid.innerHTML = files.map((file, i) => {
      const src = URL.createObjectURL(file);
      return `
        <div class="upload-preview-card" title="${file.name}">
          <img src="${src}" alt="Preview ${i + 1}" />
        </div>
      `;
    }).join('');
  }

  async function handleAddNewProduct(e) {
    e.preventDefault();

    const categoryId = document.getElementById('adminProdCat').value;
    const name = document.getElementById('adminProdName').value.trim();
    const spec = document.getElementById('adminProdSpec').value.trim();
    const priceUSD = parseFloat(document.getElementById('adminProdPriceUSD').value) || 0;
    const selectedPreset = document.getElementById('adminProdImgSelect').value;
    const submitBtn = document.getElementById('btnSubmitItem');

    let uploadedUrls = [];

    if (selectedFiles && selectedFiles.length > 0) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Uploading Product Images...';

      const formData = new FormData();
      selectedFiles.forEach(f => formData.append('files', f));

      try {
        const uploadRes = await fetch('/api/catalogapi/upload-images', {
          method: 'POST',
          body: formData
        });

        const uploadData = await uploadRes.json();
        if (uploadData.success && uploadData.urls) {
          uploadedUrls = uploadData.urls;
        } else {
          alert(`Image Upload Error: ${uploadData.message || 'Failed to upload images'}`);
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Save to Neon DB & Publish Live';
          return;
        }
      } catch (err) {
        console.error('Error uploading images:', err);
        alert('Network error uploading images.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Save to Neon DB & Publish Live';
        return;
      }
    }

    let mainImageUrl = '';
    let galleryImages = '';

    if (uploadedUrls.length > 0) {
      mainImageUrl = uploadedUrls[0];
      galleryImages = uploadedUrls.join(',');
    } else if (selectedPreset) {
      mainImageUrl = selectedPreset;
      galleryImages = `${selectedPreset},assets/ring_clarity.png,assets/ring_model.png`;
    } else {
      mainImageUrl = 'assets/ring_main.png';
      galleryImages = 'assets/ring_main.png,assets/ring_angle.png,assets/ring_clarity.png,assets/ring_model.png';
    }

    const payload = {
      categoryId,
      name,
      spec,
      priceUSD,
      imageUrl: mainImageUrl,
      galleryImages: galleryImages,
      isActive: true
    };

    try {
      submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving to Database...';

      const res = await fetch('/api/catalogapi/items', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (data.success || res.ok) {
        alert(`✨ Success! Product "${name}" published with ${uploadedUrls.length || 1} image(s).`);
        window.location.href = '/Admin/Catalog';
      } else {
        alert('Failed to publish product item.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Save to Neon DB & Publish Live';
      }
    } catch (err) {
      console.error('Error publishing product:', err);
      alert('Network error publishing item.');
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Save to Neon DB & Publish Live';
    }
  }
</script>
