      .sat-page-controls::-webkit-scrollbar { display: none; }
      .sat-p-nav-btn {
        padding: 0 8px !important;
        height: 32px !important;
        font-size: 11.5px !important;
        gap: 4px !important;
        flex-shrink: 0 !important;
      }
      .sat-p-num-btn {
        min-width: 30px !important;
        height: 32px !important;
        font-size: 12px !important;
        flex-shrink: 0 !important;
      }
      .sat-p-dots {
        padding: 0 2px !important;
        font-size: 11px !important;
        flex-shrink: 0 !important;
      }
    }

    /* Smooth Carousel Slider Styles */
    .sat-carousel-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: #000000;
    }
    .sat-carousel-track {
      position: absolute;
      top: 0;
      left: 0;
      display: flex;
      width: 100%;
      height: 100%;
      transition: transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
      will-change: transform;
      text-decoration: none;
    }
    .sat-carousel-slide {
      position: relative;
      flex: 0 0 100%;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }
    .sat-carousel-slide img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s ease;
    }
    .ivevar-product-card:hover .sat-carousel-slide img {
      transform: scale(1.05);
    }

    /* Hover Scrubber Dots */
    .sat-scrub-dots {
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 5px;
      z-index: 5;
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .ivevar-product-card:hover .sat-scrub-dots {
      opacity: 1;
    }
    .scrub-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.4);
      transition: all 0.3s ease;
    }
    .scrub-dot.active {
      background: #d4b270;
      width: 14px;
      border-radius: 4px;
    }
  </style>

  <script>
    // Robust handler for broken/non-loaded carousel images
    window.handleCarouselImgError = function(img, fallbackSrc) {
      img.onerror = null;
      const slide = img.closest('.sat-carousel-slide');
      const card = img.closest('.sat-scrub-card');
      if (slide && card) {
        const allSlides = card.querySelectorAll('.sat-carousel-slide');
        if (allSlides.length > 1) {
          slide.remove();
          const remaining = card.querySelectorAll('.sat-carousel-slide');
          card.setAttribute('data-count', remaining.length);
          const dotsWrap = card.querySelector('.sat-scrub-dots');
          if (dotsWrap) {
            dotsWrap.innerHTML = '';
            if (remaining.length > 1) {
              for (let d = 0; d < Math.min(remaining.length, 5); d++) {
                const span = document.createElement('span');
                span.className = 'scrub-dot' + (d === 0 ? ' active' : '');
                dotsWrap.appendChild(span);
              }
            }
          }
          return;
        }
      }
      img.src = fallbackSrc || '/assets/ring_1.jpg';
    };

    // Desktop Slow & Calm Right-Sliding Photo by Photo Animation on Hover
    document.querySelectorAll('.sat-scrub-card').forEach(card => {
      const track = card.querySelector('.sat-carousel-track');
      let currentIdx = 0;
      let autoSlideTimer = null;
      let lastMoveTime = 0;

      function slideTo(idx) {
        const slides = track.querySelectorAll('.sat-carousel-slide');
        const countNow = slides.length;
        if (countNow <= 1) return;
        const nextIdx = (idx + countNow) % countNow;

        // Skip non-loaded or broken images
        const targetImg = slides[nextIdx]?.querySelector('img');
        if (targetImg) {
          if (!targetImg.complete) {
            // Target image is still loading; do not slide to a blank frame
            return;
          }
          if (targetImg.naturalWidth === 0) {
            handleCarouselImgError(targetImg, card.getAttribute('data-fallback') || '');
            return;
          }
        }

        currentIdx = nextIdx;
        track.style.transform = `translateX(-${currentIdx * 100}%)`;
        const dotsNow = card.querySelectorAll('.scrub-dot');
        dotsNow.forEach((d, i) => {
          if (i === currentIdx) d.classList.add('active');
          else d.classList.remove('active');
        });
      }

      // Preload next images and calmly auto-slide photo by photo to the right when mouse is hovering
      card.addEventListener('mouseenter', () => {
        track.querySelectorAll('img').forEach(img => {
          if (img.loading === 'lazy') img.loading = 'eager';
        });
        clearInterval(autoSlideTimer);
        autoSlideTimer = setInterval(() => {
          slideTo(currentIdx + 1);
        }, 1800); // Relaxed luxury 1.8s interval
      });

      // Smoothly damped mousemove: only transitions if cursor moved deliberately and with debounce
      card.addEventListener('mousemove', (e) => {
        const now = Date.now();
        if (now - lastMoveTime < 280) return; // 280ms throttle to prevent fast jitter

        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const pct = Math.max(0, Math.min(1, x / rect.width));
        const targetIdx = Math.floor(pct * count);
        
        if (targetIdx !== currentIdx) {
          lastMoveTime = now;
          clearInterval(autoSlideTimer);
          slideTo(targetIdx);
          autoSlideTimer = setInterval(() => {
            slideTo(currentIdx + 1);
          }, 2000);
        }
      });

      card.addEventListener('mouseleave', () => {
        clearInterval(autoSlideTimer);
        slideTo(0);
      });

      // Mobile Touch Swipe support
      let touchStartX = 0;
      card.addEventListener('touchstart', (e) => {
        if (e.touches && e.touches.length > 0) {
          touchStartX = e.touches[0].clientX;
        }
      }, { passive: true });

      card.addEventListener('touchend', (e) => {
        if (e.changedTouches && e.changedTouches.length > 0) {
          const touchEndX = e.changedTouches[0].clientX;
          const diff = touchEndX - touchStartX;
          if (diff < -30) {
            slideTo(currentIdx + 1); // Swipe left -> slide to next photo
          } else if (diff > 30) {
            slideTo(currentIdx - 1); // Swipe right -> slide to prev photo
          }
        }
      }, { passive: true });
    });

    function scrollShapes(offset) {
      document.getElementById('shapesTrack').scrollBy({ left: offset, behavior: 'smooth' });
    }

    function toggleSatSortMenu() {
      const menu = document.getElementById('satSortMenu');
      const btn = document.getElementById('satSortBtn');
      if (menu && btn) {
        menu.classList.toggle('show');
        btn.classList.toggle('open');
      }
    }

    document.addEventListener('click', (e) => {
      const wrap = e.target.closest('.sat-sort-wrap');
      const menu = document.getElementById('satSortMenu');
      const btn = document.getElementById('satSortBtn');
      if (!wrap && menu && btn) {
        menu.classList.remove('show');
        btn.classList.remove('open');
      }
    });

    function applySorting(sortVal) {
      if (window.showDiamondLoader) window.showDiamondLoader('Sorting Creations...');
      const urlParams = new URLSearchParams(window.location.search);
      urlParams.set('sort', sortVal);
      urlParams.set('page', '1');
      window.location.search = urlParams.toString();
    }

    const isUserAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

    function getCartStorageKey() {
      const isAuth = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
      const email = '@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value?.ToLower()?.Trim() ?? "")';
      if (isAuth && email) {
        return 'sat_cart_' + encodeURIComponent(email);
      }
      return 'sat_cart_guest';
    }

    window.syncCartBadge = function() {
      try {
        const key = getCartStorageKey();
        const saved = localStorage.getItem(key);
        const items = saved ? JSON.parse(saved) : [];
        const count = items.reduce((sum, i) => sum + (Number(i.quantity) || 1), 0);
        document.querySelectorAll('#navCartBadge, #navCartCount, .auth-nav-cart-count, .sat-cart-count-badge').forEach(el => {
          el.textContent = count;
        });
      } catch (e) {}
    };

    document.addEventListener('DOMContentLoaded', () => {
      window.syncCartBadge();
    });

    let cartToastTimer = null;

    function showCartToast(name, priceUSD, img) {
      const toast = document.getElementById('satCartToast');
      if (!toast) return;

      document.getElementById('satToastImg').src = img || '/assets/ivevar/exclusive_regal_star_diamond_ring.jpg';
      document.getElementById('satToastTitle').innerText = name || 'Jewelry Piece';
      document.getElementById('satToastPrice').innerText = '$' + (Number(priceUSD) || 0).toLocaleString() + ' USD';

      toast.classList.add('show');

      clearTimeout(cartToastTimer);
      cartToastTimer = setTimeout(() => {
        toast.classList.remove('show');
      }, 3500);
    }

    function closeCartToast() {
      const toast = document.getElementById('satCartToast');
      if (toast) toast.classList.remove('show');
    }

    function quickAddToCart(firstArg, nameArg, priceArg, imgArg, btnArg) {
      if (!isUserAuthenticated) {
        showAuthRequiredModal('cart');
        return;
      }

      try {
        let id, name, priceUSD, img, btn;
        if (firstArg instanceof HTMLElement) {
          btn = firstArg;
          id = btn.dataset.id;
          name = btn.dataset.name;
          priceUSD = Number(btn.dataset.price);
          img = btn.dataset.img;
        } else {
          id = firstArg;
          name = nameArg;
          priceUSD = Number(priceArg);
          img = imgArg;
          btn = btnArg || (window.event && window.event.currentTarget);
        }

        const key = getCartStorageKey();
        const saved = localStorage.getItem(key);
        let items = saved ? JSON.parse(saved) : [];
        const existing = items.find(x => x.id === id);
        if (existing) {
          existing.quantity = (Number(existing.quantity) || 1) + 1;
        } else {
          items.push({
            id: id,
            name: name,
            priceUSD: priceUSD,
            img: img || '/assets/ivevar/exclusive_regal_star_diamond_ring.jpg',
            quantity: 1
          });
        }
        localStorage.setItem(key, JSON.stringify(items));

        // 1. Sync header cart badge counter
        if (window.syncCartBadge) {
          window.syncCartBadge();
        }

        // 2. Animate cart badge with bounce
        document.querySelectorAll('#navCartBadge, #navCartCount, .auth-nav-cart-count').forEach(el => {
          el.classList.remove('cart-badge-bounce');
          void el.offsetWidth;
          el.classList.add('cart-badge-bounce');
        });

        // 3. Animate the clicked button
        if (btn) {
          const originalText = btn.innerHTML;
          btn.classList.add('btn-added');
          if (btn.classList.contains('btn-card-cart')) {
            btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:19px; color:#10b981;">check</span>';
          } else {
            btn.innerHTML = '<i class="fa-solid fa-check"></i> Added!';
          }
          btn.disabled = true;

          setTimeout(() => {
            btn.classList.remove('btn-added');
            btn.innerHTML = originalText;
            btn.disabled = false;
          }, 1800);
        }

        // 4. Show luxury toast notification
        showCartToast(name, priceUSD, img);

      } catch (e) {
        console.error('Error adding item to cart:', e);
      }
    }

    function quickBuyNow(firstArg, nameArg, priceArg, imgArg, btnArg) {
      if (!isUserAuthenticated) {
        showAuthRequiredModal('cart');
        return;
      }
      quickAddToCart(firstArg, nameArg, priceArg, imgArg, btnArg);
      setTimeout(() => {
        window.location.href = '/Product/Cart';
      }, 200);
    }

    async function quickToggleWishlist(btn, event) {
      if (event) {
        event.stopPropagation();
        event.preventDefault();
      }
      if (!btn) return;
      
      // STRICT ACCOUNT LOGIN VALIDATION:
      // If user is not logged in, DO NOT save into cache/localStorage.
      // Show sign-in required message modal.
      if (!isUserAuthenticated) {
        try { localStorage.removeItem('sat_wishlist_ids'); } catch (e) {}
        showAuthRequiredModal('wishlist');
        return;
      }

      const id = btn.dataset.id;
      const name = btn.dataset.name || 'Fine Jewelry Piece';
      const priceUSD = Number(btn.dataset.price) || 0;
      const img = btn.dataset.img || '/assets/categories/cat_engagement_rings.png';

      btn.disabled = true;

      try {
        const res = await fetch('/api/WishlistApi/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            catalogItemId: id,
            productName: name,
            priceUSD: priceUSD,
            imageUrl: img
          })
        });

        if (res.status === 401) {
          showAuthRequiredModal('wishlist');
          return;
        }

        const data = await res.json();
        if (data && data.success) {
          if (data.isSaved) {
            btn.classList.add('active', 'in-wishlist');
            btn.innerHTML = '<i class="fa-solid fa-heart" style="color:#e11d48;"></i>';
            showCartToast(name + ' (Saved to Wishlist)', priceUSD, img);
          } else {
            btn.classList.remove('active', 'in-wishlist');
            btn.innerHTML = '<i class="fa-regular fa-heart"></i>';
            showCartToast(name + ' (Removed from Wishlist)', priceUSD, img);
          }
        }
      } catch (err) {
        console.error('Wishlist toggle error:', err);
      } finally {
        btn.disabled = false;
      }
    }

    function initWishlistState() {
      // Purge any legacy localStorage cache so it never leaks between sessions/users
      try { localStorage.removeItem('sat_wishlist_ids'); } catch (e) {}

      // If user is not logged in, all hearts must remain empty (no caching)
      if (!isUserAuthenticated) return;

      // Pure account-based database lookup
      fetch('/api/WishlistApi/my-wishlist')
        .then(r => r.json())
        .then(data => {
          if (data && data.success && data.isAuthenticated && data.items) {
            const serverIds = new Set(data.items.map(x => String(x.catalogItemId)));
            document.querySelectorAll('.btn-card-wishlist').forEach(btn => {
              if (serverIds.has(String(btn.dataset.id))) {
                btn.classList.add('active', 'in-wishlist');
                btn.innerHTML = '<i class="fa-solid fa-heart" style="color:#e11d48;"></i>';
              } else {
                btn.classList.remove('active', 'in-wishlist');
                btn.innerHTML = '<i class="fa-regular fa-heart"></i>';
              }
            });
          }
        })
        .catch(err => console.warn('Wishlist load warning:', err));
    }

    document.addEventListener('DOMContentLoaded', initWishlistState);
  </script>

  <!-- Global Search Modal -->
