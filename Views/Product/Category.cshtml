    }
    .sat-p-nav-btn {
      padding: 0 16px;
      height: 40px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.25);
      border-radius: 8px;
      color: #d4b270;
      text-decoration: none;
