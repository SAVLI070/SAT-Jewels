@model List<SAT1.Models.CatalogItem>
@inject SAT1.BAL.CatalogBal CatalogBal
@{
    Layout = null;
    var categoryId = ViewBag.CategoryId ?? 2;
    var categoryName = ViewBag.CategoryName as string ?? "Anniversary Ring";
    var pageTitle = $"Buy {categoryName} Online in USA | Certified Lab Diamonds — SAT Jewel";
    var pageDesc = $"Shop handcrafted {categoryName} collection at SAT Jewel. 100% GIA & IGI certified lab-grown diamonds and moissanite solitaires with bespoke customization and free insured worldwide shipping.";
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}/Product/Category?id={categoryId}";
    var selectedShape = ViewBag.SelectedShape as string ?? "All";
    var selectedSort = ViewBag.SelectedSort as string ?? "bestselling";
    var publicCategories = await CatalogBal.GetPublicCategoriesAsync();
}
@functions {
    string GetSortDisplayName(string key) {
        return (key?.ToLower()) switch {
            "featured" => "Featured",
            "relevant" => "Most relevant",
            "alpha-asc" => "Alphabetically, A-Z",
            "alpha-desc" => "Alphabetically, Z-A",
            "price-asc" => "Price, low to high",
            "price-desc" => "Price, high to low",
            "date-asc" => "Date, old to new",
            "date-desc" => "Date, new to old",
            _ => "Best selling"
        };
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@pageTitle</title>
  <meta name="title" content="@pageTitle" />
  <meta name="description" content="@pageDesc" />
  <meta name="keywords" content="@categoryName, Lab Grown @categoryName, Certified Diamonds, Custom Solitaires, SAT Jewel" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href="@canonical" />

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="product.group" />
  <meta property="og:url" content="@canonical" />
  <meta property="og:title" content="@pageTitle" />
  <meta property="og:description" content="@pageDesc" />
  <meta property="og:site_name" content="SAT Jewel" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="@pageTitle" />
  <meta name="twitter:description" content="@pageDesc" />

  <!-- BreadcrumbList JSON-LD Schema -->
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org",
    "@@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "@Context.Request.Scheme://@Context.Request.Host"
      },
      {
        "@@type": "ListItem",
        "position": 2,
        "name": "Collections",
        "item": "@Context.Request.Scheme://@Context.Request.Host/#collections"
      },
      {
        "@@type": "ListItem",
        "position": 3,
        "name": "@categoryName",
        "item": "@canonical"
      }
    ]
  }
  </script>

  <!-- CollectionPage & ItemList JSON-LD Schema -->
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org",
    "@@type": "CollectionPage",
    "name": "@categoryName Collection",
    "url": "@canonical",
    "description": "@pageDesc",
    "mainEntity": {
      "@@type": "ItemList",
      "itemListElement": [
        @for (int i = 0; i < Model.Take(12).Count(); i++)
        {
          var item = Model[i];
          var itemUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Product/Details/{item.Id}";
          <text>
          {
            "@@type": "ListItem",
            "position": @(i + 1),
            "url": "@itemUrl",
            "name": "@item.Name"
          }@(i < Math.Min(Model.Count, 12) - 1 ? "," : "")
          </text>
        }
      ]
    }
  }
  </script>

  <link rel="icon" type="image/png" href="/assets/sat_emblem_clean.png" />
  <link rel="shortcut icon" type="image/png" href="/assets/sat_emblem_clean.png" />
  <link rel="apple-touch-icon" href="/assets/sat_emblem_clean.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/style.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      corePlugins: {
        preflight: false
      },
      theme: {
        extend: {
          colors: {
            "secondary": "#e4c277",
