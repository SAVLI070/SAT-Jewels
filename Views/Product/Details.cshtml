@model SAT1.Models.CatalogItem
@{
    ViewData["Title"] = Model.Name + " — SAT Jewel Sanctuary";
    Layout = null;
    var related = ViewBag.RelatedItems as List<SAT1.Models.CatalogItem> ?? new List<SAT1.Models.CatalogItem>();
    var categoryName = ViewBag.CategoryName as string ?? "Engagement Rings";

    string FixImg(string? path) {
        if (string.IsNullOrWhiteSpace(path)) return "/assets/ivevar/exclusive_regal_star_diamond_ring.jpg";
        if (path.StartsWith("http://") || path.StartsWith("https://")) return path;
        if (path.StartsWith("~/")) return path.Substring(1);
        if (!path.StartsWith("/")) return "/" + path;
        return path;
    }

    var mainImage = FixImg(Model.ImageUrl);

    List<string> galleryList = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.GalleryImages))
    {
        galleryList = Model.GalleryImages.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => FixImg(s.Trim()))
            .ToList();
    }

    if (galleryList.Count == 0)
    {
        galleryList = new List<string> {
            mainImage,
            "/assets/ivevar/ivevar-luxury-rings-925-silver-0-80-ct-sparkling-antique-shape-moissanite-silhouette-diamond-ring-vintage-fine-jewelry-44619076403505_c18db5d1-09b7-41c4-8fd4-f72a5a00aa4a.png",
            "/assets/ivevar/ivevar-luxury-rings-925-silver-2-1-75-ct-sparkling-fancy-vivid-green-emerald-cut-moissanite-diamond-engagement-ring-44619311841585_7c5c472f-38eb-4a1b-89ee-25caa5a69c22.png",
            "/assets/ivevar/modern_wedding_ring_band_be1024e1-bb04-457c-83d2-7acda4fc55b4.png"
        };
    }

    var originalPriceUSD = (int)(Model.Price * 1.15m);

    // Dynamic Database Parsing for Metal Options & Carat Options (100% strictly from Database datatable per product)
    var rawMetalStr = Model.MetalOptions ?? string.Empty;

    var metalList = rawMetalStr.Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(opt => {
            var parts = opt.Trim().Split(new[] { " (" }, StringSplitOptions.RemoveEmptyEntries);
            var name = parts[0].Trim();
            var offset = 0m;
            if (parts.Length > 1) {
                var numStr = parts[1].Replace(")", "").Replace("+", "").Replace("USD", "").Trim();
                decimal.TryParse(numStr, out offset);
            }
            return new { Name = name, Offset = offset };
        })
        .GroupBy(x => x.Name)
        .Select(g => g.First())
        .ToList();

    var rawCaratStr = Model.CaratOptions ?? string.Empty;

    var caratList = rawCaratStr.Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(opt => {
            var parts = opt.Trim().Split(new[] { " (" }, StringSplitOptions.RemoveEmptyEntries);
            var label = parts[0].Trim();
            var offset = 0m;
            if (parts.Length > 1) {
                var numStr = parts[1].Replace(")", "").Replace("+", "").Replace("USD", "").Trim();
                decimal.TryParse(numStr, out offset);
            }
            return new { Label = label, Offset = offset };
        })
        .GroupBy(x => x.Label)
        .Select(g => g.First())
        .ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@Model.Name — SAT Jewel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/style.css" />
  <style>
    *, *:before, *:after {
      box-sizing: border-box;
    }
    html, body {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
      margin: 0;
      padding: 0 0 80px;
      background: #050b14;
      color: #ffffff;
      font-family: var(--font-sans);
      min-height: 100vh;
    }
    .pd-container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 20px 16px;
    }
    /* Top Announcement Bar (Image 1 Header) */
    .sat-announcement-bar {
      width: 100%;
      background: #000000;
      color: #ffffff;
      text-align: center;
      padding: 7px 14px;
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Clean Mobile Header (Image 1 Target) */
    .sat-nav-header {
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .sat-nav-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .sat-nav-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .sat-icon-link {
      background: none;
      border: none;
      font-size: 18px;
      color: #0f172a;
      cursor: pointer;
      padding: 4px;
    }
    .sat-nav-brand {
      text-align: center;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .brand-title {
      font-family: var(--font-serif);
      font-size: 17px;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: 1px;
    }
    .brand-title .gold-text {
      color: #d97706;
    }
    .brand-tagline {
      font-size: 9px;
      color: #64748b;
      font-style: italic;
      margin-top: -2px;
    }
    .sat-nav-right {
      display: flex;
      align-items: center;
    }
    .sat-cart-btn {
      position: relative;
      background: #f1f5f9;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #0f172a;
      text-decoration: none;
      font-size: 15px;
    }
    .cart-badge-count {
      position: absolute;
      top: -2px; right: -2px;
      background: #000000;
      color: #ffffff;
      font-size: 10px;
      font-weight: 800;
      width: 18px; height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Breadcrumbs */
    .pd-breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      font-size: 12px;
      color: #94a3b8;
      margin: 16px 0 20px;
    }
    .pd-breadcrumb a {
      color: #64748b;
      text-decoration: none;
    }
    .pd-breadcrumb .sep {
      color: #cbd5e1;
    }
    .pd-breadcrumb .curr {
      color: #ffffff;
      font-weight: 600;
    }

    /* Mobile Product Stage & Thumbnails */
    .pd-gallery-container {
      width: 100%;
      max-width: 500px;
      margin: 0 auto;
    }
    .pd-main-stage {
      position: relative;
      width: 100%;
      background: #000000;
      border-radius: 8px;
      overflow: hidden;
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
    }
    .pd-main-stage img, .pd-main-stage video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .badge-lab-grown {
      position: absolute;
      top: 12px; left: 12px;
      background: rgba(0, 0, 0, 0.75);
      color: #ffffff;
      border: 1px solid rgba(255,255,255,0.3);
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 4px;
      z-index: 5;
    }
    .gallery-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #ffffff;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
      transition: all 0.2s ease;
    }
    .gallery-arrow:hover {
      background: #fbbf24;
      color: #000000;
      border-color: #fbbf24;
    }
    .arrow-left { left: 12px; }
    .arrow-right { right: 12px; }

    .pd-thumbnails-row {
      display: flex;
      gap: 10px;
      margin-top: 12px;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .pd-thumb-box {
      position: relative;
      flex: 0 0 calc(25% - 8px);
      aspect-ratio: 1 / 1;
      background: #08111e;
      border-radius: 6px;
      overflow: hidden;
      border: 2px solid rgba(255, 255, 255, 0.15);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .pd-thumb-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .pd-thumb-box.active {
      border-color: #fbbf24;
      box-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
    }
    .thumb-vid-badge {
      position: absolute;
      top: 4px; right: 4px;
      background: rgba(0, 0, 0, 0.8);
      color: #fbbf24;
      font-size: 10px;
      padding: 2px 4px;
      border-radius: 3px;
    }

    /* Rating & Price Rows */
    .pd-rating-sku-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }
    .pd-rating-stars {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: #ffffff;
    }
    .star-icon { color: #fbbf24; font-size: 14px; }
    .rating-val { font-weight: 700; }
    .rating-pipe { color: rgba(255, 255, 255, 0.3); }
    .verify-check { color: #38bdf8; font-size: 12.5px; }
    .pd-sku-tag { font-size: 12px; color: rgba(255, 255, 255, 0.5); }

    .pd-price-row-mobile {
      margin-bottom: 12px;
    }
    .pd-price-primary {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .pd-price-val {
      font-size: 26px;
      font-weight: 800;
      color: #fbbf24;
    }
    .pd-price-orig {
      font-size: 16px;
      text-decoration: line-through;
      color: rgba(255, 255, 255, 0.45);
    }
    .pd-save-badge {
      background: #15803d;
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .pd-price-inr-sub {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.65);
      margin-top: 2px;
    }

    /* Main 2-Column Product Section */
    .pd-main-grid {
      display: grid;
      grid-template-columns: 500px 1fr;
      gap: 36px;
      align-items: start;
      margin-bottom: 60px;
    }
    @@media (max-width: 960px) {
      .pd-main-grid { grid-template-columns: 1fr; gap: 24px; }
    }

    /* Right Customizer Panel */
    .pd-customizer-panel {
      display: flex;
      flex-direction: column;
    }
    .pd-title {
      font-family: var(--font-serif);
      font-size: 30px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 10px;
      line-height: 1.3;
    }
    .pd-sub-spec {
      font-size: 13.5px;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 20px;
    }
    .pd-installments-box {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: 24px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .pd-installments-box a {
      color: var(--champagne-gold);
      text-decoration: underline;
      cursor: pointer;
    }

    /* Option Selectors */
    .pd-opt-label {
      font-size: 13.5px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 10px;
    }
    /* Circular Metal Swatches */
    .metal-swatch-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 22px;
    }
    .metal-swatch-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, 0.3);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 800;
      color: #000000;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0,0,0,0.5);
    }
    .metal-swatch-btn.active, .metal-swatch-btn:hover {
      border-color: var(--champagne-gold);
      transform: scale(1.15);
      box-shadow: 0 0 12px rgba(212, 178, 112, 0.6);
    }

    /* Carat Buttons */
    .carat-btn-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 22px;
      width: 100%;
    }
    .carat-btn {
      padding: 8px 14px;
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 6px;
      color: #ffffff;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      flex: 0 0 auto;
    }
    .carat-btn.active, .carat-btn:hover {
      background: var(--champagne-gold);
      color: #060c14;
      border-color: var(--champagne-gold);
    }

    /* Free Engraving Box */
    .engraving-box {
      margin-bottom: 22px;
    }
    .engraving-input {
      width: 100%;
      padding: 12px 16px;
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 8px;
      color: #ffffff;
      font-size: 14px;
      outline: none;
      box-sizing: border-box;
    }
    .engraving-input:focus {
      border-color: var(--champagne-gold);
    }

    /* Ring Size Dropdown */
    .size-select-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    .size-dropdown {
      width: 100%;
      padding: 12px 16px;
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 8px;
      color: #ffffff;
      font-size: 14px;
      outline: none;
      margin-bottom: 24px;
      cursor: pointer;
    }

    /* Action Buttons Group */
    .pd-main-action-buttons {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 24px;
      width: 100%;
    }
    .btn-add-cart-main {
      width: 100%;
      padding: 16px;
      background: var(--champagne-gold);
      color: #060c14;
      border: none;
      border-radius: 8px;
      font-weight: 800;
      font-size: 15px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .btn-add-cart-main:hover {
      background: #eab308;
      box-shadow: 0 6px 25px rgba(212, 178, 112, 0.5);
    }
    .btn-buy-now-main {
      width: 100%;
      padding: 16px;
      background: #ffffff;
      color: #000000;
      border: none;
      border-radius: 8px;
      font-weight: 800;
      font-size: 15px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }
    .btn-buy-now-main:hover {
      background: #f1f5f9;
      box-shadow: 0 6px 25px rgba(255, 255, 255, 0.4);
    }

    /* Delivery Estimate Box (Matching Image 2) */
    .pd-est-delivery-card {
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 8px;
      padding: 14px 18px;
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #78350f;
    }
    .est-title {
      font-size: 13.5px;
      font-weight: 700;
      color: #000000;
      display: block;
    }
    .est-sub {
      font-size: 12.5px;
      color: #d97706;
      display: block;
      margin-top: 2px;
    }
    .est-date {
      font-size: 18px;
      font-weight: 800;
      color: #000000;
    }

    /* 4 Value Badges Vertical List (Matching Image 2) */
    .pd-value-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 24px;
      padding-bottom: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .value-item {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      font-weight: 500;
      color: #ffffff;
    }
    .value-item i {
      font-size: 18px;
      color: #ffffff;
      width: 24px;
      text-align: center;
    }

    /* Drop a Hint Card (Matching Image 2) */
    .pd-hint-card {
      background: #e0f2fe;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 24px;
      color: #0f172a;
    }
    .hint-header {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 800;
      color: #000000;
      margin-bottom: 6px;
    }
    .hint-header i {
      font-size: 18px;
      color: #0284c7;
    }
    .hint-sub {
      font-size: 13px;
      color: #334155;
      line-height: 1.4;
      margin-bottom: 16px;
    }
    .btn-hint-black {
      width: 100%;
      padding: 14px;
      background: #000000;
      color: #ffffff;
      border: none;
      border-radius: 4px;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.5px;
      cursor: pointer;
      text-align: center;
    }

    /* Product Specifications Accordions (Matching Image 1 Stack Layout) */
    .pd-accordions-group {
      margin-top: 30px;
      margin-bottom: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
    }
    .acc-item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }
    .acc-header {
      padding: 16px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      cursor: pointer;
    }
    .acc-chevron {
      font-size: 12px;
      color: #ffffff;
      transition: transform 0.3s ease;
    }
    .acc-item.open .acc-chevron {
      transform: rotate(180deg);
    }
    .acc-body {
      display: none;
      padding-bottom: 16px;
      font-size: 13.5px;
      color: rgba(255, 255, 255, 0.75);
      line-height: 1.6;
    }
    .acc-item.open .acc-body {
      display: block;
    }

    /* You Might Also Like Grid (2-Col Mobile / 4-Col Desktop) */
    .you-might-like-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin-bottom: 50px;
    }
    @@media (max-width: 960px) {
      .you-might-like-grid {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 12px !important;
      }
    }
    @@media (min-width: 961px) {
      .you-might-like-grid {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 20px !important;
      }
    }
    .rec-card-mob {
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .rec-card-img-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      background: #000000;
    }
    .rec-card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .rec-badge-sub {
      position: absolute;
      bottom: 8px;
      right: 8px;
      background: #fef08a;
      color: #713f12;
      font-size: 9px;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 3px;
      text-transform: uppercase;
    }
    .rec-card-body {
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .rec-card-title {
      font-size: 13px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rec-card-price {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 800;
      color: #fbbf24;
    }
    .rec-card-orig {
      font-size: 11.5px;
      text-decoration: line-through;
      color: rgba(255, 255, 255, 0.45);
    }
    .rec-save-tag {
      background: #15803d;
      color: #ffffff;
      font-size: 9.5px;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 3px;
    }
    .rec-rating-line {
      font-size: 11.5px;
      color: rgba(255, 255, 255, 0.7);
      display: flex;
      align-items: center;
      gap: 4px;
      margin-top: 2px;
    }

    /* FAQ Tabs & Accordions (Screenshot 4) */
    .faq-tabs {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 30px;
    }
    .faq-tab-btn {
      padding: 10px 18px;
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 4px;
    }
    .faq-tab-btn.active, .faq-tab-btn:hover {
      background: var(--champagne-gold);
      color: #060c14;
      border-color: var(--champagne-gold);
    }
    @@media (min-width: 961px) {
      .desktop-hidden { display: none !important; }

      .pd-main-grid {
        display: grid;
        grid-template-columns: 500px 1fr;
        gap: 36px;
        align-items: start;
        margin-bottom: 60px;
      }
      .pd-desktop-showcase {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        width: 100%;
        max-width: 500px;
      }
      .pd-media-card {
        position: relative;
        background: #08111e;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        padding-top: 100%;
        box-shadow: 0 4px 16px rgba(0,0,0,0.3);
        transition: border-color 0.3s ease;
      }
      .pd-media-card:hover {
        border-color: var(--champagne-gold);
      }
      .pd-media-card img, .pd-media-card video {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        object-fit: cover;
      }
      .product-grid-4col {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 24px;
        margin-bottom: 60px;
      }
    }
    @@media (max-width: 960px) {
      .mobile-hidden { display: none !important; }
      .product-grid-4col { display: none !important; }
      .pd-desktop-showcase { display: none !important; }

      .pd-accordions-group { display: block !important; }
      .mobile-2col-grid {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 14px !important;
        margin-bottom: 50px;
      }
      .pd-main-grid {
        display: flex;
        flex-direction: column;
        gap: 24px;
        margin-bottom: 40px;
      }
      .pd-gallery-container {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
      }
    }
    .faq-item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      padding: 18px 0;
    }
    .faq-question {
      font-size: 16px;
      font-weight: 600;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
    }
    .faq-answer {
      display: none;
      margin-top: 12px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.6;
    }

    /* Testimonials (Screenshot 5) */
    .testi-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 80px;
    }
    @@media (max-width: 900px) {
      .testi-grid { grid-template-columns: 1fr; }
    }
    .testi-card {
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 14px;
      padding: 24px;
      text-align: center;
    }
    .testi-stars {
      color: #fbbf24;
      font-size: 14px;
      margin-bottom: 12px;
    }
    .testi-title {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 10px;
    }
    .testi-quote {
      font-size: 13.5px;
      color: rgba(255, 255, 255, 0.75);
      line-height: 1.5;
      margin-bottom: 16px;
    }
    .testi-author {
      font-size: 13px;
      font-weight: 700;
      color: var(--champagne-gold);
    }

    /* Sticky Bottom Purchase Bar (Luxury Dark Theme) */
    .sticky-bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
      background: #08111e;
      border-top: 1px solid rgba(212, 178, 112, 0.3);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      z-index: 1000;
      box-shadow: 0 -8px 25px rgba(0, 0, 0, 0.7);
      box-sizing: border-box;
      transform: translateY(100%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }
    .sticky-bottom-bar.visible {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .sticky-thumb-title {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
      flex: 1 1 auto;
      overflow: hidden;
    }
    .sticky-title-text {
      font-size: 13.5px;
      font-weight: 700;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sticky-price-text {
      font-size: 12px;
      color: var(--champagne-gold);
      font-weight: 600;
    }
    .sticky-btn-group {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }
    .btn-sticky-cart {
      padding: 10px 16px;
      background: var(--champagne-gold);
      color: #060c14;
      border: none;
      border-radius: 6px;
      font-weight: 800;
      font-size: 12.5px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .btn-sticky-cart:hover {
      background: #eab308;
    }
    .btn-sticky-buy {
      padding: 10px 16px;
      background: #ffffff;
      color: #000000;
      border: none;
      border-radius: 6px;
      font-weight: 800;
      font-size: 12.5px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .btn-sticky-buy:hover {
      background: #f1f5f9;
    }
    @@media (max-width: 768px) {
      .sticky-bottom-bar {
        padding: 8px 12px !important;
        gap: 8px !important;
      }
      .sticky-btn-group {
        gap: 6px !important;
      }
      .btn-sticky-cart, .btn-sticky-buy {
        padding: 8px 10px !important;
        font-size: 11.5px !important;
      }
    }
  </style>
</head>
<body>
  <!-- Top Announcement Bar (Mobile Only - Matching Fourth Image) -->
  <div class="sat-announcement-bar desktop-hidden">
    Trusted By 12K+ Customers Worldwide
  </div>

  <!-- Clean Mobile Header (Mobile Only - Matching Fourth Image) -->
  <nav class="sat-mobile-nav-header sat-nav-header desktop-hidden">
    <div class="sat-nav-inner">
      <div class="sat-nav-left">
        <button type="button" class="sat-icon-link" onclick="toggleMenu()" title="Menu"><i class="fa-solid fa-bars"></i></button>
        <button type="button" class="sat-icon-link" onclick="location.href='/Product'" title="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
      </div>
      <a href="/" class="sat-nav-brand">
        <span class="brand-title">SAT <span class="gold-text">LUXURY</span></span>
        <span class="brand-tagline">Crafted To Shine</span>
      </a>
      <div class="sat-nav-right">
        <a href="/Product/Cart" class="sat-cart-btn" title="Bag">
          <i class="fa-solid fa-bag-shopping"></i>
          <span id="headerCartBadge" class="cart-badge-count">0</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Desktop Header Navbar (Desktop Only - Classic Desktop View) -->
  <nav class="navbar mobile-hidden" style="position:relative; background:#08111e; border-bottom:1px solid rgba(212,178,112,0.3);">
    <div class="container nav-inner" style="padding:14px 20px;">
      <a href="/" style="display:flex; align-items:center; gap:4px; text-decoration:none; color:#ffffff;">
        <img src="~/assets/sat_logo_transparent.png" asp-append-version="true" style="height:36px; width:auto; object-fit:contain;" alt="SAT Jewels Logo" />
        <div style="display:flex; flex-direction:column; margin-left:2px;">
          <span style="font-family:var(--font-serif); font-size:20px; font-weight:700; color:#ffffff; letter-spacing:0.04em; line-height:1; white-space:nowrap;">SAT <span class="sat-brand-script" style="margin-left:4px;">Jewel</span></span>
          <span style="font-size:8.5px; font-weight:600; color:rgba(255,255,255,0.75); letter-spacing:0.16em; text-transform:uppercase; margin-top:2px;">Fine Jewelry</span>
        </div>
      </a>

      <!-- Details Header Nav Links Cluster -->
      <div class="nav-links mobile-hidden" style="margin-left: 24px; display: flex; align-items: center; gap: 20px;">
        <a href="/" class="nav-link" style="color: rgba(255,255,255,0.85); text-decoration: none; font-size: 13.5px; font-weight: 600;">Home</a>
        <div class="sat-nav-dropdown-wrap" onmouseenter="openSatMegaDropdown()" onmouseleave="closeSatMegaDropdown()">
          <a href="/Home/Index#collections" class="nav-link" style="color: var(--champagne-gold); text-decoration: none; font-size: 13.5px; font-weight: 700; display: flex; align-items: center; gap: 4px;" onclick="if(window.innerWidth <= 992) { openSatMobileDrawer(); return false; }">
            <i class="fa-solid fa-gem" style="font-size: 11px;"></i>
            <span>Collections</span>
            <i class="fa-solid fa-chevron-down" style="font-size: 9px; opacity: 0.8;"></i>
          </a>
        </div>
        <a href="/Home/CustomRings" class="nav-link" style="color: rgba(255,255,255,0.85); text-decoration: none; font-size: 13.5px; font-weight: 600;">Craft Process</a>
      </div>

      <div style="margin-left:auto; display:flex; align-items:center; gap:12px;">
        <partial name="_AuthNav" />
        <button class="hamburger desktop-hidden" onclick="openSatMobileDrawer()" aria-label="Menu" style="background:transparent; border:none; color:#ffffff; font-size:20px; cursor:pointer;">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>
  </nav>

  <div class="pd-container">
    <!-- Breadcrumb Navigation -->
    <div class="pd-breadcrumb">
      <a href="/">Home</a> <span>/</span>
      <a href="/Product">Collections</a> <span>/</span>
      <a href="/Product/Category?id=@Model.CategoryId">@categoryName</a> <span>/</span>
      <span style="color:#ffffff; font-weight:600;">@Model.Name</span>
    </div>

    <!-- Main Product Section -->
    <div class="pd-main-grid">
      <!-- Left Column: Media Showcase (Responsive Switcher) -->
      <div class="pd-media-column">
        <!-- Mobile Gallery Slider (Mobile Only - Matching Fourth Image) -->
        <div class="pd-gallery-container pd-mobile-gallery desktop-hidden">
          <div class="pd-main-stage">
            <span class="badge-lab-grown">Lab Grown</span>
            
            <img id="stageMainImg" src="@mainImage" alt="@Model.Name Main View" />
            <video id="stageVideo" src="/assets/videos/ring_360.mp4" autoplay loop muted playsinline poster="@mainImage" style="display:none;"></video>
            
            <button type="button" class="gallery-arrow arrow-left" onclick="slideGallery(-1)" title="Previous Image"><i class="fa-solid fa-chevron-left"></i></button>
            <button type="button" class="gallery-arrow arrow-right" onclick="slideGallery(1)" title="Next Image"><i class="fa-solid fa-chevron-right"></i></button>
          </div>

          <!-- 4-Thumbnail Row Directly Below Stage -->
          <div class="pd-thumbnails-row">
            @for (int i = 0; i < galleryList.Count; i++)
            {
              var isVid = (i == 1);
              <div class="pd-thumb-box @(i == 0 ? "active" : "")" onclick="selectGalleryIndex(@i, this)">
                <img src="@galleryList[i]" alt="Thumbnail @(i+1)" />
                @if (isVid)
                {
                  <span class="thumb-vid-badge"><i class="fa-solid fa-video"></i></span>
                }
              </div>
            }
          </div>
        </div>

        <!-- Desktop 2x2 Grid Showcase (Desktop Only - Classic Laptop View) -->
        <div class="pd-desktop-showcase mobile-hidden">
          <div class="pd-media-card">
            <span class="badge-lab-grown">Lab Grown</span>
            <img src="@mainImage" alt="@Model.Name Main View" />
          </div>
          <div class="pd-media-card">
            <span class="video-play-indicator"><i class="fa-solid fa-play"></i> 360° Video</span>
            <video src="/assets/videos/ring_360.mp4" autoplay loop muted playsinline poster="@mainImage"></video>
          </div>
          <div class="pd-media-card">
            <img src="@(galleryList.Count > 1 ? galleryList[1] : mainImage)" alt="@Model.Name View 2" />
          </div>
          <div class="pd-media-card">
            <img src="@(galleryList.Count > 2 ? galleryList[2] : mainImage)" alt="@Model.Name View 3" />
          </div>
        </div>
      </div>

      <!-- Right Column: Product Customizer Panel -->
      <div class="pd-customizer-panel">
        <h1 class="pd-title">@Model.Name</h1>

        <!-- Star Rating Row (Matching Fourth Image) -->
        <div class="pd-rating-sku-row">
          <div class="pd-rating-stars">
            <span class="star-icon">★</span>
            <span class="rating-val">5.0</span>
            <span class="rating-pipe">|</span>
            <span class="verify-check"><i class="fa-solid fa-circle-check"></i> (7 Reviews)</span>
          </div>
          <span class="pd-sku-tag">SKU: IVRFLR201</span>
        </div>

        <div class="pd-sub-spec">
          Lab Grown Diamond • Round Cut • E Color • 1.50 To 3.00 CT • VVS2 Clarity
        </div>

        <!-- Price Section -->
        <div class="pd-price-row-mobile">
          <div class="pd-price-primary">
            <span id="displayPriceUSD" class="pd-price-val">$ @Model.Price.ToString("N0") USD</span>
            <span id="displayPriceOrigUSD" class="pd-price-orig">$ @originalPriceUSD.ToString("N0")</span>
            <span class="pd-save-badge">Save 15%</span>
          </div>
        </div>

        <div class="pd-installments-box">
          From <strong id="displayMonthlyInstallment">$@((Model.Price / 4).ToString("F2"))/mo</strong> with <span style="color:var(--champagne-gold); font-weight:700;">ShopPay</span> <i class="fa-solid fa-circle-question" style="font-size:11px; opacity:0.6;"></i>
        </div>

        @if (metalList.Count > 0)
        {
          <!-- Metal Type Swatches (Loaded 100% Dynamically from Database Table) -->
          <div class="pd-opt-label">Metal Type: <span id="lblMetal" style="color:var(--champagne-gold);">@(metalList.FirstOrDefault()?.Name ?? "")</span></div>
          <div class="metal-swatch-list">
            @foreach (var metal in metalList)
            {
              var isDefault = metal == metalList.First();
              var bgStyle = metal.Name.Contains("Silver") ? "linear-gradient(135deg, #e2e8f0 0%, #94a3b8 100%)"
                          : metal.Name.Contains("Rose") ? "linear-gradient(135deg, #fbcfe8 0%, #f43f5e 100%)"
                          : metal.Name.Contains("White") ? "linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%)"
                          : metal.Name.Contains("Platinum") ? "linear-gradient(135deg, #e2e8f0 0%, #64748b 100%)"
                          : "linear-gradient(135deg, #fef08a 0%, #d97706 100%)";
              var abbr = metal.Name.Contains("Silver") ? "SL" : metal.Name.Contains("10K") ? "10K" : metal.Name.Contains("14K") ? "14K" : metal.Name.Contains("18K") ? "18K" : metal.Name.Contains("22K") ? "22K" : metal.Name.Contains("24K") ? "24K" : "PT";
              
              <button type="button" class="metal-swatch-btn @(isDefault ? "active" : "")" style="background: @bgStyle;" onclick="setMetal('@metal.Name', this)" title="@metal.Name">@abbr</button>
            }
          </div>
        }

        @if (caratList.Count > 0)
        {
          <!-- Diamond Size Selector (Loaded 100% Dynamically from Database Table) -->
          <div class="pd-opt-label">Select Diamond Size: <span id="lblCarat" style="color:var(--champagne-gold);">@(caratList.FirstOrDefault()?.Label ?? "")</span></div>
          <div class="carat-btn-list">
            @foreach (var carat in caratList)
            {
              var isDefault = carat == caratList.First();
              var displayLabel = carat.Label.Replace(" CT", "").Replace("ct GIA", "").Trim();
              <button type="button" class="carat-btn @(isDefault ? "active" : "")" onclick="setCarat('@carat.Label', this)">@displayLabel</button>
            }
          </div>
        }

        <!-- Free Engraving Box -->
        <div class="engraving-box">
          <div class="pd-opt-label">Enter Your Free Engraving</div>
          <input type="text" class="engraving-input" placeholder="Engrave Text (e.g. Forever & Always)" />
        </div>

        <!-- Ring Size US Dropdown -->
        <div class="size-select-row">
          <div class="pd-opt-label" style="margin:0;">Select Ring Size (US):</div>
          <a style="font-size:12px; color:var(--champagne-gold); text-decoration:underline; font-weight:700; cursor:pointer;">FIND RING SIZE</a>
        </div>
        <select class="size-dropdown">
          <option>US 5.0 (15.7mm)</option>
          <option selected>US 6.0 (16.5mm)</option>
          <option>US 7.0 (17.3mm)</option>
          <option>US 8.0 (18.2mm)</option>
        </select>

        <!-- Primary Action Buttons (Add to Cart & Buy It Now) -->
        <div class="pd-main-action-buttons">
          <button type="button" class="btn-add-cart-main" onclick="addToCartDetailed('@Model.Id', '@Model.Name', @Model.Price, '@mainImage')">
            <i class="fa-solid fa-bag-shopping" style="margin-right:8px;"></i> Add to Cart
          </button>
          <a href="/Product/Cart" class="btn-buy-now-main">
            <i class="fa-solid fa-bolt" style="margin-right:8px;"></i> Buy It Now
          </a>
        </div>

        <!-- Virtual Consultation Link (Screenshot 1) -->
        <div class="pd-consultation-link">
          Have questions? <a onclick="alert('Our AI Fine Jewelry Specialist is available 24/7! Click Chat icon.')">Book a virtual consultation</a>
        </div>

        <!-- Estimated Delivery Box (Screenshot 1) -->
        <div class="pd-est-delivery-card">
          <div class="est-left">
            <span class="est-title">When Ordered by 12pm PST, Today</span>
            <span class="est-sub">Estimated Ship Date:</span>
          </div>
          <div class="est-right">
            <span class="est-date">30 Aug</span>
          </div>
        </div>

        <!-- 4 Value Icons Vertical List (Screenshot 1) -->
        <div class="pd-value-list">
          <div class="value-item"><i class="fa-solid fa-globe"></i> Worldwide shipping</div>
          <div class="value-item"><i class="fa-solid fa-truck-fast"></i> Free and secure shipping</div>
          <div class="value-item"><i class="fa-solid fa-gem"></i> 100% diamond value guarantee</div>
          <div class="value-item"><i class="fa-solid fa-rotate-left"></i> 30-day return or exchange</div>
        </div>

        <!-- Drop a Hint Card (Screenshot 1) -->
        <div class="pd-hint-card">
          <div class="hint-header">
            <i class="fa-regular fa-envelope"></i>
            <span>Drop a Hint</span>
          </div>
          <div class="hint-sub">Love this Design? Share a Little Hint with a Loved One.</div>
          <button type="button" class="btn-hint-black" onclick="alert('Hint link copied to clipboard!')">DROP A HINT HERE</button>
        </div>

        <!-- Complimentary Gift Banner -->
        <div class="gift-card">
          <div>
            <div style="font-size:14px; font-weight:700; color:var(--champagne-gold);">Comes with a Complimentary Gift</div>
            <div style="font-size:12.5px; color:rgba(255,255,255,0.75);">Choose from Our Selected Gifts Like Pendants or Earrings, Beautifully Wrapped.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Product Specifications Accordions (Matching Screenshot 2) -->
    <div class="pd-accordions-group">
      <div class="acc-item">
        <div class="acc-header" onclick="toggleAcc(this)">
          <span>Overview</span>
          <i class="fa-solid fa-chevron-down acc-chevron"></i>
        </div>
        <div class="acc-body">
          This bespoke @Model.Name features precision GIA-certified craftsmanship, hand-set micro-pave lab grown diamonds, and a polished luxury finish.
        </div>
      </div>

      <div class="acc-item">
        <div class="acc-header" onclick="toggleAcc(this)">
          <span>Clarity & Color</span>
          <i class="fa-solid fa-chevron-down acc-chevron"></i>
        </div>
        <div class="acc-body">
          Diamond Color: E Color (Colorless) | Diamond Clarity: VVS2 Clarity (Very Very Slightly Included) | Cut: Super Ideal Cut.
        </div>
      </div>

      <div class="acc-item">
        <div class="acc-header" onclick="toggleAcc(this)">
          <span>Ring Diamonds Details</span>
          <i class="fa-solid fa-chevron-down acc-chevron"></i>
        </div>
        <div class="acc-body">
          Center Stone: 1.50 to 3.00 CT Lab Grown Diamond | Side Stones: Round Brilliant Cut Diamonds | Setting: Bezel Set with Hidden Halo.
        </div>
      </div>

      <div class="acc-item">
        <div class="acc-header" onclick="toggleAcc(this)">
          <span>Metal Details</span>
          <i class="fa-solid fa-chevron-down acc-chevron"></i>
        </div>
        <div class="acc-body">
          Available Solid Gold purities: 10K, 14K, 18K Yellow/Rose/White Gold, 925 Sterling Silver, and Platinum 950. Stamped with official hallmark authenticity.
        </div>
      </div>

      <div class="acc-item">
        <div class="acc-header" onclick="toggleAcc(this)">
          <span>Ring Size</span>
          <i class="fa-solid fa-chevron-down acc-chevron"></i>
        </div>
        <div class="acc-body">
          Standard US Sizes 5.0 to 9.0 available. Complimentary custom sizing upon request.
        </div>
      </div>

      <div class="acc-item">
        <div class="acc-header" onclick="toggleAcc(this)">
          <span>Jewelry Certification</span>
          <i class="fa-solid fa-chevron-down acc-chevron"></i>
        </div>
        <div class="acc-body">
          Includes official IGI / GIA Physical Certificate of Authenticity and 3D Laser Inscription verification code.
        </div>
      </div>

      <div class="acc-item">
        <div class="acc-header" onclick="toggleAcc(this)">
          <span>Shipping & Disclaimer</span>
          <i class="fa-solid fa-chevron-down acc-chevron"></i>
        </div>
        <div class="acc-body">
          Includes 100% Insured Express Shipping worldwide with discrete signature-required delivery. 30-Day Money-Back Guarantee.
        </div>
      </div>
    </div>

    <!-- "You Might Also Like" Section (2-Column Mobile Image 3 / 4-Column Laptop Image 4) -->
    <h2 class="sec-header">You Might Also Like</h2>
    <div class="you-might-like-grid">
      <!-- Item 1 -->
      <div class="rec-card-mob">
        <a href="/Product/Details?id=sat-prod-441" style="text-decoration:none;">
          <div class="rec-card-img-wrap">
            <img src="/assets/ivevar/exclusive_regal_star_diamond_ring.jpg" alt="Sunburst Round Cut" />
            <span class="rec-badge-sub">Lab Grown</span>
          </div>
        </a>
        <div class="rec-card-body">
          <a href="/Product/Details?id=sat-prod-441" style="text-decoration:none;">
            <div class="rec-card-title">Sunburst Round Cut Lab...</div>
          </a>
          <div class="rec-card-price">
            <span>$2,538</span>
            <span class="rec-card-orig">$2,995</span>
            <span class="rec-save-tag">Save 15%</span>
          </div>
          <div class="rec-rating-line">
            <span class="star-icon">★</span> 10 reviews
          </div>
        </div>
      </div>
      <!-- Item 2 -->
      <div class="rec-card-mob">
