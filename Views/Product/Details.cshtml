            </div>
            <input type="hidden" id="formRatingVal" value="5" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
            <div>
              <label style="display: block; font-size: 12px; font-weight: 700; color: #cbd5e1; margin-bottom: 6px;">Your Name</label>
              <input type="text" id="reviewAuthorName" required placeholder="e.g. Jessica S." style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #334155; background: #1e293b; color: #ffffff; font-size: 13px;" />
            </div>
            <div>
              <label style="display: block; font-size: 12px; font-weight: 700; color: #cbd5e1; margin-bottom: 6px;">Your Email</label>
              <input type="email" id="reviewAuthorEmail" required placeholder="name@domain.com" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #334155; background: #1e293b; color: #ffffff; font-size: 13px;" />
            </div>
          </div>

          <div style="margin-bottom: 14px;">
            <label style="display: block; font-size: 12px; font-weight: 700; color: #cbd5e1; margin-bottom: 6px;">Review Headline</label>
            <input type="text" id="reviewFormTitle" required placeholder="e.g. Absolutely stunning diamond brilliance!" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #334155; background: #1e293b; color: #ffffff; font-size: 13px;" />
          </div>

          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 12px; font-weight: 700; color: #cbd5e1; margin-bottom: 6px;">Detailed Feedback</label>
            <textarea id="reviewFormContent" required rows="4" placeholder="Share your experience with the craftsmanship, sparkle, certification, and packaging..." style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #334155; background: #1e293b; color: #ffffff; font-size: 13px;"></textarea>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 10px;">
            <button type="button" onclick="closeReviewModal()" style="background: #1e293b; color: #cbd5e1; border: 1px solid #334155; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer;">Cancel</button>
            <button type="submit" id="btnSubmitReview" style="background: linear-gradient(135deg, #d4b270 0%, #b45309 100%); color: #ffffff; border: none; padding: 10px 24px; border-radius: 8px; font-weight: 700; cursor: pointer;">Post Review</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Sticky Bottom Purchase Bar (Luxury Dark Theme) -->
  <div class="sticky-bottom-bar">
    <div class="sticky-thumb-title">
      <div class="sticky-title-text">@Model.Name</div>
      <div id="stickyDisplayPrice" class="sticky-price-text">$ @Model.Price.ToString("N0") USD</div>
    </div>
    <div class="sticky-btn-group">
      <button type="button" class="btn-sticky-cart" onclick="addToCartDetailed('@Model.Id', '@Model.Name', @Model.Price, '@mainImage')">Add To Cart</button>
      <a href="/Product/Cart" class="btn-sticky-buy" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">Buy It Now</a>
    </div>
  </div>

  <script>
    const galleryItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(galleryList));
    let currentGalleryIndex = 0;

    function updateGalleryStage() {
      const imgEl = document.getElementById('stageMainImg');
      const vidEl = document.getElementById('stageVideo');
      const thumbs = document.querySelectorAll('.pd-thumb-box');

      thumbs.forEach((t, idx) => {
        if (idx === currentGalleryIndex) t.classList.add('active');
        else t.classList.remove('active');
      });

      if (currentGalleryIndex === 1) {
        if (imgEl) imgEl.style.display = 'none';
        if (vidEl) vidEl.style.display = 'block';
      } else {
        if (vidEl) vidEl.style.display = 'none';
        if (imgEl) {
          imgEl.style.display = 'block';
          imgEl.src = galleryItems[currentGalleryIndex] || galleryItems[0];
        }
      }
    }

    function selectGalleryIndex(idx, el) {
      currentGalleryIndex = idx;
      updateGalleryStage();
    }

    function slideGallery(dir) {
      currentGalleryIndex = (currentGalleryIndex + dir + galleryItems.length) % galleryItems.length;
      updateGalleryStage();
    }

    const basePriceUSD = @Model.Price;
    let selectedMetal = '@(metalList.FirstOrDefault()?.Name ?? "18K Yellow Gold")';
    let selectedCarat = '@(caratList.FirstOrDefault()?.Label ?? "1.50 CT")';

    // Base Adjustments from Model
    let metalAdjustments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(metalList.ToDictionary(m => m.Name, m => m.Offset)));
    let caratAdjustments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(caratList.ToDictionary(c => c.Label, c => c.Offset)));

    // Fetch dynamic database-backed pricing rules asynchronously to react to real-time Admin changes
    fetch('/api/ProductApi/pricing-rules')
      .then(res => res.json())
      .then(data => {
        if (data && data.rules && data.rules.length > 0) {
          data.rules.forEach(r => {
            if (r.ruleType === 'Metal') {
              for (let k in metalAdjustments) {
                if (k.toLowerCase().includes(r.displayName.toLowerCase()) || r.displayName.toLowerCase().includes(k.toLowerCase())) {
                  metalAdjustments[k] = r.priceOffsetUSD;
                }
              }
            } else if (r.ruleType === 'Carat') {
              for (let k in caratAdjustments) {
                if (k.toLowerCase().includes(r.displayName.toLowerCase().replace(' ct','')) || r.displayName.toLowerCase().includes(k.toLowerCase())) {
                  caratAdjustments[k] = r.priceOffsetUSD;
                }
              }
            }
          });
          recalculateVariantPrice();
        }
      })
      .catch(_ => {});

    function recalculateVariantPrice() {
      const metalAdj = metalAdjustments[selectedMetal] || 0;
      const caratAdj = caratAdjustments[selectedCarat] || 0;

      const currentPriceUSD = Math.max(100, basePriceUSD + metalAdj + caratAdj);
      const originalPriceUSD = Math.floor(currentPriceUSD * 1.15);
      const monthlyInstallment = (currentPriceUSD / 11.08).toFixed(2);

      // Update UI Elements dynamically
      const mainUsdEl = document.getElementById('displayPriceUSD');
      const origUsdEl = document.getElementById('displayPriceOrigUSD');
      const monthlyEl = document.getElementById('displayMonthlyInstallment');
      const stickyPriceEl = document.getElementById('stickyDisplayPrice');
      const btnAddToCart = document.getElementById('btnAddToCartMain');

      if (mainUsdEl) mainUsdEl.textContent = `$ ${currentPriceUSD.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} USD`;
      if (origUsdEl) origUsdEl.textContent = `$ ${originalPriceUSD.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
      if (monthlyEl) monthlyEl.innerHTML = `$${monthlyInstallment}/mo</strong> with <span style="color:var(--champagne-gold); font-weight:700;">ShopPay</span> <i class="fa-solid fa-circle-question" style="font-size:11px; opacity:0.6;"></i>`;
      if (stickyPriceEl) stickyPriceEl.textContent = `$ ${currentPriceUSD.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} USD`;
      if (btnAddToCart) {
        btnAddToCart.innerHTML = `<i class="fa-solid fa-bag-shopping" style="margin-right:8px;"></i> ADD TO CART • $${currentPriceUSD.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
      }

      window.activeVariantPriceUSD = currentPriceUSD;
    }

    // ==========================================
    // REVIEWS SYSTEM JAVASCRIPT
    // ==========================================
    function loadProductReviews() {
      fetch('/api/ProductApi/@Model.Id/reviews')
        .then(res => res.json())
        .then(res => {
          if (res.success && res.data) {
            const data = res.data;
            document.getElementById('reviewAvgScore').innerText = data.averageRating.toFixed(1);
            document.getElementById('reviewTotalCount').innerText = 'Based on ' + data.totalReviews + ' reviews';

            const feed = document.getElementById('reviewsFeedList');
            if (data.reviews && data.reviews.length > 0) {
              let html = '';
              data.reviews.forEach(r => {
                let stars = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
                html += `
                  <div style="background:#0f172a; border:1px solid #1e293b; border-radius:16px; padding:24px; color:#ffffff;">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
                      <div>
                        <div style="color:#f59e0b; font-size:16px; margin-bottom:4px;">${stars}</div>
                        <h4 style="font-size:15px; font-weight:800; margin:0; color:#ffffff;">${r.reviewTitle}</h4>
                      </div>
                      ${r.isVerifiedBuyer ? '<span style="font-size:11px; background:rgba(212,178,112,0.15); color:#d4b270; padding:3px 8px; border-radius:6px; font-weight:700;">Verified Buyer</span>' : ''}
                    </div>
                    <p style="font-size:13px; color:#cbd5e1; line-height:1.5; margin:0 0 14px;">"${r.reviewText}"</p>
                    <div style="font-size:12px; color:#64748b;">— <strong style="color:#94a3b8;">${r.customerName}</strong> • ${new Date(r.createdAt).toLocaleDateString()}</div>
                  </div>
                `;
              });
              feed.innerHTML = html;
            }
          }
        })
        .catch(_ => {});
    }

    loadProductReviews();

    function openReviewModal() {
      document.getElementById('writeReviewModal').style.display = 'flex';
    }

    function closeReviewModal() {
      document.getElementById('writeReviewModal').style.display = 'none';
    }

    function setRatingValue(val) {
      document.getElementById('formRatingVal').value = val;
      const spans = document.querySelectorAll('#starPickerGroup span');
      spans.forEach((s, idx) => {
        s.style.color = idx < val ? '#f59e0b' : '#334155';
      });
    }

    function handleReviewSubmit(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSubmitReview');
      btn.disabled = true;
      btn.innerText = 'Submitting...';

      const payload = {
        productName: '@Model.Name',
        customerName: document.getElementById('reviewAuthorName').value.trim(),
        customerEmail: document.getElementById('reviewAuthorEmail').value.trim(),
        rating: parseInt(document.getElementById('formRatingVal').value) || 5,
        reviewTitle: document.getElementById('reviewFormTitle').value.trim(),
        reviewText: document.getElementById('reviewFormContent').value.trim()
      };

      fetch('/api/ProductApi/@Model.Id/reviews', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(res => res.json())
      .then(data => {
        btn.disabled = false;
        btn.innerText = 'Post Review';
        if (data.success) {
          alert('✨ Thank you! Your review has been recorded.');
          closeReviewModal();
          loadProductReviews();
        } else {
          alert(data.message);
        }
      })
      .catch(err => {
        btn.disabled = false;
        btn.innerText = 'Post Review';
        alert('Network error submitting review.');
      });
    }

    window.addEventListener('scroll', function() {
      const stickyBar = document.querySelector('.sticky-bottom-bar');
      if (stickyBar) {
        if (window.scrollY > 450) {
          stickyBar.classList.add('visible');
        } else {
          stickyBar.classList.remove('visible');
        }
      }
    });

    function setMetal(val, btn) {
      selectedMetal = val;
      document.getElementById('lblMetal').textContent = val;
      document.querySelectorAll('.metal-swatch-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      recalculateVariantPrice();
    }

    function setCarat(val, btn) {
      selectedCarat = val;
      document.getElementById('lblCarat').textContent = val;
      document.querySelectorAll('.carat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      recalculateVariantPrice();
    }

    function toggleFaq(el) {
      const ans = el.nextElementSibling;
      const icon = el.querySelector('i');
      if (ans.style.display === 'block') {
        ans.style.display = 'none';
        icon.className = 'fa-solid fa-plus';
      } else {
        ans.style.display = 'block';
        icon.className = 'fa-solid fa-minus';
      }
    }

    function toggleAcc(headerEl) {
      const parent = headerEl.parentElement;
      if (parent) {
        parent.classList.toggle('open');
      }
    }

    const isUserAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

    function addToCartDetailed(id, baseName, priceUSD, img) {
      try {
        const finalPrice = window.activeVariantPriceUSD || priceUSD || basePriceUSD;
        const engravingInput = document.querySelector('.engraving-input');
        const engravingText = engravingInput ? engravingInput.value.trim() : '';
        const sizeSelect = document.querySelector('.size-dropdown');
        const ringSize = sizeSelect ? sizeSelect.value.trim() : 'US 6.0';

        let variantName = `${baseName} (${selectedMetal}, ${selectedCarat}`;
        if (engravingText) variantName += `, Engrave: "${engravingText}"`;
        if (ringSize) variantName += `, Size: ${ringSize}`;
        variantName += ')';

        const saved = localStorage.getItem('sat_shopping_cart_usd');
        let items = saved ? JSON.parse(saved) : [];
        items.push({ 
          id, 
          name: variantName, 
          priceUSD: finalPrice, 
          metal: selectedMetal,
          carat: selectedCarat,
          engraving: engravingText,
          size: ringSize,
          img: img || '/assets/ivevar/exclusive_regal_star_diamond_ring.jpg', 
          quantity: 1 
        });
        localStorage.setItem('sat_shopping_cart_usd', JSON.stringify(items));
        
        if (!isUserAuthenticated) {
          alert('🔒 Please sign in to your account first before completing payment.');
          window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        } else {
          window.location.href = '/Product/Cart';
        }
      } catch (e) {
        console.error(e);
      }
    }

    async function toggleWishlistProduct(id, name, price, img) {
      try {
        const res = await fetch('/api/WishlistApi/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ catalogItemId: id, productName: name, priceUSD: price, imageUrl: img })
        });

        if (res.status === 401) {
          if (confirm('Please sign in to save items to your Wishlist. Would you like to sign in now?')) {
            window.location.href = `/Account/SignIn?returnUrl=${encodeURIComponent(window.location.pathname)}`;
          }
          return;
        }

        const data = await res.json();
        if (data.success) {
          const heart = document.getElementById('wishlistHeartIcon');
          const btn = document.getElementById('btnWishlistToggle');
          if (data.isSaved) {
            if (heart) { heart.className = 'fa-solid fa-heart'; heart.style.color = '#e11d48'; }
            if (btn) btn.classList.add('saved');
            alert('Saved to your Wishlist!');
          } else {
            if (heart) { heart.className = 'fa-regular fa-heart'; heart.style.color = ''; }
            if (btn) btn.classList.remove('saved');
            alert('Removed from your Wishlist.');
          }
        }
      } catch (e) {
        alert('Could not update Wishlist.');
      }
    }

    (async function checkWishlistStatus() {
      try {
        const res = await fetch('/api/WishlistApi/my-wishlist');
        const data = await res.json();
        if (data.success && data.isAuthenticated && data.items) {
          const isSaved = data.items.some(i => i.catalogItemId === '@Model.Id');
          if (isSaved) {
            const heart = document.getElementById('wishlistHeartIcon');
            const btn = document.getElementById('btnWishlistToggle');
            if (heart) { heart.className = 'fa-solid fa-heart'; heart.style.color = '#e11d48'; }
            if (btn) btn.classList.add('saved');
          }
        }
      } catch (_) {}
    })();
  </script>

  <style>
    .btn-wishlist-toggle-main {
      width: 48px;
      height: 48px;
      border-radius: 8px;
      border: 1.5px solid #e2e8f0;
      background: #ffffff;
      color: #64748b;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }
    .btn-wishlist-toggle-main:hover, .btn-wishlist-toggle-main.saved {
      border-color: #f43f5e;
      background: #fff1f2;
      color: #e11d48;
    }
  </style>

  <!-- SAT Jewel Footer -->
  <partial name="_Footer" />
</body>
</html>
