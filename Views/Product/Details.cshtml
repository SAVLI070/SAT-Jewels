@model SAT1.Models.CatalogItem
@{
    ViewData["Title"] = Model.Name + " — SAT Jewel Sanctuary";
    Layout = null;
    var related = ViewBag.RelatedItems as List<SAT1.Models.CatalogItem> ?? new List<SAT1.Models.CatalogItem>();
    var categoryName = ViewBag.CategoryName as string ?? "Engagement Rings";

    string FixImg(string? path) {
        if (string.IsNullOrWhiteSpace(path)) return "/assets/ivevar/exclusive_regal_star_diamond_ring.jpg";
        if (path.StartsWith("http://") || path.StartsWith("https://")) return path;
        if (path.StartsWith("~/")) return path.Substring(1);
        if (!path.StartsWith("/")) return "/" + path;
        return path;
    }

    var mainImage = FixImg(Model.ImageUrl);

    List<string> galleryList = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.GalleryImages))
    {
        galleryList = Model.GalleryImages.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => FixImg(s.Trim()))
            .ToList();
    }

    if (galleryList.Count == 0)
    {
        galleryList = new List<string> {
            mainImage,
            "/assets/ivevar/ivevar-luxury-rings-925-silver-0-80-ct-sparkling-antique-shape-moissanite-silhouette-diamond-ring-vintage-fine-jewelry-44619076403505_c18db5d1-09b7-41c4-8fd4-f72a5a00aa4a.png",
            "/assets/ivevar/ivevar-luxury-rings-925-silver-2-1-75-ct-sparkling-fancy-vivid-green-emerald-cut-moissanite-diamond-engagement-ring-44619311841585_7c5c472f-38eb-4a1b-89ee-25caa5a69c22.png",
            "/assets/ivevar/modern_wedding_ring_band_be1024e1-bb04-457c-83d2-7acda4fc55b4.png"
        };
    }

    var priceINR = (int)(Model.PriceUSD * 83);
    var originalPriceUSD = (int)(Model.PriceUSD * 1.15m);
    var originalPriceINR = (int)(priceINR * 1.15m);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@Model.Name — SAT Jewel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/style.css" />
  <style>
    body {
      background: #050b14;
      color: #ffffff;
      font-family: var(--font-sans);
      margin: 0;
      padding: 0 0 80px;
      min-height: 100vh;
    }
    .pd-container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 30px 24px;
    }
    .pd-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.65);
      margin-bottom: 24px;
    }
    .pd-breadcrumb a {
      color: var(--champagne-gold);
      text-decoration: none;
    }

    /* Main 2-Column Product Section */
    .pd-main-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 48px;
      margin-bottom: 70px;
    }
    @@media (max-width: 960px) {
      .pd-main-grid { grid-template-columns: 1fr; gap: 32px; }
    }

    /* Media 2x2 Grid Column */
    .pd-media-2x2-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .pd-media-card {
      position: relative;
      background: #08111e;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 100%; /* 1:1 Aspect ratio */
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      transition: border-color 0.3s ease;
    }
    .pd-media-card:hover {
      border-color: var(--champagne-gold);
    }
    .pd-media-card img, .pd-media-card video {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover;
    }
    .badge-lab-grown {
      position: absolute;
      top: 12px;
      left: 12px;
      background: rgba(0, 0, 0, 0.75);
      color: #ffffff;
      border: 1px solid rgba(255,255,255,0.3);
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 4px;
      z-index: 5;
    }
    .video-play-indicator {
      position: absolute;
      bottom: 12px;
      left: 12px;
      background: rgba(13, 27, 42, 0.85);
      color: var(--champagne-gold);
      border: 1px solid var(--champagne-gold);
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      gap: 6px;
      z-index: 5;
    }

    /* Right Customizer Panel */
    .pd-customizer-panel {
      display: flex;
      flex-direction: column;
    }
    .pd-title {
      font-family: var(--font-serif);
      font-size: 30px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 10px;
      line-height: 1.3;
    }
    .pd-sub-spec {
      font-size: 13.5px;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 20px;
    }
    .pd-price-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }
    .pd-price-inr {
      font-size: 28px;
      font-weight: 800;
      color: #fbbf24;
    }
    .pd-price-orig {
      font-size: 16px;
      text-decoration: line-through;
      color: rgba(255, 255, 255, 0.45);
    }
    .pd-save-badge {
      background: #15803d;
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .pd-sku {
      margin-left: auto;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.5);
    }
    .pd-installments-box {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: 24px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .pd-installments-box a {
      color: var(--champagne-gold);
      text-decoration: underline;
      cursor: pointer;
    }

    /* Option Selectors */
    .pd-opt-label {
      font-size: 13.5px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 10px;
    }
    /* Circular Metal Swatches */
    .metal-swatch-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 22px;
    }
    .metal-swatch-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, 0.3);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 800;
      color: #000000;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0,0,0,0.5);
    }
    .metal-swatch-btn.active, .metal-swatch-btn:hover {
      border-color: var(--champagne-gold);
      transform: scale(1.15);
      box-shadow: 0 0 12px rgba(212, 178, 112, 0.6);
    }

    /* Carat Buttons */
    .carat-btn-list {
      display: flex;
      gap: 10px;
      margin-bottom: 22px;
    }
    .carat-btn {
      padding: 10px 20px;
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 6px;
      color: #ffffff;
      font-size: 13.5px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .carat-btn.active, .carat-btn:hover {
      background: var(--champagne-gold);
      color: #060c14;
      border-color: var(--champagne-gold);
    }

    /* Free Engraving Box */
    .engraving-box {
      margin-bottom: 22px;
    }
    .engraving-input {
      width: 100%;
      padding: 12px 16px;
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 8px;
      color: #ffffff;
      font-size: 14px;
      outline: none;
      box-sizing: border-box;
    }
    .engraving-input:focus {
      border-color: var(--champagne-gold);
    }

    /* Ring Size Dropdown */
    .size-select-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    .size-dropdown {
      width: 100%;
      padding: 12px 16px;
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 8px;
      color: #ffffff;
      font-size: 14px;
      outline: none;
      margin-bottom: 24px;
      cursor: pointer;
    }

    /* Action Button */
    .btn-add-cart-main {
      width: 100%;
      padding: 16px;
      background: var(--champagne-gold);
      color: #060c14;
      border: none;
      border-radius: 8px;
      font-weight: 800;
      font-size: 15px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-bottom: 20px;
    }
    .btn-add-cart-main:hover {
      background: #ffffff;
      color: #000000;
      box-shadow: 0 6px 25px rgba(212, 178, 112, 0.5);
    }

    /* Delivery Estimate Box */
    .delivery-est-box {
      background: rgba(212, 178, 112, 0.08);
      border: 1px solid rgba(212, 178, 112, 0.25);
      border-radius: 10px;
      padding: 16px 20px;
      font-size: 13.5px;
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* 4 Value Badges Row */
    .value-icons-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 24px;
      padding-bottom: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .value-icons-grid div {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .value-icons-grid i {
      color: var(--champagne-gold);
      font-size: 16px;
    }

    /* Drop a Hint Card */
    .hint-card {
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 10px;
      padding: 18px 20px;
      margin-bottom: 20px;
    }
    .btn-hint {
      margin-top: 10px;
      padding: 10px 18px;
      background: #ffffff;
      color: #000000;
      border: none;
      border-radius: 6px;
      font-weight: 800;
      font-size: 12px;
      letter-spacing: 0.5px;
      cursor: pointer;
    }

    /* Complimentary Gift Card */
    .gift-card {
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.3);
      border-radius: 10px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 50px;
    }
    .gift-card img {
      width: 50px;
      height: 50px;
      object-fit: cover;
      border-radius: 8px;
    }

    /* Section Headers */
    .sec-header {
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 700;
      text-align: center;
      color: #ffffff;
      margin: 60px 0 32px;
    }

    /* FAQ Tabs & Accordions (Screenshot 4) */
    .faq-tabs {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 30px;
    }
    .faq-tab-btn {
      padding: 10px 18px;
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 4px;
    }
    .faq-tab-btn.active, .faq-tab-btn:hover {
      background: var(--champagne-gold);
      color: #060c14;
      border-color: var(--champagne-gold);
    }
    .faq-item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      padding: 18px 0;
    }
    .faq-question {
      font-size: 16px;
      font-weight: 600;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
    }
    .faq-answer {
      display: none;
      margin-top: 12px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.6;
    }

    /* Testimonials (Screenshot 5) */
    .testi-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 80px;
    }
    @@media (max-width: 900px) {
      .testi-grid { grid-template-columns: 1fr; }
    }
    .testi-card {
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 14px;
      padding: 24px;
      text-align: center;
    }
    .testi-stars {
      color: #fbbf24;
      font-size: 14px;
      margin-bottom: 12px;
    }
    .testi-title {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 10px;
    }
    .testi-quote {
      font-size: 13.5px;
      color: rgba(255, 255, 255, 0.75);
      line-height: 1.5;
      margin-bottom: 16px;
    }
    .testi-author {
      font-size: 13px;
      font-weight: 700;
      color: var(--champagne-gold);
    }

    /* Sticky Bottom Bar (Hidden by default, reveals after scrolling past 450px) */
    .sticky-bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: #08111e;
      border-top: 1px solid rgba(212, 178, 112, 0.3);
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 1000;
      box-shadow: 0 -8px 25px rgba(0,0,0,0.7);
      box-sizing: border-box;
      transform: translateY(100%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }
    .sticky-bottom-bar.visible {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .sticky-thumb-title {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .sticky-thumb-title img {
      width: 42px;
      height: 42px;
      border-radius: 6px;
      object-fit: cover;
    }
    .sticky-btn-group {
      display: flex;
      gap: 12px;
    }
    .btn-sticky-cart {
      padding: 10px 24px;
      background: var(--champagne-gold);
      color: #060c14;
      border: none;
      border-radius: 6px;
      font-weight: 800;
      font-size: 13px;
      cursor: pointer;
    }
    .btn-sticky-buy {
      padding: 10px 24px;
      background: #ffffff;
      color: #000000;
      border: none;
      border-radius: 6px;
      font-weight: 800;
      font-size: 13px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <!-- Header Navbar -->
  <nav class="navbar" style="position:relative; background:#08111e; border-bottom:1px solid rgba(212,178,112,0.3);">
    <div class="container nav-inner" style="padding:14px 20px;">
      <a href="/" style="display:flex; align-items:center; gap:10px; text-decoration:none; color:#ffffff;">
        <img src="~/assets/sat_emblem_clean.png" style="height:32px;" alt="SAT Emblem" />
        <span style="font-family:var(--font-serif); font-size:20px; font-weight:700;">SAT <span style="color:var(--champagne-gold);">Jewel</span></span>
      </a>
      <div style="margin-left:auto;">
        <partial name="_AuthNav" />
      </div>
    </div>
  </nav>

  <div class="pd-container">
    <!-- Breadcrumb Navigation -->
    <div class="pd-breadcrumb">
      <a href="/">Home</a> <span>/</span>
      <a href="/Product">Collections</a> <span>/</span>
      <a href="/Product/Category?name=@categoryName">@categoryName</a> <span>/</span>
      <span style="color:#ffffff; font-weight:600;">@Model.Name</span>
    </div>

    <!-- Main Product Section (Screenshots 1 & 2) -->
    <div class="pd-main-grid">
      <!-- Left Column: 2x2 Media Showcase with Image & 360 Video Loop -->
      <div class="pd-media-2x2-grid">
        <!-- Cell 1: High-res Main Image -->
        <div class="pd-media-card">
          <span class="badge-lab-grown">Lab Grown</span>
          <img src="@mainImage" alt="@Model.Name Main View" />
        </div>
        <!-- Cell 2: 360 Video Player -->
        <div class="pd-media-card">
          <span class="video-play-indicator"><i class="fa-solid fa-play"></i> 360° Video</span>
          <video src="/assets/videos/ring_360.mp4" autoplay loop muted playsinline poster="@mainImage"></video>
        </div>
        <!-- Cell 3: Angle View Image -->
        <div class="pd-media-card">
          <img src="/assets/ivevar/ivevar-luxury-rings-925-silver-0-80-ct-sparkling-antique-shape-moissanite-silhouette-diamond-ring-vintage-fine-jewelry-44619076403505_c18db5d1-09b7-41c4-8fd4-f72a5a00aa4a.png" alt="@Model.Name Angle" />
        </div>
        <!-- Cell 4: Top Profile Image -->
        <div class="pd-media-card">
          <img src="/assets/ivevar/ivevar-luxury-rings-925-silver-2-1-75-ct-sparkling-fancy-vivid-green-emerald-cut-moissanite-diamond-engagement-ring-44619311841585_7c5c472f-38eb-4a1b-89ee-25caa5a69c22.png" alt="@Model.Name Profile" />
        </div>
      </div>

      <!-- Right Column: Product Customizer Panel -->
      <div class="pd-customizer-panel">
        <h1 class="pd-title">@Model.Name</h1>
        <div class="pd-sub-spec">
          Lab Grown Diamond • Asscher Cut • E Color • 1.50 To 3.00 CT • VVS2 Clarity
        </div>

        <div class="pd-price-row">
          <span class="pd-price-inr">₹ @priceINR.ToString("N0")</span>
          <span class="pd-price-orig">₹ @originalPriceINR.ToString("N0")</span>
          <span class="pd-save-badge">Save 15%</span>
          <span class="pd-sku">SKU: IVRFLR1123</span>
        </div>
        <div class="pd-installments-box">
          4 interest-free installments, or from <strong>$80.96/mo</strong> with ShopPay. <a>View sample plans</a>
        </div>

        <!-- Metal Type Swatches -->
        <div class="pd-opt-label">Metal Type: <span id="lblMetal" style="color:var(--champagne-gold);">18K Yellow Gold</span></div>
        <div class="metal-swatch-list">
          <button type="button" class="metal-swatch-btn" style="background: linear-gradient(135deg, #e2e8f0 0%, #94a3b8 100%);" onclick="setMetal('925 Silver', this)">SL</button>
          <button type="button" class="metal-swatch-btn" style="background: linear-gradient(135deg, #fef08a 0%, #eab308 100%);" onclick="setMetal('10K Yellow Gold', this)">10K</button>
          <button type="button" class="metal-swatch-btn" style="background: linear-gradient(135deg, #fbcfe8 0%, #f43f5e 100%);" onclick="setMetal('10K Rose Gold', this)">10K</button>
          <button type="button" class="metal-swatch-btn" style="background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%);" onclick="setMetal('10K White Gold', this)">10K</button>
          <button type="button" class="metal-swatch-btn" style="background: linear-gradient(135deg, #fde047 0%, #ca8a04 100%);" onclick="setMetal('14K Yellow Gold', this)">14K</button>
          <button type="button" class="metal-swatch-btn" style="background: linear-gradient(135deg, #ffffff 0%, #94a3b8 100%);" onclick="setMetal('14K White Gold', this)">14K</button>
          <button type="button" class="metal-swatch-btn active" style="background: linear-gradient(135deg, #fef08a 0%, #d97706 100%);" onclick="setMetal('18K Yellow Gold', this)">18K</button>
          <button type="button" class="metal-swatch-btn" style="background: linear-gradient(135deg, #f43f5e 0%, #fda4af 100%);" onclick="setMetal('18K Rose Gold', this)">18K</button>
        </div>

        <!-- Diamond Size Selector -->
        <div class="pd-opt-label">Select Diamond Size: <span id="lblCarat" style="color:var(--champagne-gold);">1.50 CT</span></div>
        <div class="carat-btn-list">
          <button type="button" class="carat-btn active" onclick="setCarat('1.50 CT', this)">1.50</button>
          <button type="button" class="carat-btn" onclick="setCarat('2.00 CT', this)">2.00</button>
          <button type="button" class="carat-btn" onclick="setCarat('2.50 CT', this)">2.50</button>
          <button type="button" class="carat-btn" onclick="setCarat('3.00 CT', this)">3.00</button>
        </div>

        <!-- Free Engraving Box -->
        <div class="engraving-box">
          <div class="pd-opt-label">Enter Your Free Engraving</div>
          <input type="text" class="engraving-input" placeholder="Engrave Text (e.g. Forever & Always)" />
        </div>

        <!-- Ring Size US Dropdown -->
        <div class="size-select-row">
          <div class="pd-opt-label" style="margin:0;">Select Ring Size (US):</div>
          <a style="font-size:12px; color:var(--champagne-gold); text-decoration:underline; font-weight:700; cursor:pointer;">FIND RING SIZE</a>
        </div>
        <select class="size-dropdown">
          <option>US 5.0 (15.7mm)</option>
          <option selected>US 6.0 (16.5mm)</option>
          <option>US 7.0 (17.3mm)</option>
          <option>US 8.0 (18.2mm)</option>
        </select>

        <!-- Primary Add to Cart Button -->
        <button type="button" class="btn-add-cart-main" onclick="addToCartDetailed('@Model.Id', '@Model.Name', @Model.PriceUSD, '@mainImage')">
          <i class="fa-solid fa-bag-shopping" style="margin-right:8px;"></i> Add to Cart
        </button>

        <!-- Estimated Delivery Box -->
        <div class="delivery-est-box">
          <div><i class="fa-regular fa-clock" style="color:var(--champagne-gold); margin-right:6px;"></i> <strong>Ordered by 12pm PST Today</strong></div>
          <div style="color:var(--champagne-gold);">Estimated Ship Date: <strong>27 Aug</strong></div>
        </div>

        <!-- 4 Value Icons Grid -->
        <div class="value-icons-grid">
          <div><i class="fa-solid fa-globe"></i> Worldwide shipping</div>
