@model SAT1.Models.CatalogItem
@{
    ViewData["Title"] = Model.Name + " — SAT Jewel Sanctuary";
    Layout = null;
    var related = ViewBag.RelatedItems as List<SAT1.Models.CatalogItem> ?? new List<SAT1.Models.CatalogItem>();
    var categoryName = ViewBag.CategoryName as string ?? "Engagement Rings";
    var photoReviews = ViewBag.PhotoReviews as List<SAT1.BAL.CustomerPhotoReviewDto> ?? new List<SAT1.BAL.CustomerPhotoReviewDto>();

    string FixImg(string? path) {
        if (string.IsNullOrWhiteSpace(path)) return "/assets/ivevar/exclusive_regal_star_diamond_ring.jpg";
        if (path.StartsWith("http://") || path.StartsWith("https://")) return path;
        if (path.StartsWith("~/")) return path.Substring(1);
        if (!path.StartsWith("/")) return "/" + path;
        return path;
    }

    var mainImage = FixImg(Model.ImageUrl);

    List<string> galleryList = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.GalleryImages))
    {
        galleryList = Model.GalleryImages.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => FixImg(s.Trim()))
            .ToList();
    }

    // Enrich gallery to 4 angle shots matching Earthly Jewels layout
    List<string> fallbackAngles = new List<string> {
        mainImage,
        "/assets/ivevar/ivevar-luxury-rings-925-silver-0-80-ct-sparkling-antique-shape-moissanite-silhouette-diamond-ring-vintage-fine-jewelry-44619076403505_c18db5d1-09b7-41c4-8fd4-f72a5a00aa4a.png",
        "/assets/ivevar/ivevar-luxury-rings-925-silver-2-1-75-ct-sparkling-fancy-vivid-green-emerald-cut-moissanite-diamond-engagement-ring-44619311841585_7c5c472f-38eb-4a1b-89ee-25caa5a69c22.png",
        "/assets/ivevar/modern_wedding_ring_band_be1024e1-bb04-457c-83d2-7acda4fc55b4.png"
    };

    if (galleryList.Count == 0)
    {
        galleryList = fallbackAngles;
    }
    else if (galleryList.Count < 4)
    {
        foreach (var fa in fallbackAngles)
        {
            if (!galleryList.Contains(fa)) galleryList.Add(fa);
            if (galleryList.Count >= 4) break;
        }
    }

    galleryList = galleryList.Take(4).ToList();

    var originalPriceUSD = (int)(Model.Price * 1.15m);

    // Parse Metal Options
    var rawMetalStr = Model.MetalOptions ?? string.Empty;
    var metalList = rawMetalStr.Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(opt => {
            var parts = opt.Trim().Split(new[] { " (" }, StringSplitOptions.RemoveEmptyEntries);
            var name = parts[0].Trim();
            var offset = 0m;
            if (parts.Length > 1) {
                var numStr = parts[1].Replace(")", "").Replace("+", "").Replace("USD", "").Trim();
                decimal.TryParse(numStr, out offset);
            }
            return new { Name = name, Offset = offset };
        })
        .GroupBy(x => x.Name)
        .Select(g => g.First())
        .ToList();

    if (metalList.Count == 0)
    {
        metalList = new[] {
            new { Name = "14K Yellow Gold", Offset = 180m },
            new { Name = "14K White Gold", Offset = 180m },
            new { Name = "14K Rose Gold", Offset = 180m },
            new { Name = "18K Yellow Gold", Offset = 480m },
            new { Name = "18K White Gold", Offset = 480m },
            new { Name = "18K Rose Gold", Offset = 480m },
            new { Name = "950 Platinum", Offset = 850m }
        }.ToList();
    }

    // Parse Carat Options
    var rawCaratStr = Model.CaratOptions ?? string.Empty;
    var caratList = rawCaratStr.Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(opt => {
            var parts = opt.Trim().Split(new[] { " (" }, StringSplitOptions.RemoveEmptyEntries);
            var label = parts[0].Trim();
            var offset = 0m;
            if (parts.Length > 1) {
                var numStr = parts[1].Replace(")", "").Replace("+", "").Replace("USD", "").Trim();
                decimal.TryParse(numStr, out offset);
            }
            return new { Label = label, Offset = offset };
        })
        .GroupBy(x => x.Label)
        .Select(g => g.First())
        .ToList();

    if (caratList.Count == 0)
    {
        caratList = new[] {
            new { Label = "1.00 CT", Offset = 0m },
            new { Label = "1.50 CT", Offset = 450m },
            new { Label = "2.00 CT", Offset = 1100m },
            new { Label = "3.00 CT", Offset = 2600m }
        }.ToList();
    }

    var prodCanonical = $"{Context.Request.Scheme}://{Context.Request.Host}/Product/Details/{Model.Id}";
    var absoluteImg = mainImage.StartsWith("http") ? mainImage : $"{Context.Request.Scheme}://{Context.Request.Host}{mainImage}";
    var galleryAbsolute = galleryList.Select(g => g.StartsWith("http") ? g : $"{Context.Request.Scheme}://{Context.Request.Host}{g}").ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@Model.Name — Buy Online in USA | SAT Jewel</title>
  <meta name="title" content="@Model.Name — Buy Online in USA | SAT Jewel" />
  <meta name="description" content="Shop @Model.Name at factory-direct value. 100% GIA/IGI certified lab-grown diamonds, customizable in 10K/14K/18K gold & 950 platinum with free worldwide insured delivery." />
  <meta name="keywords" content="@Model.Name, @categoryName, Lab Grown Solitaire, Certified Diamond Ring, Custom Jewelry, SAT Jewel" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <link rel="canonical" href="@prodCanonical" />

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="product" />
  <meta property="og:url" content="@prodCanonical" />
  <meta property="og:title" content="@Model.Name — SAT Jewel" />
  <meta property="og:description" content="Shop @Model.Name. 100% certified lab-grown diamonds and moissanite solitaires with free insured shipping." />
  <meta property="og:image" content="@absoluteImg" />
  <meta property="og:site_name" content="SAT Jewel" />
  <meta property="product:price:amount" content="@Model.Price" />
  <meta property="product:price:currency" content="USD" />
  <meta property="product:availability" content="in stock" />

  <!-- Google Rich Results Product + Offer Schema -->
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org/",
    "@@type": "Product",
    "name": "@Model.Name",
    "image": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(galleryAbsolute)),
    "description": "Bespoke fine jewelry piece hand-crafted with conflict-free certified lab diamonds.",
    "sku": "SAT-@Model.Id",
    "brand": {
      "@@type": "Brand",
      "name": "SAT Jewel"
    },
    "offers": {
      "@@type": "Offer",
      "url": "@prodCanonical",
      "priceCurrency": "USD",
      "price": "@Model.Price",
      "priceValidUntil": "@DateTime.UtcNow.AddYears(1).ToString("yyyy-MM-dd")",
      "availability": "https://schema.org/InStock",
      "itemCondition": "https://schema.org/NewCondition"
    }
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/style.css" />

  <style>
    *, *:before, *:after { box-sizing: border-box; }
    html, body {
      width: 100%;
      max-width: 100vw;
      margin: 0;
      padding: 0;
      background: #050b14;
      color: #ffffff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
    }

    .pd-container {
      width: 100%;
      max-width: 1400px;
      margin: 0 auto;
      padding: 20px 24px;
      position: relative;
    }

    /* Announcement Header */
    .sat-announcement-bar {
      width: 100%;
      background: #000000;
      color: #d4b270;
      text-align: center;
      padding: 8px 14px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.6px;
      border-bottom: 1px solid rgba(212, 178, 112, 0.2);
    }

    /* Navbar */
    .sat-nav-header {
      background: #08111e;
      border-bottom: 1px solid rgba(212, 178, 112, 0.25);
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(12px);
    }
    .sat-nav-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 20px;
      font-weight: 700;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: 0.8px;
    }
    .gold-text { color: #d4b270; }

    /* =========================================================
       EARTHLY JEWELS 3-COLUMN SPLIT PRODUCT LAYOUT
       (EXACT 3-STAGE STICKY BEHAVIOR)
       ========================================================= */
    .pd-split-layout {
      display: grid;
      grid-template-columns: 480px 240px 1fr;
      gap: 24px;
      align-items: stretch; /* Allows left column track to span the full scroll height */
      position: relative;
      margin-top: 20px;
      margin-bottom: 60px;
    }

    /* Column 1: Left Sticky Hero Container (Fixed Ratio, never stretches on accordion toggle) */
    .pd-hero-sticky-col {
      position: -webkit-sticky;
      position: sticky;
      top: 85px;
      align-self: flex-start;
      height: min(650px, calc(100vh - 105px));
      min-height: 560px;
      max-height: 700px;
      width: 100%;
      aspect-ratio: 3 / 4;
      z-index: 10;
    }
    .pd-hero-img-card {
      position: relative;
      width: 100%;
      height: 100%;
      aspect-ratio: 3 / 4;
      background: #000000;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid rgba(212, 178, 112, 0.3);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8);
    }
    .pd-hero-img-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .pd-hero-img-card:hover img {
      transform: scale(1.04);
    }
    .hero-badge-tag {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(8, 17, 30, 0.85);
      border: 1px solid #d4b270;
      color: #d4b270;
      font-size: 10px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      backdrop-filter: blur(4px);
    }

    /* Column 2: Vertical Scrolling Detail Gallery (4 Square Angle Shots) */
    .pd-gallery-scroll-col {
      display: flex;
      flex-direction: column;
      gap: 16px;
      align-self: flex-start;
      width: 100%;
    }
    .pd-gallery-card {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      background: #0b1524;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(212, 178, 112, 0.22);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
      cursor: pointer;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }
    .pd-gallery-card:hover {
      transform: translateY(-4px);
      border-color: #d4b270;
    }
    .pd-gallery-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Column 3: Customizer Sidebar */
    .pd-customizer-col {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .pd-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 26px;
      font-weight: 700;
      color: #ffffff;
      margin: 0;
      line-height: 1.35;
    }
    .pd-price-line {
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
    }
    .pd-price-val {
      font-size: 26px;
      font-weight: 800;
      color: #fbbf24;
    }
    .pd-price-orig {
      font-size: 16px;
      color: #64748b;
      text-decoration: line-through;
    }
    .pd-save-badge {
      background: #15803d;
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .pd-installment-sub {
      font-size: 13px;
      color: #94a3b8;
    }
    .pd-installment-sub strong { color: #ffffff; }

    /* Trust Highlights Pill Row */
    .pd-trust-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 4px;
    }
    .pd-trust-pill {
      background: rgba(212, 178, 112, 0.1);
      border: 1px solid rgba(212, 178, 112, 0.25);
      color: #cbd5e1;
      font-size: 11.5px;
      padding: 4px 10px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .pd-trust-pill i { color: #d4b270; }

    /* LUXURY ANIMATED STONE SWITCH */
    .stone-switch-wrap {
      margin: 10px 0 6px;
    }
    .stone-switch-label {
      font-size: 12px;
      font-weight: 700;
      color: #d4b270;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .stone-slider-box {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.35);
      border-radius: 12px;
      padding: 4px;
      user-select: none;
      box-shadow: inset 0 2px 8px rgba(0,0,0,0.6);
    }
    .stone-pill-glider {
      position: absolute;
      top: 4px;
      bottom: 4px;
      left: 4px;
      width: calc(50% - 4px);
      background: linear-gradient(135deg, #d4b270 0%, #b45309 100%);
      border-radius: 8px;
      box-shadow: 0 4px 14px rgba(212, 178, 112, 0.4);
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 1;
    }
    .stone-slider-box.moissanite-active .stone-pill-glider {
      transform: translateX(100%);
    }
    .stone-opt-btn {
      position: relative;
      z-index: 2;
      background: transparent;
      border: none;
      color: #94a3b8;
      font-size: 13.5px;
      font-weight: 700;
      padding: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: color 0.3s ease, transform 0.2s ease;
    }
    .stone-opt-btn.active {
      color: #ffffff;
      transform: scale(1.02);
      text-shadow: 0 1px 3px rgba(0,0,0,0.4);
    }

    /* Metal Swatches */
    .opt-label {
      font-size: 12.5px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
    }
    .opt-label span { color: #d4b270; }
    .metal-swatch-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 8px;
    }
    .metal-swatch-btn {
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(212, 178, 112, 0.25);
      background: #08111e;
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .metal-swatch-btn:hover {
      border-color: #d4b270;
      transform: translateY(-2px);
    }
    .metal-swatch-btn.active {
      background: rgba(212, 178, 112, 0.2);
      border-color: #d4b270;
      color: #fbbf24;
      box-shadow: 0 0 12px rgba(212, 178, 112, 0.3);
    }

    /* Carat Buttons */
    .carat-btn-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 8px;
    }
    .carat-btn {
      padding: 7px 14px;
      border-radius: 8px;
      border: 1px solid rgba(212, 178, 112, 0.25);
      background: #08111e;
      color: #ffffff;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .carat-btn:hover {
      border-color: #d4b270;
      transform: translateY(-2px);
    }
    .carat-btn.active {
      background: linear-gradient(135deg, #d4b270 0%, #b45309 100%);
      border-color: #d4b270;
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(212, 178, 112, 0.35);
    }

    /* Ring Size Dropdown & Engraving */
    .pd-select {
      width: 100%;
      padding: 12px 14px;
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.3);
      border-radius: 8px;
      color: #ffffff;
      font-size: 13.5px;
      outline: none;
    }
    .pd-input {
      width: 100%;
      padding: 12px 14px;
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.3);
      border-radius: 8px;
      color: #ffffff;
      font-size: 13.5px;
      outline: none;
    }

    /* Main CTA Buttons */
    .pd-cta-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 10px;
    }
    .btn-begin-order {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, #d4b270 0%, #b45309 100%);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 6px 20px rgba(180, 83, 9, 0.4);
      transition: all 0.25s ease;
    }
    .btn-begin-order:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(212, 178, 112, 0.5);
    }
    .btn-whatsapp-chat {
      width: 100%;
      padding: 14px;
      background: #0f372e;
      border: 1px solid #10b981;
      color: #a7f3d0;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
    }
    .btn-whatsapp-chat:hover {
      background: #065f46;
      color: #ffffff;
    }

    /* Quality Metric Rings */
    .pd-metrics-card {
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.25);
      border-radius: 14px;
      padding: 16px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      text-align: center;
      margin-top: 10px;
    }
    .metric-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .metric-circle {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 3px solid #10b981;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 800;
      color: #ffffff;
    }
    .metric-circle.gold { border-color: #fbbf24; }
    .metric-name {
      font-size: 11px;
      color: #94a3b8;
      font-weight: 600;
    }

    /* ALL 7 SPECIFICATION ACCORDIONS ON THE RIGHT SIDE */
    .pd-accordions-group {
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .acc-item {
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.2);
      border-radius: 10px;
      overflow: hidden;
    }
    .acc-header {
      padding: 14px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13.5px;
      font-weight: 700;
      color: #ffffff;
      cursor: pointer;
      user-select: none;
    }
    .acc-header i {
      font-size: 12px;
      color: #d4b270;
      transition: transform 0.25s ease;
    }
    .acc-item.open .acc-header i {
      transform: rotate(180deg);
    }
    .acc-body {
      display: none;
      padding: 0 16px 14px;
      font-size: 13px;
      color: #cbd5e1;
      line-height: 1.6;
      border-top: 1px solid rgba(255,255,255,0.06);
      padding-top: 12px;
    }
    .acc-item.open .acc-body {
      display: block;
    }

    /* =========================================================
       8-STAGE "HOW OUR PRODUCTS ARE MADE" HORIZONTAL SCROLLER
       (PLACED BEFORE REVIEWS SECTION)
       ========================================================= */
    .sat-craft-process-section {
      padding: 60px 0 50px;
      background: #060e1a;
      border-top: 1px solid rgba(212, 178, 112, 0.2);
      border-bottom: 1px solid rgba(212, 178, 112, 0.2);
      position: relative;
    }
    .craft-heading-wrap {
      text-align: center;
      margin-bottom: 32px;
      padding: 0 20px;
    }
    .craft-main-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 32px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 8px;
    }
    .craft-sub-title {
      font-size: 14.5px;
      color: #94a3b8;
      margin: 0;
    }
    .craft-scroll-track-wrap {
      width: 100%;
      overflow-x: auto;
      padding: 10px 24px 24px;
      scrollbar-width: thin;
      scrollbar-color: #d4b270 #08111e;
    }
    .craft-scroll-track-wrap::-webkit-scrollbar {
      height: 6px;
    }
    .craft-scroll-track-wrap::-webkit-scrollbar-track {
      background: #08111e;
      border-radius: 4px;
    }
    .craft-scroll-track-wrap::-webkit-scrollbar-thumb {
      background: #d4b270;
      border-radius: 4px;
    }
    .craft-cards-row {
      display: flex;
      gap: 20px;
      width: max-content;
    }
    .craft-step-card {
      width: 260px;
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.25);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
      transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .craft-step-card:hover {
      transform: translateY(-5px);
      border-color: #d4b270;
    }
    .craft-card-media {
      width: 100%;
      height: 190px;
      background: #000000;
      overflow: hidden;
      position: relative;
    }
    .craft-card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .craft-step-card:hover .craft-card-media img {
      transform: scale(1.06);
    }
    .craft-card-content {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }
    .craft-step-title {
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
      margin: 0;
    }
    .craft-step-desc {
      font-size: 12.5px;
      color: #94a3b8;
      line-height: 1.5;
      margin: 0;
      flex: 1;
    }
    .craft-view-more-btn {
      color: #d4b270;
      font-size: 12px;
      font-weight: 700;
      text-decoration: underline;
      cursor: pointer;
      margin-top: 4px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .craft-view-more-btn:hover {
      color: #ffffff;
    }

    /* Modal for View More Step Details */
    .sat-craft-modal {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 99999;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      padding: 20px;
    }
    .sat-craft-modal.active {
      opacity: 1;
      visibility: visible;
    }
    .craft-modal-box {
      background: #08111e;
      border: 1px solid #d4b270;
      border-radius: 16px;
      max-width: 500px;
      width: 100%;
      padding: 24px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
      position: relative;
    }
    .craft-modal-close {
      position: absolute;
      top: 14px;
      right: 16px;
      font-size: 20px;
      color: #94a3b8;
      cursor: pointer;
    }
    .craft-modal-close:hover { color: #ffffff; }

    /* =========================================================
       INFINITE PHOTO REVIEWS MARQUEE SECTION
       (PLACED IMMEDIATELY AFTER HOW OUR PRODUCTS ARE MADE)
       ========================================================= */
    .sat-reviews-marquee-section {
      padding: 60px 0 40px;
      background: #03070d;
      border-bottom: 1px solid rgba(212, 178, 112, 0.2);
      overflow: hidden;
    }
    .marquee-heading-wrap {
      text-align: center;
      margin-bottom: 36px;
      padding: 0 20px;
    }
    .marquee-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 28px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 8px;
    }
    .marquee-subtitle {
      font-size: 14px;
      color: #94a3b8;
      margin: 0;
    }
    .marquee-track-container {
      display: flex;
      width: 100%;
      overflow: hidden;
      user-select: none;
      position: relative;
    }
    .marquee-track {
      display: flex;
      gap: 20px;
      animation: marqueeScroll 35s linear infinite;
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }
    @@keyframes marqueeScroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .review-photo-card {
      flex: 0 0 240px;
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.25);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }
    .review-photo-box {
      width: 100%;
      height: 190px;
      overflow: hidden;
      background: #000000;
    }
    .review-photo-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }
    .review-photo-card:hover .review-photo-box img {
      transform: scale(1.06);
    }
    .review-card-body {
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }
    .reviewer-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .reviewer-name {
      font-size: 13px;
      font-weight: 700;
      color: #ffffff;
    }
    .google-badge-icon {
      font-size: 13px;
      color: #4285f4;
      font-weight: 800;
    }
    .review-stars {
      color: #fbbf24;
      font-size: 11px;
      letter-spacing: 1px;
    }
    .review-snippet {
      font-size: 12px;
      color: #cbd5e1;
      line-height: 1.45;
      margin: 0;
    }

    /* FLOATING BOTTOM-RIGHT STICKY ORDER CARD */
    .sat-floating-order-card {
      position: fixed;
      bottom: 24px;
      right: 24px;
      max-width: 420px;
      width: calc(100% - 48px);
      background: rgba(11, 21, 36, 0.95);
      border: 1px solid rgba(212, 178, 112, 0.4);
      border-radius: 16px;
      padding: 14px 16px;
      backdrop-filter: blur(16px);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      z-index: 9999;
      transform: translateY(120px);
      opacity: 0;
      visibility: hidden;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .sat-floating-order-card.visible {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }
    .floating-card-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }
    .floating-thumb-img {
      width: 48px;
      height: 48px;
      border-radius: 8px;
      object-fit: cover;
      border: 1px solid rgba(212, 178, 112, 0.3);
      flex-shrink: 0;
    }
    .floating-info-text {
      min-width: 0;
    }
    .floating-title {
      font-size: 12.5px;
      font-weight: 700;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin: 0;
    }
    .floating-variant-sub {
      font-size: 11px;
      color: #94a3b8;
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .floating-price {
      font-size: 13.5px;
      font-weight: 800;
      color: #fbbf24;
    }
    .floating-btn-order {
      background: linear-gradient(135deg, #d4b270 0%, #b45309 100%);
      color: #ffffff;
      border: none;
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(180,83,9,0.35);
    }

    /* Mobile Responsive Overrides */
    @@media (max-width: 991px) {
      .pd-split-layout {
        grid-template-columns: 1fr;
        gap: 14px;
        margin-top: 10px;
        margin-bottom: 40px;
      }
      .pd-hero-sticky-col {
        position: relative !important;
        top: 0 !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        aspect-ratio: auto !important;
        width: 100% !important;
      }
      .pd-hero-img-card {
        aspect-ratio: 1 / 1 !important;
        height: auto !important;
        width: 100% !important;
        margin-bottom: 0 !important;
      }
      .pd-gallery-scroll-col {
        display: flex !important;
        flex-direction: row !important;
        overflow-x: auto !important;
        scroll-snap-type: x mandatory !important;
        gap: 10px !important;
        padding-bottom: 6px !important;
        width: 100% !important;
        scrollbar-width: none !important;
        -webkit-overflow-scrolling: touch;
      }
      .pd-gallery-scroll-col::-webkit-scrollbar {
        display: none;
      }
      .pd-gallery-card {
        flex: 0 0 90px !important;
        width: 90px !important;
        aspect-ratio: 1 / 1 !important;
        scroll-snap-align: start !important;
      }
      .sat-floating-order-card {
        bottom: 16px;
        right: 16px;
        width: calc(100% - 32px);
      }
    }
  </style>
</head>
<body>

  <!-- Top Announcement Bar -->
  <div class="sat-announcement-bar">
    <i class="fa-solid fa-gem" style="margin-right:6px;"></i> 100% GIA &amp; IGI CERTIFIED DIAMONDS • FREE WORLDWIDE INSURED SHIPPING
  </div>

  <!-- Header Navigation -->
  <header class="sat-nav-header">
    <div class="sat-nav-inner">
      <a href="/" class="brand-title">
        SAT <span class="gold-text">Jewel</span>
      </a>
      <a href="/Product/Category?id=1" style="color:#d4b270; font-size:13px; font-weight:700; text-decoration:none; display:flex; align-items:center; gap:6px;">
        <i class="fa-solid fa-arrow-left"></i> Back to Catalog
      </a>
    </div>
  </header>

  <div class="pd-container">
    
    <!-- 3-Column Split Product Layout -->
    <div class="pd-split-layout">
      
      <!-- 1. LEFT TALL STICKY COLUMN: Hero Primary Image (Stuck throughout scroll, scrolls only at the end) -->
      <div class="pd-hero-sticky-col">
        <div class="pd-hero-img-card">
          <img id="heroMainImg" src="@mainImage" alt="@Model.Name" />
          <span class="hero-badge-tag" id="heroBadgeTag">💎 Lab Grown Diamond</span>
        </div>
      </div>

      <!-- 2. MIDDLE COLUMN: Vertical Scrolling Detail Gallery (6 Angle Shots) -->
      <div class="pd-gallery-scroll-col" id="detailGalleryCol">
        @for (int i = 0; i < galleryList.Count; i++)
        {
          var img = galleryList[i];
          <div class="pd-gallery-card" onclick="switchHeroImage('@img')">
            <img src="@img" alt="Angle @(i+1)" />
          </div>
        }
      </div>

      <!-- 3. RIGHT COLUMN: Customizer Sidebar & All 7 Accordions -->
      <div class="pd-customizer-col">
        
        <h1 class="pd-title">@Model.Name</h1>

        <!-- Price & Star Ratings -->
        <div class="pd-price-line">
          <span class="pd-price-val" id="displayPriceUSD">$ @Model.Price.ToString("N0") USD</span>
          <span class="pd-price-orig" id="displayPriceOrigUSD">$ @originalPriceUSD.ToString("N0")</span>
          <span class="pd-save-badge">Save 15%</span>
        </div>

        <div class="pd-installment-sub">
          Or <strong id="displayMonthlyInstallment">$@((Model.Price / 4).ToString("F2"))/month</strong> in 4 interest-free payments.
        </div>

        <!-- Star Rating -->
        <div style="display:flex; align-items:center; gap:8px; font-size:13px; color:#fbbf24;">
          <span>★★★★★</span>
          <span style="color:#ffffff; font-weight:700;">4.9 / 5.0</span>
          <span style="color:#94a3b8;">(Google Verified Reviews)</span>
        </div>

        <!-- Trust Pills -->
        <div class="pd-trust-row">
          <span class="pd-trust-pill"><i class="fa-solid fa-certificate"></i> <span id="certPillText">IGI / GIA Certified</span></span>
          <span class="pd-trust-pill"><i class="fa-solid fa-shield-check"></i> BIS Hallmarked</span>
          <span class="pd-trust-pill"><i class="fa-solid fa-truck-fast"></i> Free Insured Express</span>
        </div>

        <!-- LUXURY ANIMATED STONE SWITCH -->
        <div class="stone-switch-wrap">
          <div class="stone-switch-label">
            <span>Center Stone Type</span>
            <span id="lblStoneChoice" style="color:#fbbf24;">Lab Grown Diamond</span>
          </div>
          <div class="stone-slider-box" id="stoneSliderBox">
            <div class="stone-pill-glider"></div>
            <button type="button" class="stone-opt-btn active" id="btnLabDiamond" onclick="setStoneType('LabGrownDiamond', this)">
              💎 Lab Grown Diamond
            </button>
            <button type="button" class="stone-opt-btn" id="btnMoissanite" onclick="setStoneType('Moissanite', this)">
              ✨ Moissanite
            </button>
          </div>
        </div>

        <!-- Metal Purity & Color Swatches -->
        <div style="margin-top: 6px;">
          <div class="opt-label">Metal Purity &amp; Color: <span id="lblMetal">@(metalList.FirstOrDefault()?.Name ?? "14K Yellow Gold")</span></div>
          <div class="metal-swatch-list">
            @foreach (var metal in metalList)
            {
              var isDef = (metal == metalList.First());
              <button type="button" class="metal-swatch-btn @(isDef ? "active" : "")" onclick="setMetal('@metal.Name', this)">
                <i class="fa-solid fa-ring"></i> @metal.Name
              </button>
            }
          </div>
        </div>

        <!-- Carat Size Selector -->
        <div>
          <div class="opt-label">Center Diamond Size: <span id="lblCarat">@(caratList.FirstOrDefault()?.Label ?? "1.50 CT")</span></div>
          <div class="carat-btn-list">
            @foreach (var carat in caratList)
            {
              var isDef = (carat == caratList.First());
              <button type="button" class="carat-btn @(isDef ? "active" : "")" onclick="setCarat('@carat.Label', this)">
                @carat.Label
              </button>
            }
          </div>
        </div>

        <!-- Ring Size Selection -->
        <div>
          <div class="opt-label">Select Ring Size (US): <span style="font-size:11px; text-decoration:underline; cursor:pointer;">Size Guide</span></div>
          <select class="pd-select" id="selRingSize">
            <option>US 5.0 (15.7mm)</option>
            <option selected>US 6.0 (16.5mm)</option>
            <option>US 7.0 (17.3mm)</option>
            <option>US 8.0 (18.2mm)</option>
            <option>US 9.0 (19.0mm)</option>
          </select>
        </div>

        <!-- Free Laser Engraving -->
        <div>
          <div class="opt-label">Free Laser Engraving</div>
          <input type="text" class="pd-input" id="txtEngraving" placeholder="Engrave Text (e.g. Forever & Always ♡)" maxlength="30" />
        </div>

        <!-- CTA Action Buttons -->
        <div class="pd-cta-group">
          <button type="button" class="btn-begin-order" id="btnBeginOrder" onclick="executeAddToCart()">
            <i class="fa-solid fa-bag-shopping"></i> Begin My Order • <span id="btnOrderPrice">$@Model.Price.ToString("N0")</span>
          </button>
          <a href="https://wa.me/19175550199?text=Hello%20SAT%20Jewel%2C%20I%20am%20interested%20in%20@Uri.EscapeDataString(Model.Name)" target="_blank" class="btn-whatsapp-chat">
            <i class="fa-brands fa-whatsapp" style="font-size:18px;"></i> WhatsApp Us for Bespoke Request
          </a>
        </div>

        <!-- Quality Scores -->
        <div class="pd-metrics-card">
          <div class="metric-box">
            <div class="metric-circle">8</div>
            <span class="metric-name">Daily Wear</span>
          </div>
          <div class="metric-box">
            <div class="metric-circle">9</div>
            <span class="metric-name">Durability</span>
          </div>
          <div class="metric-box">
            <div class="metric-circle">8</div>
            <span class="metric-name">Exclusivity</span>
          </div>
          <div class="metric-box">
            <div class="metric-circle gold">5</div>
            <span class="metric-name">Reworkability</span>
          </div>
        </div>

        <!-- ALL 7 SPECIFICATION ACCORDIONS ON THE RIGHT SIDE -->
        <div class="pd-accordions-group">
          
          <div class="acc-item open">
            <div class="acc-header" onclick="toggleAcc(this)">
              <span>Product Overview</span>
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="acc-body">
              This handcrafted @Model.Name features precision 3D-engineered prongs, micro-pave accents, and a mirror-polished solid metal finish. Hand-selected for exceptional fire and symmetry.
            </div>
          </div>

          <div class="acc-item">
            <div class="acc-header" onclick="toggleAcc(this)">
              <span>Clarity &amp; Color Grading</span>
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="acc-body" id="accClarityText">
              Stone Color: <strong>E–F (Colorless)</strong> • Clarity: <strong>VVS1–VVS2 (Eye Clean)</strong> • Polish &amp; Symmetry: <strong>Excellent</strong>.
            </div>
          </div>

          <div class="acc-item">
            <div class="acc-header" onclick="toggleAcc(this)">
              <span>Diamond &amp; Gemstone Details</span>
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="acc-body" id="accDiamondDetails">
              Center Stone: <strong>Selected Carat Weight</strong> • Setting Type: <strong>4-Prong Comfort Fit</strong> • Conflict-free &amp; 100% sustainable.
            </div>
          </div>

          <div class="acc-item">
            <div class="acc-header" onclick="toggleAcc(this)">
              <span>Metal &amp; Craft Details</span>
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="acc-body">
              Available in Solid 10K, 14K, 18K Yellow, White &amp; Rose Gold, as well as 950 Platinum. Stamped with official BIS/Hallmark authenticity.
            </div>
          </div>

          <div class="acc-item">
            <div class="acc-header" onclick="toggleAcc(this)">
              <span>Ring Sizing &amp; Custom Fit</span>
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="acc-body">
              Crafted in standard US sizes 4.0 to 10.0. We offer 1 complimentary resize within 60 days of delivery.
            </div>
          </div>

          <div class="acc-item">
            <div class="acc-header" onclick="toggleAcc(this)">
              <span>Jewelry Certification &amp; Laser Inscription</span>
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="acc-body" id="accCertText">
              Includes physical IGI / GIA Certificate of Authenticity card and microscopic girdle laser inscription matching laboratory reports.
            </div>
          </div>

          <div class="acc-item">
            <div class="acc-header" onclick="toggleAcc(this)">
              <span>Shipping, Delivery &amp; Warranty</span>
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="acc-body">
              Includes 100% Free Insured Courier Delivery with signature required. Backed by SAT Jewel Lifetime Manufacturing Warranty and 30-Day returns.
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- DEDICATED 8-STAGE "HOW OUR PRODUCTS ARE MADE" SECTION -->
  <!-- (PLACED IN A SINGLE HORIZONTAL SCROLLABLE LINE BEFORE REVIEWS) -->
  <section class="sat-craft-process-section">
    <div class="craft-heading-wrap">
      <h2 class="craft-main-title">How Our Products Are Made</h2>
      <p class="craft-sub-title">From initial sketch to certified master jewelry, explore our bespoke 8-step crafting journey.</p>
    </div>

    <div class="craft-scroll-track-wrap">
      <div class="craft-cards-row">
        
        <!-- Step 1 -->
        <div class="craft-step-card">
          <div class="craft-card-media">
            <img src="/assets/process/craft_design_selection.jpg" alt="Design & Selection" />
          </div>
          <div class="craft-card-content">
            <h3 class="craft-step-title">Design &amp; Selection</h3>
            <p class="craft-step-desc">Meticulously designed, from custom creations to ready-to-ship fine jewelry.</p>
            <span class="craft-view-more-btn" onclick="openCraftModal('Design & Selection', 'Every SAT Jewel creation begins with meticulous sketches, hand-selecting ideal center stones, and harmonizing proportions for lifelong comfort and timeless beauty.')">View More &rarr;</span>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="craft-step-card">
          <div class="craft-card-media">
            <img src="/assets/process/craft_cad_design.jpg" alt="CAD Design" />
          </div>
          <div class="craft-card-content">
            <h3 class="craft-step-title">CAD Design</h3>
            <p class="craft-step-desc">Turning concepts into precise 3D models before they're ever made.</p>
            <span class="craft-view-more-btn" onclick="openCraftModal('CAD 3D Design', 'Advanced 3D computer-aided engineering ensures every prong, micro-pave channel, and shank thickness is engineered to sub-millimeter precision.')">View More &rarr;</span>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="craft-step-card">
          <div class="craft-card-media">
            <img src="/assets/process/craft_diamond_crafting.jpg" alt="Finest Diamond Crafting" />
          </div>
          <div class="craft-card-content">
            <h3 class="craft-step-title">Finest Diamond Crafting</h3>
            <p class="craft-step-desc">Where precision craftsmanship transforms a diamond's potential into fire.</p>
            <span class="craft-view-more-btn" onclick="openCraftModal('Finest Diamond Crafting', 'Master lapidaries cut and polish rough crystals to achieve Super Ideal cut proportions, maximizing light refraction and breathtaking fire.')">View More &rarr;</span>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="craft-step-card">
          <div class="craft-card-media">
            <img src="/assets/process/craft_casting_jewellery.jpg" alt="Casting Jewellery" />
          </div>
          <div class="craft-card-content">
            <h3 class="craft-step-title">Casting Jewellery</h3>
            <p class="craft-step-desc">In-house precious metal casting guarantees superior quality and purity.</p>
            <span class="craft-view-more-btn" onclick="openCraftModal('Jewelry Casting', 'Our state-of-the-art induction casting furnaces pour 10K/14K/18K gold and 950 platinum with zero porosity for unmatched structural integrity.')">View More &rarr;</span>
          </div>
        </div>

        <!-- Step 5 -->
        <div class="craft-step-card">
          <div class="craft-card-media">
            <img src="/assets/process/craft_stone_setting.jpg" alt="Stone Setting" />
          </div>
          <div class="craft-card-content">
            <h3 class="craft-step-title">Stone Setting</h3>
            <p class="craft-step-desc">Diamonds are expertly set and polished for maximum security and brilliance.</p>
            <span class="craft-view-more-btn" onclick="openCraftModal('Microscopic Stone Setting', 'Expert setters secure center stones and micro-pave accents under high-magnification stereomicroscopes for flawless alignment and durability.')">View More &rarr;</span>
          </div>
        </div>

        <!-- Step 6 -->
        <div class="craft-step-card">
          <div class="craft-card-media">
            <img src="/assets/process/craft_polishing_jewellery.jpg" alt="Polishing Jewellery" />
          </div>
          <div class="craft-card-content">
            <h3 class="craft-step-title">Polishing Jewellery</h3>
            <p class="craft-step-desc">Multi-stage mirror finishing that brings out deep metallic luster.</p>
            <span class="craft-view-more-btn" onclick="openCraftModal('Artisan Polishing', 'Using specialized felt wheels and diamond compounds, each curve of the ring is meticulously buffed to achieve a mirror-like finish.')">View More &rarr;</span>
          </div>
        </div>

        <!-- Step 7 -->
        <div class="craft-step-card">
          <div class="craft-card-media">
            <img src="/assets/process/craft_rhodium_process.jpg" alt="Rhodium Process" />
          </div>
          <div class="craft-card-content">
            <h3 class="craft-step-title">Rhodium Process</h3>
            <p class="craft-step-desc">The secret to brilliant white jewelry that never fades its luster.</p>
            <span class="craft-view-more-btn" onclick="openCraftModal('Rhodium Electroplating', 'An ultra-pure electroplated rhodium layer adds diamond-like hardness, corrosion resistance, and an iconic radiant white sheen.')">View More &rarr;</span>
          </div>
        </div>

        <!-- Step 8 -->
        <div class="craft-step-card">
          <div class="craft-card-media">
            <img src="/assets/process/craft_quality_check.jpg" alt="Quality Check & Packaging" />
          </div>
          <div class="craft-card-content">
            <h3 class="craft-step-title">Quality Check &amp; Packaging</h3>
            <p class="craft-step-desc">Passing a strict final quality control assessment before shipment.</p>
            <span class="craft-view-more-btn" onclick="openCraftModal('Quality Inspection & Packaging', 'Every piece undergoes multi-point gemological inspection, laser hallmark verification, and is placed in luxury illuminated presentation boxes.')">View More &rarr;</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- POPUP MODAL FOR CRAFT STAGE DETAILS -->
  <div class="sat-craft-modal" id="craftModal" onclick="closeCraftModal(event)">
    <div class="craft-modal-box" onclick="event.stopPropagation()">
      <span class="craft-modal-close" onclick="closeCraftModal()">&times;</span>
      <h3 id="modalCraftTitle" style="font-family:'Playfair Display',serif; font-size:22px; color:#ffffff; margin:0 0 12px;"></h3>
      <p id="modalCraftBody" style="font-size:14px; color:#cbd5e1; line-height:1.6; margin:0 0 18px;"></p>
      <button type="button" class="btn-begin-order" style="padding:10px;" onclick="closeCraftModal()">Got It</button>
    </div>
  </div>

  <!-- INFINITE GOOGLE & CUSTOMER PHOTO REVIEWS SECTION -->
  <!-- (PLACED IMMEDIATELY AFTER HOW OUR PRODUCTS ARE MADE) -->
  <section class="sat-reviews-marquee-section">
    <div class="marquee-heading-wrap">
      <h2 class="marquee-title">Real Customer Stories &amp; Unboxing</h2>
      <p class="marquee-subtitle">See real fine jewelry delivered to our cherished global clients.</p>
    </div>

    <div class="marquee-track-container">
      <div class="marquee-track">
        @foreach (var rev in photoReviews)
        {
          <div class="review-photo-card">
            <div class="review-photo-box">
              <img src="@rev.PhotoUrl" alt="@rev.CustomerName Review" />
            </div>
            <div class="review-card-body">
              <div class="reviewer-meta-row">
                <span class="reviewer-name">@rev.CustomerName</span>
                <span class="google-badge-icon"><i class="fa-brands fa-google"></i></span>
              </div>
              <div class="review-stars">★★★★★</div>
              <p class="review-snippet">"@rev.ReviewText"</p>
            </div>
          </div>
        }
        @* Duplicate for seamless infinite marquee loop *@
        @foreach (var rev in photoReviews)
        {
          <div class="review-photo-card">
            <div class="review-photo-box">
              <img src="@rev.PhotoUrl" alt="@rev.CustomerName Review" />
            </div>
            <div class="review-card-body">
              <div class="reviewer-meta-row">
                <span class="reviewer-name">@rev.CustomerName</span>
                <span class="google-badge-icon"><i class="fa-brands fa-google"></i></span>
              </div>
              <div class="review-stars">★★★★★</div>
              <p class="review-snippet">"@rev.ReviewText"</p>
            </div>
          </div>
        }
      </div>
    </div>
  </section>

  <!-- FLOATING BOTTOM-RIGHT STICKY ORDER CARD -->
  <div class="sat-floating-order-card" id="floatingOrderCard">
    <div class="floating-card-left">
      <img src="@mainImage" class="floating-thumb-img" id="floatingThumb" alt="Product thumbnail" />
      <div class="floating-info-text">
        <p class="floating-title">@Model.Name</p>
        <p class="floating-variant-sub" id="floatingSpecsSub">14K Yellow Gold • 1.50 CT • Lab Diamond</p>
        <span class="floating-price" id="floatingPriceVal">$ @Model.Price.ToString("N0")</span>
      </div>
    </div>
    <button type="button" class="floating-btn-order" onclick="executeAddToCart()">
      Begin My Order
    </button>
  </div>

  <partial name="_Footer" />

  <script>
    // Global State for Dynamic Recalculation
    const basePriceUSD = @Model.Price;
    let currentStoneType = 'LabGrownDiamond'; // 'LabGrownDiamond' or 'Moissanite'
    let selectedMetal = '@(metalList.FirstOrDefault()?.Name ?? "14K Yellow Gold")';
    let selectedCarat = '@(caratList.FirstOrDefault()?.Label ?? "1.50 CT")';

    // Metal & Carat Adjustments Pre-populated from Server
    let metalAdjustments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(metalList.ToDictionary(m => (string)m.Name, m => (decimal)m.Offset)));
    let caratAdjustments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(caratList.ToDictionary(c => (string)c.Label, c => (decimal)c.Offset)));

    // Fetch real-time Admin Pricing Rules from DB and match with normalized regex
    fetch('/api/ProductApi/pricing-rules')
      .then(res => res.json())
      .then(data => {
        if (data && data.rules && data.rules.length > 0) {
          data.rules.forEach(r => {
            if (r.ruleType === 'Metal') {
              for (let k in metalAdjustments) {
                const kLower = k.toLowerCase();
                const codeLower = (r.code || '').toLowerCase();
                if ((kLower.includes('10k') && codeLower.includes('10k')) ||
                    (kLower.includes('14k') && codeLower.includes('14k')) ||
                    (kLower.includes('18k') && codeLower.includes('18k')) ||
                    (kLower.includes('platinum') && codeLower.includes('platinum')) ||
                    (kLower.includes('silver') && codeLower.includes('silver'))) {
                  metalAdjustments[k] = r.priceOffsetUSD;
                }
              }
            } else if (r.ruleType === 'Carat') {
              for (let k in caratAdjustments) {
                const kNum = (k.match(/\d+(\.\d+)?/) || [''])[0];
                const rNum = (r.displayName.match(/\d+(\.\d+)?/) || [''])[0];
                if (kNum && rNum && Math.abs(parseFloat(kNum) - parseFloat(rNum)) < 0.05) {
                  caratAdjustments[k] = r.priceOffsetUSD;
                }
              }
            }
          });
          recalculatePrice();
        }
      })
      .catch(_ => {});

    // Stone Type Switcher with Luxury Animation
    function setStoneType(type, btn) {
      currentStoneType = type;
      const box = document.getElementById('stoneSliderBox');
      document.querySelectorAll('.stone-opt-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      if (type === 'Moissanite') {
        box.classList.add('moissanite-active');
        document.getElementById('lblStoneChoice').textContent = 'Moissanite Diamond';
        document.getElementById('heroBadgeTag').textContent = '✨ Moissanite';
        document.getElementById('certPillText').textContent = 'SGL / GRA Certified';
        document.getElementById('accCertText').innerHTML = 'Includes physical SGL / GRA Authenticity Card verifying Grade D Colorless Moissanite.';
      } else {
        box.classList.remove('moissanite-active');
        document.getElementById('lblStoneChoice').textContent = 'Lab Grown Diamond';
        document.getElementById('heroBadgeTag').textContent = '💎 Lab Grown Diamond';
        document.getElementById('certPillText').textContent = 'IGI / GIA Certified';
        document.getElementById('accCertText').innerHTML = 'Includes physical IGI / GIA Certificate of Authenticity card and girdle laser inscription.';
      }

      recalculatePrice();
    }

    function setMetal(name, btn) {
      selectedMetal = name;
      document.getElementById('lblMetal').textContent = name;
      document.querySelectorAll('.metal-swatch-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      recalculatePrice();
    }

    function setCarat(label, btn) {
      selectedCarat = label;
      document.getElementById('lblCarat').textContent = label;
      document.querySelectorAll('.carat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      recalculatePrice();
    }

    function recalculatePrice() {
      const metalAdj = metalAdjustments[selectedMetal] || 0;
      const caratAdj = caratAdjustments[selectedCarat] || 0;

      let subtotal = basePriceUSD + metalAdj + caratAdj;
      let finalPrice = (currentStoneType === 'Moissanite') ? Math.max(120, Math.round(subtotal * 0.55)) : subtotal;
      let originalPrice = Math.floor(finalPrice * 1.15);
      let monthly = (finalPrice / 4).toFixed(2);

      window.activeVariantPriceUSD = finalPrice;

      document.getElementById('displayPriceUSD').textContent = `$ ${finalPrice.toLocaleString('en-US')} USD`;
      document.getElementById('displayPriceOrigUSD').textContent = `$ ${originalPrice.toLocaleString('en-US')}`;
      document.getElementById('displayMonthlyInstallment').textContent = `$${monthly}/month`;
      document.getElementById('btnOrderPrice').textContent = `$${finalPrice.toLocaleString('en-US')}`;
      document.getElementById('floatingPriceVal').textContent = `$ ${finalPrice.toLocaleString('en-US')}`;

      const stoneLabel = currentStoneType === 'Moissanite' ? 'Moissanite' : 'Lab Diamond';
      document.getElementById('floatingSpecsSub').textContent = `${selectedMetal} • ${selectedCarat} • ${stoneLabel}`;
    }

    function switchHeroImage(src) {
      const hero = document.getElementById('heroMainImg');
      if (hero) {
        hero.style.opacity = '0.4';
        setTimeout(() => {
          hero.src = src;
          hero.style.opacity = '1';
        }, 150);
      }
      const thumb = document.getElementById('floatingThumb');
      if (thumb) thumb.src = src;
    }

    function toggleAcc(header) {
      const item = header.closest('.acc-item');
      if (item) item.classList.toggle('open');
    }

    function openCraftModal(title, body) {
      document.getElementById('modalCraftTitle').textContent = title;
      document.getElementById('modalCraftBody').textContent = body;
      document.getElementById('craftModal').classList.add('active');
    }

    function closeCraftModal(e) {
      if (!e || e.target === document.getElementById('craftModal') || e.target.classList.contains('craft-modal-close')) {
        document.getElementById('craftModal').classList.remove('active');
      }
    }

    // Scroll listener for Floating Bottom-Right Card
    window.addEventListener('scroll', () => {
      const card = document.getElementById('floatingOrderCard');
      if (card) {
        if (window.scrollY > 400) {
          card.classList.add('visible');
        } else {
          card.classList.remove('visible');
        }
      }
    });

    const isUserAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

    function executeAddToCart() {
      try {
        const finalPrice = window.activeVariantPriceUSD || basePriceUSD;
        const sizeSelect = document.getElementById('selRingSize');
        const ringSize = sizeSelect ? sizeSelect.value : 'US 6.0';
        const txtEngraving = document.getElementById('txtEngraving');
        const engraving = txtEngraving ? txtEngraving.value.trim() : '';
        const stoneName = currentStoneType === 'Moissanite' ? 'Moissanite' : 'Lab Grown Diamond';

        const variantTitle = `@Model.Name (${stoneName}, ${selectedMetal}, ${selectedCarat}, Size: ${ringSize}${engraving ? `, Engraved: "${engraving}"` : ''})`;

        const saved = localStorage.getItem('sat_shopping_cart_usd');
        let items = saved ? JSON.parse(saved) : [];
        items.push({
          id: '@Model.Id',
          name: variantTitle,
          priceUSD: finalPrice,
          metal: selectedMetal,
          carat: selectedCarat,
          stone: stoneName,
          size: ringSize,
          engraving: engraving,
          img: '@mainImage',
          quantity: 1
        });
        localStorage.setItem('sat_shopping_cart_usd', JSON.stringify(items));

        if (!isUserAuthenticated) {
          alert('🔒 Please sign in to your account first to complete your bespoke order.');
          window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        } else {
          window.location.href = '/Product/Cart';
        }
      } catch (e) {}
    }

    recalculatePrice();
  </script>
</body>
</html>
