@model SAT1.Models.GiaCertificateViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@Model.CertType Gemological Report - @Model.ProductName</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root {
      --gia-navy: #0e2b46;
      --gia-gold: #c5a059;
      --gia-gold-light: #f5eedf;
      --gia-border: #d1d5db;
      --gia-text: #1f2937;
      --gia-gray-bg: #f9fafb;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #e2e8f0;
      font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--gia-text);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 30px 15px;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .toolbar {
      width: 100%;
      max-width: 820px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      gap: 12px;
      flex-wrap: wrap;
    }

    .toolbar a, .toolbar button {
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 13.5px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .btn-back {
      background: #ffffff;
      color: #334155;
      border: 1px solid #cbd5e1;
    }
    .btn-back:hover { background: #f1f5f9; color: #0f172a; }

    .btn-download-pdf {
      background: linear-gradient(135deg, #0e2b46 0%, #1e3a8a 100%);
      color: #ffffff;
      border: none;
      box-shadow: 0 4px 14px rgba(14, 43, 70, 0.3);
    }
    .btn-download-pdf:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(14, 43, 70, 0.45);
      background: linear-gradient(135deg, #1e3a8a 0%, #0e2b46 100%);
    }

    /* GIA Document Sheet */
    .gia-sheet {
      width: 100%;
      max-width: 820px;
      background: #ffffff;
      box-shadow: 0 10px 30px rgba(0,0,0,0.12);
      border-radius: 4px;
      border: 1px solid #cbd5e1;
      padding: 40px 45px;
      position: relative;
    }

    /* Top GIA Header */
    .gia-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid var(--gia-gold);
      padding-bottom: 18px;
      margin-bottom: 24px;
    }

    .gia-logo-box {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .gia-logo-text {
      font-family: 'Cinzel', Georgia, serif;
      font-size: 34px;
      font-weight: 800;
      letter-spacing: 4px;
      color: var(--gia-navy);
      line-height: 1;
    }

    .gia-sub-brand {
      font-size: 9.5px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #64748b;
      font-weight: 600;
      margin-top: 4px;
    }

    .gia-report-badge {
      text-align: right;
    }
    .gia-report-title {
      font-family: 'Cinzel', Georgia, serif;
      font-size: 15px;
      font-weight: 700;
      color: var(--gia-navy);
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .gia-report-num {
      font-family: monospace;
      font-size: 15px;
      font-weight: 700;
      color: var(--gia-gold);
      margin-top: 3px;
    }
    .gia-report-date {
      font-size: 11px;
      color: #64748b;
      margin-top: 2px;
    }

    /* Product Ribbon */
    .product-ribbon {
      background: var(--gia-gold-light);
      border-left: 4px solid var(--gia-gold);
      padding: 12px 16px;
      border-radius: 0 6px 6px 0;
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .product-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--gia-navy);
    }
    .product-sku {
      font-size: 11px;
      color: #64748b;
      font-family: monospace;
      margin-top: 2px;
    }

    /* Grid Layout */
    .gia-grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 30px;
      margin-bottom: 24px;
    }

    .section-heading {
      font-family: 'Cinzel', Georgia, serif;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--gia-navy);
      border-bottom: 1px solid var(--gia-border);
      padding-bottom: 6px;
      margin-bottom: 12px;
    }

    .spec-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    .spec-table tr {
      border-bottom: 1px solid #f1f5f9;
    }
    .spec-table tr:last-child {
      border-bottom: none;
    }
    .spec-table td {
      padding: 8px 4px;
      vertical-align: middle;
    }
    .spec-label {
      color: #64748b;
      font-weight: 500;
      width: 45%;
    }
    .spec-value {
      font-weight: 700;
      color: var(--gia-navy);
      text-align: right;
    }
    .spec-highlight {
      color: #b45309;
      font-weight: 800;
    }

    /* Right Column: Diamond Silhouette & Scale */
    .diagram-box {
      border: 1px solid var(--gia-border);
      border-radius: 6px;
      padding: 16px;
      text-align: center;
      background: var(--gia-gray-bg);
      margin-bottom: 16px;
    }

    .diamond-icon-wrap {
      font-size: 54px;
      color: var(--gia-navy);
      margin-bottom: 10px;
      opacity: 0.85;
    }

    .proportions-list {
      display: flex;
      justify-content: space-around;
      font-size: 11px;
      color: #475569;
      margin-top: 10px;
      border-top: 1px dashed #cbd5e1;
      padding-top: 10px;
    }
    .proportions-list div strong {
      display: block;
      color: var(--gia-navy);
      font-size: 12px;
    }

    /* Laser Inscription Box */
    .laser-box {
      background: #ffffff;
      border: 1px solid var(--gia-gold);
      border-radius: 6px;
      padding: 12px;
      font-size: 11.5px;
      margin-bottom: 16px;
    }
    .laser-title {
      font-weight: 700;
      color: var(--gia-navy);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Security Footer & Seals */
    .gia-footer {
      border-top: 2px solid var(--gia-gold);
      padding-top: 18px;
      margin-top: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10.5px;
      color: #64748b;
      gap: 16px;
      flex-wrap: wrap;
    }

    .security-badge {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .security-stamp {
      width: 50px;
      height: 50px;
      border: 2px solid var(--gia-gold);
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 7px;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--gia-gold);
      line-height: 1.1;
      text-align: center;
      letter-spacing: 0.5px;
    }

    /* Print Styles */
    @@media print {
      body {
        background: #ffffff !important;
        padding: 0 !important;
      }
      .toolbar {
        display: none !important;
      }
      .gia-sheet {
        border: none !important;
        box-shadow: none !important;
        padding: 15mm 20mm !important;
        max-width: 100% !important;
        width: 100% !important;
        page-break-after: avoid;
      }
    }
  </style>
</head>
<body>

  <div class="toolbar">
    <a href="javascript:window.history.back()" class="btn-back">
      <i class="fa-solid fa-arrow-left"></i> Back to @(Model.IsPurchasedOrder ? "Orders" : "Product")
    </a>
    <div style="display:flex; gap:10px;">
      <button type="button" onclick="window.print()" class="btn-download-pdf">
        <i class="fa-solid fa-file-arrow-down"></i> Print / Save PDF Certificate
      </button>
    </div>
  </div>

  <div class="gia-sheet">
    <!-- Header -->
    <div class="gia-header">
      <div class="gia-logo-box">
        <div>
          <div class="gia-logo-text">@Model.CertType</div>
          <div class="gia-sub-brand">Gemological Institute of America &bull; Official Report Dossier</div>
        </div>
      </div>
      <div class="gia-report-badge">
        <div class="gia-report-title">@Model.ReportTitle</div>
        <div class="gia-report-num">@Model.ReportNumber</div>
        <div class="gia-report-date">Issued: @Model.IssueDate</div>
      </div>
    </div>

    <!-- Product Ribbon -->
    <div class="product-ribbon">
      <div>
        <div class="product-title"><i class="fa-solid fa-gem" style="color:var(--gia-gold); margin-right:6px;"></i> @Model.ProductName</div>
        <div class="product-sku">
          @if (Model.IsPurchasedOrder)
          {
            <span><strong>Order Ref:</strong> @Model.OrderNumber &bull; </span>
          }
          <span>Atelier SKU: @Model.Sku &bull; SAT Jewels Surat Atelier</span>
          @if (!string.IsNullOrWhiteSpace(Model.ClientName))
          {
            <div><span style="color:#0f172a; font-weight:600;">Client:</span> @Model.ClientName</div>
          }
        </div>
      </div>
      <div style="text-align:right;">
        <span style="display:inline-flex; align-items:center; gap:6px; background:#ffffff; border:1px solid var(--gia-gold); padding:4px 10px; border-radius:4px; font-size:11px; font-weight:700; color:var(--gia-navy);">
          <i class="fa-solid fa-circle-check" style="color:#16a34a;"></i> @Model.VerificationBadge
        </span>
        @if (!string.IsNullOrWhiteSpace(Model.MetalType))
        {
          <div style="font-size:11px; color:#475569; margin-top:4px; font-weight:600;">
            <i class="fa-solid fa-ring" style="color:var(--gia-gold); margin-right:4px;"></i>@Model.MetalType @(!string.IsNullOrWhiteSpace(Model.RingSize) ? $" • Size {Model.RingSize}" : "")
          </div>
        }
      </div>
    </div>

    <!-- Grading Details Grid -->
    <div class="gia-grid">
      <!-- Left: 4Cs & Grading Results -->
      <div>
        <div class="section-heading">Grading Results (The 4Cs)</div>
        <table class="spec-table">
          <tr>
            <td class="spec-label">Carat Weight</td>
            <td class="spec-value spec-highlight" style="font-size:14px;">@Model.CaratWeight</td>
          </tr>
          <tr>
            <td class="spec-label">Color Grade</td>
            <td class="spec-value">@Model.ColorGrade</td>
          </tr>
          <tr>
            <td class="spec-label">Clarity Grade</td>
            <td class="spec-value">@Model.ClarityGrade</td>
          </tr>
          <tr>
            <td class="spec-label">Cut Grade</td>
            <td class="spec-value" style="color:#16a34a;">@Model.CutGrade</td>
          </tr>
        </table>

        <div class="section-heading" style="margin-top:20px;">Additional Grading Information</div>
        <table class="spec-table">
          <tr>
            <td class="spec-label">Polish</td>
            <td class="spec-value">@Model.Polish</td>
          </tr>
          <tr>
            <td class="spec-label">Symmetry</td>
            <td class="spec-value">@Model.Symmetry</td>
          </tr>
          <tr>
            <td class="spec-label">Fluorescence</td>
            <td class="spec-value">@Model.Fluorescence</td>
          </tr>
          <tr>
            <td class="spec-label">Shape &amp; Cutting Style</td>
            <td class="spec-value">@Model.Shape</td>
          </tr>
          <tr>
            <td class="spec-label">Measurements</td>
            <td class="spec-value">@Model.Measurements</td>
          </tr>
        </table>
      </div>

      <!-- Right: Proportions, Laser Inscription, QR -->
      <div>
        <div class="section-heading">Diamond Profile &amp; Proportions</div>
        <div class="diagram-box">
          <div class="diamond-icon-wrap">
            <i class="fa-regular fa-gem"></i>
          </div>
          <div style="font-size:12px; font-weight:700; color:var(--gia-navy);">Ideal Proportions Analysis (@Model.Shape)</div>
          <div class="proportions-list">
            <div>Table<strong>@Model.TablePercentage</strong></div>
            <div>Depth<strong>@Model.DepthPercentage</strong></div>
            <div>Crown<strong>@Model.CrownAngle</strong></div>
            <div>Pavilion<strong>@Model.PavilionAngle</strong></div>
          </div>
        </div>

        <div class="laser-box">
          <div class="laser-title">
            <i class="fa-solid fa-microchip" style="color:var(--gia-gold);"></i> Girdle Laser Inscription Registry
          </div>
          <div style="font-family: monospace; font-size:12px; color:var(--gia-navy); font-weight:700; margin-top:3px; word-break: break-all;">
            @Model.LaserInscription
          </div>
          <div style="font-size:10.5px; color:#64748b; margin-top:2px;">
            Microscopically laser-inscribed on gem girdle for anti-tamper client verification.
          </div>
        </div>

        <div style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:6px; padding:10px 14px; display:flex; align-items:center; gap:12px;">
          <i class="fa-solid fa-qrcode" style="font-size:38px; color:var(--gia-navy);"></i>
          <div>
            <div style="font-size:11px; font-weight:700; color:var(--gia-navy);">@Model.CertType Report Check Online</div>
            <div style="font-size:10px; color:#64748b;">Verify authenticity at gia.edu/report-check using report #@Model.ReportNumber</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Security Footer -->
    <div class="gia-footer">
      <div class="security-badge">
        <div class="security-stamp">
          <span>@Model.CertType</span>
          <span>SEAL</span>
        </div>
        <div>
          <div style="font-weight:700; color:var(--gia-navy);">OFFICIAL @Model.CertType LABORATORY REPORT DOSSIER</div>
          <div>This digital certificate is cryptographically matched to physical laser inscriptions and SAT Jewels records.</div>
        </div>
      </div>
      <div style="text-align:right;">
        <div style="font-weight:700; color:var(--gia-navy);">SAT JEWELS GLOBAL CLIENT SERVICES</div>
        <div>Surat Diamond Bourse, Gujarat, India &bull; Worldwide Insured Express</div>
      </div>
    </div>
  </div>

</body>
</html>
