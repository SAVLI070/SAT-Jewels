          const certUrl = `/Product/GiaCertificate/${encodeURIComponent(item.id || 'sat-prod-8')}?carat=${encodeURIComponent(item.carat || '')}&metal=${encodeURIComponent(item.metal || '')}&stone=${encodeURIComponent(item.stone || '')}&size=${encodeURIComponent(item.size || '')}${item.engraving ? `&engraving=${encodeURIComponent(item.engraving)}` : ''}`;

          html += `
            <div class="rounded-xl bg-surface-container p-6 shadow-md relative overflow-hidden">
