    function validatePostalCodeFormat(postal, country, state) {
      if (!postal) return { valid: false, message: 'Postal / ZIP Code is required.' };
      const clean = postal.trim().toUpperCase();
      const digitsOnly = clean.replace(/\D/g, '');

      if (country === 'United States') {
        if (digitsOnly.length === 6) {
          return {
            valid: false,
            message: `"${postal}" is a 6-digit Indian PIN. For US, enter 5-digit ZIP (e.g. 90210).`
          };
        }
        if (!/^\d{5}(-\d{4})?$/.test(clean)) {
          return { valid: false, message: 'Please enter a valid 5-digit US ZIP code (e.g. 90210 or 10001).' };
        }

        const prefix = clean.substring(0, 2);
        if (state && CART_US_STATE_ZIP_PREFIXES[state]) {
          const allowed = CART_US_STATE_ZIP_PREFIXES[state];
          if (!allowed.includes(prefix)) {
            let foundState = Object.keys(CART_US_STATE_ZIP_PREFIXES).find(s => CART_US_STATE_ZIP_PREFIXES[s].includes(prefix));
            const hint = state === 'California' ? 'e.g. 90001 or 90210' : (state === 'New York' ? 'e.g. 10001 or 10021' : '');
            return {
              valid: false,
              message: foundState 
                ? `ZIP code ${clean} belongs to ${foundState}, not ${state}. ${hint ? '(' + hint + ')' : ''}`
                : `ZIP code ${clean} is not valid for ${state}.`
            };
          }
        }

        return { valid: true, message: `Valid ${state || 'United States'} postal format & armored service area.` };
      }

      if (country === 'India') {
        if (digitsOnly.length === 5) {
          return {
            valid: false,
            message: `"${postal}" is a 5-digit US ZIP. For India, enter 6-digit PIN (e.g. 411001 for Pune, Maharashtra).`
          };
        }
        if (!/^\d{6}$/.test(clean)) {
          return { valid: false, message: 'Please enter a valid 6-digit Indian PIN code (e.g. 411001).' };
        }

        const prefix = clean.substring(0, 2);
        if (state && CART_INDIA_STATE_PIN_PREFIXES[state]) {
          const allowed = CART_INDIA_STATE_PIN_PREFIXES[state];
          if (!allowed.includes(prefix)) {
            let foundState = Object.keys(CART_INDIA_STATE_PIN_PREFIXES).find(s => CART_INDIA_STATE_PIN_PREFIXES[s].includes(prefix));
            const hint = state === 'Maharashtra' ? 'starts with 40-44, e.g. 411001 for Pune' : (state === 'Gujarat' ? 'starts with 36-39, e.g. 395006 for Surat' : '');
            return {
              valid: false,
              message: foundState
                ? `PIN code ${clean} belongs to ${foundState}, not ${state}. ${hint ? '(' + hint + ')' : ''}`
                : `PIN code ${clean} does not match state of ${state}.`
            };
          }
        }

        return { valid: true, message: `Valid ${state || 'India'} PIN format & armored service area.` };
      }

      if (country === 'United Kingdom') {
        if (!/^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/i.test(clean)) {
          return { valid: false, message: 'Please enter a valid UK postcode (e.g. SW1A 1AA).' };
        }
        return { valid: true, message: 'Valid UK postal format & armored service area.' };
      }

      if (country === 'Canada') {
        if (!/^[A-Za-z]\d[A-Za-z][ -]?\d[A-Za-z]\d$/.test(clean)) {
          return { valid: false, message: 'Please enter a valid Canadian Postal Code (e.g. K1A 0B1).' };
        }
        return { valid: true, message: 'Valid Canada postal format & armored service area.' };
      }

      if (country === 'Australia') {
        if (!/^\d{4}$/.test(clean)) {
          return { valid: false, message: 'Please enter a valid 4-digit Australian postcode (e.g. 2000).' };
        }
        return { valid: true, message: 'Valid Australia postal format & armored service area.' };
      }

      if (clean.length < 3) {
        return { valid: false, message: 'Please enter a valid postal code.' };
      }

      return { valid: true, message: `Valid ${country} postal format & armored service area.` };
    }

    function getShippingAddressData() {
      const nameEl = document.getElementById('shipFullName');
      const phoneEl = document.getElementById('shipPhone');
      const streetEl = document.getElementById('shipStreet');
      const cityEl = document.getElementById('shipCity');
      const stateEl = document.getElementById('shipState');
      const postalEl = document.getElementById('shipPostalCode');
      const countryEl = document.getElementById('shipCountry');

      if (!nameEl || !phoneEl || !streetEl || !cityEl || !stateEl || !postalEl || !countryEl) return null;

      const name = nameEl.value.trim();
      const phone = phoneEl.value.trim();
      const street = streetEl.value.trim();
      const city = cityEl.value.trim();
      const state = stateEl.value.trim();
      const postal = postalEl.value.trim();
      const country = countryEl.value.trim();

      if (!name || !phone || !street || !city || !state || !postal) return null;

      const check = validatePostalCodeFormat(postal, country, state);
      if (!check.valid) return null;

      return { name, phone, street, city, state, postal, country };
    }

    function checkAddressValidation() {
      const addr = getShippingAddressData();
      const notice = document.getElementById('addressWarningNotice');
      const icon = document.getElementById('addressStatusIcon');
      const text = document.getElementById('addressStatusText');
      const paypalBox = document.getElementById('paypalContainerBox');
      const feedback = document.getElementById('postalCodeFeedback');
      const postalEl = document.getElementById('shipPostalCode');
      const countryEl = document.getElementById('shipCountry');
      const stateEl = document.getElementById('shipState');

      const postalVal = postalEl ? postalEl.value.trim() : '';
      const countryVal = countryEl ? countryEl.value : 'India';
      const stateVal = stateEl ? stateEl.value : '';

      if (postalVal && feedback) {
        const check = validatePostalCodeFormat(postalVal, countryVal, stateVal);
        feedback.classList.remove('hidden');
        feedback.classList.add('flex');
        if (!check.valid) {
          feedback.className = 'flex items-center gap-1.5 text-error pt-0.5';
          feedback.innerHTML = `<span class="material-symbols-outlined text-[16px]">warning</span> <span class="font-label-sm text-label-sm">${check.message}</span>`;
        } else {
          feedback.className = 'flex items-center gap-1.5 text-tertiary pt-0.5';
          feedback.innerHTML = `<span class="material-symbols-outlined text-[16px]">check_circle</span> <span class="font-label-sm text-label-sm">${check.message}</span>`;
        }
      } else if (feedback) {
        feedback.classList.add('hidden');
        feedback.classList.remove('flex');
      }

      if (addr) {
        if (notice && icon && text) {
          notice.className = 'p-3.5 rounded-lg bg-surface-container-high border border-tertiary/40 flex items-center gap-3 transition-colors';
          icon.className = 'material-symbols-outlined text-tertiary text-[22px]';
          icon.textContent = 'verified_user';
          text.innerHTML = `<strong class="text-tertiary font-semibold">Payment Authorized:</strong> Shipping address verified for ${addr.country}. Select your payment gateway below.`;
        }
        if (paypalBox) {
          paypalBox.classList.remove('opacity-50', 'pointer-events-none');
        }
        return true;
      } else {
        if (notice && icon && text) {
          notice.className = 'p-3.5 rounded-lg bg-surface-container-low border border-outline-variant/30 flex items-center gap-3 transition-colors';
          icon.className = 'material-symbols-outlined text-primary text-[22px]';
          icon.textContent = 'lock';
          text.innerHTML = `<strong class="text-primary font-semibold">Address &amp; Mobile Required:</strong> Complete your delivery address and contact phone number above to unlock payment.`;
        }
        if (paypalBox) {
          paypalBox.classList.add('opacity-50', 'pointer-events-none');
        }
        return false;
      }
    }

    function toggleWireDetails() {
      const wire = document.getElementById('wire-payment-details');
      if (wire) wire.classList.toggle('hidden');
    }

    let noticeToastTimer = null;
    function showCartNoticeToast(title, message, type = 'info') {
      const toast = document.getElementById('satNoticeToast');
      if (!toast) return;

      const titleEl = document.getElementById('satNoticeToastTitle');
      const msgEl = document.getElementById('satNoticeToastMsg');
      const iconWrap = document.getElementById('satNoticeToastIconWrap');
      const iconEl = document.getElementById('satNoticeToastIcon');

      if (titleEl) titleEl.textContent = title;
      if (msgEl) msgEl.textContent = message;

      if (iconWrap && iconEl) {
        if (type === 'error' || type === 'danger') {
          iconWrap.className = 'w-9 h-9 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0';
          iconEl.textContent = 'error';
        } else if (type === 'warning') {
          iconWrap.className = 'w-9 h-9 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0';
          iconEl.textContent = 'warning';
        } else if (type === 'success') {
          iconWrap.className = 'w-9 h-9 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0';
          iconEl.textContent = 'check_circle';
        } else {
          iconWrap.className = 'w-9 h-9 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0';
          iconEl.textContent = 'info';
        }
      }

      toast.classList.remove('-translate-y-10', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');

      clearTimeout(noticeToastTimer);
      noticeToastTimer = setTimeout(() => {
        closeNoticeToast();
      }, 4500);
    }

    function closeNoticeToast() {
      const toast = document.getElementById('satNoticeToast');
      if (toast) {
        toast.classList.add('-translate-y-10', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }
    }

    function validateAddressFieldsInteractive() {
      const nameEl = document.getElementById('shipFullName');
      const phoneEl = document.getElementById('shipPhone');
      const streetEl = document.getElementById('shipStreet');
      const cityEl = document.getElementById('shipCity');
      const stateEl = document.getElementById('shipState');
      const postalEl = document.getElementById('shipPostalCode');
      const countryEl = document.getElementById('shipCountry');

      const name = nameEl ? nameEl.value.trim() : '';
      const phone = phoneEl ? phoneEl.value.trim() : '';
      const street = streetEl ? streetEl.value.trim() : '';
      const city = cityEl ? cityEl.value.trim() : '';
      const state = stateEl ? stateEl.value.trim() : '';
      const postal = postalEl ? postalEl.value.trim() : '';
      const country = countryEl ? countryEl.value : 'India';

      let missing = [];
      if (!street || street.length < 5) missing.push('Home Delivery Street Address');
      if (!phone || phone.replace(/\D/g, '').length < 7) missing.push('Contact Mobile Number');
      if (!name) missing.push('Recipient Full Name');
      if (!city) missing.push('City / Town');
      if (!postal) missing.push('Postal / ZIP Code');

      if (missing.length > 0) {
        // If inputs were hidden, reveal them so user can enter the missing details
        showAddressInputForm(true);

        if (streetEl && (!street || street.length < 5)) {
          streetEl.style.borderColor = '#f43f5e';
          streetEl.style.boxShadow = '0 0 0 2px rgba(244, 63, 94, 0.4)';
        }
        if (phoneEl && (!phone || phone.replace(/\D/g, '').length < 7)) {
          phoneEl.style.borderColor = '#f43f5e';
          phoneEl.style.boxShadow = '0 0 0 2px rgba(244, 63, 94, 0.4)';
        }

        const missingText = missing.join(', ');
        if (window.Swal) {
          Swal.fire({
            icon: 'warning',
            title: 'Shipping Details Incomplete',
            html: `<p style="color:#d4b878;font-size:15px;margin-bottom:8px;"><strong>Delivery Address &amp; Mobile Number are required.</strong></p><p style="color:#a1a1aa;font-size:13px;">Please complete: <strong>${missingText}</strong> before proceeding to payment.</p>`,
            confirmButtonColor: '#d4b878',
            background: '#16141a',
            color: '#ffffff'
          }).then(() => {
            const target = (!street || street.length < 5) ? streetEl : ((!phone || phone.replace(/\D/g, '').length < 7) ? phoneEl : nameEl);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'center' });
              target.focus();
            }
          });
        } else {
          showCartNoticeToast("Shipping Details Incomplete", `Please provide your ${missingText} before proceeding to payment.`, "error");
        }
        return false;
      }

      // Check postal code
      const postalCheck = validatePostalCodeFormat(postal, country, state);
      if (!postalCheck.valid) {
        showAddressInputForm(true);
        if (postalEl) {
          postalEl.style.borderColor = '#f43f5e';
          postalEl.style.boxShadow = '0 0 0 2px rgba(244, 63, 94, 0.4)';
          postalEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          postalEl.focus();
        }
        if (window.Swal) {
          Swal.fire({
            icon: 'warning',
            title: 'Invalid Postal Code',
            text: postalCheck.message,
            confirmButtonColor: '#d4b878',
            background: '#16141a',
            color: '#ffffff'
          });
        } else {
          showCartNoticeToast("Invalid Postal Code", postalCheck.message, "warning");
        }
        return false;
      }

      [nameEl, phoneEl, streetEl, cityEl, stateEl, postalEl].forEach(el => {
        if (el) {
          el.style.borderColor = '';
          el.style.boxShadow = '';
        }
      });

      checkAddressValidation();
      return true;
    }

    function scrollToPaymentOrAction() {
      if (!isUserAuthenticated) {
        if (window.Swal) {
          Swal.fire({
            icon: 'warning',
            title: 'Authentication Required',
            text: 'Please sign in to your SAT Jewel account before completing order dispatch.',
            confirmButtonColor: '#d4b878',
            background: '#16141a',
            color: '#ffffff'
          }).then(() => {
            window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
          });
        } else {
          showCartNoticeToast("Authentication Required", "Please sign in to your SAT Jewel account before completing order dispatch.", "warning");
          setTimeout(() => {
            window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
          }, 1200);
        }
        return;
      }

      if (!validateAddressFieldsInteractive()) return;

      const paypalBox = document.getElementById('paypalContainerBox');
      if (paypalBox) {
        paypalBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        showCartNoticeToast("Address Confirmed", "Shipping address verified. Select your payment gateway below.", "success");
      }
    }

    function handleMobilePaymentClick() {
      if (!isUserAuthenticated) {
        showCartNoticeToast("Authentication Required", "Please sign in to your SAT Jewel account to proceed with payment.", "warning");
        setTimeout(() => {
          window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        }, 1200);
        return;
      }

      const items = getActiveCartItems();
      if (!items || items.length === 0) {
        showCartNoticeToast("Bag Empty", "Your shopping bag is empty. Please select a fine jewelry creation first.", "warning");
        return;
      }

      if (!validateAddressFieldsInteractive()) return;

      const paypalBox = document.getElementById('paypalContainerBox');
      if (paypalBox) {
        paypalBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        showCartNoticeToast("Address Confirmed", "Proceed with instant PayPal checkout below.", "success");
      }
    }

    function showPaymentProcessing(msg) {
      const el = document.getElementById('paymentProcessingOverlay');
      const msgEl = document.getElementById('processingOverlayMessage');
      const player = document.getElementById('paymentCreditCardLottie');
      if (msgEl && msg) msgEl.textContent = msg;
      if (player && typeof player.play === 'function') {
        try { player.play(); } catch(e) {}
      }
      if (el) el.style.display = 'flex';
    }

    function hidePaymentProcessing() {
      const el = document.getElementById('paymentProcessingOverlay');
      if (el) el.style.display = 'none';
      const player = document.getElementById('paymentCreditCardLottie');
      if (player && typeof player.stop === 'function') {
        try { player.stop(); } catch(e) {}
      }
    }

    function isPhysicalCertSelected() {
      const chk = document.getElementById('gia-checkbox');
      return chk ? chk.checked : (localStorage.getItem('sat_cart_physical_cert') === 'true');
    }

    // PayPal Official Smart Buttons Integration
    function initPayPalButtons() {
      if (typeof paypal === 'undefined') return;

      const container = document.getElementById('paypal-button-container');
      const stickyContainer = document.getElementById('sticky-paypal-button-container');
      if (!container && !stickyContainer) return;
      if (container) container.innerHTML = '';
      if (stickyContainer) stickyContainer.innerHTML = '';

      const paypalConfig = {
        style: {
          layout: 'vertical',
          color:  'gold',
          shape:  'rect',
          label:  'paypal'
        },

        onClick: function(data, actions) {
          if (!isUserAuthenticated) {
            if (typeof Swal !== 'undefined') {
              Swal.fire({
                icon: 'warning',
                title: 'Sign In Required',
                text: 'Please sign in to your account before proceeding to payment.',
                confirmButtonColor: '#b45309',
                background: '#18181b',
                color: '#ffffff'
              }).then(() => {
                window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
              });
            } else {
              window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
            }
            return actions.reject();
          }

          if (!validateAddressFieldsInteractive()) {
            return actions.reject();
          }
          showPaymentProcessing("PayPal checkout window is active. Please complete payment in the PayPal window...");
          return actions.resolve();
        },

        createOrder: async function(data, actions) {
          showPaymentProcessing("Connecting with PayPal & securing transaction session...");
          const addr = getShippingAddressData();
          if (!addr) {
            hidePaymentProcessing();
            validateAddressFieldsInteractive();
            throw new Error('Shipping address incomplete.');
          }

          const cartItems = getActiveCartItems();
          const firstItemId = cartItems.length > 0 ? (cartItems[0].id || cartItems[0].catalogItemId || 'sat-prod-8') : 'sat-prod-8';
          const qty = cartItems.length > 0 ? (Number(cartItems[0].quantity) || 1) : 1;
          const mappedCartItems = cartItems.map(item => ({
            productId: item.id || item.catalogItemId || 'sat-prod-8',
            name: item.name || 'Bespoke Fine Jewelry',
            quantity: Number(item.quantity) || 1,
            stoneType: item.stone || item.stoneType || 'Lab Grown Diamond',
            metal: item.metal || '',
            size: item.size || '',
            priceUSD: Number(item.priceUSD) || 0
          }));

          try {
            const res = await fetch('/api/payment/create-order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                productId: firstItemId,
                quantity: qty,
                stoneType: cartItems[0]?.stone || cartItems[0]?.stoneType || 'Lab Grown Diamond',
                metal: cartItems[0]?.metal || '',
                ringSize: cartItems[0]?.size || '',
                cartItems: mappedCartItems,
                includePhysicalCertificate: isPhysicalCertSelected(),
                shippingFullName: addr.name,
                shippingPhone: addr.phone,
                shippingStreet: addr.street,
                shippingCity: addr.city,
                shippingState: addr.state,
                shippingPostalCode: addr.postal,
                shippingCountry: addr.country
              })
            });

            const result = await res.json();
            if (result.success && result.orderId) {
              return result.orderId;
            } else {
              hidePaymentProcessing();
              if (typeof Swal !== 'undefined') {
                Swal.fire({
                  icon: 'error',
                  title: 'Order Initialization Error',
                  text: result.message || 'Server error initializing PayPal transaction.',
                  confirmButtonColor: '#b45309'
                });
              } else {
                alert('Error initializing PayPal order: ' + (result.message || 'Server error'));
              }
              throw new Error(result.message);
            }
          } catch (err) {
            hidePaymentProcessing();
            console.error('PayPal createOrder error:', err);
            throw err;
          }
        },

        onApprove: function(data, actions) {
          showPaymentProcessing("Confirming PayPal payment authorization with server-authoritative verification. Please do not close this window...");
          return fetch('/api/payment/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ payPalOrderId: data.orderID })
          })
          .then(res => res.json())
          .then(result => {
            hidePaymentProcessing();
            if (result.success) {
              const key = getCartStorageKey();
              const savedCart = localStorage.getItem(key);
              const cartItems = savedCart ? JSON.parse(savedCart) : [];
              const firstItemId = cartItems.length > 0 ? (cartItems[0].id || cartItems[0].catalogItemId || 'sat-prod-8') : 'sat-prod-8';
              localStorage.removeItem(key);

              try {
                sessionStorage.setItem('sat_pending_review_item', JSON.stringify({
                  productId: firstItemId,
                  productName: cartItems[0]?.name || 'Bespoke Fine Jewelry',
                  orderId: result.orderId || data.orderID
                }));
              } catch(e) {}

              const confirmedOrderId = result.orderId || data.orderID;
              window.location.href = '/Order/Confirmation?orderId=' + encodeURIComponent(confirmedOrderId);
            } else {
              if (typeof Swal !== 'undefined') {
                Swal.fire({
                  icon: 'warning',
                  title: 'Verification Notice',
                  text: result.message || 'Payment verification response requires attention.',
                  confirmButtonColor: '#b45309'
                });
              } else {
                alert('⚠️ PayPal Verification Warning: ' + result.message);
              }
            }
          })
          .catch(err => {
            hidePaymentProcessing();
            console.error('PayPal Verify Error:', err);
            if (typeof Swal !== 'undefined') {
              Swal.fire({
                icon: 'error',
                title: 'Verification Error',
                text: 'Unable to verify payment with PayPal. Please check your account or contact support.',
                confirmButtonColor: '#b45309'
              });
            } else {
              alert('Verification Error: Unable to verify payment with PayPal. Please check your account or contact support.');
            }
          });
        },

        onCancel: function(data) {
          hidePaymentProcessing();
          showCartNoticeToast("Checkout Paused", "PayPal checkout was cancelled. Your items remain safely in your cart.", "info");
        },

        onError: function(err) {
          hidePaymentProcessing();
          console.error('PayPal Checkout Error:', err);
          if (typeof Swal !== 'undefined') {
            Swal.fire({
              icon: 'error',
              title: 'Checkout Error',
              text: 'An error occurred during PayPal checkout. Please ensure your shipping details are entered and try again.',
              confirmButtonColor: '#b45309'
            });
          } else {
            alert('An error occurred during PayPal checkout. Please ensure your shipping details are entered and try again.');
          }
        }
      };

      if (container) {
        paypal.Buttons(paypalConfig).render('#paypal-button-container');
      }

      if (stickyContainer) {
        paypal.Buttons({
          ...paypalConfig,
          style: { layout: 'horizontal', color: 'gold', shape: 'rect', label: 'paypal', tagline: false, height: 46 }
        }).render('#sticky-paypal-button-container');
      }
    }

    // Razorpay Embedded Card Payment
    async function payWithRazorpay() {
      if (!isUserAuthenticated) {
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            icon: 'warning',
            title: 'Sign In Required',
            text: 'You must sign in to your account before proceeding to payment.',
            confirmButtonColor: '#b45309',
            background: '#18181b',
            color: '#ffffff'
          }).then(() => {
            window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
          });
        } else {
          window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        }
        return;
      }

      if (!validateAddressFieldsInteractive()) return;

      const addr = getShippingAddressData();
      if (!addr) return;

      const cartItems = getActiveCartItems();
      const firstItemId = cartItems.length > 0 ? (cartItems[0].id || cartItems[0].catalogItemId || 'sat-prod-8') : 'sat-prod-8';
      const qty = cartItems.length > 0 ? (Number(cartItems[0].quantity) || 1) : 1;
      const mappedCartItems = cartItems.map(item => ({
        productId: item.id || item.catalogItemId || 'sat-prod-8',
        name: item.name || 'Bespoke Fine Jewelry',
        quantity: Number(item.quantity) || 1,
        stoneType: item.stone || item.stoneType || 'Lab Grown Diamond',
        metal: item.metal || '',
        size: item.size || '',
        priceUSD: Number(item.priceUSD) || 0
      }));

      try {
        const res = await fetch('/api/payment/razorpay/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: firstItemId,
            quantity: qty,
            stoneType: cartItems[0]?.stone || cartItems[0]?.stoneType || 'Lab Grown Diamond',
            metal: cartItems[0]?.metal || '',
            ringSize: cartItems[0]?.size || '',
            cartItems: mappedCartItems,
            includePhysicalCertificate: isPhysicalCertSelected(),
            shippingFullName: addr.name,
            shippingPhone: addr.phone,
            shippingStreet: addr.street,
            shippingCity: addr.city,
            shippingState: addr.state,
            shippingPostalCode: addr.postal,
            shippingCountry: addr.country
          })
        });

        const data = await res.json();
        if (!data.success) {
          if (typeof Swal !== 'undefined') {
            Swal.fire({
              icon: 'error',
              title: 'Order Initialization Error',
              text: data.message || 'Error initializing Razorpay order.',
              confirmButtonColor: '#b45309'
            });
          } else {
            alert('Error initializing Razorpay order: ' + data.message);
          }
          return;
        }

        const options = {
          key: data.keyId,
          amount: Math.round(data.amountUSD * 100),
          currency: 'USD',
          name: 'SAT Luxury Jewellery',
          description: 'Bespoke Fine Jewelry Order',
          image: '/assets/sat_logo_transparent.png',
          order_id: data.razorpayOrderId,
          handler: async function (response) {
            showPaymentProcessing("Verifying Razorpay card signature server-side. Please do not close this window...");
            try {
              const verifyRes = await fetch('/api/payment/razorpay/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpayOrderId: response.razorpay_order_id,
                  razorpayPaymentId: response.razorpay_payment_id,
                  razorpaySignature: response.razorpay_signature
                })
              });

              const verifyResult = await verifyRes.json();
              hidePaymentProcessing();

              if (verifyResult.success) {
                localStorage.removeItem(getCartStorageKey());
                try {
                  sessionStorage.setItem('sat_pending_review_item', JSON.stringify({
                    productId: firstItemId,
                    productName: cartItems[0]?.name || 'Bespoke Fine Jewelry',
                    orderId: verifyResult.orderId || response.razorpay_order_id
                  }));
                } catch(e) {}
                const confirmedOrderId = verifyResult.orderId || response.razorpay_order_id;
                if (window.showDiamondLoader) window.showDiamondLoader('Securing Order Confirmation...');
                window.location.href = '/Order/Confirmation?orderId=' + encodeURIComponent(confirmedOrderId);
              } else {
                if (typeof Swal !== 'undefined') {
                  Swal.fire({
                    icon: 'warning',
                    title: 'Verification Warning',
                    text: verifyResult.message || 'Signature verification alert.',
                    confirmButtonColor: '#b45309'
                  });
                } else {
                  alert('⚠️ Razorpay Signature Verification Alert: ' + verifyResult.message);
                }
              }
            } catch (err) {
              hidePaymentProcessing();
              if (typeof Swal !== 'undefined') {
                Swal.fire({
                  icon: 'error',
                  title: 'Verification Error',
                  text: 'Error verifying Razorpay payment signature.',
                  confirmButtonColor: '#b45309'
                });
              } else {
                alert('Error verifying Razorpay payment signature.');
              }
            }
          },
          prefill: {
            name: addr.name,
            contact: addr.phone
          },
          theme: {
            color: '#d4af37'
          },
          modal: {
            ondismiss: function() {
              hidePaymentProcessing();
            }
          }
        };

        showPaymentProcessing("Processing card payment. Please enter your card credentials in the checkout window...");
        const rzp = new Razorpay(options);
        rzp.open();
      } catch (err) {
        hidePaymentProcessing();
        console.error('Razorpay Checkout Exception:', err);
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            icon: 'error',
            title: 'Payment Error',
            text: 'An error occurred during Razorpay card checkout. Please try again.',
            confirmButtonColor: '#b45309'
          });
        } else {
          alert('An error occurred during Razorpay card checkout. Please try again.');
        }
      }
    }
  </script>

  <!-- Global Search Modal -->
  <partial name="_SearchModal" />

