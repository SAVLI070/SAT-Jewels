    function toggleGiaHardcopy(el) {
      const checkbox = document.getElementById('gia-checkbox');
      const isChecked = checkbox ? checkbox.checked : false;
      localStorage.setItem('sat_cart_physical_cert', isChecked ? 'true' : 'false');
      
      const giaRow = document.getElementById('summary-gia-row');
      const totalDisplay = document.getElementById('order-summary-total');
      const totalBannerDisplay = document.getElementById('banner-subtotal-display');
      const cardContainer = document.getElementById('giaCardContainer');

      const giaPrice = isChecked ? 50 : 0;
      const newTotalNum = currentRawItemsTotal + giaPrice;
      currentCartTotal = newTotalNum;
      const formattedTotal = '$' + newTotalNum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';

      if (isChecked) {
        if (giaRow) {
          giaRow.classList.remove('hidden');
