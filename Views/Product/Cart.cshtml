@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    ViewData["Title"] = "Bespoke Shopping Cart & Secure Checkout";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var payPalClientId = Configuration["PayPal:ClientId"] ?? "sb";
    var savedAddresses = ViewBag.SavedAddresses as List<SAT1.Models.UserAddress> ?? new List<SAT1.Models.UserAddress>();
}
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport" />
  <meta content="web_standard" name="shell-type" />
  <title>Bespoke Shopping Cart &amp; Secure Checkout — SAT Jewel Sanctuary</title>
  <link rel="icon" type="image/png" href="/assets/sat_emblem_clean.png" />
  <link rel="shortcut icon" type="image/png" href="/assets/sat_emblem_clean.png" />
  <link rel="apple-touch-icon" href="/assets/sat_emblem_clean.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <style>
    @@layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
      main > :first-child { margin-top: 0 !important; }
      main > :last-child { margin-bottom: 0 !important; }
    }
    ::-webkit-scrollbar { display: none; }

    @@keyframes spinDiamond {
      0% { transform: rotate(0deg) scale(1); }
      50% { transform: rotate(180deg) scale(1.1); }
      100% { transform: rotate(360deg) scale(1); }
    }
  </style>

  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary": "#e4c277",
            "on-secondary-container": "#d5b46b",
            "on-primary-fixed-variant": "#574500",
            "surface-container-high": "#2a2a2b",
            "on-surface-variant": "#d0c5af",
            "tertiary-fixed-dim": "#26e19a",
            "secondary-fixed-dim": "#e4c277",
            "tertiary": "#36eaa1",
            "primary-container": "#d4af37",
            "surface-dim": "#131314",
            "on-error": "#690005",
            "primary-fixed": "#ffe088",
            "surface-container-low": "#1c1b1c",
            "surface-variant": "#353436",
            "inverse-on-surface": "#313031",
            "on-tertiary-fixed-variant": "#005234",
            "inverse-surface": "#e5e2e3",
            "primary": "#f2ca50",
            "surface-tint": "#e9c349",
            "background": "#131314",
            "error": "#ffb4ab",
            "on-surface": "#e5e2e3",
            "surface": "#131314",
            "on-secondary-fixed": "#251a00",
            "surface-container-lowest": "#0e0e0f",
            "tertiary-fixed": "#53feb4",
            "outline": "#99907c",
            "surface-container": "#201f20",
            "on-tertiary": "#003823",
            "secondary-fixed": "#ffdf9b",
            "on-primary-container": "#554300",
            "on-secondary-fixed-variant": "#5a4302",
            "on-primary-fixed": "#241a00",
            "surface-bright": "#3a393a",
            "on-primary": "#3c2f00",
            "on-tertiary-fixed": "#002112",
            "secondary-container": "#5d4604",
            "error-container": "#93000a",
            "on-secondary": "#3f2e00",
            "surface-container-highest": "#353436",
            "on-tertiary-container": "#005033",
            "primary-fixed-dim": "#e9c349",
            "on-error-container": "#ffdad6",
            "on-background": "#e5e2e3",
            "inverse-primary": "#735c00",
            "tertiary-container": "#00cc89",
            "outline-variant": "#4d4635"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          spacing: {
            "gutter": "1.5rem",
            "space-md": "1rem",
            "space-sm": "0.5rem",
            "margin": "3rem",
            "space-2xl": "4rem",
            "space-lg": "1.5rem",
            "gutter-mobile": "1rem",
            "margin-mobile": "1.25rem",
            "space-xs": "0.25rem",
            "space-xl": "2.5rem"
          },
          fontFamily: {
            "headline-sm": ["Playfair Display", "serif"],
            "headline-lg": ["Playfair Display", "serif"],
            "display-hero": ["Playfair Display", "serif"],
            "headline-md": ["Playfair Display", "serif"],
            "label-sm": ["Plus Jakarta Sans", "sans-serif"],
            "body-lg": ["Plus Jakarta Sans", "sans-serif"],
            "body-sm": ["Plus Jakarta Sans", "sans-serif"],
            "body-md": ["Plus Jakarta Sans", "sans-serif"],
            "label-md": ["Plus Jakarta Sans", "sans-serif"],
            "label-caps": ["Plus Jakarta Sans", "sans-serif"],
            "headline-lg-mobile": ["Playfair Display", "serif"],
            "display-hero-mobile": ["Playfair Display", "serif"]
          },
          fontSize: {
            "headline-sm": ["20px", { lineHeight: "28px", fontWeight: "500" }],
            "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "500" }],
            "display-hero": ["52px", { lineHeight: "64px", letterSpacing: "-0.02em", fontWeight: "600" }],
            "headline-md": ["24px", { lineHeight: "32px", fontWeight: "500" }],
            "label-sm": ["12px", { lineHeight: "16px", fontWeight: "500" }],
            "body-lg": ["16px", { lineHeight: "26px", fontWeight: "400" }],
            "body-sm": ["13px", { lineHeight: "20px", fontWeight: "400" }],
            "body-md": ["14px", { lineHeight: "22px", fontWeight: "400" }],
            "label-md": ["13px", { lineHeight: "18px", fontWeight: "600" }],
            "label-caps": ["11px", { lineHeight: "16px", letterSpacing: "0.12em", fontWeight: "700" }],
            "headline-lg-mobile": ["26px", { lineHeight: "34px", letterSpacing: "0em", fontWeight: "500" }],
            "display-hero-mobile": ["34px", { lineHeight: "42px", letterSpacing: "-0.01em", fontWeight: "600" }]
          }
        }
      }
    };
  </script>

  <!-- Dual Official Payment Gateways: PayPal SDK + Razorpay Checkout.js -->
  <script src="https://www.paypal.com/sdk/js?client-id=@(payPalClientId)&currency=USD&enable-funding=venmo,paylater"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>

<body class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary-container">

  <!-- Fixed Top Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-surface/95 backdrop-blur-xl border-b border-outline-variant/30">
    <div class="h-16 max-w-[1240px] mx-auto px-6 flex items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <a class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors text-label-sm font-label-md font-medium" href="javascript:void(0);" onclick="if(window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }">
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          <span>Back</span>
        </a>
        <div class="h-4 w-[1px] bg-outline-variant/40"></div>
        <a class="flex items-center gap-2.5 group" href="/">
          <img src="/assets/sat_emblem_clean.png" alt="SAT Jewels Logo" class="w-8 h-8 rounded-full object-contain border border-primary/30" />
          <span style="font-family: var(--font-serif, 'Playfair Display', serif); font-size: 19px; font-weight: 700; color: #ffffff; letter-spacing: 0.03em; line-height: 1; white-space: nowrap; display: flex; align-items: center;">SAT <span style="margin-left: 4px; color: #d4b878;">Jewel</span></span>
        </a>
      </div>

      <div class="flex items-center gap-3">
        <button type="button" class="relative p-2 text-on-surface-variant hover:text-primary transition-colors" onclick="openSatGlobalSearch(event)" title="Search Fine Jewelry">
          <span class="material-symbols-outlined text-[20px]">search</span>
        </button>
        <a class="relative p-2 text-on-surface-variant hover:text-primary transition-colors" href="/Product/Cart" title="Cart">
          <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
          <span id="navCartBadge" class="absolute top-1 right-1 w-4 h-4 rounded-full bg-primary text-on-primary font-label-caps text-[9px] flex items-center justify-center font-bold">0</span>
        </a>
        @if (isAuthenticated)
        {
          var displayInitial = string.IsNullOrEmpty(userName) ? "U" : userName.Substring(0, 1).ToUpper();
          <a class="flex items-center gap-2 pl-2 pr-1 py-1 rounded-full bg-surface-container hover:bg-surface-container-high transition-colors" href="/Account/MyAccount">
            <span class="font-label-sm text-label-sm text-on-surface font-medium hidden sm:inline">@(string.IsNullOrEmpty(userName) ? "My Account" : userName)</span>
            <div class="w-7 h-7 rounded-full bg-primary flex items-center justify-center font-bold text-on-primary text-[12px]">@displayInitial</div>
          </a>
        }
        else
        {
          <a class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary text-on-primary font-label-sm text-label-sm font-bold hover:bg-primary-fixed transition-colors" href="/Account/SignIn?returnUrl=/Product/Cart">
            <span class="material-symbols-outlined text-[16px]">person</span>
            <span>Sign In</span>
          </a>
        }
      </div>
    </div>
  </header>

  <!-- Main View -->
  <main class="w-full bg-surface pt-20">
    <div class="flex flex-col w-full">

      <!-- Navigation / Reservation Timer Bar -->
      <div class="w-full bg-surface-container-lowest py-3">
        <div class="max-w-[1180px] mx-auto px-6 flex items-center justify-end">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container font-label-caps text-label-caps text-tertiary">
              <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
              <span id="reservationTimer">Cart Vault Reserved (14:32 remaining)</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Main Checkout Container Canvas -->
      <section class="max-w-[1180px] mx-auto w-full px-6 py-8">

        <!-- Title and Executive Stepper Header -->
        <div class="space-y-6 mb-10">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="font-label-caps text-label-caps uppercase tracking-widest text-primary">Private Client Reservation</span>
                <span class="text-outline-variant">•</span>
                <span class="font-label-caps text-label-caps uppercase tracking-wider text-on-surface-variant">Order Ref #SJ-2026-9481</span>
              </div>
              <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Bespoke Shopping Cart &amp; Secure Checkout</h1>
              <p class="font-body-md text-body-md text-on-surface-variant mt-1">Review your certified diamond solitaire creation prior to insured armored transit and cryptographic checkout.</p>
            </div>
            <!-- Discreet Security Seal Pill -->
            <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-surface-container-low shadow-sm">
              <span class="material-symbols-outlined text-primary text-[20px]">lock_clock</span>
              <div class="text-left leading-tight">
                <p class="font-label-caps text-[10px] uppercase tracking-wider text-on-surface">End-to-End Encrypted</p>
                <p class="font-label-sm text-label-sm text-tertiary font-semibold">256-Bit TLS Bank Level</p>
              </div>
            </div>
          </div>

          <!-- 3-Step Checkout Milestone Ribbon -->
          <div class="p-4 rounded-xl bg-surface-container-low shadow-sm">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <!-- Step 1 -->
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-sm text-label-sm font-bold shadow-[0_0_12px_rgba(212,175,55,0.35)]">
                  <span class="material-symbols-outlined text-[18px]">done</span>
                </div>
                <div>
                  <p class="font-label-caps text-[10px] text-primary uppercase tracking-wider">Step 01</p>
                  <p class="font-label-md text-label-md text-on-surface font-medium">Bespoke Spec &amp; Item</p>
                </div>
              </div>
              <!-- Step 2 -->
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-surface-container-high text-primary flex items-center justify-center font-label-sm text-label-sm font-bold shadow-[0_0_10px_rgba(212,175,55,0.2)]">
                  2
                </div>
                <div>
                  <p class="font-label-caps text-[10px] text-primary uppercase tracking-wider">Step 02 [ACTIVE]</p>
                  <p class="font-label-md text-label-md text-on-surface font-semibold">Insured Delivery Vault</p>
                </div>
              </div>
              <!-- Step 3 -->
              <div class="flex items-center gap-3 opacity-70">
                <div class="w-8 h-8 rounded-full bg-surface-container text-on-surface-variant flex items-center justify-center font-label-sm text-label-sm font-semibold">
                  3
                </div>
                <div>
                  <p class="font-label-caps text-[10px] text-on-surface-variant uppercase tracking-wider">Step 03</p>
                  <p class="font-label-md text-label-md text-on-surface-variant">Instant Payment Gate</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2-Column Luxury Architecture: Left (Review & Address & Gateway), Right (Summary Vault) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

          <!-- ==================== LEFT COLUMN (7-8 COLS) ==================== -->
          <div class="lg:col-span-7 xl:col-span-8 space-y-6">

            <!-- 1. CART ITEMS VAULT CONTAINER -->
            <div id="cartItemsContainer" class="space-y-4">
              <!-- Dynamically populated by renderCart() -->
            </div>

            <!-- 2. HOME DELIVERY SHIPPING ADDRESS VAULT -->
            @if (isAuthenticated)
            {
              <div class="rounded-xl bg-surface-container p-6 shadow-md space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2">
                  <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-primary text-[22px]">local_shipping</span>
                    <h3 class="font-headline-sm text-headline-sm text-on-surface">Home Delivery Shipping Address</h3>
                  </div>
                  <span class="inline-flex items-center px-2.5 py-1 rounded bg-secondary-container/40 text-on-secondary-container font-label-caps text-[10px] font-bold tracking-wider uppercase">
                    [ Required for Insured Dispatch ]
                  </span>
                </div>

                <!-- Quick Select from Saved Address Vault -->
                @if (savedAddresses.Count > 0)
                {
                  <div class="p-4 rounded-lg bg-surface-container-low space-y-2">
                    <div class="flex items-center justify-between">
                      <label class="font-label-caps text-label-caps text-primary uppercase tracking-wider flex items-center gap-1.5" for="address-vault-select">
                        <span class="material-symbols-outlined text-[15px]">bookmark</span>
                        <span>Quick Select From Saved Address Vault:</span>
                      </label>
                      <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors underline-offset-2 hover:underline" href="/Account/MyAccount?tab=addresses">Manage Vault (@savedAddresses.Count Saved)</a>
                    </div>
                    <div class="relative">
                      <select class="w-full bg-surface-container-highest text-on-surface font-body-md text-body-md rounded-lg px-4 py-3 appearance-none focus:outline-none focus:bg-surface-bright cursor-pointer pr-10" id="address-vault-select" onchange="loadSavedAddress(this.value)">
                        <option value="">-- Choose a Saved Shipping Address --</option>
                        @foreach (var addr in savedAddresses)
                        {
                          <option value="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(addr))" selected="@(addr.IsDefault ? "selected" : null)">
                            @(addr.IsDefault ? "⭐ [DEFAULT] " : "")@addr.FullName - @addr.StreetAddress, @addr.City, @addr.State (@addr.Country - @addr.PostalCode)
                          </option>
                        }
                      </select>
                      <span class="material-symbols-outlined text-on-surface-variant text-[20px] absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none">unfold_more</span>
                    </div>
                  </div>
                }

                <!-- Address Input Form Grid -->
                <form id="shippingAddressForm" oninput="checkAddressValidation()" onsubmit="return false;">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Full Name -->
                    <div class="space-y-1.5">
                      <label class="block font-label-sm text-label-sm text-on-surface-variant">Recipient Full Name <span class="text-primary">*</span></label>
                      <div class="relative">
                        <input class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-lg px-3.5 py-2.5 focus:outline-none focus:bg-surface-container-high transition-colors" id="shipFullName" type="text" value="@userName" placeholder="e.g. Sahil Khurana" required />
                        <span class="material-symbols-outlined text-on-surface-variant text-[18px] absolute right-3 top-1/2 -translate-y-1/2">person</span>
                      </div>
                    </div>

                    <!-- Phone Number -->
                    <div class="space-y-1.5">
                      <label class="block font-label-sm text-label-sm text-on-surface-variant">Contact Phone (For Courier Tracking SMS) <span class="text-primary">*</span></label>
                      <div class="relative">
                        <input class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-lg px-3.5 py-2.5 focus:outline-none focus:bg-surface-container-high transition-colors" id="shipPhone" type="tel" placeholder="+91 81282 91686" required />
                        <span class="material-symbols-outlined text-on-surface-variant text-[18px] absolute right-3 top-1/2 -translate-y-1/2">call</span>
                      </div>
                    </div>

                    <!-- Street Address (Spans 2 columns) -->
                    <div class="md:col-span-2 space-y-1.5">
                      <label class="block font-label-sm text-label-sm text-on-surface-variant">Home Delivery Street Address <span class="text-primary">*</span></label>
                      <input class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-lg px-3.5 py-2.5 focus:outline-none focus:bg-surface-container-high transition-colors" id="shipStreet" type="text" placeholder="Jalalpore road, Flat 402, Royal Residency" required />
                    </div>

                    <!-- City / Town -->
                    <div class="space-y-1.5">
                      <label class="block font-label-sm text-label-sm text-on-surface-variant">City / Town <span class="text-primary">*</span></label>
                      <input class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-lg px-3.5 py-2.5 focus:outline-none focus:bg-surface-container-high transition-colors" id="shipCity" type="text" placeholder="Navasari" required />
                    </div>

                    <!-- State / Province / Region -->
                    <div class="space-y-1.5">
                      <label class="block font-label-sm text-label-sm text-on-surface-variant">State / Province / Region <span class="text-primary">*</span></label>
                      <input class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-lg px-3.5 py-2.5 focus:outline-none focus:bg-surface-container-high transition-colors" id="shipState" type="text" placeholder="Gujarat" required />
                    </div>

                    <!-- Postal / ZIP Code -->
                    <div class="space-y-1.5">
                      <label class="block font-label-sm text-label-sm text-on-surface-variant">Postal / ZIP Code <span class="text-primary">*</span></label>
                      <input class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-lg px-3.5 py-2.5 focus:outline-none focus:bg-surface-container-high transition-colors" id="shipPostalCode" type="text" placeholder="396445" required />
                      <div id="postalCodeFeedback" class="hidden items-center gap-1.5 text-tertiary pt-0.5">
                        <span class="material-symbols-outlined text-[16px]">check_circle</span>
                        <span class="font-label-sm text-label-sm">Valid international postal format &amp; armored service area.</span>
                      </div>
                    </div>

                    <!-- Country Selection Dropdown -->
                    <div class="space-y-1.5">
                      <label class="block font-label-sm text-label-sm text-on-surface-variant">Country <span class="text-primary">*</span></label>
                      <div class="relative">
                        <select class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-lg px-3.5 py-2.5 appearance-none focus:outline-none focus:bg-surface-container-high transition-colors pr-10" id="shipCountry" onchange="onCountryChanged()" required>
                          <option value="India" selected>India (Domestic Insured Speed Delivery)</option>
                          <option value="United States">United States (Armored Air Dispatch)</option>
                          <option value="United Kingdom">United Kingdom (Direct Atelier Import)</option>
                          <option value="United Arab Emirates">United Arab Emirates (Dubai VIP Vault)</option>
                          <option value="Singapore">Singapore (Direct Insured Courier)</option>
                          <option value="Canada">Canada (Express Insured Air)</option>
                          <option value="Australia">Australia (Direct Courier)</option>
                          <option value="Germany">Germany (EU Insured Dispatch)</option>
                          <option value="France">France (EU Insured Dispatch)</option>
                        </select>
                        <span class="material-symbols-outlined text-on-surface-variant text-[20px] absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">expand_more</span>
                      </div>
                    </div>
                  </div>

                  <!-- Transit Tier Radio Badges -->
                  <div class="pt-4">
                    <label class="block font-label-caps text-[10px] uppercase tracking-wider text-on-surface-variant mb-2.5">Select Armored Transit Tier</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <label class="p-3.5 rounded-lg bg-surface-container-high cursor-pointer flex items-start gap-3 transition-colors">
                        <input checked="" class="mt-1 accent-primary w-4 h-4 cursor-pointer" name="shipping-tier" type="radio" />
                        <div class="space-y-0.5">
                          <div class="flex items-center justify-between">
                            <span class="font-label-md text-label-md text-on-surface font-semibold">Priority Armored Courier</span>
                            <span class="font-label-caps text-[10px] text-tertiary font-bold uppercase">FREE</span>
                          </div>
                          <p class="font-body-sm text-body-sm text-on-surface-variant">3-5 business days. Discretely packaged, GPS tracked, signature verification required.</p>
                        </div>
                      </label>
                      <label class="p-3.5 rounded-lg bg-surface-container-low hover:bg-surface-container-high cursor-pointer flex items-start gap-3 transition-colors">
                        <input class="mt-1 accent-primary w-4 h-4 cursor-pointer" name="shipping-tier" type="radio" />
                        <div class="space-y-0.5">
                          <div class="flex items-center justify-between">
                            <span class="font-label-md text-label-md text-on-surface font-semibold">White-Glove Salon Handover</span>
                            <span class="font-label-caps text-[10px] text-primary font-bold uppercase">+$120.00</span>
                          </div>
