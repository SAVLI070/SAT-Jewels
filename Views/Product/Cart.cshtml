                    <a class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-primary hover:text-primary-fixed transition-colors underline-offset-4 hover:underline" href="${certUrl}" target="_blank">
                      <span class="material-symbols-outlined text-[16px]">verified</span>
