@{
    Layout = null;
    ViewData["Title"] = "Shopping Cart & Home Delivery Checkout";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shopping Cart & Home Delivery Checkout — SAT Jewel Sanctuary</title>
  <link rel="icon" type="image/png" href="/assets/sat_logo_transparent.png" />
  <link rel="shortcut icon" type="image/png" href="/assets/sat_logo_transparent.png" />
  <link rel="apple-touch-icon" href="/assets/sat_logo_transparent.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/style.css" />
  <!-- Official Dual Payment Gateways (PayPal SDK + Razorpay Checkout.js) -->
  <script src="https://www.paypal.com/sdk/js?client-id=sb&currency=USD&enable-funding=venmo,paylater"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <style>
    body {
      background: radial-gradient(circle at 50% 20%, #16141a 0%, #06070a 100%);
      color: #ffffff;
      font-family: var(--font-sans);
      min-height: 100vh;
      margin: 0;
    }
    .cart-container {
      max-width: 960px;
      margin: 40px auto 80px;
      padding: 0 20px;
    }
    .cart-card {
      background: rgba(14, 13, 16, 0.88);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(212, 184, 120, 0.35);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.85);
    }
    .cart-title {
      font-family: var(--font-serif);
      font-size: 28px;
      margin: 0 0 6px;
    }
    .cart-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      gap: 16px;
    }
    .cart-item-img {
      width: 70px;
      height: 70px;
      border-radius: 12px;
      object-fit: cover;
      border: 1px solid rgba(212, 178, 112, 0.3);
    }
    .paypal-checkout-panel {
      margin-top: 28px;
      padding-top: 24px;
      border-top: 1px solid rgba(212, 178, 112, 0.3);
    }
    .paypal-box-wrap {
      max-width: 520px;
      margin: 20px auto 0;
    }
    .paypal-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: rgba(0, 112, 186, 0.15);
      border: 1px solid #0070ba;
      border-radius: 20px;
      color: #38bdf8;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 14px;
    }
    .auth-required-banner {
      background: rgba(212, 178, 112, 0.08);
      border: 1px solid rgba(212, 178, 112, 0.4);
      border-radius: 16px;
      padding: 28px 24px;
      text-align: center;
      margin-top: 24px;
    }
    .btn-auth-signin {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      background: var(--champagne-gold);
      color: #060c14;
      font-weight: 800;
      border-radius: 30px;
      text-decoration: none;
      transition: all 0.25s ease;
    }
    .btn-auth-signin:hover {
      background: #ffffff;
      color: #000000;
      box-shadow: 0 4px 20px rgba(212, 178, 112, 0.5);
    }
    .btn-auth-signup {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      background: transparent;
      border: 1px solid var(--champagne-gold);
      color: var(--champagne-gold);
      font-weight: 700;
      border-radius: 30px;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    /* Home Delivery Address Form Section */
    .delivery-form-box {
      background: #0e0d10;
      border: 1px solid rgba(212, 178, 112, 0.35);
      border-radius: 18px;
      padding: 24px;
      margin-top: 28px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }
    .delivery-form-title {
      font-size: 17px;
      font-weight: 700;
      color: var(--champagne-gold);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .form-grid-2col {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    @@media (max-width: 650px) {
      .form-grid-2col { grid-template-columns: 1fr; }
    }
    .form-group-item {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-group-item label {
      font-size: 12.5px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.85);
    }
    .form-input-field {
      padding: 12px 14px;
      background: #0d1b2a;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 8px;
      color: #ffffff;
      font-size: 13.5px;
      outline: none;
      box-sizing: border-box;
      transition: border-color 0.25s ease;
    }
    .form-input-field:focus {
      border-color: var(--champagne-gold);
      box-shadow: 0 0 10px rgba(212, 178, 112, 0.3);
    }
  </style>
</head>
<body>
  <div class="cart-container">
    <div style="margin-bottom: 20px;">
      <a href="/" style="color: var(--champagne-gold); text-decoration: none; font-size: 14px;"><i class="fa-solid fa-arrow-left"></i> Back to Storefront</a>
    </div>

    <div class="cart-card">
      <h1 class="cart-title">Bespoke Shopping Cart</h1>
      <p style="color:var(--taupe-beige); font-size:14px; margin-bottom:28px;">Review your GIA certified fine jewelry pieces before secure PayPal USD checkout.</p>

      <div id="cartItemsContainer">
        <!-- Rendered dynamically by JavaScript -->
      </div>

      @if (isAuthenticated)
      {
        var savedAddresses = ViewBag.SavedAddresses as List<SAT1.Models.UserAddress> ?? new List<SAT1.Models.UserAddress>();

        <!-- High Priority Home Delivery Address Form -->
        <div class="delivery-form-box">
          <div class="delivery-form-title">
            <i class="fa-solid fa-truck-ramp-box"></i> Home Delivery Shipping Address <span style="font-size:11px; color:#fbbf24; font-weight:600; margin-left:auto;">[ REQUIRED FOR PAYMENT ]</span>
          </div>

          @if (savedAddresses.Count > 0)
          {
            <div style="margin-bottom: 18px; padding: 12px 16px; background: rgba(212,178,112,0.12); border: 1px solid rgba(212,178,112,0.35); border-radius: 12px;">
              <label style="font-size: 12px; font-weight: 700; color: #fbbf24; display: block; margin-bottom: 6px;">
                <i class="fa-solid fa-bookmark"></i> Quick Select From Saved Address Vault:
              </label>
              <select id="savedAddressSelector" class="form-input-field" onchange="loadSavedAddress(this.value)" style="border-color:#d4b270;">
                <option value="">-- Choose a Saved Shipping Address --</option>
                @foreach (var addr in savedAddresses)
                {
                  <option value="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(addr))" selected="@(addr.IsDefault ? "selected" : null)">
                    @(addr.IsDefault ? "⭐ [DEFAULT] " : "")@addr.FullName - @addr.StreetAddress, @addr.City, @addr.State
                  </option>
                }
              </select>
            </div>
          }

          <form id="shippingAddressForm" oninput="checkAddressValidation()">
            <div class="form-grid-2col">
              <div class="form-group-item">
                <label>Recipient Full Name *</label>
                <input type="text" id="shipFullName" class="form-input-field" value="@userName" placeholder="e.g. Sahil Kumar" required />
              </div>
              <div class="form-group-item">
                <label>Contact Phone (For Courier Tracking SMS) *</label>
                <input type="tel" id="shipPhone" class="form-input-field" placeholder="e.g. +91 98765 43210" required />
              </div>
            </div>

            <div class="form-group-item" style="margin-top:14px;">
              <label>Home Delivery Street Address *</label>
              <input type="text" id="shipStreet" class="form-input-field" placeholder="Flat No., House No., Building Name, Street" required />
            </div>

            <div class="form-grid-2col" style="margin-top:14px;">
              <div class="form-group-item">
                <label>City / Town *</label>
                <input type="text" id="shipCity" class="form-input-field" placeholder="e.g. Mumbai / New York" required />
              </div>
              <div class="form-group-item">
                <label>State / Province / Region *</label>
                <input type="text" id="shipState" class="form-input-field" placeholder="e.g. Maharashtra / California" required />
              </div>
            </div>

            <div class="form-grid-2col" style="margin-top:14px;">
              <div class="form-group-item">
                <label>Postal / ZIP Code *</label>
                <input type="text" id="shipPostalCode" class="form-input-field" placeholder="e.g. 400001 / 396445 (6 digits)" oninput="checkAddressValidation()" required />
                <div id="postalCodeFeedback" style="display:none; font-size:11.5px; margin-top:4px; font-weight:600; line-height:1.4;"></div>
              </div>
              <div class="form-group-item">
                <label>Country *</label>
                <select id="shipCountry" class="form-input-field" onchange="onCountryChanged()" required>
                  <option value="India" selected>India</option>
                  <option value="United States">United States</option>
                  <option value="United Kingdom">United Kingdom</option>
                  <option value="Canada">Canada</option>
                  <option value="Australia">Australia</option>
                  <option value="United Arab Emirates">United Arab Emirates</option>
                  <option value="Germany">Germany</option>
                  <option value="France">France</option>
                </select>
              </div>
            </div>
          </form>
        </div>
      }

      <div class="paypal-checkout-panel">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
          <div>
            <div class="paypal-badge"><i class="fa-brands fa-paypal"></i> PayPal USD Express Checkout</div>
            <div style="color:var(--taupe-beige); font-size:14px;">Total Order Subtotal:</div>
            <div id="cartTotalDisplay" style="font-family:var(--font-serif); font-size:30px; font-weight:700; color:#fbbf24; margin-top:2px;">$0 USD</div>
          </div>
        </div>

        @if (isAuthenticated)
        {
          <!-- Dynamic Address Status Warning -->
          <div id="addressWarningNotice" style="margin-top:16px; padding:14px 18px; background:rgba(239,68,68,0.12); border:1px solid #ef4444; border-radius:12px; color:#fca5a5; font-size:13.5px; display:flex; align-items:center; gap:10px;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:18px; color:#ef4444;"></i>
            <div>
              <strong>Payment Permission Locked:</strong> Please fill in all required shipping address fields above before payment can be authorized.
            </div>
          </div>

          <div id="paypalContainerBox" class="paypal-box-wrap" style="opacity: 0.5; pointer-events: none;">
            <!-- Option 1: Official PayPal Express Checkout -->
            <div style="margin-bottom: 20px;">
              <div style="font-size:12px; color:var(--taupe-beige); font-weight:700; margin-bottom:8px; text-transform:uppercase; letter-spacing:0.5px;">Option 1: Pay with PayPal</div>
              <button type="button" id="btnPayPalExpress" class="btn-paypal-express" onclick="payWithPayPalInstant()" style="width:100%; padding:14px 20px; background:#ffc439; color:#003087; border:none; border-radius:10px; font-weight:800; font-size:15px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:10px; box-shadow:0 4px 15px rgba(255,196,57,0.3); transition:all 0.3s ease;">
                <i class="fa-brands fa-paypal" style="font-size:20px; color:#003087;"></i> Pay with PayPal (<span id="paypalBtnAmountDisplay">$0 USD</span>)
              </button>
              <div id="paypal-button-container" style="margin-top:12px; display:none;"></div>
            </div>

            <!-- Option 2: Razorpay Independent Card Gateway (Embedded Modal Overlay) -->
            <div style="margin-top: 20px; padding-top: 18px; border-top: 1px dashed rgba(212, 178, 112, 0.3);">
              <div style="font-size:12px; color:var(--taupe-beige); font-weight:700; margin-bottom:8px; text-transform:uppercase; letter-spacing:0.5px;">Option 2: Pay with Credit / Debit Card (Razorpay)</div>
              <button type="button" id="btnRazorpayCard" class="btn-razorpay-card" onclick="payWithRazorpay()" style="width:100%; padding:14px 20px; background:linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color:#ffffff; border:1px solid rgba(212, 178, 112, 0.5); border-radius:10px; font-weight:800; font-size:14px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:10px; box-shadow:0 4px 15px rgba(0,0,0,0.3); transition:all 0.3s ease;">
                <i class="fa-solid fa-credit-card" style="color:var(--champagne-gold); font-size:18px;"></i> Pay with Card (No PayPal Account Required)
              </button>
            </div>
          </div>
        }
        else
        {
          <!-- GATE 1: Sign In Required Banner -->
          <div class="auth-required-banner">
            <i class="fa-solid fa-user-lock" style="font-size:42px; color:#f59e0b; margin-bottom:12px;"></i>
            <h3 style="margin:0 0 8px; font-family:var(--font-serif); font-size:24px; color:#ffffff;">🚫 Permission Denied: Sign In Required</h3>
            <p style="color:rgba(255,255,255,0.8); font-size:14px; margin-bottom:24px; max-width:560px; margin-left:auto; margin-right:auto; line-height:1.6;">
              You must sign in to your SAT Jewel account before any payment or shipping transaction can be authorized.
            </p>
            <div style="display:flex; justify-content:center; gap:14px; flex-wrap:wrap;">
              <a href="/Account/SignIn?returnUrl=/Product/Cart" class="btn-auth-signin">
                <i class="fa-solid fa-right-to-bracket"></i> Sign In to Proceed
              </a>
              <a href="/Account/SignUp?returnUrl=/Product/Cart" class="btn-auth-signup">
                <i class="fa-solid fa-user-plus"></i> Create Account
              </a>
            </div>
          </div>
        }
      </div>
    </div>
  </div>

  <script>
    const isUserAuthenticated = @(isAuthenticated ? "true" : "false");
    let currentCartTotal = 0;
    let currentCartSummary = 'Bespoke Jewelry Order';

    document.addEventListener('DOMContentLoaded', () => {
      renderCart();
      if (isUserAuthenticated) {
        // Auto-select default saved address if dropdown exists
        const savedSelect = document.getElementById('savedAddressSelector');
        if (savedSelect && savedSelect.value) {
          loadSavedAddress(savedSelect.value);
        }
        checkAddressValidation();
        initPayPalButtons();
      }
    });

    function loadSavedAddress(jsonStr) {
      if (!jsonStr) return;
      try {
        const item = JSON.parse(jsonStr);
        if (item.FullName) document.getElementById('shipFullName').value = item.FullName;
        if (item.Phone) document.getElementById('shipPhone').value = item.Phone;
        if (item.StreetAddress) document.getElementById('shipStreet').value = item.StreetAddress;
        if (item.City) document.getElementById('shipCity').value = item.City;
        if (item.State) document.getElementById('shipState').value = item.State;
        if (item.PostalCode) document.getElementById('shipPostalCode').value = item.PostalCode;
        if (item.Country) document.getElementById('shipCountry').value = item.Country;
        checkAddressValidation();
      } catch (e) {
        console.error(e);
      }
    }

    function onCountryChanged() {
      const countryEl = document.getElementById('shipCountry');
      const postalEl = document.getElementById('shipPostalCode');
      if (!countryEl || !postalEl) return;

      const country = countryEl.value;
      switch (country) {
        case 'India':
          postalEl.placeholder = 'e.g. 400001 / 396445 (6-digit PIN)';
          break;
        case 'United States':
          postalEl.placeholder = 'e.g. 10001 / 90210 (5-digit ZIP)';
          break;
        case 'United Kingdom':
          postalEl.placeholder = 'e.g. SW1A 1AA / EC1A 1BB';
          break;
        case 'Canada':
          postalEl.placeholder = 'e.g. M5V 2T6 / K1A 0B1';
          break;
        case 'Australia':
          postalEl.placeholder = 'e.g. 2000 / 3000 (4-digit Postcode)';
          break;
        case 'Germany':
        case 'France':
          postalEl.placeholder = 'e.g. 75001 / 10115 (5-digit Code)';
          break;
        default:
          postalEl.placeholder = 'Postal / ZIP Code';
          break;
      }
      checkAddressValidation();
    }

    function validatePostalCodeFormat(postal, country) {
      if (!postal) return { valid: false, message: 'Postal / ZIP Code is required.' };
      const clean = postal.trim().toUpperCase();
      const digitsOnly = clean.replace(/\D/g, '');

      if (country === 'United States') {
        if (digitsOnly.length === 6) {
          return {
            valid: false,
            message: `"${postal}" is a 6-digit Indian PIN code. For United States, please enter a 5-digit US ZIP code (e.g. 10001, 90210) or switch country to India.`
          };
        }
        const usRegex = /^\d{5}(-\d{4})?$/;
        if (!usRegex.test(clean)) {
          return { valid: false, message: 'For United States, please enter a valid 5-digit ZIP code (e.g. 10001, 90210).' };
        }
        return { valid: true };
      }

      if (country === 'India') {
        if (digitsOnly.length === 5) {
          return {
            valid: false,
            message: `"${postal}" is a 5-digit US ZIP code. For India, please enter a 6-digit Indian PIN code (e.g. 400001, 396445) or switch country to United States.`
          };
        }
        const inRegex = /^\d{6}$/;
        if (!inRegex.test(clean)) {
          return { valid: false, message: 'For India, please enter a valid 6-digit postal PIN code (e.g. 396445, 400001).' };
        }
        return { valid: true };
      }

      if (country === 'United Kingdom') {
        const ukRegex = /^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/;
        if (!ukRegex.test(clean)) {
          return { valid: false, message: 'For United Kingdom, please enter a valid UK postcode (e.g. SW1A 1AA, EC1A 1BB).' };
        }
        return { valid: true };
      }

      if (country === 'Canada') {
        const caRegex = /^[A-Z]\d[A-Z]\s*\d[A-Z]\d$/;
        if (!caRegex.test(clean)) {
          return { valid: false, message: 'For Canada, please enter a valid Canadian postal code (e.g. M5V 2T6).' };
        }
        return { valid: true };
      }

      if (country === 'Australia') {
        if (!/^\d{4}$/.test(clean)) {
          return { valid: false, message: 'For Australia, please enter a valid 4-digit postcode (e.g. 2000).' };
        }
        return { valid: true };
      }

      if (country === 'Germany' || country === 'France') {
        if (!/^\d{5}$/.test(clean)) {
          return { valid: false, message: `For ${country}, please enter a valid 5-digit postal code (e.g. 75001).` };
        }
        return { valid: true };
      }

      if (clean.length < 3) {
        return { valid: false, message: 'Please enter a valid postal code.' };
      }

      return { valid: true };
    }

    function checkAddressValidation() {
      const addr = getShippingAddressData();
      const notice = document.getElementById('addressWarningNotice');
      const paypalBox = document.getElementById('paypalContainerBox');
      const postalFeedback = document.getElementById('postalCodeFeedback');
      const postalEl = document.getElementById('shipPostalCode');
      const countryEl = document.getElementById('shipCountry');

      const postalVal = postalEl ? postalEl.value.trim() : '';
      const countryVal = countryEl ? countryEl.value : 'India';

      if (postalVal && postalFeedback && postalEl) {
        const postalCheck = validatePostalCodeFormat(postalVal, countryVal);
        if (!postalCheck.valid) {
          postalFeedback.style.display = 'block';
          postalFeedback.style.color = '#f87171';
          postalFeedback.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${postalCheck.message}`;
          postalEl.style.borderColor = '#ef4444';
          postalEl.style.boxShadow = '0 0 10px rgba(239, 68, 68, 0.4)';
        } else {
          postalFeedback.style.display = 'block';
          postalFeedback.style.color = '#4ade80';
          postalFeedback.innerHTML = `<i class="fa-solid fa-circle-check"></i> Valid ${countryVal} postal format.`;
          postalEl.style.borderColor = '#22c55e';
          postalEl.style.boxShadow = '0 0 10px rgba(34, 197, 94, 0.3)';
        }
      } else if (postalFeedback) {
        postalFeedback.style.display = 'none';
        if (postalEl) {
          postalEl.style.borderColor = '';
          postalEl.style.boxShadow = '';
        }
      }

      if (addr) {
        if (notice) {
          notice.style.background = 'rgba(34, 197, 94, 0.12)';
          notice.style.borderColor = '#22c55e';
          notice.style.color = '#4ade80';
          notice.innerHTML = `<i class="fa-solid fa-circle-check" style="font-size:18px; color:#22c55e;"></i> <div><strong>Payment Authorized:</strong> Shipping address verified for ${addr.country}. You may now complete your payment below.</div>`;
        }
        if (paypalBox) {
          paypalBox.style.opacity = '1';
          paypalBox.style.pointerEvents = 'auto';
        }
        return true;
      } else {
        if (notice) {
          notice.style.background = 'rgba(239,68,68,0.12)';
          notice.style.borderColor = '#ef4444';
          notice.style.color = '#fca5a5';
          notice.innerHTML = '<i class="fa-solid fa-triangle-exclamation" style="font-size:18px; color:#ef4444;"></i> <div><strong>Payment Permission Locked:</strong> Complete home delivery shipping address with valid country-matched PIN/ZIP code required before payment button unlocks.</div>';
        }
        if (paypalBox) {
          paypalBox.style.opacity = '0.5';
          paypalBox.style.pointerEvents = 'none';
        }
        return false;
      }
    }

    function getCartStorageKey() {
      const isAuth = @(isAuthenticated ? "true" : "false");
      const email = '@(userEmail.ToLower().Trim())';
      if (isAuth && email) {
        return 'sat_cart_' + encodeURIComponent(email);
      }
      return 'sat_cart_guest';
    }

    function renderCart() {
      const container = document.getElementById('cartItemsContainer');
      const totalEl = document.getElementById('cartTotalDisplay');
      const paypalBox = document.getElementById('paypalContainerBox');
      if (!container) return;

      try {
        const key = getCartStorageKey();
        const saved = localStorage.getItem(key);
        const items = saved ? JSON.parse(saved) : [];

        if (items.length === 0) {
          container.innerHTML = `
            <div style="text-align:center; padding: 40px 20px;">
              <i class="fa-solid fa-bag-shopping" style="font-size:42px; color:var(--champagne-gold); margin-bottom:14px;"></i>
              <h3 style="margin:0 0 8px; font-family:var(--font-serif);">Your Shopping Cart is Empty</h3>
              <p style="color:var(--taupe-beige); font-size:14px; margin-bottom:20px;">Discover handcrafted engagement rings, necklaces, and GIA diamonds in our shop.</p>
              <a href="/Product" class="btn-primary" style="display:inline-flex; padding:10px 24px; border-radius:30px; text-decoration:none;"><i class="fa-solid fa-gem"></i> Browse Shop Catalog</a>
            </div>
          `;
          totalEl.textContent = '$0 USD';
          if (paypalBox) paypalBox.style.display = 'none';
          currentCartTotal = 0;
          return;
        }

        if (paypalBox && isUserAuthenticated) paypalBox.style.display = 'block';

        let total = 0;
        let html = '';
        let names = [];

        items.forEach((item, index) => {
          const itemPrice = Number(item.priceUSD) || 0;
          const qty = Number(item.quantity) || 1;
          const subtotal = itemPrice * qty;
          total += subtotal;
          names.push(item.name || 'Jewelry Piece');

          html += `
            <div class="cart-item-row">
              <div style="display:flex; align-items:center; gap:16px;">
                <img src="${item.img || '/assets/ring_1.jpg'}" class="cart-item-img" alt="${item.name}" />
                <div>
                  <div style="font-weight:700; font-family:var(--font-serif); font-size:16px;">${item.name}</div>
                  <div style="font-size:12px; color:var(--taupe-beige); margin-top:2px;">$${itemPrice.toLocaleString()} USD each</div>
                </div>
              </div>
              <div style="display:flex; align-items:center; gap:16px;">
                <div style="font-weight:700; color:#fbbf24; font-size:18px;">$${subtotal.toLocaleString()} USD</div>
                <button type="button" onclick="removeItem(${index})" style="background:none; border:none; color:#fca5a5; cursor:pointer; font-size:16px;" title="Remove Item"><i class="fa-solid fa-trash-can"></i></button>
              </div>
            </div>
          `;
        });

        currentCartTotal = total;
        currentCartSummary = names.join(', ');
        container.innerHTML = html;
        totalEl.textContent = '$' + total.toLocaleString() + ' USD';
        const btnDisplay = document.getElementById('paypalBtnAmountDisplay');
        if (btnDisplay) btnDisplay.textContent = '$' + total.toLocaleString() + ' USD';
      } catch (e) {
        console.error(e);
      }
    }

    async function payWithPayPalInstant() {
      if (!isUserAuthenticated) {
        alert('🚫 PERMISSION DENIED: You must sign in to your account before proceeding to payment.');
        window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        return;
      }

      const addr = getShippingAddressData();
      if (!addr) {
        alert('⚠️ PERMISSION DENIED: Complete home delivery shipping address (Full Name, Phone, Street, City, State, ZIP) is required before payment can be initialized.');
        checkAddressValidation();
        return;
      }

      const key = getCartStorageKey();
      const savedCart = localStorage.getItem(key);
      const cartItems = savedCart ? JSON.parse(savedCart) : [];
      const firstItemId = cartItems.length > 0 ? (cartItems[0].id || cartItems[0].catalogItemId || 'sat-prod-8') : 'sat-prod-8';
      const qty = cartItems.length > 0 ? (Number(cartItems[0].quantity) || 1) : 1;

      showPaymentProcessing("Processing PayPal payment authorization and securing your bespoke jewelry order...");

      try {
        // Step 1: Create PayPal Order
        const res = await fetch('/api/payment/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: firstItemId,
            quantity: qty,
            shippingFullName: addr.name,
            shippingPhone: addr.phone,
            shippingStreet: addr.street,
            shippingCity: addr.city,
            shippingState: addr.state,
            shippingPostalCode: addr.postal,
            shippingCountry: addr.country
          })
        });

        const result = await res.json();
        if (!result.success || !result.orderId) {
          hidePaymentProcessing();
          alert('Error initializing PayPal order: ' + (result.message || 'Server error'));
          return;
        }

        // Step 2: Auto-verify and confirm payment into DB
        const verifyRes = await fetch('/api/payment/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ payPalOrderId: result.orderId })
        });

        const verifyResult = await verifyRes.json();
        hidePaymentProcessing();

        if (verifyResult.success) {
          localStorage.removeItem(getCartStorageKey());
          alert('🎉 PayPal Payment Authorized & Order Placed Successfully!\n\nOrder ID: ' + (verifyResult.orderId || result.internalOrderId || result.orderId) + '\nStatus: Paid & Insured Dispatch Booked');
          window.location.href = '/Account/Orders';
        } else {
          alert('⚠️ Payment Verification Notice: ' + (verifyResult.message || 'Processing'));
          window.location.href = '/Account/Orders';
        }
      } catch (err) {
        hidePaymentProcessing();
        console.error('PayPal instant error:', err);
        alert('An error occurred during payment processing. Please try again.');
      }
    }

    async function payWithPayPalMe() {
      if (!isUserAuthenticated) {
        alert('🚫 PERMISSION DENIED: You must sign in to your account before proceeding to payment.');
        window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        return;
      }

      const addr = getShippingAddressData();
      if (!addr) {
        alert('⚠️ PERMISSION DENIED: Complete home delivery shipping address (Full Name, Phone, Street, City, State, ZIP) is required before payment can be initialized.');
        checkAddressValidation();
        return;
      }

      if (currentCartTotal <= 0) {
        alert('Your shopping cart is empty.');
        return;
      }

      const btn = document.getElementById('btnPayPalDirect');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Preparing PayPal USD Transfer...';
      }

      try {
        const res = await fetch('/api/paymentapi/process-paypal-me', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            itemName: currentCartSummary,
            amount: currentCartTotal,
            shippingFullName: addr.name,
            shippingPhone: addr.phone,
            shippingStreet: addr.street,
            shippingCity: addr.city,
            shippingState: addr.state,
            shippingPostalCode: addr.postal,
            shippingCountry: addr.country
          })
        });

        const data = await res.json();
        if (data.success && data.directPaymentUrl) {
          // Open direct PayPal.Me link pre-filled with exact amount in new tab
          window.open(data.directPaymentUrl, '_blank');
          
          localStorage.removeItem(getCartStorageKey());
          if (typeof showPaymentSuccessModal === 'function') {
            showPaymentSuccessModal(data.orderId);
          } else {
            alert(`🎉 Order Registered! Order ID: ${data.orderId}\n\nWe have opened PayPal.Me in a new window pre-filled for your $${data.amount} USD transfer.`);
            window.location.href = '/Account/Orders';
          }
        } else {
          alert('Error initializing PayPal transfer: ' + (data.message || 'Server error'));
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = `<i class="fa-brands fa-paypal" style="font-size:22px; color:#003087;"></i> Pay with PayPal ($${currentCartTotal.toLocaleString()} USD)`;
          }
        }
      } catch (err) {
        console.error('PayPal.Me Checkout Error:', err);
        alert('An error occurred. Please try again.');
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `<i class="fa-brands fa-paypal" style="font-size:22px; color:#003087;"></i> Pay with PayPal ($${currentCartTotal.toLocaleString()} USD)`;
        }
      }
    }

    function getShippingAddressData() {
      const nameEl = document.getElementById('shipFullName');
      const phoneEl = document.getElementById('shipPhone');
      const streetEl = document.getElementById('shipStreet');
      const cityEl = document.getElementById('shipCity');
      const stateEl = document.getElementById('shipState');
      const postalEl = document.getElementById('shipPostalCode');
      const countryEl = document.getElementById('shipCountry');

      if (!nameEl || !phoneEl || !streetEl || !cityEl || !stateEl || !postalEl || !countryEl) return null;

      const name = nameEl.value.trim();
      const phone = phoneEl.value.trim();
      const street = streetEl.value.trim();
      const city = cityEl.value.trim();
      const state = stateEl.value.trim();
      const postal = postalEl.value.trim();
      const country = countryEl.value.trim();

      if (!name || !phone || !street || !city || !state || !postal) {
        return null;
      }

      if (typeof validatePostalCodeFormat === 'function') {
        const check = validatePostalCodeFormat(postal, country);
        if (!check.valid) return null;
      }

      return { name, phone, street, city, state, postal, country };
    }

    function removeItem(index) {
      try {
        const key = getCartStorageKey();
        const saved = localStorage.getItem(key);
        let items = saved ? JSON.parse(saved) : [];
        items.splice(index, 1);
        localStorage.setItem(key, JSON.stringify(items));
        renderCart();
        if (typeof syncCartBadge === 'function') syncCartBadge();
      } catch (e) {}
    }

    function showPaymentProcessing(msg) {
      const el = document.getElementById('paymentProcessingOverlay');
      const msgEl = document.getElementById('processingOverlayMessage');
      if (msgEl && msg) msgEl.textContent = msg;
      if (el) el.style.display = 'flex';
    }

    function hidePaymentProcessing() {
      const el = document.getElementById('paymentProcessingOverlay');
      if (el) el.style.display = 'none';
    }

    function initPayPalButtons() {
      if (typeof paypal === 'undefined') return;

      paypal.Buttons({
        style: {
          layout: 'vertical',
          color:  'gold',
          shape:  'rect',
          label:  'paypal'
        },

        onClick: function(data, actions) {
          if (!isUserAuthenticated) {
            alert('🚫 PERMISSION DENIED: You must sign in to your account before proceeding to payment.');
            window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
            return actions.reject();
          }

          const addr = getShippingAddressData();
          if (!addr) {
            alert('⚠️ PERMISSION DENIED: Complete home delivery shipping address (Full Name, Phone, Street, City, State, ZIP) is required before payment can be initialized.');
            checkAddressValidation();
            return actions.reject();
          }
          return actions.resolve();
        },

        createOrder: async function(data, actions) {
          const addr = getShippingAddressData();
          if (!addr) {
            alert('⚠️ Shipping Address Required before completing checkout.');
            throw new Error('Shipping address incomplete.');
          }

          // Security Rule: Never send price/amount! Pass only productId & quantity to server
          const key = getCartStorageKey();
          const savedCart = localStorage.getItem(key);
          const cartItems = savedCart ? JSON.parse(savedCart) : [];
          const firstItemId = cartItems.length > 0 ? (cartItems[0].id || cartItems[0].catalogItemId || 'sat-prod-8') : 'sat-prod-8';
          const qty = cartItems.length > 0 ? (Number(cartItems[0].quantity) || 1) : 1;

          try {
            const res = await fetch('/api/payment/create-order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                productId: firstItemId,
                quantity: qty,
                shippingFullName: addr.name,
                shippingPhone: addr.phone,
                shippingStreet: addr.street,
                shippingCity: addr.city,
                shippingState: addr.state,
                shippingPostalCode: addr.postal,
                shippingCountry: addr.country
              })
            });

            const result = await res.json();
            if (result.success && result.orderId) {
              return result.orderId;
            } else {
              alert('Error initializing PayPal order: ' + (result.message || 'Server error'));
              throw new Error(result.message);
            }
          } catch (err) {
            console.error('PayPal createOrder error:', err);
            throw err;
          }
        },

        onApprove: function(data, actions) {
          showPaymentProcessing("Confirming PayPal payment authorization with server-authoritative verification. Please do not close this window...");
          return fetch('/api/payment/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ payPalOrderId: data.orderID })
          })
          .then(res => res.json())
          .then(result => {
            hidePaymentProcessing();
            if (result.success) {
              localStorage.removeItem(getCartStorageKey());
              alert('🎉 Order Verified & Placed Successfully! Order ID: ' + (result.orderId || data.orderID));
              window.location.href = '/Account/Orders';
            } else {
              alert('⚠️ PayPal Verification Warning: ' + result.message);
            }
          })
          .catch(err => {
            hidePaymentProcessing();
            console.error('PayPal Verify Error:', err);
            alert('Payment received. Order is being processed under Order ID: ' + data.orderID);
          });
        },

        onError: function(err) {
          hidePaymentProcessing();
          console.error('PayPal Checkout Error:', err);
          alert('An error occurred during PayPal checkout. Please ensure all shipping details are entered and try again.');
        }
      }).render('#paypal-button-container');
    }

    // Razorpay Embedded Card Payment Modal (Independent path - No PayPal prompt)
    async function payWithRazorpay() {
      if (!isUserAuthenticated) {
        alert('🚫 PERMISSION DENIED: You must sign in to your account before proceeding to payment.');
        window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        return;
      }

      const addr = getShippingAddressData();
      if (!addr) {
        alert('⚠️ PERMISSION DENIED: Complete home delivery shipping address (Full Name, Phone, Street, City, State, ZIP) is required before payment can be initialized.');
        checkAddressValidation();
        return;
      }

      const key = getCartStorageKey();
      const savedCart = localStorage.getItem(key);
      const cartItems = savedCart ? JSON.parse(savedCart) : [];
      const firstItemId = cartItems.length > 0 ? (cartItems[0].id || cartItems[0].catalogItemId || 'sat-prod-8') : 'sat-prod-8';
      const qty = cartItems.length > 0 ? (Number(cartItems[0].quantity) || 1) : 1;

      try {
        // Step 1: Server calculates price & creates Razorpay Order
        const res = await fetch('/api/payment/razorpay/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: firstItemId,
            quantity: qty,
            shippingFullName: addr.name,
            shippingPhone: addr.phone,
            shippingStreet: addr.street,
            shippingCity: addr.city,
            shippingState: addr.state,
            shippingPostalCode: addr.postal,
            shippingCountry: addr.country
          })
        });

        const data = await res.json();
        if (!data.success) {
          alert('Error initializing Razorpay order: ' + data.message);
          return;
        }

        // Step 2: Open Embedded Razorpay Checkout.js Modal
        const options = {
          key: data.keyId,
          amount: Math.round(data.amountUSD * 100),
          currency: 'USD',
          name: 'SAT Luxury Jewellery',
          description: 'Bespoke Fine Jewelry Order',
          image: '/assets/ring_1.jpg',
          order_id: data.razorpayOrderId,
          handler: async function (response) {
            showPaymentProcessing("Verifying Razorpay card HMAC signature server-side. Please do not close this window...");
            try {
              // Step 3: Server-side HMAC Signature Verification
              const verifyRes = await fetch('/api/payment/razorpay/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpayOrderId: response.razorpay_order_id,
                  razorpayPaymentId: response.razorpay_payment_id,
                  razorpaySignature: response.razorpay_signature
                })
              });

              const verifyResult = await verifyRes.json();
              hidePaymentProcessing();

              if (verifyResult.success) {
                localStorage.removeItem(getCartStorageKey());
                alert('🎉 Razorpay Card Order Verified and Confirmed! Order ID: ' + (verifyResult.orderId || response.razorpay_order_id));
                window.location.href = '/Account/Orders';
              } else {
                alert('⚠️ Razorpay Signature Verification Alert: ' + verifyResult.message);
              }
            } catch (err) {
              hidePaymentProcessing();
              alert('Error verifying Razorpay payment signature.');
            }
          },
          prefill: {
            name: addr.name,
            contact: addr.phone
          },
          theme: {
            color: '#d4b270'
          }
        };

        const rzp = new Razorpay(options);
        rzp.open();
      } catch (err) {
        hidePaymentProcessing();
        console.error('Razorpay Checkout Exception:', err);
        alert('An error occurred during Razorpay card checkout. Please try again.');
      }
    }
  </script>

  <!-- In-Page Payment Processing & Verification Modal Overlay -->
  <div id="paymentProcessingOverlay" style="position:fixed; inset:0; background:rgba(5, 11, 20, 0.88); backdrop-filter:blur(12px); z-index:999999; display:none; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:24px;">
    <div style="background:rgba(13, 27, 42, 0.95); border:1px solid rgba(212, 178, 112, 0.4); border-radius:24px; padding:40px 32px; max-width:440px; width:100%; box-shadow:0 20px 60px rgba(0,0,0,0.7);">
      <div style="font-size:48px; color:var(--champagne-gold); margin-bottom:16px; animation:spinDiamond 3s infinite linear;">
        <i class="fa-solid fa-gem"></i>
      </div>
      <h3 style="font-family:var(--font-serif); font-size:22px; color:#ffffff; margin:0 0 10px;">Verifying Payment Security...</h3>
      <p id="processingOverlayMessage" style="color:var(--taupe-beige); font-size:14px; margin:0 0 20px; line-height:1.6;">
        Confirming payment with server-authoritative pricing. Please do not close or refresh this window.
      </p>
      <div style="display:inline-flex; align-items:center; gap:8px; padding:6px 16px; background:rgba(212, 178, 112, 0.15); border:1px solid rgba(212, 178, 112, 0.3); border-radius:20px; color:#fbbf24; font-size:12px; font-weight:700;">
        <i class="fa-solid fa-shield-halved"></i> 256-Bit TLS Encrypted Verification
