@{
    ViewData["Title"] = "Your Shopping Cart Vault — SAT Jewel";
    Layout = null;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "VIP Client";
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Shopping Cart — SAT Jewel</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/style.css" />

  <style>
    body {
      background: var(--onyx, #040a18);
      color: var(--cream-ivory);
      font-family: var(--font-sans);
      margin: 0;
      padding: 0;
      min-height: 100vh;
    }

    .cart-container {
      max-width: 1100px;
      margin: 100px auto 60px;
      padding: 0 24px;
      box-sizing: border-box;
    }

    .cart-header-head {
      margin-bottom: 24px;
    }

    .cart-title {
      font-family: var(--font-serif);
      font-size: 32px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 6px;
    }

    .cart-sub {
      font-size: 14px;
      color: var(--taupe-beige);
    }

    .cart-grid {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 32px;
      align-items: start;
    }

    @@media (max-width: 900px) {
      .cart-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Cart Items Table Panel */
    .cart-items-card {
      background: rgba(8, 17, 34, 0.85);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(212, 178, 112, 0.3);
      border-radius: var(--radius-2xl);
      padding: 24px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }

    .cart-item-row {
      display: grid;
      grid-template-columns: 72px 1fr auto auto;
      gap: 16px;
      align-items: center;
      padding: 16px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .cart-item-row:last-child {
      border-bottom: none;
    }

    .cart-item-img {
      width: 72px;
      height: 72px;
      border-radius: var(--radius-md);
      object-fit: cover;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .cart-item-name {
      font-family: var(--font-serif);
      font-size: 16px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 4px;
    }

    .cart-item-meta {
      font-size: 12px;
      color: var(--taupe-beige);
    }

    .cart-qty-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: var(--radius-full);
      padding: 4px 10px;
    }

    .cart-qty-btn {
      background: none;
      border: none;
      color: var(--champagne-gold);
      font-size: 14px;
      cursor: pointer;
      padding: 2px 6px;
      transition: color 0.2s;
    }

    .cart-qty-btn:hover {
      color: #ffffff;
    }

    .cart-qty-val {
      font-size: 13px;
      font-weight: 700;
      min-width: 18px;
      text-align: center;
    }

    .cart-item-price {
      font-family: var(--font-serif);
      font-size: 18px;
      font-weight: 700;
      color: var(--champagne-gold);
      text-align: right;
    }

    .btn-cart-remove {
      background: none;
      border: none;
      color: #ef4444;
      font-size: 13px;
      cursor: pointer;
      margin-left: 8px;
      transition: opacity 0.2s;
    }

    .btn-cart-remove:hover {
      opacity: 0.8;
    }

    /* Summary Card Panel */
    .cart-summary-card {
      background: rgba(8, 17, 34, 0.85);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(212, 178, 112, 0.3);
      border-radius: var(--radius-2xl);
      padding: 28px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }

    .cart-sum-title {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .cart-sum-row {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      color: var(--taupe-beige);
      margin-bottom: 12px;
    }

    .cart-sum-total {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--border-gold);
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 700;
      color: var(--champagne-gold);
    }

    .btn-checkout-cart {
      width: 100%;
      padding: 14px 0;
      border-radius: var(--radius-full);
      background: #d4b270;
      border: none;
      color: #060d0a;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 20px;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 4px 20px rgba(212, 178, 112, 0.35);
    }

    .btn-checkout-cart:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 28px rgba(212, 178, 112, 0.6);
      background: #e2ca94;
    }

    .empty-cart-box {
      text-align: center;
      padding: 48px 20px;
    }

    .empty-cart-box i {
      font-size: 48px;
      color: var(--champagne-gold);
      margin-bottom: 16px;
    }
  </style>
</head>

<body>
  <!-- Top Navbar -->
  <nav class="navbar scrolled">
    <div class="container nav-inner">
      <a href="/" class="nav-logo-slot" style="text-decoration:none;">
        <div class="sat-logo-emblem" style="width:36px;height:36px;">
          <img src="~/assets/sat_emblem_clean.png" class="official-sat-logo-img" alt="SAT Emblem" />
        </div>
        <div class="sat-logo-text-wrap" style="margin-left:10px;">
          <div class="sat-logo-brand" style="font-size:18px;">SAT <span>Jewel</span></div>
          <div class="sat-logo-tagline" style="font-size:8px;">Bespoke Vault</div>
        </div>
      </a>

      <div class="nav-actions">
        @{ ViewData["ShowCartLink"] = false; }
        <partial name="_AuthNav" />

        <a href="/#cta" class="btn-primary">
          <i class="fa-solid fa-envelope"></i> Contact Us
        </a>
      </div>
    </div>
  </nav>

  <div class="cart-container">
    <div class="cart-header-head">
      <h1 class="cart-title"><i class="fa-solid fa-bag-shopping" style="color:var(--champagne-gold);"></i> Shopping Cart Vault</h1>
      <p class="cart-sub">Review your selected GIA-certified bespoke items and proceed to secure USD checkout.</p>
    </div>

    @if (!isAuthenticated)
    {
      <div style="background:rgba(212,178,112,0.12);border:1px solid rgba(212,178,112,0.35);border-radius:12px;padding:14px 20px;margin-bottom:24px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:10px;color:var(--champagne-gold);">
          <i class="fa-solid fa-user-lock"></i>
          <span>You can review your cart as a guest. Sign in to complete secure Stripe checkout.</span>
        </div>
        <a href="/Account/SignIn?returnUrl=/Product/Cart" class="btn-auth-nav" style="background:var(--champagne-gold);color:#060d0a;">Sign In to Checkout</a>
      </div>
    }

    <div class="cart-grid">
      <!-- Left: Cart Items List -->
      <div class="cart-items-card">
        <div id="cartItemsList">
          <!-- Injected dynamically by JavaScript -->
        </div>
      </div>

      <!-- Right: Summary & Checkout -->
      <div class="cart-summary-card">
        <h2 class="cart-sum-title">Order Summary (USD)</h2>

        <div class="cart-sum-row">
          <span>Subtotal</span>
          <span id="cartSubtotal">$0 USD</span>
        </div>
        <div class="cart-sum-row">
          <span>Insured Express Shipping</span>
          <span style="color:var(--champagne-gold);">Complimentary</span>
        </div>
        <div class="cart-sum-row">
          <span>GIA Dossier & Insurance</span>
          <span style="color:var(--champagne-gold);">Included</span>
        </div>

        <div class="cart-sum-total">
          <span>Total:</span>
          <span id="cartTotalUSD">$0 USD</span>
        </div>

        <button class="btn-checkout-cart" onclick="proceedCartCheckout()">
          <i class="fa-solid fa-credit-card"></i> Proceed to USD Checkout
        </button>

        <div style="text-align:center;margin-top:16px;">
          <a href="/#collections" style="color:var(--taupe-beige);font-size:13px;text-decoration:none;">
            <i class="fa-solid fa-arrow-left"></i> Continue Shopping
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const isUserLoggedIn = @(isAuthenticated ? "true" : "false");

    function getCartItems() {
      try {
        const saved = localStorage.getItem('sat_shopping_cart_usd');
        return saved ? JSON.parse(saved) : [];
      } catch {
        return [];
      }
    }

    function saveCartItems(items) {
      localStorage.setItem('sat_shopping_cart_usd', JSON.stringify(items));
      renderCartView();
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function fixImagePath(path) {
      if (!path) return '/assets/ring_1.jpg';
      if (path.startsWith('http://') || path.startsWith('https://')) return path;
      if (path.startsWith('~/')) return path.substring(1);
      if (!path.startsWith('/')) return '/' + path;
      return path;
    }

    function renderCartView() {
      const items = getCartItems();
      const container = document.getElementById('cartItemsList');
      if (!container) return;

      if (!items || items.length === 0) {
        container.innerHTML = `
          <div class="empty-cart-box">
            <i class="fa-solid fa-bag-shopping"></i>
            <h3 style="font-family:var(--font-serif);margin-bottom:8px;color:#ffffff;">Your Shopping Cart is Empty</h3>
            <p style="font-size:13px;color:var(--taupe-beige);margin-bottom:20px;">Explore our GIA-certified collections and add items to your vault.</p>
            <a href="/#collections" class="btn-auth-nav" style="background:var(--champagne-gold);color:#060d0a;">Explore Collections</a>
          </div>
        `;
        document.getElementById('cartSubtotal').textContent = '$0 USD';
        document.getElementById('cartTotalUSD').textContent = '$0 USD';
        return;
      }

      let subtotal = 0;

      container.innerHTML = items.map((item, index) => {
        const qty = Number(item.quantity) || 1;
        const itemTotal = (Number(item.priceUSD) || 0) * qty;
        subtotal += itemTotal;
        const imgSrc = escapeHtml(fixImagePath(item.img));
        const name = escapeHtml(item.name);
        const metal = escapeHtml(item.metal || '18K Gold');
        const carat = escapeHtml(item.carat || '1.5ct GIA');
        const engraving = item.engraving
          ? `| Engraving: "<em>${escapeHtml(item.engraving)}</em>"`
          : '';

        return `
          <div class="cart-item-row">
            <img src="${imgSrc}" class="cart-item-img" alt="${name}" />
            <div>
              <div class="cart-item-name">${name}</div>
              <div class="cart-item-meta">
                ${metal} | ${carat}
                ${engraving}
              </div>
            </div>
            <div class="cart-qty-wrap">
              <button type="button" class="cart-qty-btn" onclick="updateQty(${index}, -1)">-</button>
              <span class="cart-qty-val">${qty}</span>
              <button type="button" class="cart-qty-btn" onclick="updateQty(${index}, 1)">+</button>
            </div>
            <div style="display:flex;align-items:center;gap:12px;">
              <div class="cart-item-price">$${itemTotal.toLocaleString()} USD</div>
              <button type="button" class="btn-cart-remove" onclick="removeItem(${index})" title="Remove item">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
        `;
      }).join('');

      document.getElementById('cartSubtotal').textContent = `$${subtotal.toLocaleString()} USD`;
      document.getElementById('cartTotalUSD').textContent = `$${subtotal.toLocaleString()} USD`;
    }

    function updateQty(index, change) {
      const items = getCartItems();
      if (items[index]) {
        items[index].quantity = (Number(items[index].quantity) || 1) + change;
        if (items[index].quantity <= 0) {
          items.splice(index, 1);
        }
        saveCartItems(items);
      }
    }

    function removeItem(index) {
      const items = getCartItems();
      if (items[index]) {
        items.splice(index, 1);
        saveCartItems(items);
      }
    }

    async function proceedCartCheckout() {
      if (!isUserLoggedIn) {
        if (confirm("Sign In Required!\n\nYou must be signed in to checkout your shopping cart.\n\nWould you like to Sign In now?")) {
          window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        }
        return;
      }

      const items = getCartItems();
      if (!items || items.length === 0) {
        alert("Your cart is empty. Please add items to checkout.");
        return;
      }

      const btn = document.querySelector('.btn-checkout-cart');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Connecting to Stripe…';
      }

      try {
        const payload = {
          items: items.map(i => ({
            id: i.id,
            metal: i.metal || '',
            carat: i.carat || '',
            engraving: i.engraving || '',
            quantity: Number(i.quantity) || 1
          }))
        };

        const res = await fetch('/Payment/CreateCheckoutSession', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': ''
          },
          body: JSON.stringify(payload)
        });

        const data = await res.json().catch(() => ({}));
        if (res.status === 401) {
          if (confirm((data.message || 'Sign in required.') + '\n\nGo to Sign In?')) {
            window.location.href = data.loginUrl || '/Account/SignIn?returnUrl=/Product/Cart';
          }
          return;
        }
        if (!res.ok || !data.success || !data.url) {
          throw new Error(data.message || 'Unable to start Stripe checkout.');
        }

        window.location.href = data.url;
      } catch (err) {
        alert(err.message || 'Checkout failed. Please try again.');
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-credit-card"></i> Proceed to USD Checkout';
        }
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      renderCartView();
      const params = new URLSearchParams(window.location.search);
      if (params.get('cleared') === '1') {
        localStorage.removeItem('sat_shopping_cart_usd');
        renderCartView();
        history.replaceState({}, '', '/Product/Cart');
      }
    });
  </script>
</body>

</html>
