@{
    ViewData["Title"] = "Shopping Cart & Home Delivery Checkout";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shopping Cart & Home Delivery Checkout — SAT Jewel Sanctuary</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/style.css" />
  @if (isAuthenticated)
  {
    <!-- Official PayPal Smart Payment Buttons SDK -->
    <script src="https://www.paypal.com/sdk/js?client-id=sb&currency=USD&enable-funding=venmo,paylater"></script>
  }
  <style>
    body {
      background: radial-gradient(circle at 50% 20%, #0d1b2a 0%, #050b14 100%);
      color: #ffffff;
      font-family: var(--font-sans);
      min-height: 100vh;
      margin: 0;
    }
    .cart-container {
      max-width: 960px;
      margin: 40px auto 80px;
      padding: 0 20px;
    }
    .cart-card {
      background: rgba(8, 17, 34, 0.85);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(212, 178, 112, 0.35);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    }
    .cart-title {
      font-family: var(--font-serif);
      font-size: 28px;
      margin: 0 0 6px;
    }
    .cart-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      gap: 16px;
    }
    .cart-item-img {
      width: 70px;
      height: 70px;
      border-radius: 12px;
      object-fit: cover;
      border: 1px solid rgba(212, 178, 112, 0.3);
    }
    .paypal-checkout-panel {
      margin-top: 28px;
      padding-top: 24px;
      border-top: 1px solid rgba(212, 178, 112, 0.3);
    }
    .paypal-box-wrap {
      max-width: 520px;
      margin: 20px auto 0;
    }
    .paypal-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: rgba(0, 112, 186, 0.15);
      border: 1px solid #0070ba;
      border-radius: 20px;
      color: #38bdf8;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 14px;
    }
    .auth-required-banner {
      background: rgba(212, 178, 112, 0.08);
      border: 1px solid rgba(212, 178, 112, 0.4);
      border-radius: 16px;
      padding: 28px 24px;
      text-align: center;
      margin-top: 24px;
    }
    .btn-auth-signin {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      background: var(--champagne-gold);
      color: #060c14;
      font-weight: 800;
      border-radius: 30px;
      text-decoration: none;
      transition: all 0.25s ease;
    }
    .btn-auth-signin:hover {
      background: #ffffff;
      color: #000000;
      box-shadow: 0 4px 20px rgba(212, 178, 112, 0.5);
    }
    .btn-auth-signup {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      background: transparent;
      border: 1px solid var(--champagne-gold);
      color: var(--champagne-gold);
      font-weight: 700;
      border-radius: 30px;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    /* Home Delivery Address Form Section */
    .delivery-form-box {
      background: #08111e;
      border: 1px solid rgba(212, 178, 112, 0.35);
      border-radius: 18px;
      padding: 24px;
      margin-top: 28px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }
    .delivery-form-title {
      font-size: 17px;
      font-weight: 700;
      color: var(--champagne-gold);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .form-grid-2col {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    @@media (max-width: 650px) {
      .form-grid-2col { grid-template-columns: 1fr; }
    }
    .form-group-item {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-group-item label {
      font-size: 12.5px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.85);
    }
    .form-input-field {
      padding: 12px 14px;
      background: #0d1b2a;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 8px;
      color: #ffffff;
      font-size: 13.5px;
      outline: none;
      box-sizing: border-box;
      transition: border-color 0.25s ease;
    }
    .form-input-field:focus {
      border-color: var(--champagne-gold);
      box-shadow: 0 0 10px rgba(212, 178, 112, 0.3);
    }
  </style>
</head>
<body>
  <div class="cart-container">
    <div style="margin-bottom: 20px;">
      <a href="/" style="color: var(--champagne-gold); text-decoration: none; font-size: 14px;"><i class="fa-solid fa-arrow-left"></i> Back to Storefront</a>
    </div>

    <div class="cart-card">
      <h1 class="cart-title">Bespoke Shopping Cart</h1>
      <p style="color:var(--taupe-beige); font-size:14px; margin-bottom:28px;">Review your GIA certified fine jewelry pieces before secure PayPal USD checkout.</p>

      <div id="cartItemsContainer">
        <!-- Rendered dynamically by JavaScript -->
      </div>

      @if (isAuthenticated)
      {
        <!-- High Priority Home Delivery Address Form -->
        <div class="delivery-form-box">
          <div class="delivery-form-title">
            <i class="fa-solid fa-truck-ramp-box"></i> Home Delivery Shipping Address <span style="font-size:11px; color:#fbbf24; font-weight:600; margin-left:auto;">[ HIGH PRIORITY ]</span>
          </div>

          <form id="shippingAddressForm">
            <div class="form-grid-2col">
              <div class="form-group-item">
                <label>Recipient Full Name *</label>
                <input type="text" id="shipFullName" class="form-input-field" value="@userName" placeholder="e.g. Sahil Kumar" required />
              </div>
              <div class="form-group-item">
                <label>Contact Phone (For Courier Tracking SMS) *</label>
                <input type="tel" id="shipPhone" class="form-input-field" placeholder="e.g. +91 98765 43210" required />
              </div>
            </div>

            <div class="form-group-item" style="margin-top:14px;">
              <label>Home Delivery Street Address *</label>
              <input type="text" id="shipStreet" class="form-input-field" placeholder="Flat No., House No., Building Name, Street" required />
            </div>

            <div class="form-grid-2col" style="margin-top:14px;">
              <div class="form-group-item">
                <label>City / Town *</label>
                <input type="text" id="shipCity" class="form-input-field" placeholder="e.g. Mumbai / New York" required />
              </div>
              <div class="form-group-item">
                <label>State / Province / Region *</label>
                <input type="text" id="shipState" class="form-input-field" placeholder="e.g. Maharashtra / California" required />
              </div>
            </div>

            <div class="form-grid-2col" style="margin-top:14px;">
              <div class="form-group-item">
                <label>Postal / ZIP Code *</label>
                <input type="text" id="shipPostalCode" class="form-input-field" placeholder="e.g. 400001 / 10001" required />
              </div>
              <div class="form-group-item">
                <label>Country *</label>
                <select id="shipCountry" class="form-input-field" required>
                  <option value="India" selected>India</option>
                  <option value="United States">United States</option>
                  <option value="United Kingdom">United Kingdom</option>
                  <option value="Canada">Canada</option>
                  <option value="Australia">Australia</option>
                  <option value="United Arab Emirates">United Arab Emirates</option>
                  <option value="Germany">Germany</option>
                  <option value="France">France</option>
                </select>
              </div>
            </div>
          </form>
        </div>
      }

      <div class="paypal-checkout-panel">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
          <div>
            <div class="paypal-badge"><i class="fa-brands fa-paypal"></i> PayPal USD Express Checkout</div>
            <div style="color:var(--taupe-beige); font-size:14px;">Total Order Subtotal:</div>
            <div id="cartTotalDisplay" style="font-family:var(--font-serif); font-size:30px; font-weight:700; color:#fbbf24; margin-top:2px;">$0 USD</div>
          </div>
        </div>

        @if (isAuthenticated)
        {
          <div id="paypalContainerBox" class="paypal-box-wrap">
            <div id="paypal-button-container"></div>
          </div>
        }
        else
        {
          <!-- Sign In Required Gate Banner -->
          <div class="auth-required-banner">
            <i class="fa-solid fa-lock" style="font-size:36px; color:var(--champagne-gold); margin-bottom:12px;"></i>
            <h3 style="margin:0 0 8px; font-family:var(--font-serif); font-size:22px; color:#ffffff;">Sign In Required to Proceed to Payment</h3>
            <p style="color:rgba(255,255,255,0.75); font-size:14px; margin-bottom:22px; max-width:540px; margin-left:auto; margin-right:auto; line-height:1.5;">
              To secure your order, receive instant order confirmation, and provide your home delivery address, please sign in to your account before completing payment.
            </p>
            <div style="display:flex; justify-content:center; gap:14px; flex-wrap:wrap;">
              <a href="/Account/SignIn?returnUrl=/Product/Cart" class="btn-auth-signin">
                <i class="fa-solid fa-right-to-bracket"></i> Sign In to Continue
              </a>
              <a href="/Account/SignUp?returnUrl=/Product/Cart" class="btn-auth-signup">
                <i class="fa-solid fa-user-plus"></i> Create New Account
              </a>
            </div>
          </div>
        }
      </div>
    </div>
  </div>

  <script>
    const isUserAuthenticated = @(isAuthenticated ? "true" : "false");
    let currentCartTotal = 0;
    let currentCartSummary = 'Bespoke Jewelry Order';

    document.addEventListener('DOMContentLoaded', () => {
      renderCart();
      if (isUserAuthenticated) {
        initPayPalButtons();
      }
    });

    function renderCart() {
      const container = document.getElementById('cartItemsContainer');
      const totalEl = document.getElementById('cartTotalDisplay');
      const paypalBox = document.getElementById('paypalContainerBox');
      if (!container) return;

      try {
        const saved = localStorage.getItem('sat_shopping_cart_usd');
        const items = saved ? JSON.parse(saved) : [];

        if (items.length === 0) {
          container.innerHTML = `
            <div style="text-align:center; padding: 40px 20px;">
              <i class="fa-solid fa-bag-shopping" style="font-size:42px; color:var(--champagne-gold); margin-bottom:14px;"></i>
              <h3 style="margin:0 0 8px; font-family:var(--font-serif);">Your Shopping Cart is Empty</h3>
              <p style="color:var(--taupe-beige); font-size:14px; margin-bottom:20px;">Discover handcrafted engagement rings, necklaces, and GIA diamonds in our shop.</p>
              <a href="/Product" class="btn-primary" style="display:inline-flex; padding:10px 24px; border-radius:30px; text-decoration:none;"><i class="fa-solid fa-gem"></i> Browse Shop Catalog</a>
            </div>
          `;
          totalEl.textContent = '$0 USD';
          if (paypalBox) paypalBox.style.display = 'none';
          currentCartTotal = 0;
          return;
        }

        if (paypalBox && isUserAuthenticated) paypalBox.style.display = 'block';

        let total = 0;
        let html = '';
        let names = [];

        items.forEach((item, index) => {
          const itemPrice = Number(item.priceUSD) || 0;
          const qty = Number(item.quantity) || 1;
          const subtotal = itemPrice * qty;
          total += subtotal;
          names.push(item.name || 'Jewelry Piece');

          html += `
            <div class="cart-item-row">
              <div style="display:flex; align-items:center; gap:16px;">
                <img src="${item.img || '/assets/ring_1.jpg'}" class="cart-item-img" alt="${item.name}" />
                <div>
                  <div style="font-weight:700; font-family:var(--font-serif); font-size:16px;">${item.name}</div>
                  <div style="font-size:12px; color:var(--taupe-beige); margin-top:2px;">$${itemPrice.toLocaleString()} USD each</div>
                </div>
              </div>
              <div style="display:flex; align-items:center; gap:16px;">
                <div style="font-weight:700; color:#fbbf24; font-size:18px;">$${subtotal.toLocaleString()} USD</div>
                <button type="button" onclick="removeItem(${index})" style="background:none; border:none; color:#fca5a5; cursor:pointer; font-size:16px;" title="Remove Item"><i class="fa-solid fa-trash-can"></i></button>
              </div>
            </div>
          `;
        });

        currentCartTotal = total;
        currentCartSummary = names.join(', ');
        container.innerHTML = html;
        totalEl.textContent = '$' + total.toLocaleString() + ' USD';
      } catch (e) {
        console.error(e);
      }
    }

    function getShippingAddressData() {
      const nameEl = document.getElementById('shipFullName');
      const phoneEl = document.getElementById('shipPhone');
      const streetEl = document.getElementById('shipStreet');
      const cityEl = document.getElementById('shipCity');
      const stateEl = document.getElementById('shipState');
      const postalEl = document.getElementById('shipPostalCode');
      const countryEl = document.getElementById('shipCountry');

      if (!nameEl || !phoneEl || !streetEl || !cityEl || !stateEl || !postalEl || !countryEl) return null;

      const name = nameEl.value.trim();
      const phone = phoneEl.value.trim();
      const street = streetEl.value.trim();
      const city = cityEl.value.trim();
      const state = stateEl.value.trim();
      const postal = postalEl.value.trim();
      const country = countryEl.value.trim();

      if (!name || !phone || !street || !city || !state || !postal) {
        return null;
      }

      return { name, phone, street, city, state, postal, country };
    }

    function removeItem(index) {
      try {
        const saved = localStorage.getItem('sat_shopping_cart_usd');
        let items = saved ? JSON.parse(saved) : [];
        items.splice(index, 1);
        localStorage.setItem('sat_shopping_cart_usd', JSON.stringify(items));
        renderCart();
        if (typeof syncCartBadge === 'function') syncCartBadge();
      } catch (e) {}
    }

    function initPayPalButtons() {
      if (typeof paypal === 'undefined') return;

      paypal.Buttons({
        style: {
          layout: 'vertical',
          color:  'gold',
          shape:  'rect',
          label:  'paypal'
        },

        createOrder: function(data, actions) {
          const addr = getShippingAddressData();
          if (!addr) {
            alert('⚠️ Please fill in all required Home Delivery Shipping Address fields before completing checkout.');
            throw new Error('Shipping address incomplete.');
          }

          const finalAmount = currentCartTotal > 0 ? currentCartTotal.toFixed(2) : '1700.00';
          return actions.order.create({
            purchase_units: [{
              description: currentCartSummary || 'SAT Bespoke Jewelry Order',
              amount: {
                currency_code: 'USD',
                value: finalAmount
              }
            }]
          });
        },

        onApprove: function(data, actions) {
          return actions.order.capture().then(async function(details) {
            const paypalOrderId = data.orderID || details.id || 'PAYPAL-' + Date.now();
            const payerEmail = details.payer ? details.payer.email_address : '';
            const addr = getShippingAddressData() || {};

            try {
              const res = await fetch('/api/paymentapi/process-paypal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  payPalOrderId: paypalOrderId,
                  itemName: currentCartSummary || 'Bespoke Fine Jewelry',
                  amount: currentCartTotal > 0 ? currentCartTotal : 1700,
                  payerEmail: payerEmail,
                  payerCountryCode: addr.country || 'India',

                  // Pass Home Delivery Shipping Address to API
                  shippingFullName: addr.name || '',
                  shippingPhone: addr.phone || '',
                  shippingStreet: addr.street || '',
                  shippingCity: addr.city || '',
                  shippingState: addr.state || '',
                  shippingPostalCode: addr.postal || '',
                  shippingCountry: addr.country || 'India'
                })
              });

              const result = await res.json();
              if (result.success) {
                alert('🎉 Order Placed Successfully! Your fine jewelry order has been scheduled for Home Delivery. Order ID: ' + result.orderId);
                localStorage.removeItem('sat_shopping_cart_usd');
                window.location.href = '/Account/Orders';
              } else {
                alert('Payment captured, but order registration warning: ' + result.message);
                window.location.href = '/Account/Orders';
              }
            } catch (err) {
              alert('Payment Completed via PayPal! Redirecting to your Orders...');
              localStorage.removeItem('sat_shopping_cart_usd');
              window.location.href = '/Account/Orders';
            }
          });
        },

        onError: function(err) {
          console.error('PayPal Checkout Error:', err);
          alert('An error occurred during PayPal checkout. Please ensure all shipping details are entered and try again.');
        }
      }).render('#paypal-button-container');
    }
  </script>
</body>
</html>
