    function populateStateDropdown(country, targetState, targetCity) {
      const stateEl = document.getElementById('shipState');
      if (!stateEl) return;
      stateEl.innerHTML = '';
      
      const states = GEO_DATA[country] || {};
      const stateKeys = Object.keys(states);

      if (stateKeys.length === 0) {
        const opt = document.createElement('option');
        opt.value = targetState || 'Standard';
        opt.textContent = targetState || 'Standard';
        stateEl.appendChild(opt);
      } else {
        stateKeys.forEach(st => {
          const opt = document.createElement('option');
          opt.value = st;
          opt.textContent = st;
          if (targetState && targetState.toLowerCase() === st.toLowerCase()) {
            opt.selected = true;
          }
          stateEl.appendChild(opt);
        });
      }

      onStateChanged(targetCity);
    }

    function onStateChanged(targetCity) {
      const countryEl = document.getElementById('shipCountry');
      const stateEl = document.getElementById('shipState');
      const cityEl = document.getElementById('shipCity');
      if (!countryEl || !stateEl || !cityEl) return;

      const country = countryEl.value;
      const state = stateEl.value;
      cityEl.innerHTML = '';

      const cities = (GEO_DATA[country] && GEO_DATA[country][state]) ? GEO_DATA[country][state] : [];
      if (cities.length === 0) {
        const opt = document.createElement('option');
        opt.value = targetCity || 'Metro Area';
        opt.textContent = targetCity || 'Metro Area';
        cityEl.appendChild(opt);
      } else {
        cities.forEach(ct => {
          const opt = document.createElement('option');
          opt.value = ct;
          opt.textContent = ct;
          if (targetCity && targetCity.toLowerCase() === ct.toLowerCase()) {
            opt.selected = true;
          }
          cityEl.appendChild(opt);
        });
      }
      checkAddressValidation();
    }

    function onAddressSelectChanged(val) {
      if (val === '__new__') {
        showAddressInputForm(true);
        // Clear inputs for entering a brand new address
        const nameEl = document.getElementById('shipFullName');
        if (nameEl && !nameEl.value) nameEl.value = '@userName';
        const streetEl = document.getElementById('shipStreet');
        if (streetEl) streetEl.value = '';
        const phoneEl = document.getElementById('shipPhone');
        if (phoneEl && phoneEl.value.includes('DEFAULT')) phoneEl.value = '';
        const postalEl = document.getElementById('shipPostalCode');
        if (postalEl) postalEl.value = '';
        const initCountry = document.getElementById('shipCountry')?.value || 'India';
        populateStateDropdown(initCountry, 'Gujarat', 'Navsari');
        checkAddressValidation();
        return;
      }

      if (!val) {
        showAddressInputForm(true);
        return;
      }

      try {
        const item = typeof val === 'string' ? JSON.parse(val) : val;
        loadSavedAddressIntoFields(item);
        updateSelectedAddressCard(item);
        showAddressInputForm(false);
        checkAddressValidation();
      } catch (e) {
        console.error('Error parsing saved address:', e);
        showAddressInputForm(true);
      }
    }

