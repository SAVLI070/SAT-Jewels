      const bannerSubtotal = document.getElementById('banner-subtotal-display');
      const giaRow = document.getElementById('summary-gia-row');
      const giaCheckbox = document.getElementById('gia-checkbox');

      if (!container) return;

      try {
        const items = getActiveCartItems();
        const totalQty = items.reduce((sum, i) => sum + (Number(i.quantity) || 1), 0);
        if (badgeEl) badgeEl.textContent = totalQty;
        document.querySelectorAll('#navCartBadge, #navCartCount, .auth-nav-cart-count, .sat-cart-count-badge').forEach(el => {
          el.textContent = String(totalQty);
