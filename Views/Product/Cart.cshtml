        }

        const totalFormatted = '$' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
        if (totalDisplay) totalDisplay.textContent = totalFormatted;
        if (bannerSubtotal) bannerSubtotal.textContent = totalFormatted;

      } catch (e) {
