                      <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                    </a>
                    <div class="text-left sm:text-right">
                      <p class="font-headline-sm text-headline-sm text-primary font-bold tracking-tight">${formattedPrice} <span class="font-label-caps text-label-caps text-on-surface-variant font-normal">USD</span></p>
                      <p class="font-label-caps text-[10px] text-on-surface-variant">Complimentary Armored Freight Included</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          `;
        });

        container.innerHTML = html;
        currentRawItemsTotal = rawTotal;

        // Restore GIA hardcopy option from storage
        const storedGia = localStorage.getItem('sat_cart_physical_cert');
        if (giaCheckbox) {
          if (storedGia !== null) {
            giaCheckbox.checked = (storedGia === 'true');
          } else {
            giaCheckbox.checked = true; // default enabled
          }
        }

        const isGia = giaCheckbox ? giaCheckbox.checked : true;
        const giaFee = isGia ? 50 : 0;
        const total = rawTotal + giaFee;
        currentCartTotal = total;
        currentCartSummary = names.join(', ') + (isGia ? ' (+ Hardcopy GIA Certificate)' : '');

        if (countBadge) countBadge.textContent = `${items.length} Custom ${items.length === 1 ? 'Piece' : 'Pieces'}`;
        if (itemsPriceEl) itemsPriceEl.textContent = '$' + rawTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
        
        if (giaRow) {
          if (isGia) {
            giaRow.classList.remove('hidden');
            giaRow.classList.add('flex');
          } else {
            giaRow.classList.add('hidden');
            giaRow.classList.remove('flex');
