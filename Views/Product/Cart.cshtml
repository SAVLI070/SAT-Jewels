    function removeItem(index) {
      try {
        const key = getCartStorageKey();
        const saved = localStorage.getItem(key);
        let items = saved ? JSON.parse(saved) : [];
        items.splice(index, 1);
        localStorage.setItem(key, JSON.stringify(items));
        renderCart();
      } catch (e) {
        console.error(e);
      }
    }

    function loadSavedAddress(jsonStr) {
      if (!jsonStr) return;
      try {
        const item = JSON.parse(jsonStr);
        if (item.FullName) document.getElementById('shipFullName').value = item.FullName;
        if (item.Phone) document.getElementById('shipPhone').value = item.Phone;
        if (item.StreetAddress) document.getElementById('shipStreet').value = item.StreetAddress;
        if (item.City) document.getElementById('shipCity').value = item.City;
        if (item.State) document.getElementById('shipState').value = item.State;
        if (item.PostalCode) document.getElementById('shipPostalCode').value = item.PostalCode;
        if (item.Country) {
          const countryEl = document.getElementById('shipCountry');
          if (countryEl) countryEl.value = item.Country;
        }
        checkAddressValidation();
      } catch (e) {
        console.error(e);
      }
    }

    function onCountryChanged() {
      const countryEl = document.getElementById('shipCountry');
      const postalEl = document.getElementById('shipPostalCode');
      if (!countryEl || !postalEl) return;

      const country = countryEl.value;
      switch (country) {
        case 'India':
          postalEl.placeholder = '396445 (6-digit PIN)';
          break;
        case 'United States':
          postalEl.placeholder = '10021 / 90210 (5-digit ZIP)';
          break;
        case 'United Kingdom':
          postalEl.placeholder = 'SW1A 1AA / EC1A 1BB';
          break;
        case 'Canada':
          postalEl.placeholder = 'M5V 2T6';
          break;
        case 'Australia':
          postalEl.placeholder = '2000 / 3000';
          break;
        default:
          postalEl.placeholder = 'Postal / ZIP Code';
          break;
      }
      checkAddressValidation();
    }

    function validatePostalCodeFormat(postal, country) {
      if (!postal) return { valid: false, message: 'Postal / ZIP Code is required.' };
      const clean = postal.trim().toUpperCase();
      const digitsOnly = clean.replace(/\D/g, '');

      if (country === 'United States') {
        if (digitsOnly.length === 6) {
          return {
            valid: false,
            message: `"${postal}" is a 6-digit Indian PIN. For US, enter 5-digit ZIP (e.g. 10021).`
          };
        }
        if (!/^\d{5}(-\d{4})?$/.test(clean)) {
          return { valid: false, message: 'Please enter a valid 5-digit US ZIP code (e.g. 10021).' };
        }
        return { valid: true };
      }

      if (country === 'India') {
        if (digitsOnly.length === 5) {
          return {
            valid: false,
            message: `"${postal}" is a 5-digit US ZIP. For India, enter 6-digit PIN (e.g. 396445).`
          };
        }
        if (!/^\d{6}$/.test(clean)) {
          return { valid: false, message: 'Please enter a valid 6-digit Indian PIN code (e.g. 396445).' };
        }
        return { valid: true };
      }

      if (country === 'United Kingdom') {
        if (!/^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/.test(clean)) {
          return { valid: false, message: 'Please enter a valid UK postcode (e.g. SW1A 1AA).' };
        }
        return { valid: true };
      }

      if (clean.length < 3) {
        return { valid: false, message: 'Please enter a valid postal code.' };
      }

      return { valid: true };
    }

    function getShippingAddressData() {
      const nameEl = document.getElementById('shipFullName');
      const phoneEl = document.getElementById('shipPhone');
      const streetEl = document.getElementById('shipStreet');
      const cityEl = document.getElementById('shipCity');
      const stateEl = document.getElementById('shipState');
      const postalEl = document.getElementById('shipPostalCode');
      const countryEl = document.getElementById('shipCountry');

      if (!nameEl || !phoneEl || !streetEl || !cityEl || !stateEl || !postalEl || !countryEl) return null;

      const name = nameEl.value.trim();
      const phone = phoneEl.value.trim();
      const street = streetEl.value.trim();
      const city = cityEl.value.trim();
      const state = stateEl.value.trim();
      const postal = postalEl.value.trim();
      const country = countryEl.value.trim();

      if (!name || !phone || !street || !city || !state || !postal) return null;

      const check = validatePostalCodeFormat(postal, country);
      if (!check.valid) return null;

      return { name, phone, street, city, state, postal, country };
    }

    function checkAddressValidation() {
      const addr = getShippingAddressData();
      const notice = document.getElementById('addressWarningNotice');
      const icon = document.getElementById('addressStatusIcon');
      const text = document.getElementById('addressStatusText');
      const paypalBox = document.getElementById('paypalContainerBox');
      const feedback = document.getElementById('postalCodeFeedback');
      const postalEl = document.getElementById('shipPostalCode');
      const countryEl = document.getElementById('shipCountry');

      const postalVal = postalEl ? postalEl.value.trim() : '';
      const countryVal = countryEl ? countryEl.value : 'India';

      if (postalVal && feedback) {
        const check = validatePostalCodeFormat(postalVal, countryVal);
        feedback.classList.remove('hidden');
        feedback.classList.add('flex');
        if (!check.valid) {
          feedback.className = 'flex items-center gap-1.5 text-error pt-0.5';
          feedback.innerHTML = `<span class="material-symbols-outlined text-[16px]">warning</span> <span class="font-label-sm text-label-sm">${check.message}</span>`;
        } else {
          feedback.className = 'flex items-center gap-1.5 text-tertiary pt-0.5';
          feedback.innerHTML = `<span class="material-symbols-outlined text-[16px]">check_circle</span> <span class="font-label-sm text-label-sm">Valid ${countryVal} postal format &amp; armored service area.</span>`;
        }
      } else if (feedback) {
        feedback.classList.add('hidden');
        feedback.classList.remove('flex');
      }

      if (addr) {
        if (notice && icon && text) {
          notice.className = 'p-3.5 rounded-lg bg-surface-container-high border border-tertiary/40 flex items-center gap-3 transition-colors';
          icon.className = 'material-symbols-outlined text-tertiary text-[22px]';
          icon.textContent = 'verified_user';
          text.innerHTML = `<strong class="text-tertiary font-semibold">Payment Authorized:</strong> Shipping address verified for ${addr.country}. Select your payment gateway below.`;
        }
        if (paypalBox) {
          paypalBox.classList.remove('opacity-50', 'pointer-events-none');
        }
        return true;
      } else {
        if (notice && icon && text) {
          notice.className = 'p-3.5 rounded-lg bg-surface-container-low border border-outline-variant/30 flex items-center gap-3 transition-colors';
          icon.className = 'material-symbols-outlined text-primary text-[22px]';
          icon.textContent = 'lock';
          text.innerHTML = `<strong class="text-primary font-semibold">Address Required:</strong> Complete your full name, street, city, and valid postal code above to unlock payment.`;
        }
        if (paypalBox) {
          paypalBox.classList.add('opacity-50', 'pointer-events-none');
        }
        return false;
      }
    }

    function toggleWireDetails() {
      const wire = document.getElementById('wire-payment-details');
      if (wire) wire.classList.toggle('hidden');
    }

    function scrollToPaymentOrAction() {
      if (!isUserAuthenticated) {
        window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        return;
      }
      const addr = getShippingAddressData();
      if (!addr) {
        const formEl = document.getElementById('shippingAddressForm');
        if (formEl) formEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        checkAddressValidation();
        return;
      }
      const paypalBox = document.getElementById('paypalContainerBox');
      if (paypalBox) {
        paypalBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function showPaymentProcessing(msg) {
      const el = document.getElementById('paymentProcessingOverlay');
      const msgEl = document.getElementById('processingOverlayMessage');
      if (msgEl && msg) msgEl.textContent = msg;
      if (el) el.style.display = 'flex';
    }

    function hidePaymentProcessing() {
      const el = document.getElementById('paymentProcessingOverlay');
      if (el) el.style.display = 'none';
    }

    function isPhysicalCertSelected() {
      const chk = document.getElementById('gia-checkbox');
      return chk ? chk.checked : (localStorage.getItem('sat_cart_physical_cert') === 'true');
    }

    // PayPal Official Smart Buttons Integration
    function initPayPalButtons() {
      if (typeof paypal === 'undefined') return;

      const container = document.getElementById('paypal-button-container');
      if (!container) return;
      container.innerHTML = '';

      paypal.Buttons({
        style: {
          layout: 'vertical',
          color:  'gold',
          shape:  'rect',
          label:  'paypal'
        },

        onClick: function(data, actions) {
          if (!isUserAuthenticated) {
            alert('🚫 PERMISSION DENIED: You must sign in to your account before proceeding to payment.');
            window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
            return actions.reject();
          }

          const addr = getShippingAddressData();
          if (!addr) {
            alert('⚠️ PERMISSION DENIED: Complete home delivery shipping address (Full Name, Phone, Street, City, State, ZIP) is required before payment can be initialized.');
            checkAddressValidation();
            scrollToPaymentOrAction();
            return actions.reject();
          }
          return actions.resolve();
        },

        createOrder: async function(data, actions) {
          const addr = getShippingAddressData();
          if (!addr) {
            alert('⚠️ Shipping Address Required before completing checkout.');
            throw new Error('Shipping address incomplete.');
          }

          const key = getCartStorageKey();
          const savedCart = localStorage.getItem(key);
          const cartItems = savedCart ? JSON.parse(savedCart) : [];
          const firstItemId = cartItems.length > 0 ? (cartItems[0].id || cartItems[0].catalogItemId || 'sat-prod-8') : 'sat-prod-8';
          const qty = cartItems.length > 0 ? (Number(cartItems[0].quantity) || 1) : 1;
          const mappedCartItems = cartItems.map(item => ({
            productId: item.id || item.catalogItemId || 'sat-prod-8',
            name: item.name || 'Bespoke Fine Jewelry',
            quantity: Number(item.quantity) || 1,
            stoneType: item.stone || item.stoneType || 'Lab Grown Diamond',
            metal: item.metal || '',
            size: item.size || '',
            priceUSD: Number(item.priceUSD) || 0
          }));

          try {
            const res = await fetch('/api/payment/create-order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                productId: firstItemId,
                quantity: qty,
                stoneType: cartItems[0]?.stone || cartItems[0]?.stoneType || 'Lab Grown Diamond',
                metal: cartItems[0]?.metal || '',
                ringSize: cartItems[0]?.size || '',
                cartItems: mappedCartItems,
                includePhysicalCertificate: isPhysicalCertSelected(),
                shippingFullName: addr.name,
                shippingPhone: addr.phone,
                shippingStreet: addr.street,
                shippingCity: addr.city,
                shippingState: addr.state,
                shippingPostalCode: addr.postal,
                shippingCountry: addr.country
              })
            });

            const result = await res.json();
            if (result.success && result.orderId) {
              return result.orderId;
            } else {
              alert('Error initializing PayPal order: ' + (result.message || 'Server error'));
              throw new Error(result.message);
            }
          } catch (err) {
            console.error('PayPal createOrder error:', err);
            throw err;
          }
        },

        onApprove: function(data, actions) {
          showPaymentProcessing("Confirming PayPal payment authorization with server-authoritative verification. Please do not close this window...");
          return fetch('/api/payment/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ payPalOrderId: data.orderID })
          })
          .then(res => res.json())
          .then(result => {
            hidePaymentProcessing();
            if (result.success) {
              const key = getCartStorageKey();
              const savedCart = localStorage.getItem(key);
              const cartItems = savedCart ? JSON.parse(savedCart) : [];
              const firstItemId = cartItems.length > 0 ? (cartItems[0].id || cartItems[0].catalogItemId || 'sat-prod-8') : 'sat-prod-8';
              localStorage.removeItem(key);

              try {
                sessionStorage.setItem('sat_pending_review_item', JSON.stringify({
                  productId: firstItemId,
                  productName: cartItems[0]?.name || 'Bespoke Fine Jewelry',
                  orderId: result.orderId || data.orderID
                }));
              } catch(e) {}

              const confirmedOrderId = result.orderId || data.orderID;
              window.location.href = '/Order/Confirmation?orderId=' + encodeURIComponent(confirmedOrderId);
            } else {
              alert('⚠️ PayPal Verification Warning: ' + result.message);
            }
          })
          .catch(err => {
            hidePaymentProcessing();
            console.error('PayPal Verify Error:', err);
            alert('Verification Error: Unable to verify payment with PayPal. Please check your account or contact support.');
          });
        },

        onCancel: function(data) {
          hidePaymentProcessing();
          alert('PayPal checkout was cancelled. Your items remain safely in your cart.');
        },

        onError: function(err) {
          hidePaymentProcessing();
          console.error('PayPal Checkout Error:', err);
          alert('An error occurred during PayPal checkout. Please ensure your shipping details are entered and try again.');
        }
      }).render('#paypal-button-container');
    }

    // Razorpay Embedded Card Payment
    async function payWithRazorpay() {
      if (!isUserAuthenticated) {
        alert('🚫 PERMISSION DENIED: You must sign in to your account before proceeding to payment.');
        window.location.href = '/Account/SignIn?returnUrl=/Product/Cart';
        return;
      }

      const addr = getShippingAddressData();
      if (!addr) {
        alert('⚠️ PERMISSION DENIED: Complete home delivery shipping address (Full Name, Phone, Street, City, State, ZIP) is required before payment can be initialized.');
        checkAddressValidation();
        scrollToPaymentOrAction();
        return;
      }

      const key = getCartStorageKey();
      const savedCart = localStorage.getItem(key);
      const cartItems = savedCart ? JSON.parse(savedCart) : [];
      const firstItemId = cartItems.length > 0 ? (cartItems[0].id || cartItems[0].catalogItemId || 'sat-prod-8') : 'sat-prod-8';
      const qty = cartItems.length > 0 ? (Number(cartItems[0].quantity) || 1) : 1;
      const mappedCartItems = cartItems.map(item => ({
        productId: item.id || item.catalogItemId || 'sat-prod-8',
        name: item.name || 'Bespoke Fine Jewelry',
        quantity: Number(item.quantity) || 1,
        stoneType: item.stone || item.stoneType || 'Lab Grown Diamond',
        metal: item.metal || '',
        size: item.size || '',
        priceUSD: Number(item.priceUSD) || 0
      }));

      try {
        const res = await fetch('/api/payment/razorpay/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: firstItemId,
            quantity: qty,
            stoneType: cartItems[0]?.stone || cartItems[0]?.stoneType || 'Lab Grown Diamond',
            metal: cartItems[0]?.metal || '',
            ringSize: cartItems[0]?.size || '',
            cartItems: mappedCartItems,
            includePhysicalCertificate: isPhysicalCertSelected(),
            shippingFullName: addr.name,
            shippingPhone: addr.phone,
            shippingStreet: addr.street,
            shippingCity: addr.city,
            shippingState: addr.state,
            shippingPostalCode: addr.postal,
            shippingCountry: addr.country
          })
        });

        const data = await res.json();
        if (!data.success) {
          alert('Error initializing Razorpay order: ' + data.message);
          return;
        }

        const options = {
          key: data.keyId,
          amount: Math.round(data.amountUSD * 100),
          currency: 'USD',
          name: 'SAT Luxury Jewellery',
          description: 'Bespoke Fine Jewelry Order',
          image: '/assets/sat_logo_transparent.png',
          order_id: data.razorpayOrderId,
          handler: async function (response) {
            showPaymentProcessing("Verifying Razorpay card signature server-side. Please do not close this window...");
            try {
              const verifyRes = await fetch('/api/payment/razorpay/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpayOrderId: response.razorpay_order_id,
                  razorpayPaymentId: response.razorpay_payment_id,
                  razorpaySignature: response.razorpay_signature
                })
              });

              const verifyResult = await verifyRes.json();
              hidePaymentProcessing();

              if (verifyResult.success) {
                localStorage.removeItem(getCartStorageKey());
                try {
                  sessionStorage.setItem('sat_pending_review_item', JSON.stringify({
                    productId: firstItemId,
                    productName: cartItems[0]?.name || 'Bespoke Fine Jewelry',
                    orderId: verifyResult.orderId || response.razorpay_order_id
                  }));
                } catch(e) {}
                const confirmedOrderId = verifyResult.orderId || response.razorpay_order_id;
                window.location.href = '/Order/Confirmation?orderId=' + encodeURIComponent(confirmedOrderId);
              } else {
                alert('⚠️ Razorpay Signature Verification Alert: ' + verifyResult.message);
              }
            } catch (err) {
              hidePaymentProcessing();
              alert('Error verifying Razorpay payment signature.');
            }
          },
          prefill: {
            name: addr.name,
            contact: addr.phone
          },
          theme: {
            color: '#d4af37'
          }
        };

        const rzp = new Razorpay(options);
        rzp.open();
      } catch (err) {
        hidePaymentProcessing();
        console.error('Razorpay Checkout Exception:', err);
        alert('An error occurred during Razorpay card checkout. Please try again.');
      }
    }
  </script>

