          if (itemsPriceEl) itemsPriceEl.textContent = '$0.00 USD';
          if (totalDisplay) totalDisplay.textContent = '$0.00 USD';
          if (bannerSubtotal) bannerSubtotal.textContent = '$0.00 USD';
          const stickyBarEmpty = document.getElementById('mobileStickyPaymentBar');
          if (stickyBarEmpty) stickyBarEmpty.style.display = 'none';
          currentCartTotal = 0;
          currentRawItemsTotal = 0;
