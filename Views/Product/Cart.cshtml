  <script>
    const isUserAuthenticated = @(isAuthenticated ? "true" : "false");
    let currentCartTotal = 0;
    let currentRawItemsTotal = 0;
    let currentCartSummary = 'Bespoke Jewelry Order';

    document.addEventListener('DOMContentLoaded', () => {
      // 1. Initialize cart state from storage with auto-migration
      renderCart();

      // 2. Initialize saved address if available
      if (isUserAuthenticated) {
        const savedSelect = document.getElementById('address-vault-select');
        if (savedSelect && savedSelect.value) {
          onAddressSelectChanged(savedSelect.value);
        } else {
          showAddressInputForm(true);
          const initCountry = document.getElementById('shipCountry')?.value || 'India';
          populateStateDropdown(initCountry, 'Gujarat', 'Navsari');
        }
        checkAddressValidation();
        initPayPalButtons();
      }

      // 3. Countdown timer simulation for vault reservation
      startReservationTimer(14 * 60 + 32);
    });

    function startReservationTimer(duration) {
      let timer = duration;
      const el = document.getElementById('reservationTimer');
      if (!el) return;
      setInterval(() => {
        const minutes = parseInt(timer / 60, 10);
        const seconds = parseInt(timer % 60, 10);
        const formatted = (minutes < 10 ? '0' + minutes : minutes) + ':' + (seconds < 10 ? '0' + seconds : seconds);
        el.textContent = `Cart Vault Reserved (${formatted} remaining)`;
        if (--timer < 0) {
          timer = duration;
        }
      }, 1000);
    }

    function getCartStorageKey() {
      const isAuth = @(isAuthenticated ? "true" : "false");
      const email = '@(userEmail.ToLower().Trim())';
      if (isAuth && email) {
        return 'sat_cart_' + encodeURIComponent(email);
      }
      return 'sat_cart_guest';
    }

    function getActiveCartItems() {
      const activeKey = getCartStorageKey();
      let items = [];

      // 1. Try active key
      try {
        const raw = localStorage.getItem(activeKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) items = parsed;
          else if (parsed && typeof parsed === 'object') items = [parsed];
        }
      } catch(e) {}

      // 2. If authenticated and user cart is empty, check sat_cart_guest and migrate
      if (items.length === 0 && activeKey !== 'sat_cart_guest') {
        try {
          const guestRaw = localStorage.getItem('sat_cart_guest');
          if (guestRaw) {
            const parsedGuest = JSON.parse(guestRaw);
            if (Array.isArray(parsedGuest) && parsedGuest.length > 0) {
              items = parsedGuest;
              localStorage.setItem(activeKey, JSON.stringify(items));
              localStorage.removeItem('sat_cart_guest');
            } else if (parsedGuest && typeof parsedGuest === 'object') {
              items = [parsedGuest];
              localStorage.setItem(activeKey, JSON.stringify(items));
              localStorage.removeItem('sat_cart_guest');
            }
          }
        } catch(e) {}
      }

      // 3. Fallback to generic 'sat_cart' legacy key
      if (items.length === 0) {
        try {
          const legacyRaw = localStorage.getItem('sat_cart');
          if (legacyRaw) {
            const parsedLegacy = JSON.parse(legacyRaw);
            if (Array.isArray(parsedLegacy) && parsedLegacy.length > 0) {
              items = parsedLegacy;
              localStorage.setItem(activeKey, JSON.stringify(items));
            } else if (parsedLegacy && typeof parsedLegacy === 'object') {
              items = [parsedLegacy];
              localStorage.setItem(activeKey, JSON.stringify(items));
            }
          }
        } catch(e) {}
      }

      // 4. Fallback: Search all keys in localStorage for sat_cart_*
      if (items.length === 0) {
        try {
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && k.startsWith('sat_cart_') && k !== activeKey && k !== 'sat_cart_physical_cert') {
              const val = localStorage.getItem(k);
              if (val) {
                const p = JSON.parse(val);
                if (Array.isArray(p) && p.length > 0) {
                  items = p;
                  localStorage.setItem(activeKey, JSON.stringify(items));
                  break;
                }
              }
            }
          }
        } catch(e) {}
      }

      return items;
    }

    function renderCart() {
      const container = document.getElementById('cartItemsContainer');
      const badgeEl = document.getElementById('navCartBadge');
