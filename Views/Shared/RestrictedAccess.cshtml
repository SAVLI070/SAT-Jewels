@{
    ViewData["Title"] = "Access Restricted — SAT Jewel";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var message = ViewBag.Message as string ?? "You cannot access this item directly or it is currently unavailable.";
}

<style>
  .restricted-hero {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    position: relative;
    background: radial-gradient(circle at 50% 30%, #0a1426 0%, #030712 100%);
  }

  .restricted-card {
    max-width: 580px;
    width: 100%;
    background: rgba(8, 17, 34, 0.88);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(212, 178, 112, 0.35);
    border-radius: var(--radius-2xl);
    padding: 48px 36px;
    text-align: center;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8), 0 0 40px rgba(212, 178, 112, 0.2);
  }

  .restricted-icon-box {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    border-radius: 24px;
    background: radial-gradient(circle, #1e2d4a 0%, #081120 100%);
    border: 1.5px solid var(--champagne-gold);
    color: var(--champagne-gold);
    font-size: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 30px rgba(212, 178, 112, 0.4);
  }

  .restricted-title {
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .restricted-desc {
    color: var(--taupe-beige);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 32px;
  }

  .restricted-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-restricted-gold {
    padding: 14px 28px;
    background: linear-gradient(135deg, #d4b270 0%, #b45309 100%);
    border: none;
    border-radius: var(--radius-full);
    color: #060d0a;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 4px 20px rgba(212, 178, 112, 0.4);
    transition: all 0.3s ease;
  }

  .btn-restricted-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(212, 178, 112, 0.6);
    color: #000000;
  }

  .btn-restricted-ghost {
    padding: 14px 28px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(212, 178, 112, 0.4);
    border-radius: var(--radius-full);
    color: var(--champagne-gold);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
  }

  .btn-restricted-ghost:hover {
    background: rgba(212, 178, 112, 0.15);
    color: #ffffff;
  }
</style>

<div class="restricted-hero">
  <div class="restricted-card">
    <div class="restricted-icon-box">
      <i class="fa-solid fa-shield-halved"></i>
    </div>
    
    <h1 class="restricted-title">Direct Access Restricted</h1>
    
    <p class="restricted-desc">
      @message
    </p>

    <div class="restricted-actions">
      <a href="/" class="btn-restricted-gold">
        <i class="fa-solid fa-gem"></i> Explore Storefront Collections
      </a>
      <a href="/Account/SignIn" class="btn-restricted-ghost">
        <i class="fa-solid fa-user-lock"></i> Sign In to Account
      </a>
    </div>
  </div>
</div>
