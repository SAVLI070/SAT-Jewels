@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var title = (ViewData["Title"] ?? "SAT Jewel | Buy Certified Lab Grown Diamond Engagement Rings & Fine Jewelry").ToString();
    var description = (ViewData["Description"] ?? "Shop bespoke fine jewelry, certified lab grown diamond engagement rings, solitaires, and wedding bands online at factory-direct pricing. 100% GIA & IGI certified diamonds with free insured worldwide shipping.").ToString();
    var keywords = (ViewData["Keywords"] ?? "Sat jewel, SAT Jewel, buy jewelry online, diamond engagement rings, lab grown diamonds, lab grown diamond engagement rings, solitaire diamond ring, custom engagement rings, moissanite rings, certified diamonds, wedding bands, diamond necklace, diamond earrings, tennis bracelet, fine jewelry USA, GIA certified diamonds").ToString();
    var canonicalUrl = (ViewData["CanonicalUrl"] ?? $"https://www.satjewel.com{Context.Request.Path}").ToString();
    var ogImage = (ViewData["OgImage"] ?? "https://www.satjewel.com/assets/auth_luxury_highjewelry.jpg").ToString();
    var siteUrl = "https://www.satjewel.com";
    var googleVerificationCode = Configuration["Google:SiteVerification"] ?? ViewData["GoogleSiteVerification"]?.ToString() ?? "TObPREmxOn155EOzsRD02qX8rhzmhUM3uxFkYVd1sVU";
}

<!-- Primary Search Engine Meta Tags -->
<title>@title</title>
<meta name="title" content="@title" />
<meta name="description" content="@description" />
<meta name="keywords" content="@keywords" />
<meta name="author" content="SAT Jewel" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="theme-color" content="#06070a" />
<link rel="canonical" href="@canonicalUrl" />

<!-- Google Search Console Site Verification -->
<meta name="google-site-verification" content="@googleVerificationCode" />

<!-- Geo-Targeting Meta Tags -->
<meta name="geo.region" content="US-NY" />
<meta name="geo.placename" content="New York / Surat" />
<meta name="geo.position" content="40.7128;-74.0060" />
<meta name="ICBM" content="40.7128, -74.0060" />

<!-- Open Graph / Facebook / WhatsApp Sharing Meta Tags -->
<meta property="og:type" content="website" />
<meta property="og:url" content="@canonicalUrl" />
<meta property="og:title" content="@title" />
<meta property="og:description" content="@description" />
<meta property="og:image" content="@ogImage" />
<meta property="og:image:secure_url" content="@ogImage" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="800" />
<meta property="og:site_name" content="SAT Jewel" />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content="@canonicalUrl" />
<meta name="twitter:title" content="@title" />
<meta name="twitter:description" content="@description" />
<meta name="twitter:image" content="@ogImage" />

<!-- Google Sitelinks Search Box & WebSite Schema -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "WebSite",
  "name": "SAT Jewel",
  "url": "@siteUrl",
  "description": "Bespoke handcrafted lab-grown diamond engagement rings and fine jewelry sanctuary.",
  "potentialAction": {
    "@@type": "SearchAction",
    "target": {
      "@@type": "EntryPoint",
      "urlTemplate": "@siteUrl/Product?search={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

