@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var rawName = User.Identity?.Name ?? "";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    // Clean display name calculation (prevents raw "@" symbol)
    string displayName = "Client";
    if (!string.IsNullOrWhiteSpace(rawName) && rawName.Trim() != "@")
    {
        displayName = rawName.Trim();
    }
    else if (!string.IsNullOrWhiteSpace(userEmail) && userEmail.Contains("@"))
    {
        displayName = userEmail.Split('@')[0];
    }

    var firstName = displayName.Split(' ').FirstOrDefault() ?? "Account";
}

<div class="auth-nav-cluster sat-icons-cluster" style="display: flex; align-items: center; gap: 12px;">
  
  <!-- 1. Search Outline Icon Button -->
  <button type="button" class="sat-header-icon-btn sat-search-trigger-btn" onclick="openSatGlobalSearch(event)" title="Search Fine Jewelry" aria-label="Search">
    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
  </button>

  <!-- 2. User / Sign In Outline Icon Button & Authenticated Cart Button -->
  @if (isAuthenticated)
  {
    <div class="account-menu" style="position: relative;">
      <button type="button" class="sat-header-icon-btn account-menu-trigger" aria-haspopup="true" aria-expanded="false" onclick="toggleAccountMenu(event)" title="Account: @displayName" aria-label="Account">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </button>
      <div class="account-menu-dropdown" role="menu">
        <div class="account-menu-head">
          <div class="account-menu-hello">Hello, @displayName</div>
          @if (!string.IsNullOrWhiteSpace(userEmail))
          {
            <div class="account-menu-email">@userEmail</div>
          }
        </div>
        <a href="/Product" class="account-menu-item" role="menuitem">
          <i class="fa-solid fa-gem"></i> Shop Products
        </a>
        <a href="/Account/MyAccount" class="account-menu-item" role="menuitem">
          <i class="fa-regular fa-user"></i> My Account
        </a>
        <a href="/Account/Wishlist" class="account-menu-item" role="menuitem">
          <i class="fa-regular fa-heart"></i> My Wishlist
        </a>
        <a href="/Account/Orders" class="account-menu-item" role="menuitem">
          <i class="fa-solid fa-box"></i> My Orders
        </a>
        <a href="/Product/Cart" class="account-menu-item" role="menuitem">
          <i class="fa-solid fa-cart-shopping"></i> Shopping Cart
        </a>
        <a href="/#cta" class="account-menu-item" role="menuitem">
          <i class="fa-solid fa-envelope"></i> Contact Us
        </a>
        @if (string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase))
        {
          <a href="/admin" class="account-menu-item" role="menuitem">
            <i class="fa-solid fa-gauge-high"></i> Admin Portal
          </a>
        }
        <div class="account-menu-divider"></div>
        <a href="/Account/Logout" class="account-menu-item account-menu-logout" role="menuitem">
          <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
      </div>
    </div>

    <!-- 3. Shopping Cart Outline Icon Button (Visible ONLY AFTER SIGN IN) -->
    <a href="/Product/Cart" class="sat-header-icon-btn sat-cart-btn-wrap" title="Shopping Cart" aria-label="Shopping Cart">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1.5"></circle>
        <circle cx="20" cy="21" r="1.5"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <span class="sat-cart-count-badge" id="navCartCount">0</span>
    </a>
  }
  else
  {
    <a href="/Account/SignIn?returnUrl=@Uri.EscapeDataString(returnUrl)" class="sat-header-icon-btn" id="navSignInBtn" title="Sign In" aria-label="Sign In">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    </a>
  }

</div>

<style>
  .sat-header-icon-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.9);
    padding: 7px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
  }

  .sat-header-icon-btn:hover {
    color: var(--champagne-gold, #d4b270);
    background: rgba(255, 255, 255, 0.1);
    transform: scale(1.08);
  }

  .sat-cart-btn-wrap {
    position: relative;
  }

  .sat-cart-count-badge {
    position: absolute;
    top: 0px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    border-radius: 10px;
    background: var(--champagne-gold, #d4b270);
    color: #060c14;
    font-size: 10px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
  }
</style>

<script>
  function toggleAccountMenu(e) {
    e.stopPropagation();
    const menu = e.currentTarget.closest('.account-menu');
    document.querySelectorAll('.account-menu.open').forEach(m => {
      if (m !== menu) m.classList.remove('open');
    });
    menu.classList.toggle('open');
    e.currentTarget.setAttribute('aria-expanded', menu.classList.contains('open') ? 'true' : 'false');
  }

  document.addEventListener('click', () => {
    document.querySelectorAll('.account-menu.open').forEach(m => m.classList.remove('open'));
  });

  // Prevent Back Button bfcache after Logout
  window.addEventListener('pageshow', function (event) {
    if (event.persisted || (performance && performance.navigation && performance.navigation.type === 2)) {
      window.location.reload();
    }
  });

  (function syncCartBadge() {
    try {
      const saved = localStorage.getItem('sat_shopping_cart_usd');
      const items = saved ? JSON.parse(saved) : [];
      const count = items.reduce((sum, i) => sum + (Number(i.quantity) || 1), 0);
      document.querySelectorAll('#navCartCount, .auth-nav-cart-count').forEach(el => {
        el.textContent = String(count);
      });
    } catch (_) { }
  })();
</script>
