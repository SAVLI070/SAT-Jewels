<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@(ViewData["Title"] ?? "SAT Jewel") | Fine Jewelry & AI Diamond Intelligence</title>
  
  <meta name="description" content="SAT Jewel — Luxury Fine Jewelry featuring GIA-certified diamonds, AI-driven market pricing, and bespoke 3D studio craftsmanship." />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Pinyon+Script&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Official Lottie Player Web Component SDK -->
  <script src="https://unpkg.com/@@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>

  <!-- Stylesheet -->
  <link rel="stylesheet" href="~/css/style.css" />
</head>

<body>
  <!-- Global SAT Bespoke Lottie Diamond Loading Overlay -->
  <div id="satLottieLoader" class="sat-lottie-overlay">
    <div class="sat-lottie-modal">
      <lottie-player 
        src="/assets/animations/loading_diamond.json" 
        background="transparent" 
        speed="1.2" 
        style="width: 140px; height: 140px;" 
        loop 
        autoplay>
      </lottie-player>
      <div class="sat-lottie-text">
        <span class="sat-gold-sparkle"><i class="fa-solid fa-gem"></i></span> Loading Bespoke Collection...
      </div>
    </div>
  </div>

  <!-- Global SAT Bespoke Payment Success Lottie Modal -->
  <div id="satPaymentSuccessModal" class="sat-lottie-overlay">
    <div class="sat-lottie-modal" style="max-width: 460px; text-align: center; padding: 36px 30px;">
      <lottie-player 
        id="paymentSuccessLottiePlayer"
        src="/assets/animations/payment_success.json" 
        background="transparent" 
        speed="1.0" 
        style="width: 170px; height: 170px; margin: 0 auto;" 
        autoplay>
      </lottie-player>
      
      <h2 style="font-family: var(--font-serif); font-size: 24px; color: #ffffff; margin: 10px 0 6px;">
        Payment Successful!
      </h2>
      <p id="successOrderIdDisplay" style="color: #fbbf24; font-size: 14px; font-weight: 700; margin: 0 0 14px;">
        Order Confirmed & Scheduled
      </p>
      <p style="color: rgba(255, 255, 255, 0.8); font-size: 13.5px; line-height: 1.6; margin-bottom: 24px;">
        Thank you for your purchase! Your bespoke GIA-certified fine jewelry piece has been scheduled for Home Delivery.
      </p>

      <a href="/Account/Orders" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 28px; border-radius: 30px; text-decoration: none; font-weight: 700; font-size: 14px; background: var(--champagne-gold); color: #060c14;">
        <i class="fa-solid fa-box-open"></i> View My Orders
      </a>
    </div>
  </div>

  @RenderBody()

  <script src="~/js/script.js"></script>
  @RenderSection("Scripts", required: false)
</body>

</html>
