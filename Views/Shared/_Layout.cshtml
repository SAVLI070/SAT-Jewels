<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  
  <partial name="_SeoHead" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Pinyon+Script&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Official Lottie Player Web Component SDK -->
  <script src="https://unpkg.com/@@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>

  <!-- Favicon / Tab Icons (Golden SJ Emblem) -->
  <link rel="icon" type="image/png" href="/assets/sat_emblem_clean.png" />
  <link rel="shortcut icon" type="image/png" href="/assets/sat_emblem_clean.png" />
  <link rel="apple-touch-icon" href="/assets/sat_emblem_clean.png" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="~/css/style.css" />
</head>

<body>
  <!-- Global SAT Bespoke Diamond Line Loading Animation (Pure Floating Diamond Lines) -->
  <div id="satLottieLoader" class="sat-lottie-overlay">
    <div class="sat-pure-diamond-loader">
      <svg viewBox="0 0 100 100" class="sat-diamond-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Outer Diamond Geometry -->
        <polygon points="50,12 88,38 50,88 12,38" class="diamond-line-outer" />
        <!-- Table & Crown Facets -->
        <polygon points="50,12 68,38 50,48 32,38" class="diamond-line-table" />
        <line x1="50" y1="12" x2="50" y2="48" class="diamond-line-inner" />
        <line x1="12" y1="38" x2="88" y2="38" class="diamond-line-inner" />
        <line x1="32" y1="38" x2="50" y2="88" class="diamond-line-inner" />
        <line x1="68" y1="38" x2="50" y2="88" class="diamond-line-inner" />
        <line x1="50" y1="48" x2="50" y2="88" class="diamond-line-inner" />
      </svg>
    </div>
  </div>

  <!-- Global SAT Bespoke Payment Success Lottie Modal -->
  <div id="satPaymentSuccessModal" class="sat-lottie-overlay">
    <div class="sat-lottie-modal" style="max-width: 460px; text-align: center; padding: 36px 30px;">
      <lottie-player 
        id="paymentSuccessLottiePlayer"
        src="/assets/animations/payment_success.json" 
        background="transparent" 
        speed="1.0" 
        style="width: 170px; height: 170px; margin: 0 auto;" 
        autoplay>
      </lottie-player>
      
      <h2 style="font-family: var(--font-serif); font-size: 24px; color: #ffffff; margin: 10px 0 6px;">
        Payment Successful!
      </h2>
      <p id="successOrderIdDisplay" style="color: #fbbf24; font-size: 14px; font-weight: 700; margin: 0 0 14px;">
        Order Confirmed & Scheduled
      </p>
      <p style="color: rgba(255, 255, 255, 0.8); font-size: 13.5px; line-height: 1.6; margin-bottom: 24px;">
        Thank you for your purchase! Your bespoke GIA-certified fine jewelry piece has been scheduled for Home Delivery.
      </p>

      <a href="/Account/Orders" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 28px; border-radius: 30px; text-decoration: none; font-weight: 700; font-size: 14px; background: var(--champagne-gold); color: #060c14;">
        <i class="fa-solid fa-box-open"></i> View My Orders
      </a>
    </div>
  </div>

  @RenderBody()

  <!-- Global SAT Jewel Mega Menu & Mobile Drawer -->
  <partial name="_MegaMenu" />

  <!-- Global Floating SAT Jewel WhatsApp Chat Widget (Matching Reference Screenshot) -->
  <div class="sat-floating-whatsapp-wrap" id="satWhatsappWidget">
    <div class="sat-wa-badge-popup">
      <span>We Are Here! 👋</span>
      <button type="button" class="sat-wa-close-btn" onclick="dismissWaWidget(event)">&times;</button>
    </div>
    <a href="https://wa.me/918320972779?text=Hello%20SAT%20Jewel%20Team!%20I%20am%20interested%20in%20your%20custom%20Lab-Grown%20Diamonds%20%26%20Moissanite%20Jewelry.%20Could%20you%20please%20assist%20me%3F" target="_blank" rel="noopener" class="sat-wa-float-btn" aria-label="Chat with SAT Jewel on WhatsApp">
      <i class="fa-brands fa-whatsapp"></i>
    </a>
  </div>

  <style>
    .sat-floating-whatsapp-wrap {
      position: fixed;
      bottom: 28px;
      right: 28px;
      z-index: 999999;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
    }

    .sat-wa-badge-popup {
      background: #0f172a;
      color: #ffffff;
      font-size: 0.85rem;
      font-weight: 700;
      padding: 7px 14px;
      border-radius: 20px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      animation: waBounce 2.5s infinite ease-in-out;
    }

    .sat-wa-close-btn {
      background: none;
      border: none;
      color: #9ca3af;
      font-size: 1.1rem;
      line-height: 1;
      cursor: pointer;
      padding: 0 2px;
    }

    .sat-wa-close-btn:hover {
      color: #ffffff;
    }

    .sat-wa-float-btn {
      width: 58px;
      height: 58px;
      background: #25D366;
      color: #ffffff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
      text-decoration: none;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .sat-wa-float-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 8px 28px rgba(37, 211, 102, 0.65);
      color: #ffffff;
    }

    @@keyframes waBounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }
  </style>

  <!-- Global SAT Jewel Live Search Modal / Overlay -->
  <partial name="_SearchModal" />

  <script>
    // Anti-bfcache & Back Button Security Buster: Prevent cached account views after logout/tab close
    window.addEventListener('pageshow', function (event) {
      if (event.persisted || (performance && performance.navigation && performance.navigation.type === 2)) {
        window.location.reload();
      }
    });
  </script>

  <script src="~/js/script.js"></script>
  @RenderSection("Scripts", required: false)
</body>

</html>
