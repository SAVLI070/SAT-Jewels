<!-- Sign In Required Modal (for unauthenticated Cart / Wishlist attempts) -->
<div id="satAuthRequiredModal" class="sat-auth-modal-backdrop" onclick="closeAuthRequiredModal(event)">
  <div class="sat-auth-modal-card" onclick="event.stopPropagation()">
    <button type="button" class="sat-auth-modal-close" onclick="closeAuthRequiredModal(event)" aria-label="Close modal">&times;</button>
    <div class="sat-auth-modal-icon">
      <i class="fa-solid fa-gem"></i>
    </div>
    <h3 class="sat-auth-modal-title" id="authModalActionTitle">Sign In Required</h3>
    <p class="sat-auth-modal-desc" id="authModalActionDesc">
      Please sign in to your SAT Jewel account to continue.
    </p>
    <div class="sat-auth-modal-actions">
      <a id="authModalSignInBtn" href="/Account/SignIn" class="sat-auth-modal-btn-signin">
        <i class="fa-solid fa-arrow-right-to-bracket"></i>
        <span>Sign In to Continue</span>
      </a>
      <button type="button" class="sat-auth-modal-btn-cancel" onclick="closeAuthRequiredModal(event)">
        <span>Continue Browsing</span>
      </button>
    </div>
  </div>
</div>

<style>
  .sat-auth-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(5, 7, 12, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 99999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sat-auth-modal-backdrop.open {
    opacity: 1;
    visibility: visible;
  }
  .sat-auth-modal-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: linear-gradient(180deg, #161b26 0%, #0d1117 100%);
    border: 1px solid rgba(212, 184, 120, 0.45);
    border-radius: 20px;
    padding: 32px 28px;
    text-align: center;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9), 0 0 30px rgba(212, 184, 120, 0.15);
    transform: translateY(15px) scale(0.96);
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sat-auth-modal-backdrop.open .sat-auth-modal-card {
    transform: translateY(0) scale(1);
  }
  .sat-auth-modal-close {
    position: absolute;
    top: 14px;
    right: 18px;
    background: none;
    border: none;
    font-size: 26px;
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s ease;
  }
  .sat-auth-modal-close:hover {
    color: #ffffff;
  }
  .sat-auth-modal-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 184, 120, 0.2) 0%, rgba(212, 184, 120, 0.04) 70%);
    border: 1px solid rgba(212, 184, 120, 0.5);
    color: #d4b878;
    font-size: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px auto;
  }
  .sat-auth-modal-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 10px 0;
  }
  .sat-auth-modal-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
    margin: 0 0 24px 0;
  }
  .sat-auth-modal-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sat-auth-modal-btn-signin {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 13px 20px;
    background: linear-gradient(135deg, #d4b878 0%, #b8944d 100%);
    color: #06070a !important;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 13.5px;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .sat-auth-modal-btn-signin:hover {
    background: linear-gradient(135deg, #f1dfae 0%, #d4b878 100%);
    box-shadow: 0 4px 20px rgba(212, 184, 120, 0.4);
    transform: translateY(-1px);
    color: #000000 !important;
  }
  .sat-auth-modal-btn-cancel {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.7);
    padding: 11px 20px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .sat-auth-modal-btn-cancel:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }
</style>

<script>
  function showAuthRequiredModal(action) {
    const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
    const signInLink = document.getElementById('authModalSignInBtn');
    if (signInLink) {
      signInLink.href = '/Account/SignIn?returnUrl=' + returnUrl;
    }

    const titleEl = document.getElementById('authModalActionTitle');
    const descEl = document.getElementById('authModalActionDesc');

    if (action === 'cart') {
      if (titleEl) titleEl.innerText = 'Sign In to Add to Bag';
      if (descEl) descEl.innerText = 'Please sign in to your SAT Jewel account to add this fine jewelry piece to your shopping bag and begin your bespoke order.';
    } else {
      if (titleEl) titleEl.innerText = 'Sign In for Wishlist';
      if (descEl) descEl.innerText = 'Please sign in to your SAT Jewel account to save this fine jewelry piece to your private Wishlist Sanctuary.';
    }

    const modal = document.getElementById('satAuthRequiredModal');
    if (modal) {
      modal.classList.add('open');
    }
  }

  function closeAuthRequiredModal(e) {
    if (e && e.preventDefault) e.preventDefault();
    const modal = document.getElementById('satAuthRequiredModal');
    if (modal) {
      modal.classList.remove('open');
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAuthRequiredModal();
    }
  });
</script>
