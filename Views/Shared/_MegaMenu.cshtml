    width: 24px;
    height: 24px;
    object-fit: contain;
  }
</style>

<script>
  function openSatMobileDrawer() {
    const drawer = document.getElementById('satMobileDrawer');
    const backdrop = document.getElementById('satMobileDrawerBackdrop');
    if (drawer && backdrop) {
      drawer.classList.add('active');
      backdrop.classList.add('active');
    }
  }

  function closeSatMobileDrawer() {
    const drawer = document.getElementById('satMobileDrawer');
    const backdrop = document.getElementById('satMobileDrawerBackdrop');
    if (drawer && backdrop) {
      drawer.classList.remove('active');
      backdrop.classList.remove('active');
    }
  }

  function openSatMobSubMenu(title) {
    const mainScreen = document.getElementById('satMobMainScreen');
    const subScreen = document.getElementById('satMobSubScreen');
    const subTitle = document.getElementById('satMobSubTitle');

    if (subTitle) subTitle.innerText = title;
    if (mainScreen && subScreen) {
      mainScreen.classList.remove('active');
      subScreen.classList.add('active');
    }
  }

  function backSatMobMainScreen() {
    const mainScreen = document.getElementById('satMobMainScreen');
    const subScreen = document.getElementById('satMobSubScreen');

    if (mainScreen && subScreen) {
      subScreen.classList.remove('active');
      mainScreen.classList.add('active');
    }
  }
</script>
