  /* Screens */
  .sat-mob-screen {
    display: none;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
  }
  .sat-mob-screen.active {
    display: flex;
  }

  /* Level 1 List */
  .sat-mob-menu-list {
    display: flex;
    flex-direction: column;
  }
  .sat-mob-menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    text-align: left;
    transition: background 0.2s;
  }
  .sat-mob-menu-item:hover {
    background: rgba(212, 178, 112, 0.1);
    color: var(--champagne-gold, #d4b270);
  }
  .sat-mob-menu-item i {
    font-size: 12px;
    color: var(--champagne-gold, #d4b270);
  }

  /* Utility List */
  .sat-mob-utility-list {
    margin-top: auto;
    padding: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: #050b13;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sat-mob-util-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }
  .whatsapp-icon {
    color: #25d366;
    font-size: 18px;
  }

  /* STRICT VIEWPORT BREAKPOINTS */
  @@media (min-width: 993px) {
    .sat-mobile-drawer,
    .sat-mobile-drawer-backdrop {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  }

  @@media (max-width: 992px) {
    .sat-mega-dropdown {
      display: none !important;
    }
  }
</style>

<script>
  function openSatMobileDrawer() {
    const drawer = document.getElementById('satMobileDrawer');
    const backdrop = document.getElementById('satMobileDrawerBackdrop');
    if (drawer && backdrop) {
      drawer.style.display = 'flex';
      drawer.classList.add('active');
      backdrop.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeSatMobileDrawer() {
    const drawer = document.getElementById('satMobileDrawer');
    const backdrop = document.getElementById('satMobileDrawerBackdrop');
    if (drawer && backdrop) {
      drawer.classList.remove('active');
      backdrop.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  function toggleSatMegaDropdown() {
    const dropdown = document.getElementById('satMegaDropdown');
    if (dropdown) {
      dropdown.classList.toggle('show');
    }
  }

  document.addEventListener('click', (e) => {
    const dropdown = document.getElementById('satMegaDropdown');
    const wrap = e.target.closest('.sat-nav-dropdown-wrap');
    if (!wrap && dropdown && !dropdown.contains(e.target)) {
      dropdown.classList.remove('show');
    }
  });

  // Close drawer on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > 992) {
      closeSatMobileDrawer();
    }
  });
</script>
