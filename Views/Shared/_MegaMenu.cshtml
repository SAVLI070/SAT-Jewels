@inject SAT1.BAL.CatalogBal CatalogBal
@{
    var publicCategories = await CatalogBal.GetPublicCategoriesAsync();
}
<!-- SAT JEWEL LUXURY MEGA MENU & MOBILE OFF-CANVAS DRAWER -->

<!-- 1. DESKTOP MEGA MENU DROPDOWN (CENTERED POPUP WITH DYNAMIC ACTIVE CATEGORIES) -->
<div class="sat-mega-dropdown" id="satMegaDropdown">
  <div class="sat-mega-container">
    
    <!-- Main Mega Content Grid -->
    <div class="sat-mega-grid">

      <!-- MAIN CATEGORIES LIST COLUMN -->
      <div class="sat-mega-column">
        <h3 class="sat-mega-col-heading">
          <i class="fa-solid fa-gem" style="color: var(--champagne-gold);"></i>
          <span>EXPLORE OUR COLLECTIONS</span>
        </h3>

        <div class="sat-main-cats-grid" id="satMegaDesktopCatsGrid">
          @if (publicCategories != null && publicCategories.Count > 0)
          {
            @foreach (var cat in publicCategories)
            {
              <a href="/Product/Category?id=@cat.Id" class="sat-mega-cat-card">
                <img src="@cat.ImageUrl" alt="@cat.Name" class="sat-mega-cat-img" />
                <div class="sat-mega-cat-info">
                  <span class="sat-cat-name">@cat.Name</span>
                  <span class="sat-cat-sub">@(string.IsNullOrWhiteSpace(cat.Subtitle) ? "Fine Crafted Jewelry" : cat.Subtitle)</span>
                </div>
                <i class="fa-solid fa-chevron-right sat-cat-arrow"></i>
              </a>
            }
          }
        </div>
      </div>

      <!-- FEATURED EDITORIAL CARD -->
      <div class="sat-mega-column sat-mega-featured-col">
        <div class="sat-mega-card">
          <img src="/assets/hero_1.jpg" alt="Award-winning SAT Jewel diamond ring" class="sat-card-img" />
          <div class="sat-card-overlay">
            <h4 class="sat-card-title">Award-winning designs, meticulously crafted.</h4>
            <a href="/Product/Category?id=1" class="sat-card-btn">Explore Collections &gt;</a>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>


<!-- 2. MOBILE OFF-CANVAS NAVIGATION DRAWER -->
<div class="sat-mobile-drawer-backdrop" id="satMobileDrawerBackdrop" onclick="closeSatMobileDrawer()"></div>

<div class="sat-mobile-drawer" id="satMobileDrawer">
  
  <!-- Mobile Header Control Bar -->
  <div class="sat-mob-header">
    <button type="button" class="sat-mob-close-btn" onclick="closeSatMobileDrawer()" aria-label="Close menu">
      <i class="fa-solid fa-xmark"></i>
    </button>
    
    <div class="sat-mob-logo-center" style="display:flex; align-items:center; gap:6px;">
      <img src="/assets/sat_emblem_clean.png" alt="SAT Jewel Logo" style="height:28px; width:auto;" />
      <span style="font-family:var(--font-serif); font-size:15px; font-weight:700; color:#ffffff;">SAT <span class="sat-brand-script" style="color:var(--champagne-gold);">Jewel</span></span>
    </div>

    <a href="/Product/Cart" class="sat-mob-cart-btn" aria-label="View Cart">
      <i class="fa-solid fa-bag-shopping"></i>
    </a>
  </div>

  <!-- SCREEN 1: MAIN NAVIGATION BAR OPTIONS -->
  <div class="sat-mob-screen active" id="satMobMainScreen">
    <div class="sat-mob-menu-list">
      <a href="/" class="sat-mob-menu-item" onclick="closeSatMobileDrawer()">
        <span><i class="fa-solid fa-house" style="margin-right:10px; opacity:0.85;"></i> Home</span>
      </a>

      <!-- DRILLDOWN BUTTON TO COLLECTIONS (SCREEN 2) -->
      <button type="button" class="sat-mob-menu-item trigger-sub" onclick="openSatMobSubMenu('Collections')">
        <span><i class="fa-solid fa-gem" style="margin-right:10px; color:var(--champagne-gold, #d4b270);"></i> Collections</span>
        <i class="fa-solid fa-chevron-right"></i>
      </button>

      <a href="/Home/CustomRings" class="sat-mob-menu-item" onclick="closeSatMobileDrawer()">
        <span><i class="fa-solid fa-hammer" style="margin-right:10px; opacity:0.85;"></i> Custom Rings Process</span>
      </a>

      <a href="/Home/Index#ai-features" class="sat-mob-menu-item" onclick="closeSatMobileDrawer()">
        <span><i class="fa-solid fa-chart-line" style="margin-right:10px; opacity:0.85;"></i> AI Valuer</span>
      </a>

      <a href="/Home/Index#why" class="sat-mob-menu-item" onclick="closeSatMobileDrawer()">
        <span><i class="fa-solid fa-shield-halved" style="margin-right:10px; opacity:0.85;"></i> Why SAT Jewel</span>
      </a>

      <a href="/Home/Index#cta" class="sat-mob-menu-item" onclick="closeSatMobileDrawer()">
        <span><i class="fa-solid fa-envelope" style="margin-right:10px; opacity:0.85;"></i> Contact Us</span>
      </a>
    </div>

    <!-- Extra Mobile Utility Links -->
    <div class="sat-mob-utility-list">
      <a href="/Home/Index#cta" class="sat-mob-util-item" onclick="closeSatMobileDrawer()">
        <i class="fa-solid fa-calendar-check"></i>
        <span>Virtual Appointment</span>
      </a>

      <a href="/Account/SignIn" class="sat-mob-util-item">
        <i class="fa-regular fa-user"></i>
        <span>Log in</span>
      </a>

      <div class="sat-mob-util-item">
        <i class="fa-solid fa-globe"></i>
        <span>USD $</span>
      </div>
    </div>
  </div>

  <!-- SCREEN 2: COLLECTIONS DRILLDOWN (ACTIVE DYNAMIC CATEGORIES) -->
  <div class="sat-mob-screen" id="satMobSubScreen">
    <button type="button" class="sat-mob-back-btn" onclick="backSatMobMainScreen()">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Main Menu</span>
    </button>

    <div class="sat-mob-menu-list" id="satMegaMobileCatsList">
      @if (publicCategories != null && publicCategories.Count > 0)
      {
        @foreach (var cat in publicCategories)
        {
          <a href="/Product/Category?id=@cat.Id" class="sat-mob-menu-item" onclick="closeSatMobileDrawer()">
            <span>@cat.Name</span>
            <i class="fa-solid fa-chevron-right"></i>
          </a>
        }
      }
    </div>

    <!-- Extra Mobile Utility Links -->
    <div class="sat-mob-utility-list">
      <a href="/Order/Track" class="sat-mob-util-item" onclick="closeSatMobileDrawer()">
        <i class="fa-solid fa-truck-fast"></i>
        <span>Track Order Live</span>
      </a>
      <a href="/Home/Index#cta" class="sat-mob-util-item" onclick="closeSatMobileDrawer()">
        <i class="fa-solid fa-calendar-check"></i>
        <span>Virtual Appointment</span>
      </a>
    </div>
  </div>

</div>


<style>
  .sat-nav-dropdown-wrap {
    position: relative;
    display: inline-block;
  }

  .sat-mega-dropdown {
    position: fixed;
    top: 72px;
    left: 50%;
    transform: translateX(-50%);
    width: min(940px, calc(100vw - 32px));
    box-sizing: border-box;
    overflow: hidden;
    background: rgba(12, 11, 15, 0.97);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(212, 184, 120, 0.45);
    border-radius: 20px;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.95), 0 0 40px rgba(212, 184, 120, 0.15);
    padding: 24px 26px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
    z-index: 999999;
  }

  .sat-mega-container {
    width: 100%;
    box-sizing: border-box;
  }

  /* Invisible hover bridge to prevent premature mouseleave across navbar gap */
  .sat-mega-dropdown::before {
    content: '';
    position: absolute;
    top: -35px;
    left: 0;
    right: 0;
    height: 35px;
    background: transparent;
  }

  .sat-mega-dropdown.show,
  .sat-mega-dropdown:hover {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateX(-50%) translateY(0) !important;
  }

  /* Mega Grid */
  .sat-mega-grid {
    display: grid;
    grid-template-columns: 1fr 270px;
    gap: 22px;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
  }

  .sat-mega-column {
    box-sizing: border-box;
    min-width: 0;
  }

  .sat-mega-featured-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 270px;
    box-sizing: border-box;
  }

  .sat-mega-col-heading {
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--champagne-gold, #d4b270);
    letter-spacing: 0.12em;
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* 6 Main Categories Cards Grid */
  .sat-main-cats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    box-sizing: border-box;
  }

  /* New Luxury Gold Hover Color Combination */
  .sat-mega-cat-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    min-width: 0;
    position: relative;
    overflow: hidden;
  }

  .sat-mega-cat-card:hover {
    background: linear-gradient(135deg, rgba(212, 184, 120, 0.16) 0%, rgba(180, 83, 9, 0.08) 100%);
    border-color: rgba(212, 184, 120, 0.55);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35), 0 0 16px rgba(212, 184, 120, 0.15);
    transform: translateX(4px);
  }

  .sat-mega-cat-img {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid rgba(212, 184, 120, 0.3);
    flex-shrink: 0;
    transition: all 0.25s ease;
  }

  .sat-mega-cat-card:hover .sat-mega-cat-img {
    border-color: var(--champagne-gold, #d4b270);
    transform: scale(1.05);
    box-shadow: 0 0 10px rgba(212, 184, 120, 0.35);
  }

  .sat-mega-cat-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    overflow: hidden;
    min-width: 0;
  }

  .sat-cat-name {
    font-size: 13.5px;
    font-weight: 700;
    color: #f1eee8;
    letter-spacing: 0.2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .sat-mega-cat-card:hover .sat-cat-name {
    color: #d4b270;
    text-shadow: 0 0 12px rgba(212, 184, 120, 0.45);
  }

  .sat-cat-sub {
    font-size: 11px;
    color: rgba(241, 238, 232, 0.55);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s ease;
  }

  .sat-mega-cat-card:hover .sat-cat-sub {
    color: rgba(241, 238, 232, 0.85);
  }

  .sat-cat-arrow {
    font-size: 11px;
    color: rgba(212, 184, 120, 0.5);
    transition: transform 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    flex-shrink: 0;
  }

  .sat-mega-cat-card:hover .sat-cat-arrow {
    color: #d4b270;
    opacity: 1;
    transform: translateX(4px);
  }

  /* Featured Card Constrained to Column */
  .sat-mega-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 230px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(212, 184, 120, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    box-sizing: border-box;
  }

  .sat-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
    display: block;
  }

  .sat-mega-card:hover .sat-card-img {
    transform: scale(1.05);
  }

  .sat-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(6, 14, 25, 0.92) 100%);
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    box-sizing: border-box;
  }

  .sat-card-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 16.5px;
    font-style: italic;
    color: #ffffff;
    margin: 0 0 12px;
    line-height: 1.35;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }

  .sat-card-btn {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0b0a0d;
    background: linear-gradient(135deg, #d4b878 0%, #b45309 100%);
    padding: 8px 16px;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 15px rgba(212, 184, 120, 0.3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .sat-card-btn:hover {
    background: #ffffff;
    color: #0b0a0d;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.4);
  }

  /* MOBILE OFF-CANVAS DRAWER STYLES */
  .sat-mobile-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    z-index: 999998;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  .sat-mobile-drawer-backdrop.active {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .sat-mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 88vw;
    max-width: 360px;
    height: 100vh;
    background: #08111e;
    color: #ffffff;
    z-index: 999999;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 10px 0 40px rgba(0,0,0,0.8);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-right: 1px solid rgba(212, 178, 112, 0.3);
  }
  .sat-mobile-drawer.active {
    transform: translateX(0) !important;
  }

  /* Mobile Header */
  .sat-mob-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(212, 178, 112, 0.2);
    background: #060c15;
  }
  .sat-mob-close-btn, .sat-mob-cart-btn {
    background: transparent;
    border: none;
    font-size: 20px;
    color: #ffffff;
    cursor: pointer;
    text-decoration: none;
  }

  /* Screens */
  .sat-mob-screen {
    display: none;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
  }
  .sat-mob-screen.active {
    display: flex;
  }

  /* Level 1 List */
  .sat-mob-menu-list {
    display: flex;
    flex-direction: column;
  }
  .sat-mob-menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    text-align: left;
    transition: background 0.2s;
  }
  .sat-mob-menu-item:hover {
    background: rgba(212, 178, 112, 0.1);
    color: var(--champagne-gold, #d4b270);
  }
  .sat-mob-menu-item i {
    font-size: 12px;
    color: var(--champagne-gold, #d4b270);
  }

  /* Utility List */
  .sat-mob-utility-list {
    margin-top: auto;
    padding: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: #050b13;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sat-mob-util-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }
  .whatsapp-icon {
    color: #25d366;
    font-size: 18px;
  }

  .sat-mob-back-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--champagne-gold, #d4b270);
    background: rgba(212, 178, 112, 0.1);
    border: none;
    border-bottom: 1px solid rgba(212, 178, 112, 0.2);
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: background 0.2s;
  }
  .sat-mob-back-btn:hover {
    background: rgba(212, 178, 112, 0.2);
  }

  /* STRICT VIEWPORT BREAKPOINTS */
  @@media (min-width: 993px) {
    .sat-mobile-drawer,
    .sat-mobile-drawer-backdrop {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  }

  @@media (max-width: 992px) {
    .sat-mega-dropdown {
      display: none !important;
    }
  }
</style>

<script>
  function openSatMobileDrawer() {
    const drawer = document.getElementById('satMobileDrawer');
    const backdrop = document.getElementById('satMobileDrawerBackdrop');
    if (drawer && backdrop) {
      backSatMobMainScreen(); // Ensure Screen 1 opens first!
      drawer.style.display = 'flex';
      drawer.classList.add('active');
      backdrop.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeSatMobileDrawer() {
    const drawer = document.getElementById('satMobileDrawer');
    const backdrop = document.getElementById('satMobileDrawerBackdrop');
    if (drawer && backdrop) {
      drawer.classList.remove('active');
      backdrop.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  function openSatMobSubMenu(title) {
    const mainScreen = document.getElementById('satMobMainScreen');
    const subScreen = document.getElementById('satMobSubScreen');
    if (mainScreen && subScreen) {
      mainScreen.classList.remove('active');
      subScreen.classList.add('active');
    }
  }

  function backSatMobMainScreen() {
    const mainScreen = document.getElementById('satMobMainScreen');
    const subScreen = document.getElementById('satMobSubScreen');
    if (mainScreen && subScreen) {
      subScreen.classList.remove('active');
      mainScreen.classList.add('active');
    }
  }

  let satMegaCloseTimer = null;
  let satMegaPinned = false;

  function openSatMegaDropdown() {
    if (window.innerWidth <= 992) return;
    clearTimeout(satMegaCloseTimer);
    const dropdown = document.getElementById('satMegaDropdown');
    if (dropdown) dropdown.classList.add('show');
  }

  function closeSatMegaDropdown(force = false) {
    if (satMegaPinned && !force) return;
    clearTimeout(satMegaCloseTimer);
    satMegaCloseTimer = setTimeout(() => {
      if (satMegaPinned && !force) return;
      const dropdown = document.getElementById('satMegaDropdown');
      if (dropdown) dropdown.classList.remove('show');
    }, 280);
  }

  function toggleSatMegaDropdown(e) {
    if (e) e.preventDefault();
    if (window.innerWidth <= 992) {
      openSatMobileDrawer();
    } else {
      const dropdown = document.getElementById('satMegaDropdown');
      if (dropdown) {
        if (dropdown.classList.contains('show')) {
          satMegaPinned = false;
          dropdown.classList.remove('show');
        } else {
          satMegaPinned = true;
          dropdown.classList.add('show');
        }
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const dropdown = document.getElementById('satMegaDropdown');
    if (dropdown) {
      dropdown.addEventListener('mouseenter', () => {
        clearTimeout(satMegaCloseTimer);
      });
      dropdown.addEventListener('mouseleave', () => {
        closeSatMegaDropdown();
      });
    }
  });

  document.addEventListener('click', (e) => {
    const dropdown = document.getElementById('satMegaDropdown');
    const wrap = e.target.closest('.sat-has-mega, .sat-nav-dropdown-wrap, #navCollectionsLink');
    if (!wrap && dropdown && !dropdown.contains(e.target)) {
      satMegaPinned = false;
      dropdown.classList.remove('show');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      satMegaPinned = false;
      const dropdown = document.getElementById('satMegaDropdown');
      if (dropdown) dropdown.classList.remove('show');
    }
  });

  // Close drawer on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > 992) {
      closeSatMobileDrawer();
    }
  });
</script>
