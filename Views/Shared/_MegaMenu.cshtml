    padding: 24px 30px 28px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 9999;
  }

  .sat-nav-dropdown-wrap:hover .sat-mega-dropdown,
  .sat-nav-dropdown-wrap.active .sat-mega-dropdown,
  .sat-mega-dropdown.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Subnav Bar */
