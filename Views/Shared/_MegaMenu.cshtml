    border-radius: 14px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
    padding: 26px 30px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 99999;
  }

  .sat-nav-dropdown-wrap:hover .sat-mega-dropdown,
  .sat-nav-dropdown-wrap.active .sat-mega-dropdown,
  .sat-mega-dropdown.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
