@{
    Layout = null;
    var title = (ViewData["Title"] ?? "Admin Dashboard").ToString();
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>@title — SAT Jewel Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <link rel="stylesheet" href="~/css/admin_layout.css" />
  <link rel="stylesheet" href="~/css/style.css" />

  <!-- Blocking Script to prevent sidebar reload flash -->
  <script>
    (function() {
      try {
        if (localStorage.getItem('sat_admin_sidebar_collapsed') === 'true') {
          document.documentElement.classList.add('sidebar-is-collapsed');
        }
      } catch (e) {}
    })();
  </script>

  <style>
    /* Full Glassmorphic Transparency Theme matching Navbar (Image 2) */
    html, body {
      background: #050b14 !important;
      background-image: radial-gradient(circle at 50% 20%, #0d1b2a 0%, #050b14 100%) !important;
      background-attachment: fixed !important;
      color: #f8fafc !important;
      font-family: var(--font-sans);
      margin: 0;
      padding: 0;
      min-height: 100vh;
    }

    #farmbridgeAdminPortal {
      background: transparent !important;
      min-height: 100vh;
    }

    /* Fully Transparent Glassmorphic Sidebar */
    .adm-sidebar {
      background: rgba(10, 20, 36, 0.45) !important;
      backdrop-filter: blur(25px) !important;
      -webkit-backdrop-filter: blur(25px) !important;
      border-right: 1px solid rgba(212, 178, 112, 0.25) !important;
      transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), padding 0.3s ease !important;
      box-shadow: 10px 0 35px rgba(0, 0, 0, 0.5) !important;
    }

    /* Fully Transparent Glassmorphic Topbar */
    .adm-topbar {
      background: rgba(10, 20, 36, 0.45) !important;
      backdrop-filter: blur(25px) !important;
      -webkit-backdrop-filter: blur(25px) !important;
      border-bottom: 1px solid rgba(212, 178, 112, 0.25) !important;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
    }

    .adm-main {
      background: transparent !important;
    }

    .adm-content {
      background: transparent !important;
    }

    .adm-page-title {
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 700;
      color: #ffffff !important;
    }

    .adm-sidebar-name {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 700;
      color: #ffffff !important;
    }

    .adm-sidebar-name span {
      color: #fbbf24 !important;
    }

    .adm-role-badge {
      background: rgba(212, 178, 112, 0.18) !important;
      border: 1px solid #d4b270 !important;
      color: #fbbf24 !important;
      font-weight: 700;
    }

    .adm-nav-link {
      color: #cbd5e1 !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      transition: all 0.25s ease !important;
      border-radius: 12px !important;
      padding: 12px 16px !important;
      position: relative !important;
    }

    .adm-nav-link:hover {
      background: rgba(255, 255, 255, 0.08) !important;
      color: #ffffff !important;
    }

    .adm-nav-link.active {
      background: linear-gradient(135deg, rgba(212, 178, 112, 0.22) 0%, rgba(180, 83, 9, 0.22) 100%) !important;
      border: 1px solid #d4b270 !important;
      color: #fbbf24 !important;
      box-shadow: 0 4px 18px rgba(212, 178, 112, 0.25) !important;
      font-weight: 700 !important;
    }

    .adm-nav-link.active i {
      color: #fbbf24 !important;
    }

    .adm-avatar {
      background: rgba(212, 178, 112, 0.2) !important;
      border: 1px solid #d4b270 !important;
      color: #fbbf24 !important;
      font-weight: 700;
    }

    /* Collapsed Sidebar Styles */
    html.sidebar-is-collapsed .adm-sidebar,
    .adm-sidebar.collapsed {
      width: 72px !important;
      padding: 24px 10px !important;
    }

    html.sidebar-is-collapsed .adm-sidebar .adm-sidebar-name,
    html.sidebar-is-collapsed .adm-sidebar .adm-role-badge,
    html.sidebar-is-collapsed .adm-sidebar .adm-nav-link span,
    html.sidebar-is-collapsed .adm-sidebar .adm-sidebar-foot span,
    .adm-sidebar.collapsed .adm-sidebar-name,
    .adm-sidebar.collapsed .adm-role-badge,
    .adm-sidebar.collapsed .adm-nav-link span,
    .adm-sidebar.collapsed .adm-sidebar-foot span {
      display: none !important;
    }

    html.sidebar-is-collapsed .adm-sidebar .adm-nav-link,
    .adm-sidebar.collapsed .adm-nav-link {
      justify-content: center;
      padding: 12px;
    }

    html.sidebar-is-collapsed .adm-sidebar .adm-sidebar-logo,
    .adm-sidebar.collapsed .adm-sidebar-logo {
      justify-content: center;
    }

    /* Floating Tooltip ONLY when Sidebar is Collapsed */
    @@keyframes fadeInTooltip {
      from { opacity: 0; transform: translateY(-50%) translateX(-6px); }
      to { opacity: 1; transform: translateY(-50%) translateX(0); }
    }

    html.sidebar-is-collapsed .adm-sidebar .adm-nav-link:hover::after,
    .adm-sidebar.collapsed .adm-nav-link:hover::after {
      content: attr(data-tooltip);
      position: absolute;
      left: calc(100% + 14px);
      top: 50%;
      transform: translateY(-50%);
      background: rgba(8, 16, 32, 0.95);
      border: 1px solid #d4b270;
      border-radius: 8px;
      color: #fbbf24;
      padding: 6px 14px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
      box-shadow: 0 6px 22px rgba(0, 0, 0, 0.7), 0 0 14px rgba(212, 178, 112, 0.35);
      pointer-events: none;
      z-index: 999999;
      animation: fadeInTooltip 0.2s ease-out forwards;
    }

    html.sidebar-is-collapsed .adm-sidebar .adm-nav-link:hover::before,
    .adm-sidebar.collapsed .adm-nav-link:hover::before {
      content: "";
      position: absolute;
      left: calc(100% + 6px);
      top: 50%;
      transform: translateY(-50%);
      border-width: 5px;
      border-style: solid;
      border-color: transparent #d4b270 transparent transparent;
      pointer-events: none;
      z-index: 999999;
      animation: fadeInTooltip 0.2s ease-out forwards;
    }

    .adm-collapse-btn {
      background: rgba(212, 178, 112, 0.15);
      border: 1px solid rgba(212, 178, 112, 0.4);
      color: #fbbf24;
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.2s ease;
      margin-right: 14px;
    }

    .adm-collapse-btn:hover {
      background: #fbbf24;
      color: #060d0a;
      box-shadow: 0 0 14px rgba(251, 191, 36, 0.5);
    }
  </style>
</head>

<body>

  <!-- Mobile Backdrop Overlay -->
  <div class="adm-backdrop" id="admBackdrop" onclick="toggleAdmDrawer(event)"></div>

  <div id="farmbridgeAdminPortal" class="show" style="position:relative; opacity:1; visibility:visible;">
    <!-- Left Sidebar (`adm-sidebar`) -->
    <aside class="adm-sidebar" id="admSidebar">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom: 14px;">
        <a href="/Admin/Dashboard" class="adm-sidebar-logo" style="margin-bottom:0;text-decoration:none;">
          <div class="sat-logo-emblem" style="width:38px;height:38px;background:#0f172a;border-color:#b45309;">
            <img src="~/assets/sat_emblem_clean.png" class="official-sat-logo-img" alt="SAT Logo Emblem" />
          </div>
          <span class="adm-sidebar-name">SAT <span>Jewel</span></span>
        </a>
        <button class="adm-sidebar-close-btn" onclick="toggleAdmDrawer(event)" title="Close Menu">&times;</button>
      </div>

      <div class="adm-role-badge">Admin</div>

      <ul class="adm-nav">
        <li>
          <a href="/Admin/Dashboard" data-tooltip="Overview" class="adm-nav-link @(Context.Request.Path.Value?.ToLower().Contains("dashboard") == true || Context.Request.Path.Value?.ToLower() == "/admin" ? "active" : "")" onclick="closeAdmOnMobile()">
            <i class="fa-solid fa-chart-pie"></i> <span>Overview</span>
          </a>
        </li>
        <li>
          <a href="/Admin/Categories" data-tooltip="Manage Categories" class="adm-nav-link @(Context.Request.Path.Value?.ToLower().Contains("categories") == true ? "active" : "")" onclick="closeAdmOnMobile()">
            <i class="fa-solid fa-layer-group"></i> <span>Manage Categories</span>
          </a>
        </li>
        <li>
          <a href="/Admin/Catalog" data-tooltip="Jewelry Catalog" class="adm-nav-link @(Context.Request.Path.Value?.ToLower().Contains("catalog") == true ? "active" : "")" onclick="closeAdmOnMobile()">
            <i class="fa-solid fa-gem"></i> <span>Jewelry Catalog</span>
          </a>
        </li>
      </ul>

      <div class="adm-sidebar-foot">
        <a href="/" data-tooltip="Exit to Storefront" class="adm-nav-link adm-logout" style="color:#fca5a5 !important;">
          <i class="fa-solid fa-right-from-bracket"></i> <span>Exit to Storefront</span>
        </a>
      </div>
    </aside>

    <!-- Main Content Area (`adm-main`) -->
    <div class="adm-main">
      <header class="adm-topbar">
        <div class="adm-topbar-left" style="display:flex;align-items:center;">
          <!-- Sidebar Collapse/Expand Toggle Button -->
          <button class="adm-collapse-btn" id="sidebarCollapseToggleBtn" onclick="toggleSidebarCollapse()" title="Collapse / Expand Sidebar">
            <i class="fa-solid fa-bars-staggered" id="sidebarCollapseIcon"></i>
          </button>
          <button class="adm-menu-btn" onclick="toggleAdmDrawer(event)" aria-label="Toggle Menu">
            <i class="fa-solid fa-bars"></i>
          </button>
          <h1 class="adm-page-title" style="margin:0;">@title</h1>
        </div>
        <div class="adm-topbar-right" style="display:flex;align-items:center;gap:12px;">
          <span style="font-size:12px;color:#fbbf24;font-weight:600;"><i class="fa-solid fa-user-shield"></i> VIP Admin</span>
          <a href="/Account/Logout" style="font-size:12px;color:#cbd5e1;text-decoration:none;font-weight:600;"><i class="fa-solid fa-sign-out"></i> Logout</a>
          <div class="adm-avatar">A</div>
        </div>
      </header>

      <main class="adm-content" style="padding:32px 24px;">
        @RenderBody()
      </main>
    </div>
  </div>

  <script src="~/js/script.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sidebar = document.getElementById('admSidebar');
      const isCollapsed = localStorage.getItem('sat_admin_sidebar_collapsed') === 'true';
      if (sidebar) {
        if (isCollapsed) {
          sidebar.classList.add('collapsed');
          document.documentElement.classList.add('sidebar-is-collapsed');
        } else {
          sidebar.classList.remove('collapsed');
          document.documentElement.classList.remove('sidebar-is-collapsed');
        }
      }
      const icon = document.getElementById('sidebarCollapseIcon');
      if (icon) {
        icon.className = isCollapsed ? 'fa-solid fa-indent' : 'fa-solid fa-bars-staggered';
      }
    });

    function toggleSidebarCollapse() {
      const sidebar = document.getElementById('admSidebar');
      if (!sidebar) return;
      
      const isCollapsed = sidebar.classList.toggle('collapsed');
      if (isCollapsed) {
        document.documentElement.classList.add('sidebar-is-collapsed');
      } else {
        document.documentElement.classList.remove('sidebar-is-collapsed');
      }
      
      localStorage.setItem('sat_admin_sidebar_collapsed', isCollapsed ? 'true' : 'false');
      
      const icon = document.getElementById('sidebarCollapseIcon');
      if (icon) {
        icon.className = isCollapsed ? 'fa-solid fa-indent' : 'fa-solid fa-bars-staggered';
      }
    }
  </script>
  @RenderSection("Scripts", required: false)
</body>

</html>
