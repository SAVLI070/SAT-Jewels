@{
    Layout = null;
    var title = (ViewData["Title"] ?? "Admin Dashboard").ToString();
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@title — SAT Jewel Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <link rel="stylesheet" href="~/css/admin_layout.css" />
  <link rel="stylesheet" href="~/css/style.css" />
</head>

<body style="background: #f8fafc; color: #0f172a;">

  <div id="farmbridgeAdminPortal" class="show" style="position:relative; opacity:1; visibility:visible;">
    <!-- Left Sidebar (`adm-sidebar`) -->
    <aside class="adm-sidebar" id="admSidebar">
      <div class="adm-sidebar-logo">
        <div class="sat-logo-emblem" style="width:36px;height:36px;background:#0f172a;border-color:#b45309;">
          <svg class="sat-monogram-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M50 10 L85 30 L85 70 L50 90 L15 70 L15 30 Z" stroke="#fbbf24" stroke-width="3" fill="none" />
          </svg>
        </div>
        <span class="adm-sidebar-name">SAT <span>Jewel</span></span>
      </div>
      <div class="adm-role-badge">Admin</div>

      <ul class="adm-nav">
        <li>
          <a href="/Admin/Dashboard" class="adm-nav-link @(Context.Request.Path.Value?.ToLower().Contains("dashboard") == true ? "active" : "")">
            <i class="fa-solid fa-chart-pie"></i> <span>Overview</span>
          </a>
        </li>
        <li>
          <a href="/Admin/Catalog" class="adm-nav-link @(Context.Request.Path.Value?.ToLower().Contains("catalog") == true ? "active" : "")">
            <i class="fa-solid fa-gem"></i> <span>Jewelry Catalog</span>
          </a>
        </li>
        <li>
          <a href="/Admin/AddProduct" class="adm-nav-link @(Context.Request.Path.Value?.ToLower().Contains("addproduct") == true ? "active" : "")">
            <i class="fa-solid fa-circle-plus"></i> <span>Add New Item</span>
          </a>
        </li>
      </ul>

      <div class="adm-sidebar-foot">
        <a href="/" class="adm-nav-link adm-logout">
          <i class="fa-solid fa-right-from-bracket"></i> <span>Exit to Storefront</span>
        </a>
      </div>
    </aside>

    <!-- Main Content Area (`adm-main`) -->
    <div class="adm-main">
      <header class="adm-topbar">
        <div class="adm-topbar-left">
          <h1 class="adm-page-title">@title</h1>
        </div>
        <div class="adm-topbar-right">
          <div class="adm-avatar">A</div>
        </div>
      </header>

      <main class="adm-content">
        @RenderBody()
      </main>
    </div>
  </div>

  <script src="~/js/script.js"></script>
  @RenderSection("Scripts", required: false)
</body>

</html>
