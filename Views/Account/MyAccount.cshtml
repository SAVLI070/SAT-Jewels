  <div class="w-full max-w-lg rounded-2xl bg-surface-container-lowest border border-secondary/40 p-6 shadow-2xl space-y-4">
    <div class="flex items-center justify-between border-b border-outline-variant/30 pb-3">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary text-[24px]">verified</span>
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Review Your Purchase</h3>
      </div>
      <button onclick="closeReviewModal()" class="w-8 h-8 rounded-full hover:bg-surface-container-high text-outline hover:text-on-surface flex items-center justify-center">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
