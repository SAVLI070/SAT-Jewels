<script>
  let activeTab = 'account';

  // Toggle Sidebar Collapse / Expand
  function toggleSidebar() {
    const sidebar = document.getElementById('accountSidebar');
    const mainCanvas = document.getElementById('accountMainCanvas');
    const topHeader = document.getElementById('accountTopHeader');
    const btnExpand = document.getElementById('btnExpandSidebar');

    const isCollapsed = sidebar.classList.contains('-translate-x-full');
    if (isCollapsed) {
      // Expand sidebar
      sidebar.classList.remove('-translate-x-full');
      mainCanvas.classList.add('pl-72');
      mainCanvas.classList.remove('pl-0');
      topHeader.classList.add('left-72');
      topHeader.classList.remove('left-0');
      if (btnExpand) btnExpand.classList.add('hidden');
      localStorage.setItem('sat_sidebar_collapsed', 'false');
    } else {
      // Collapse sidebar
      sidebar.classList.add('-translate-x-full');
      mainCanvas.classList.remove('pl-72');
      mainCanvas.classList.add('pl-0');
      topHeader.classList.remove('left-72');
      topHeader.classList.add('left-0');
      if (btnExpand) btnExpand.classList.remove('hidden');
      localStorage.setItem('sat_sidebar_collapsed', 'true');
    }
  }

  // Toggle Past Orders Dropdown / Accordion
  function togglePastOrders() {
    const container = document.getElementById('pastOrdersContainer');
    const icon = document.getElementById('iconTogglePastOrders');
    const txt = document.getElementById('txtTogglePastOrders');
    if (!container) return;
    const isHidden = container.classList.contains('hidden');
    if (isHidden) {
      container.classList.remove('hidden');
      if (icon) icon.classList.add('rotate-180');
      if (txt) txt.textContent = 'Collapse Archive';
    } else {
      container.classList.add('hidden');
      if (icon) icon.classList.remove('rotate-180');
      if (txt) txt.textContent = 'View Archive';
    }
  }

  // Switch tabs & scroll to target
  function switchAccountTab(tab, e) {
    if (e && e.preventDefault) e.preventDefault();
    activeTab = tab;

    const inactiveBase = 'px-space-md py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all font-label-md text-label-md';
    const activeBase = 'px-space-md py-2.5 rounded-lg bg-primary-container text-on-primary-container font-semibold transition-all shadow-[0_0_15px_rgba(212,175,55,0.2)] font-label-md text-label-md';

    // Reset all nav items cleanly
    const itemAccount = document.getElementById('navItemAccount');
    const itemWishlist = document.getElementById('navItemWishlist');
    const itemOrders = document.getElementById('navItemOrders');
    const itemAddresses = document.getElementById('navItemAddresses');
    const itemContact = document.getElementById('navItemContact');

    if (itemAccount) itemAccount.className = 'flex items-center gap-3 ' + inactiveBase;
    if (itemContact) itemContact.className = 'flex items-center gap-3 ' + inactiveBase;
    if (itemWishlist) itemWishlist.className = 'flex items-center justify-between ' + inactiveBase;
    if (itemOrders) itemOrders.className = 'flex items-center justify-between ' + inactiveBase;
    if (itemAddresses) itemAddresses.className = 'flex items-center justify-between ' + inactiveBase;

    let targetEl = null;

    if (tab === 'wishlist') {
      if (itemWishlist) itemWishlist.className = 'flex items-center justify-between ' + activeBase;
      targetEl = document.getElementById('sectionWishlist');
    } else if (tab === 'orders') {
      if (itemOrders) itemOrders.className = 'flex items-center justify-between ' + activeBase;
      targetEl = document.getElementById('sectionOrders');
    } else if (tab === 'addresses') {
      if (itemAddresses) itemAddresses.className = 'flex items-center justify-between ' + activeBase;
      targetEl = document.getElementById('sectionAddresses');
    } else if (tab === 'contact') {
      if (itemContact) itemContact.className = 'flex items-center gap-3 ' + activeBase;
      targetEl = document.getElementById('sectionContact');
    } else {
      if (itemAccount) itemAccount.className = 'flex items-center gap-3 ' + activeBase;
      targetEl = document.getElementById('sectionAccount');
    }

    if (e && targetEl) {
      targetEl.scrollIntoView({ behavior: 'smooth' });
    }
  }

  // Handle URL hash or tab query on load & restore sidebar state
  window.addEventListener('DOMContentLoaded', () => {
    // Restore sidebar state
    if (localStorage.getItem('sat_sidebar_collapsed') === 'true') {
      toggleSidebar();
    }

    const params = new URLSearchParams(window.location.search);
    const tabParam = params.get('tab') || window.location.hash.replace('#', '');
    if (tabParam && tabParam !== 'account') {
      switchAccountTab(tabParam);
      const target = document.getElementById('section' + tabParam.charAt(0).toUpperCase() + tabParam.slice(1));
      if (target) {
        setTimeout(() => target.scrollIntoView({ behavior: 'smooth' }), 100);
      }
    } else {
      switchAccountTab('account');
    }

    // Check for post-purchase review prompt
    if (params.get('promptReview') === '1') {
      try {
        const pending = sessionStorage.getItem('sat_pending_review_item');
        if (pending) {
          const data = JSON.parse(pending);
          promptProductReview(data.productId || 'sat-prod-8', data.productName || 'Bespoke Fine Jewelry', data.productImg || '/assets/ring_1.jpg');
          sessionStorage.removeItem('sat_pending_review_item');
        } else {
          promptProductReview('sat-prod-8', 'Bespoke Fine Jewelry Creation', '/assets/ring_1.jpg');
        }
      } catch (err) {
        promptProductReview('sat-prod-8', 'Bespoke Fine Jewelry Creation', '/assets/ring_1.jpg');
      }
    }
  });

  // Address Modal Helpers
  function openAddressModal() {
    document.getElementById('addrModalTitle').textContent = 'Add Shipping Address';
    document.getElementById('addrInputId').value = '';
    document.getElementById('addrInputName').value = '@displayName';
    document.getElementById('addrInputPhone').value = '@phone';
    document.getElementById('addrInputStreet').value = '';
    document.getElementById('addrInputSuite').value = '';
    document.getElementById('addrInputCity').value = '';
    document.getElementById('addrInputState').value = '';
    document.getElementById('addrInputZip').value = '';
