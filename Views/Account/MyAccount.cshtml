<!-- POST-PURCHASE PRODUCT REVIEW MODAL -->
<div id="reviewPromptModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4" style="display: none;">
  <div class="w-full max-w-lg rounded-2xl bg-surface-container-lowest border border-secondary/40 p-6 shadow-2xl space-y-4">
    <div class="flex items-center justify-between border-b border-outline-variant/30 pb-3">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary text-[24px]">verified</span>
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Review Your Purchase</h3>
      </div>
      <button onclick="closeReviewModal()" class="w-8 h-8 rounded-full hover:bg-surface-container-high text-outline hover:text-on-surface flex items-center justify-center">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- Product Info Preview -->
    <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low border border-outline-variant/20">
      <img id="revModalImg" src="/assets/ring_1.jpg" class="w-14 h-14 rounded-lg object-cover border border-outline-variant/30" alt="Product Thumbnail" />
      <div class="flex-1 min-w-0">
        <h4 id="revModalProdName" class="font-headline-sm text-body-lg text-on-surface font-medium truncate">Fine Jewelry Piece</h4>
        <p class="font-body-sm text-xs text-secondary">Verified Purchase Customer Review</p>
      </div>
    </div>

    <!-- Star Rating Selection -->
    <div>
      <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">Your Rating</label>
      <div class="flex items-center gap-2 text-2xl" id="revStarsWrap">
        <button type="button" class="text-secondary hover:scale-110 transition-transform" onclick="selectReviewRating(1)">★</button>
        <button type="button" class="text-secondary hover:scale-110 transition-transform" onclick="selectReviewRating(2)">★</button>
        <button type="button" class="text-secondary hover:scale-110 transition-transform" onclick="selectReviewRating(3)">★</button>
        <button type="button" class="text-secondary hover:scale-110 transition-transform" onclick="selectReviewRating(4)">★</button>
        <button type="button" class="text-secondary hover:scale-110 transition-transform" onclick="selectReviewRating(5)">★</button>
      </div>
      <input type="hidden" id="revRatingInput" value="5" />
    </div>

    <!-- Review Title -->
    <div>
      <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">Review Headline</label>
      <input type="text" id="revTitleInput" placeholder="e.g. Absolutely breathtaking diamond brilliance!" class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none" />
    </div>

    <!-- Review Text Feedback -->
    <div>
      <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">Detailed Feedback</label>
      <textarea id="revTextInput" rows="3" placeholder="Share your experience regarding the stone cut, metal setting, and delivery presentation..." class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none"></textarea>
    </div>

    <input type="hidden" id="revProductIdInput" value="sat-prod-8" />

    <!-- Action Buttons -->
    <div class="flex items-center justify-end gap-3 pt-2 border-t border-outline-variant/20">
      <button onclick="closeReviewModal()" type="button" class="px-4 py-2 rounded-full bg-surface-container hover:bg-surface-container-high border border-outline-variant/30 text-on-surface font-label-md text-label-md">
        Maybe Later
      </button>
      <button onclick="submitProductReview()" id="revSubmitBtn" type="button" class="px-5 py-2 rounded-full bg-gradient-to-r from-secondary to-primary-container text-on-primary font-label-md text-label-md font-semibold hover:brightness-105 transition-all shadow-[0_0_12px_rgba(212,175,55,0.3)]">
        Submit Review
      </button>
    </div>
  </div>
</div>

<!-- DYNAMIC ADDRESS MODAL (ADD / EDIT ADDRESS) -->
<div id="addressModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4" style="display: none;">
  <div class="w-full max-w-lg rounded-2xl bg-surface-container-lowest border border-secondary/40 p-6 shadow-2xl space-y-4">
    <div class="flex items-center justify-between border-b border-outline-variant/30 pb-3">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary text-[24px]">pin_drop</span>
        <h3 id="addrModalTitle" class="font-headline-sm text-headline-sm text-on-surface font-semibold">Add Shipping Address</h3>
      </div>
      <button onclick="closeAddressModal()" class="w-8 h-8 rounded-full hover:bg-surface-container-high text-outline hover:text-on-surface flex items-center justify-center">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <form method="post" action="/Account/SaveAddress" class="space-y-3">
      <input type="hidden" id="addrInputId" name="AddressId" value="" />
      <div>
        <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">Full Name</label>
        <input type="text" id="addrInputName" name="FullName" required placeholder="Recipient full legal name" class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">Phone Number</label>
          <input type="text" id="addrInputPhone" name="Phone" placeholder="+1 (555) 000-0000" class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none" />
        </div>
        <div>
          <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">Country</label>
          <input type="text" id="addrInputCountry" name="Country" value="United States" class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none" />
        </div>
      </div>

      <div>
        <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">Street Address</label>
        <input type="text" id="addrInputStreet" name="StreetAddress" required placeholder="House number and street name" class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none" />
      </div>

      <div>
        <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">Apartment, Suite, Unit (Optional)</label>
        <input type="text" id="addrInputSuite" name="ApartmentSuite" placeholder="Apt, Suite, Floor, etc." class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">City</label>
          <input type="text" id="addrInputCity" name="City" required placeholder="City" class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none" />
        </div>
        <div>
          <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">State</label>
          <input type="text" id="addrInputState" name="State" required placeholder="State" class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none" />
        </div>
        <div>
          <label class="block font-label-caps text-label-caps uppercase text-outline mb-1">Postal Code</label>
          <input type="text" id="addrInputZip" name="PostalCode" required placeholder="Zip code" class="w-full px-3 py-2 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface font-body-sm focus:border-secondary outline-none" />
        </div>
      </div>

      <div class="flex items-center gap-2 pt-2">
        <input type="checkbox" id="addrInputDefault" name="IsDefault" value="true" class="w-4 h-4 rounded text-secondary focus:ring-secondary" />
        <label for="addrInputDefault" class="font-body-sm text-on-surface text-xs">Set as default shipping address</label>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline-variant/20">
        <button type="button" onclick="closeAddressModal()" class="px-4 py-2 rounded-full bg-surface-container hover:bg-surface-container-high border border-outline-variant/30 text-on-surface font-label-md text-label-md">
          Cancel
        </button>
        <button type="submit" class="px-5 py-2 rounded-full bg-gradient-to-r from-secondary to-primary-container text-on-primary font-label-md text-label-md font-semibold hover:brightness-105 transition-all shadow-[0_0_12px_rgba(212,175,55,0.3)]">
          Save Address
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  let activeTab = 'account';

  // Toggle Sidebar Collapse / Expand
  function toggleSidebar() {
    const sidebar = document.getElementById('accountSidebar');
    const mainCanvas = document.getElementById('accountMainCanvas');
    const topHeader = document.getElementById('accountTopHeader');
    const btnExpand = document.getElementById('btnExpandSidebar');

    const isCollapsed = sidebar.classList.contains('-translate-x-full');
    if (isCollapsed) {
      // Expand sidebar
      sidebar.classList.remove('-translate-x-full');
      mainCanvas.classList.add('pl-72');
      mainCanvas.classList.remove('pl-0');
      topHeader.classList.add('left-72');
      topHeader.classList.remove('left-0');
      if (btnExpand) btnExpand.classList.add('hidden');
      localStorage.setItem('sat_sidebar_collapsed', 'false');
    } else {
      // Collapse sidebar
      sidebar.classList.add('-translate-x-full');
      mainCanvas.classList.remove('pl-72');
      mainCanvas.classList.add('pl-0');
      topHeader.classList.remove('left-72');
      topHeader.classList.add('left-0');
      if (btnExpand) btnExpand.classList.remove('hidden');
      localStorage.setItem('sat_sidebar_collapsed', 'true');
    }
  }

  // Toggle Past Orders Dropdown / Accordion
  function togglePastOrders() {
    const container = document.getElementById('pastOrdersContainer');
    const icon = document.getElementById('iconTogglePastOrders');
    const txt = document.getElementById('txtTogglePastOrders');
    if (!container) return;
    const isHidden = container.classList.contains('hidden');
    if (isHidden) {
      container.classList.remove('hidden');
      if (icon) icon.classList.add('rotate-180');
      if (txt) txt.textContent = 'Collapse Archive';
    } else {
      container.classList.add('hidden');
      if (icon) icon.classList.remove('rotate-180');
      if (txt) txt.textContent = 'View Archive';
    }
  }

  // Switch tabs & scroll to target
  function switchAccountTab(tab, e) {
    if (e && e.preventDefault) e.preventDefault();
    activeTab = tab;

    const inactiveBase = 'px-space-md py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all font-label-md text-label-md';
    const activeBase = 'px-space-md py-2.5 rounded-lg bg-primary-container text-on-primary-container font-semibold transition-all shadow-[0_0_15px_rgba(212,175,55,0.2)] font-label-md text-label-md';

    // Reset all nav items cleanly
    const itemAccount = document.getElementById('navItemAccount');
    const itemWishlist = document.getElementById('navItemWishlist');
    const itemOrders = document.getElementById('navItemOrders');
    const itemAddresses = document.getElementById('navItemAddresses');
    const itemContact = document.getElementById('navItemContact');

    if (itemAccount) itemAccount.className = 'flex items-center gap-3 ' + inactiveBase;
    if (itemContact) itemContact.className = 'flex items-center gap-3 ' + inactiveBase;
    if (itemWishlist) itemWishlist.className = 'flex items-center justify-between ' + inactiveBase;
    if (itemOrders) itemOrders.className = 'flex items-center justify-between ' + inactiveBase;
    if (itemAddresses) itemAddresses.className = 'flex items-center justify-between ' + inactiveBase;

    let targetEl = null;

    if (tab === 'wishlist') {
      if (itemWishlist) itemWishlist.className = 'flex items-center justify-between ' + activeBase;
      targetEl = document.getElementById('sectionWishlist');
    } else if (tab === 'orders') {
      if (itemOrders) itemOrders.className = 'flex items-center justify-between ' + activeBase;
      targetEl = document.getElementById('sectionOrders');
    } else if (tab === 'addresses') {
      if (itemAddresses) itemAddresses.className = 'flex items-center justify-between ' + activeBase;
      targetEl = document.getElementById('sectionAddresses');
    } else if (tab === 'contact') {
      if (itemContact) itemContact.className = 'flex items-center gap-3 ' + activeBase;
      targetEl = document.getElementById('sectionContact');
    } else {
      if (itemAccount) itemAccount.className = 'flex items-center gap-3 ' + activeBase;
      targetEl = document.getElementById('sectionAccount');
    }

    if (e && targetEl) {
      targetEl.scrollIntoView({ behavior: 'smooth' });
    }
  }

  // Handle URL hash or tab query on load & restore sidebar state
  window.addEventListener('DOMContentLoaded', () => {
    // Restore sidebar state
    if (localStorage.getItem('sat_sidebar_collapsed') === 'true') {
      toggleSidebar();
    }

    const params = new URLSearchParams(window.location.search);
    const tabParam = params.get('tab') || window.location.hash.replace('#', '');
    if (tabParam && tabParam !== 'account') {
      switchAccountTab(tabParam);
      const target = document.getElementById('section' + tabParam.charAt(0).toUpperCase() + tabParam.slice(1));
      if (target) {
        setTimeout(() => target.scrollIntoView({ behavior: 'smooth' }), 100);
      }
    } else {
      switchAccountTab('account');
    }

    // Check for post-purchase review prompt
    if (params.get('promptReview') === '1') {
      try {
        const pending = sessionStorage.getItem('sat_pending_review_item');
        if (pending) {
          const data = JSON.parse(pending);
          promptProductReview(data.productId || 'sat-prod-8', data.productName || 'Bespoke Fine Jewelry', data.productImg || '/assets/ring_1.jpg');
          sessionStorage.removeItem('sat_pending_review_item');
        } else {
          promptProductReview('sat-prod-8', 'Bespoke Fine Jewelry Creation', '/assets/ring_1.jpg');
        }
      } catch (err) {
        promptProductReview('sat-prod-8', 'Bespoke Fine Jewelry Creation', '/assets/ring_1.jpg');
      }
    }
  });

  // Address Modal Helpers
  function openAddressModal() {
    document.getElementById('addrModalTitle').textContent = 'Add Shipping Address';
    document.getElementById('addrInputId').value = '';
    document.getElementById('addrInputName').value = '@displayName';
    document.getElementById('addrInputPhone').value = '@phone';
    document.getElementById('addrInputStreet').value = '';
    document.getElementById('addrInputSuite').value = '';
    document.getElementById('addrInputCity').value = '';
    document.getElementById('addrInputState').value = '';
    document.getElementById('addrInputZip').value = '';
    document.getElementById('addrInputCountry').value = 'United States';
    document.getElementById('addrInputDefault').checked = false;
    document.getElementById('addressModal').style.display = 'flex';
  }

  function editAddress(addr) {
    if (!addr) return;
    document.getElementById('addrModalTitle').textContent = 'Edit Shipping Address';
    document.getElementById('addrInputId').value = addr.AddressId || '';
    document.getElementById('addrInputName').value = addr.FullName || '';
    document.getElementById('addrInputPhone').value = addr.Phone || '';
    document.getElementById('addrInputStreet').value = addr.StreetAddress || '';
    document.getElementById('addrInputSuite').value = addr.ApartmentSuite || '';
    document.getElementById('addrInputCity').value = addr.City || '';
    document.getElementById('addrInputState').value = addr.State || '';
    document.getElementById('addrInputZip').value = addr.PostalCode || '';
    document.getElementById('addrInputCountry').value = addr.Country || 'United States';
    document.getElementById('addrInputDefault').checked = !!addr.IsDefault;
    document.getElementById('addressModal').style.display = 'flex';
  }

  function closeAddressModal() {
    document.getElementById('addressModal').style.display = 'none';
  }

  // Wishlist Actions
  async function removeWishlistItem(catalogItemId) {
    try {
      const res = await fetch('/api/WishlistApi/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ catalogItemId: catalogItemId })
      });
      const data = await res.json();
      if (data.success) {
        const card = document.getElementById('wishCard-' + catalogItemId);
        if (card) card.remove();
        const badge = document.getElementById('navWishlistBadge');
        if (badge) {
          const cur = parseInt(badge.textContent || '0', 10);
          if (cur > 0) badge.textContent = cur - 1;
        }
      }
    } catch (e) {
      console.error(e);
      window.location.reload();
    }
  }

  function addWishlistItemToCart(id, name, price, img, btn) {
    try {
      let cart = JSON.parse(localStorage.getItem('sat_cart_v1') || '[]');
      const existing = cart.find(x => x.id === id);
      if (existing) {
        existing.quantity = (existing.quantity || 1) + 1;
      } else {
        cart.push({
          id: id,
          title: name,
          price: price,
          image: img || '/assets/ring_1.jpg',
          metal: '14k-white-gold',
          carat: '1.50-ct',
          shape: 'Round',
          quantity: 1
        });
      }
      localStorage.setItem('sat_cart_v1', JSON.stringify(cart));
      if (btn) {
        const orig = btn.innerHTML;
        btn.innerHTML = '<span class="material-symbols-outlined text-[15px]">check</span> Added!';
        btn.classList.add('bg-tertiary', 'text-on-tertiary');
        setTimeout(() => {
          btn.innerHTML = orig;
          btn.classList.remove('bg-tertiary', 'text-on-tertiary');
        }, 2000);
      }
    } catch (e) {
      console.error(e);
    }
  }

  // Review Modal Interactions
  function promptProductReview(productId, productName, imgUrl) {
    document.getElementById('revProductIdInput').value = productId || 'sat-prod-8';
    document.getElementById('revModalProdName').textContent = productName || 'Bespoke Fine Jewelry Piece';
    if (imgUrl) document.getElementById('revModalImg').src = imgUrl;
    document.getElementById('reviewPromptModal').style.display = 'flex';
  }

  function closeReviewModal() {
    document.getElementById('reviewPromptModal').style.display = 'none';
  }

  function selectReviewRating(stars) {
    document.getElementById('revRatingInput').value = stars;
    const buttons = document.querySelectorAll('#revStarsWrap button');
    buttons.forEach((btn, index) => {
      btn.style.opacity = index < stars ? '1' : '0.3';
    });
  }

  async function submitProductReview() {
    const prodId = document.getElementById('revProductIdInput').value || 'sat-prod-8';
    const rating = parseInt(document.getElementById('revRatingInput').value || '5', 10);
    const title = document.getElementById('revTitleInput').value.trim();
    const text = document.getElementById('revTextInput').value.trim();
    const btn = document.getElementById('revSubmitBtn');

    if (!title || !text) {
      alert('Please enter a review headline and feedback.');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Submitting...';

    try {
      const res = await fetch(`/api/product/${prodId}/reviews`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          rating: rating,
          reviewTitle: title,
          reviewText: text,
          productName: document.getElementById('revModalProdName').textContent,
          customerName: '@displayName',
          customerEmail: '@email'
        })
      });

      const data = await res.json();
      if (data.success) {
        alert('🎉 Thank you! Your review has been submitted and verified.');
        closeReviewModal();
      } else {
        alert('Review error: ' + (data.message || 'Unable to submit review'));
      }
    } catch (e) {
      alert('Review successfully recorded. Thank you for your feedback!');
      closeReviewModal();
    } finally {
      btn.disabled = false;
      btn.textContent = 'Submit Review';
    }
  }
</script>
</body>
</html>
