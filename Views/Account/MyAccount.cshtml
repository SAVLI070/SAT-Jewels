  // Backdrop click listener to close modals
  window.addEventListener('click', (e) => {
    const orderModal = document.getElementById('orderDetailsModal');
    if (e.target === orderModal) closeOrderModal();
    const careModal = document.getElementById('ringCareModal');
    if (e.target === careModal) closeRingCareModal();
    const addressModal = document.getElementById('addressModal');
    if (e.target === addressModal) closeAddressModal();
    const reviewModal = document.getElementById('reviewPromptModal');
    if (e.target === reviewModal) closeReviewModal();
  });

  // ESC key to close any open modal
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeOrderModal();
      closeRingCareModal();
      closeAddressModal();
      closeReviewModal();
    }
  });
</script>
