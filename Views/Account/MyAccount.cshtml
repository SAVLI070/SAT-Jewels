      <div class="flex-1 min-w-0">
        <h4 id="revModalProdName" class="font-headline-sm text-body-lg text-on-surface font-medium truncate">Fine Jewelry Piece</h4>
        <p class="font-body-sm text-xs text-secondary">Verified Purchase Customer Review</p>
      </div>
