</head>
<body class="bg-background font-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary-container min-h-screen">

<!-- LEFT NAVIGATION SIDEBAR -->
<aside id="accountSidebar" class="fixed left-0 top-0 h-full w-72 bg-surface-container-lowest border-r border-outline-variant/30 z-50 flex flex-col justify-between p-space-md transition-transform duration-300 ease-in-out">
  <div class="flex flex-col h-full justify-between">
    <div class="space-y-space-md">
      <!-- Brand Logo + Collapse Button -->
      <div class="flex items-center justify-between px-space-xs pt-space-xs">
        <a class="flex items-center gap-space-sm group" href="/">
          <img src="/assets/sat_emblem_clean.png" alt="SAT Jewels Official Logo" class="w-9 h-9 rounded-full object-contain border border-primary/30 shadow-[0_0_12px_rgba(212,175,55,0.2)]" />
          <div class="flex flex-col">
            <span style="font-family: var(--font-serif, 'Playfair Display', serif); font-size: 19px; font-weight: 700; color: #ffffff; letter-spacing: 0.03em; line-height: 1; white-space: nowrap; display: flex; align-items: center;">SAT <span style="margin-left: 4px; color: #d4b878;">Jewel</span></span>
            <span class="font-label-caps text-[9px] uppercase tracking-[0.2em] text-secondary/80 mt-1">Fine Jewelry &amp; Atelier</span>
          </div>
        </a>
        <button id="btnCollapseSidebar" onclick="toggleSidebar()" type="button" class="w-8 h-8 rounded-full hover:bg-surface-container-high text-on-surface-variant hover:text-secondary flex items-center justify-center transition-colors" title="Collapse sidebar menu">
          <span class="material-symbols-outlined text-[20px]">chevron_left</span>
        </button>
      </div>

      <!-- User Info Header Card -->
      <div class="p-space-md rounded-xl bg-surface-container/50 border border-outline-variant/30 flex items-center gap-3 mt-2">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-surface-container-highest to-surface-container-low border border-secondary/40 flex items-center justify-center font-headline-sm text-headline-sm text-secondary font-bold flex-shrink-0">
          @initial
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-headline-sm text-body-lg text-on-surface font-semibold truncate">Hello, @displayName</p>
          <p class="font-body-sm text-body-sm text-on-surface-variant truncate">@email</p>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="space-y-1 pt-2" id="navSidebarList">
        <!-- Shop Products -->
        <a class="flex items-center gap-3 px-space-md py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all font-label-md text-label-md" href="/Product">
          <span class="material-symbols-outlined text-[20px]">diamond</span>
          <span>Shop Products</span>
        </a>

        <!-- My Account -->
        <a id="navItemAccount" class="flex items-center gap-3 px-space-md py-2.5 rounded-lg bg-primary-container text-on-primary-container font-semibold transition-all shadow-[0_0_15px_rgba(212,175,55,0.2)] font-label-md text-label-md" href="#sectionAccount" onclick="switchAccountTab('account', event)">
          <span class="material-symbols-outlined text-[20px]">person</span>
          <span>My Account</span>
        </a>

        <!-- My Wishlist -->
        <a id="navItemWishlist" class="flex items-center justify-between px-space-md py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all font-label-md text-label-md" href="#sectionWishlist" onclick="switchAccountTab('wishlist', event)">
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-[20px]">favorite</span>
            <span>My Wishlist</span>
          </span>
          <span id="navWishlistBadge" class="px-2 py-0.5 rounded-full bg-surface-container-lowest/80 text-secondary text-label-caps font-bold">@wishlistCount</span>
        </a>

        <!-- My Orders -->
        <a id="navItemOrders" class="flex items-center justify-between px-space-md py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all font-label-md text-label-md" href="#sectionOrders" onclick="switchAccountTab('orders', event)">
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-[20px]">inventory_2</span>
            <span>My Orders</span>
          </span>
          <span class="px-2 py-0.5 rounded-full bg-secondary-container/50 text-secondary text-label-caps font-bold">@orderCount</span>
        </a>

        <!-- Saved Addresses -->
        <a id="navItemAddresses" class="flex items-center justify-between px-space-md py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all font-label-md text-label-md" href="#sectionAddresses" onclick="switchAccountTab('addresses', event)">
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-[20px]">location_on</span>
            <span>Saved Addresses</span>
          </span>
          <span class="px-2 py-0.5 rounded-full bg-surface-container-lowest/80 text-secondary text-label-caps font-bold">@addressCount</span>
        </a>

        <!-- Shopping Cart -->
        <a class="flex items-center gap-3 px-space-md py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all font-label-md text-label-md" href="/Product/Cart">
          <span class="material-symbols-outlined text-[20px]">shopping_cart</span>
          <span>Shopping Cart</span>
        </a>

        <!-- Contact Us (Clean left-aligned with icon gap-3) -->
        <a id="navItemContact" class="flex items-center gap-3 px-space-md py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all font-label-md text-label-md" href="#sectionContact" onclick="switchAccountTab('contact', event)">
          <span class="material-symbols-outlined text-[20px]">mail</span>
          <span>Contact Us</span>
        </a>
      </nav>
    </div>

    <!-- Bottom section: Logout -->
    <div class="pt-3 border-t border-outline-variant/30 space-y-2 pb-1">
      <a href="/Account/Logout" class="flex items-center gap-3 w-full px-space-md py-2.5 rounded-lg text-error hover:bg-surface-container-high transition-all font-label-md text-label-md text-left" role="button">
        <span class="material-symbols-outlined text-[20px]">logout</span>
        <span class="font-medium">Logout</span>
      </a>
    </div>
  </div>
</aside>

<!-- MAIN APP CANVAS -->
<div id="accountMainCanvas" class="pl-72 transition-all duration-300 ease-in-out">
  <!-- TOP HEADER -->
  <header id="accountTopHeader" class="fixed top-0 left-72 right-0 h-16 bg-surface-container-lowest/85 backdrop-blur-xl border-b border-outline-variant/30 z-40 px-gutter flex items-center justify-between shadow-[0_4px_30px_rgba(0,0,0,0.6)] transition-all duration-300 ease-in-out">
    <div class="flex items-center gap-3">
      <!-- Toggle button when sidebar collapsed -->
      <button id="btnExpandSidebar" onclick="toggleSidebar()" type="button" class="hidden p-2 rounded-lg hover:bg-surface-container-high text-on-surface-variant hover:text-secondary flex items-center justify-center transition-colors" title="Open Navigation Menu">
        <span class="material-symbols-outlined text-[22px]">menu</span>
      </button>

      <a class="inline-flex items-center gap-1.5 text-on-surface-variant hover:text-secondary transition-colors font-label-md text-label-md group" href="/">
        <span class="material-symbols-outlined text-[18px] transition-transform group-hover:-translate-x-1">west</span>
        <span>Back to Storefront</span>
      </a>
    </div>

    <div class="flex items-center gap-space-md">
      <div class="relative hidden md:block">
        <div class="flex items-center gap-2 px-space-md py-1.5 rounded-full bg-surface-container/80 border border-outline-variant/30 text-on-surface-variant font-label-sm text-label-sm w-64 lg:w-72">
          <span class="material-symbols-outlined text-[18px]">search</span>
          <input class="bg-transparent border-none outline-none text-on-surface placeholder:text-on-surface-variant/60 w-full text-xs" placeholder="Search orders, items..." type="text">
        </div>
      </div>
      <a href="/Product/Cart" aria-label="Cart" class="w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:text-secondary hover:bg-surface-container-high transition-all relative" role="button">
        <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
      </a>
      <div class="pl-space-xs border-l border-outline-variant/40 flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-surface-container-highest to-surface-container-low border border-secondary/40 flex items-center justify-center font-headline-sm text-secondary font-bold text-xs ring-1 ring-secondary/40">
          @initial
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN SCROLLABLE CONTENT -->
  <main class="relative pt-20 px-4 md:px-gutter pb-space-2xl min-h-screen bg-background">
    <div class="flex flex-col w-full max-w-[1180px] mx-auto space-y-8">
      
      <!-- 1. WELCOME BANNER (Clean Luxury Customer Profile) -->
      <section id="sectionAccount" class="relative rounded-2xl bg-surface-container-lowest/90 border border-secondary/25 p-6 md:p-8 shadow-xl overflow-hidden">
        <div class="absolute -top-32 -right-32 w-80 h-80 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col gap-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-md border-b border-outline-variant/20 pb-6">
            <div class="flex items-center gap-space-md">
              <div class="relative flex-shrink-0">
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-surface-container-highest via-surface-container-high to-surface-container-lowest border-2 border-secondary/60 flex items-center justify-center shadow-[0_0_20px_rgba(212,175,55,0.2)]">
                  <span class="font-headline-lg text-headline-md text-secondary font-bold">@initial</span>
                </div>
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-2.5 flex-wrap">
                  <h1 class="font-headline-lg text-headline-lg text-on-surface font-semibold tracking-tight">Welcome back, @displayName</h1>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-secondary-container/40 border border-secondary/35 text-secondary font-label-caps text-label-caps font-semibold">
                    <span class="material-symbols-outlined text-[13px]">diamond</span>
                    SAT Member
                  </span>
                </div>
                <div class="flex items-center gap-3 text-on-surface-variant font-body-sm text-body-sm mt-1 flex-wrap">
                  <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-outline">mail</span> @email</span>
                  <span class="w-1 h-1 rounded-full bg-outline"></span>
                  <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-outline">call</span> @phone</span>
                </div>
              </div>
            </div>

            <!-- Profile Action Buttons -->
            <div class="flex items-center gap-space-sm flex-wrap w-full sm:w-auto">
              <a href="/Account/EditProfile" class="inline-flex items-center justify-center gap-2 px-space-md py-2 rounded-full bg-surface-container hover:bg-surface-container-high border border-outline-variant/30 text-on-surface font-label-md text-label-md transition-all" role="button">
                <span class="material-symbols-outlined text-[16px]">edit</span>
                <span>Edit Profile</span>
              </a>
              <button onclick="switchAccountTab('orders', event)" class="inline-flex items-center justify-center gap-2 px-space-md py-2 rounded-full bg-surface-container hover:bg-surface-container-high border border-outline-variant/30 text-on-surface font-label-md text-label-md transition-all" type="button">
                <span class="material-symbols-outlined text-[16px]">receipt_long</span>
                <span>Orders &amp; Invoices</span>
              </button>
            </div>
          </div>

          <!-- Quick Account Overview Cards (100% Dynamic with Database) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
            <!-- Orders Card -->
            <div onclick="switchAccountTab('orders', event)" class="cursor-pointer p-space-md rounded-xl bg-surface-container-low/70 border border-outline-variant/20 hover:border-secondary/30 transition-all flex items-center justify-between">
              <div>
                <span class="font-label-caps text-label-caps uppercase text-outline tracking-wider block">Orders</span>
                <p class="font-headline-md text-headline-md text-on-surface font-semibold mt-0.5">@orders.Count @(orders.Count == 1 ? "Order" : "Orders")</p>
                <span class="font-label-sm text-label-sm text-secondary font-medium">
                  @(activeOrders.Count > 0 ? $"{activeOrders.Count} active in handcrafting" : "All orders fulfilled")
                </span>
              </div>
              <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-secondary border border-secondary/20">
                <span class="material-symbols-outlined text-[24px]">shopping_bag</span>
              </div>
            </div>

            <!-- Addresses Card -->
            <div onclick="switchAccountTab('addresses', event)" class="cursor-pointer p-space-md rounded-xl bg-surface-container-low/70 border border-outline-variant/20 hover:border-secondary/30 transition-all flex items-center justify-between">
              <div>
                <span class="font-label-caps text-label-caps uppercase text-outline tracking-wider block">Addresses</span>
                <p class="font-headline-md text-headline-md text-on-surface font-semibold mt-0.5">@addresses.Count @(addresses.Count == 1 ? "Address" : "Addresses")</p>
                <span class="font-label-sm text-label-sm text-on-surface-variant font-medium truncate block max-w-[180px]">
                  @(defaultAddr != null ? $"{defaultAddr.City}, {defaultAddr.State}" : "No address saved")
                </span>
              </div>
              <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-secondary border border-secondary/20">
                <span class="material-symbols-outlined text-[24px]">location_on</span>
              </div>
            </div>

            <!-- Wishlist Card -->
            <div onclick="switchAccountTab('wishlist', event)" class="cursor-pointer p-space-md rounded-xl bg-surface-container-low/70 border border-outline-variant/20 hover:border-secondary/30 transition-all flex items-center justify-between">
              <div>
                <span class="font-label-caps text-label-caps uppercase text-outline tracking-wider block">Wishlist</span>
                <p class="font-headline-md text-headline-md text-on-surface font-semibold mt-0.5">@wishlist.Count @(wishlist.Count == 1 ? "Piece" : "Pieces")</p>
                <span class="font-label-sm text-label-sm text-tertiary font-medium">
                  @(wishlist.Count > 0 ? "Saved in vault" : "Explore collection")
                </span>
              </div>
              <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-secondary border border-secondary/20">
                <span class="material-symbols-outlined text-[24px]">favorite</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. RECENT ORDERS (100% Dynamic from Database) -->
      <section id="sectionOrders" class="space-y-space-md">
        <div class="flex items-center justify-between">
          <div>
            <span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary">Purchases &amp; Tracking</span>
            <h2 class="font-headline-md text-headline-md text-on-surface">Recent Orders (@orders.Count)</h2>
          </div>
          <a href="/Product" class="inline-flex items-center gap-1 text-secondary hover:underline font-label-md text-label-md">
            <span>Explore Atelier</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        @if (orders.Count > 0)
        {
          for (int i = 0; i < orders.Count; i++)
          {
            var order = orders[i];
            bool isDelivered = order.OrderStatus == "Delivered";
            bool isCancelled = order.OrderStatus == "Cancelled";
            string estDelivery = order.EstimatedDeliveryDate.HasValue 
              ? order.EstimatedDeliveryDate.Value.ToString("MMM dd") 
              : order.CreatedAt.AddDays(14).ToString("MMM dd");

            if (i == 1)
            {
              @:<div class="pt-2">
                <button id="btnTogglePastOrders" onclick="togglePastOrders()" type="button" class="w-full py-3.5 px-6 rounded-2xl bg-surface-container-low/90 border border-outline-variant/30 hover:border-secondary/50 text-on-surface hover:text-secondary flex items-center justify-between transition-all group shadow-md mb-space-md">
                  <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-full bg-secondary-container/40 text-secondary flex items-center justify-center flex-shrink-0">
                      <span class="material-symbols-outlined text-[20px]">history</span>
                    </span>
                    <div class="text-left">
                      <span class="font-label-md text-label-md font-semibold text-on-surface group-hover:text-secondary transition-colors block">
                        Archive of Previous Commissions (@(orders.Count - 1) Older Orders)
                      </span>
                      <span class="font-body-sm text-xs text-on-surface-variant">Click to view complete order history and GIA certificates</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 text-secondary">
                    <span id="txtTogglePastOrders" class="font-label-sm text-label-sm font-medium hidden sm:inline">View Archive (@(orders.Count - 1))</span>
                    <span id="iconTogglePastOrders" class="material-symbols-outlined text-[22px] transition-transform duration-300">expand_more</span>
                  </div>
                </button>
              @:<div id="pastOrdersContainer" class="hidden space-y-space-md transition-all duration-300">
            }

            <article class="rounded-2xl bg-surface-container-lowest/90 border @(isDelivered ? "border-outline-variant/25 hover:border-secondary/35" : "border-secondary/30") p-space-lg md:p-space-xl shadow-lg relative overflow-hidden space-y-space-lg">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm border-b border-outline-variant/20 pb-space-md">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-label-caps text-label-caps font-bold tracking-wider text-secondary">ORDER #@(order.OrderNumber ?? order.OrderId)</span>
                    <span class="text-outline text-xs">•</span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Placed @order.CreatedAt.ToString("MMM dd, yyyy")</span>
                  </div>
                  <h3 class="font-headline-md text-headline-md text-on-surface mt-1">@order.ItemName</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Bespoke Jewelry Commission • Includes GIA/IGI Certification &amp; Presentation Box</p>
                </div>
                <div class="flex flex-col sm:items-end">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full @(isDelivered ? "bg-tertiary-container/30 border border-tertiary/40 text-tertiary" : "bg-secondary-container/40 border border-secondary/40 text-secondary") font-label-caps text-label-caps font-semibold">
                    @if (!isDelivered && !isCancelled)
                    {
                      <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                    }
                    else if (isDelivered)
                    {
                      <span class="material-symbols-outlined text-[13px]">check_circle</span>
                    }
                    @order.OrderStatus • @(isDelivered ? "Delivered" : $"Est. Delivery {estDelivery}")
                  </span>
                  <span class="font-headline-sm text-headline-sm text-secondary font-bold mt-2">$@order.TotalAmountUSD.ToString("N2") USD</span>
                </div>
              </div>

              <!-- Product Preview & Progress Tracker -->
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center">
                <div class="lg:col-span-3 flex items-center gap-4">
                  <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl bg-surface-container overflow-hidden border border-outline-variant/30 flex-shrink-0">
                    <img class="w-full h-full object-cover" alt="@order.ItemName" src="/assets/ring_1.jpg">
                  </div>
                  <div class="space-y-1">
                    <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-label-caps text-label-caps">GIA #@(order.OrderId.Length > 10 ? order.OrderId.Substring(0, 10).ToUpper() : order.OrderId)</span>
                    <p class="font-label-sm text-label-sm text-tertiary flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px]">verified</span> Insured Delivery
                    </p>
                    <p class="font-label-caps text-label-caps text-outline">Signature Required</p>
                  </div>
                </div>

                @if (!isDelivered && !isCancelled)
                {
                  <div class="lg:col-span-9 p-space-md rounded-xl bg-surface-container-low/80 border border-outline-variant/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-full bg-secondary-container/40 border border-secondary/40 text-secondary flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">diamond</span>
                      </div>
                      <div>
                        <p class="font-label-md text-label-md text-on-surface font-semibold">Commission Status: <span class="text-secondary">@order.OrderStatus</span></p>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Insured Handcrafted Delivery • Includes Physical GIA/IGI Certification</p>
                      </div>
                    </div>
                    <div class="text-left sm:text-right sm:border-l sm:border-outline-variant/30 sm:pl-4">
                      <span class="font-label-caps text-label-caps uppercase text-outline block">Estimated Completion</span>
                      <span class="font-label-md text-label-md text-secondary font-bold">@estDelivery</span>
                    </div>
                  </div>
                }
                else
                {
                  <div class="lg:col-span-9 flex items-center justify-end">
                    <span class="px-4 py-2 rounded-xl bg-surface-container text-on-surface-variant font-label-md flex items-center gap-2">
                      <span class="material-symbols-outlined text-tertiary text-[20px]">task_alt</span>
                      Fulfilled &amp; Delivered with GIA physical hardcopy certificate
                    </span>
                  </div>
                }
              </div>

              <!-- Order Actions -->
              <div class="flex items-center justify-between gap-space-sm pt-space-sm border-t border-outline-variant/20 flex-wrap">
                <div class="flex items-center gap-2 flex-wrap">
                  <button onclick="promptProductReview('@order.OrderId', '@order.ItemName', '/assets/ring_1.jpg')" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-gradient-to-r from-secondary to-primary-container text-on-primary font-label-md text-label-md font-semibold hover:brightness-105 transition-all shadow-[0_0_12px_rgba(212,175,55,0.25)]" type="button">
                    <span class="material-symbols-outlined text-[16px]">rate_review</span>
                    <span>Write a Review</span>
                  </button>
                </div>
                <button onclick="switchAccountTab('contact', event)" class="text-secondary hover:underline font-label-sm text-label-sm flex items-center gap-1" type="button">
                  <span class="material-symbols-outlined text-[16px]">help</span>
                  <span>Need help with this piece?</span>
                </button>
              </div>
            </article>

            if (i == orders.Count - 1 && orders.Count > 1)
            {
              @:</div>
              @:</div>
            }
          }
        }
        else
        {
          <div class="rounded-2xl bg-surface-container-lowest/90 border border-outline-variant/30 p-12 text-center space-y-4">
            <div class="w-16 h-16 rounded-full bg-surface-container mx-auto flex items-center justify-center text-secondary border border-secondary/20">
              <span class="material-symbols-outlined text-[32px]">inventory_2</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface font-semibold">No Orders Placed Yet</h3>
            <p class="text-on-surface-variant font-body-md max-w-md mx-auto">Your personal collection awaits. Explore our certified lab-grown diamond solitaires and bespoke fine jewelry creations.</p>
            <a href="/Product" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-gradient-to-r from-secondary to-primary-container text-on-primary font-label-md text-label-md font-semibold hover:brightness-105 transition-all shadow-[0_0_15px_rgba(212,175,55,0.3)]">
              <span class="material-symbols-outlined text-[18px]">diamond</span>
              <span>Explore Creations</span>
            </a>
          </div>
        }
      </section>

      <!-- 3. MY WISHLIST SECTION (100% Dynamic from Database) -->
      <section id="sectionWishlist" class="space-y-space-md">
        <div class="flex items-center justify-between">
          <div>
            <span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary">Private Collection</span>
            <h2 class="font-headline-md text-headline-md text-on-surface">My Wishlist Sanctuary (@wishlist.Count)</h2>
          </div>
          <a href="/Product" class="inline-flex items-center gap-1 text-secondary hover:underline font-label-md text-label-md">
            <span>Browse More Pieces</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        @if (wishlist.Count > 0)
        {
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="wishlistGrid">
            @foreach (var item in wishlist)
            {
              <div class="rounded-2xl bg-surface-container-lowest/90 border border-outline-variant/25 p-4 flex flex-col justify-between hover:border-secondary/40 transition-all group" id="wishCard-@item.CatalogItemId">
                <div class="space-y-3">
                  <div class="relative w-full aspect-square rounded-xl bg-surface-container overflow-hidden border border-outline-variant/20">
                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/assets/ring_1.jpg" : item.ImageUrl)" alt="@item.ProductName" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                    <button onclick="removeWishlistItem('@item.CatalogItemId')" class="absolute top-2 right-2 w-8 h-8 rounded-full bg-black/60 backdrop-blur-md text-error hover:scale-110 transition-transform flex items-center justify-center" title="Remove from Wishlist">
                      <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                  </div>
                  <div>
                    <h4 class="font-headline-sm text-body-md text-on-surface font-medium line-clamp-1">@item.ProductName</h4>
                    <p class="font-headline-sm text-secondary font-bold text-body-lg mt-1">$@item.PriceUSD.ToString("N2") USD</p>
                  </div>
                </div>
                <div class="pt-3 border-t border-outline-variant/20 mt-3 flex items-center gap-2">
                  <button onclick="addWishlistItemToCart('@item.CatalogItemId', '@item.ProductName', @item.PriceUSD, '@item.ImageUrl', this)" class="flex-1 py-2 px-3 rounded-full bg-gradient-to-r from-secondary to-primary-container text-on-primary font-label-sm font-semibold text-center hover:brightness-105 transition-all text-xs flex items-center justify-center gap-1 shadow-[0_0_10px_rgba(212,175,55,0.2)]">
                    <span class="material-symbols-outlined text-[15px]">shopping_cart</span>
                    <span>Add to Bag</span>
                  </button>
                  <a href="/Product" class="w-8 h-8 rounded-full bg-surface-container hover:bg-surface-container-high border border-outline-variant/30 flex items-center justify-center text-on-surface-variant hover:text-secondary transition-colors" title="View details">
                    <span class="material-symbols-outlined text-[16px]">visibility</span>
                  </a>
                </div>
              </div>
            }
          </div>
        }
        else
        {
          <div class="rounded-2xl bg-surface-container-lowest/90 border border-outline-variant/30 p-12 text-center space-y-4">
            <div class="w-16 h-16 rounded-full bg-surface-container mx-auto flex items-center justify-center text-secondary border border-secondary/20">
              <span class="material-symbols-outlined text-[32px]">favorite_border</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface font-semibold">Your Wishlist Sanctuary is Empty</h3>
            <p class="text-on-surface-variant font-body-md max-w-md mx-auto">Save your dream diamond cuts and bespoke creations as you explore our jewelry vitrines.</p>
            <a href="/Product" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-gradient-to-r from-secondary to-primary-container text-on-primary font-label-md text-label-md font-semibold hover:brightness-105 transition-all shadow-[0_0_15px_rgba(212,175,55,0.3)]">
              <span class="material-symbols-outlined text-[18px]">diamond</span>
              <span>Explore Collection</span>
            </a>
          </div>
        }
      </section>

      <!-- 4. SAVED SHIPPING ADDRESSES & CLIENT CARE (100% Dynamic from Database) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
        <!-- LEFT: SAVED SHIPPING ADDRESSES (7 COLS) -->
        <section id="sectionAddresses" class="lg:col-span-7 rounded-2xl bg-surface-container-lowest/80 border border-outline-variant/25 p-space-lg space-y-space-md shadow-md">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[22px]">location_on</span>
              <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Shipping Address Vault (@addresses.Count)</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Linked to verified courier dispatches</p>
              </div>
            </div>
            <button onclick="openAddressModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high border border-secondary/35 text-secondary font-label-sm text-label-sm font-semibold transition-all" type="button">
              <span class="material-symbols-outlined text-[16px]">add</span>
              <span>Add Address</span>
            </button>
          </div>

          @if (addresses.Count > 0)
          {
            <div class="space-y-3">
              @foreach (var addr in addresses)
              {
                <div class="p-space-md rounded-xl bg-surface-container-low/80 border @(addr.IsDefault ? "border-secondary/40 shadow-[0_0_15px_rgba(212,175,55,0.1)]" : "border-outline-variant/20") relative">
                  <div class="flex items-start justify-between">
                    <div class="space-y-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-label-md text-label-md text-on-surface font-bold">@addr.FullName</span>
                        @if (addr.IsDefault)
                        {
                          <span class="px-2 py-0.5 rounded-full bg-secondary-container/40 text-secondary font-label-caps text-label-caps font-semibold">DEFAULT</span>
                        }
                      </div>
                      <p class="font-body-md text-body-md text-on-surface">@addr.StreetAddress @(!string.IsNullOrWhiteSpace(addr.ApartmentSuite) ? $", {addr.ApartmentSuite}" : "")</p>
                      <p class="font-body-md text-body-md text-on-surface-variant">@addr.City, @addr.State @addr.PostalCode</p>
                      <p class="font-body-sm text-body-sm text-outline">@addr.Country • @addr.Phone</p>
                    </div>

                    <div class="flex items-center gap-1">
                      <button onclick='editAddress(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(addr)))' class="w-8 h-8 rounded-full hover:bg-surface-container-high text-outline hover:text-on-surface flex items-center justify-center transition-all" title="Edit address">
                        <span class="material-symbols-outlined text-[18px]">edit</span>
                      </button>
                      <form method="post" action="/Account/DeleteAddress" onsubmit="return confirm('Remove this shipping address?');" class="inline">
                        <input type="hidden" name="addressId" value="@addr.AddressId" />
                        <button type="submit" class="w-8 h-8 rounded-full hover:bg-surface-container-high text-outline hover:text-error flex items-center justify-center transition-all" title="Delete address">
                          <span class="material-symbols-outlined text-[18px]">delete</span>
                        </button>
                      </form>
                    </div>
                  </div>

                  @if (!addr.IsDefault)
                  {
                    <div class="mt-2 pt-2 border-t border-outline-variant/20 flex items-center justify-end">
                      <form method="post" action="/Account/SetDefaultAddress">
                        <input type="hidden" name="addressId" value="@addr.AddressId" />
                        <button type="submit" class="text-secondary hover:underline font-label-sm text-label-sm">Set as Default</button>
                      </form>
                    </div>
                  }
                  else
                  {
                    <div class="mt-2 pt-2 border-t border-outline-variant/20 flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm">
                      <span class="flex items-center gap-1 text-tertiary">
                        <span class="material-symbols-outlined text-[15px]">verified_user</span> Direct Adult Signature Required
                      </span>
                      <span class="text-outline">FedEx/DHL Priority Insured</span>
                    </div>
                  }
                </div>
              }
            </div>
          }
          else
          {
            <div class="p-8 rounded-xl bg-surface-container-low/50 border border-dashed border-outline-variant/30 text-center space-y-3">
              <span class="material-symbols-outlined text-outline text-[32px]">pin_drop</span>
              <p class="font-body-md text-on-surface-variant">No shipping addresses saved yet.</p>
              <button onclick="openAddressModal()" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-secondary-container/40 border border-secondary/40 text-secondary font-label-sm font-semibold">
                <span class="material-symbols-outlined text-[16px]">add</span>
                <span>Add Your First Address</span>
              </button>
            </div>
          }
        </section>

        <!-- RIGHT: CLIENT CARE & WISHLIST SUPPORT (5 COLS) -->
        <section id="sectionContact" class="lg:col-span-5 rounded-2xl bg-surface-container-lowest/85 border border-secondary/25 p-space-lg space-y-space-md shadow-md">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-surface-container-high border border-secondary/40 overflow-hidden flex-shrink-0 flex items-center justify-center">
              <span class="material-symbols-outlined text-secondary text-[26px]">support_agent</span>
            </div>
            <div>
              <span class="font-label-caps text-label-caps uppercase text-secondary font-bold">Client Care &amp; Atelier</span>
              <h3 class="font-headline-sm text-headline-sm text-on-surface">Need Help With Your Order?</h3>
            </div>
          </div>
          <p class="font-body-sm text-body-sm text-on-surface-variant">
            Our jewelry specialists are here to assist with custom ring sizing, shipment scheduling, care polishing, or private atelier inquiries.
          </p>
          <div class="space-y-2 pt-1">
            <a class="w-full inline-flex items-center justify-center gap-2 py-2.5 rounded-full bg-gradient-to-r from-secondary to-primary-container text-on-primary font-label-md text-label-md font-semibold hover:brightness-105 transition-all shadow-[0_0_12px_rgba(212,175,55,0.2)]" href="https://wa.me/918320972779" target="_blank">
              <span class="material-symbols-outlined text-[18px]">chat</span>
              <span>Message SAT Customer Care</span>
            </a>
            <a href="mailto:care@satjewel.com" class="w-full inline-flex items-center justify-center gap-2 py-2.5 rounded-full bg-surface-container hover:bg-surface-container-high border border-outline-variant/30 text-on-surface font-label-md text-label-md transition-all" role="button">
              <span class="material-symbols-outlined text-[18px]">mail</span>
              <span>Email: care@satjewel.com</span>
            </a>
          </div>
          <div class="pt-2 border-t border-outline-variant/20 flex items-center justify-between text-outline font-label-sm text-label-sm">
            <span>Hours: Mon – Sat, 9am – 8pm EST</span>
            <span class="text-tertiary flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span> Live Support</span>
          </div>
        </section>
      </div>

    </div>
  </main>
</div>

<!-- FLOATING WHATSAPP CHAT BADGE -->
