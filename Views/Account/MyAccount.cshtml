  // Wishlist Actions
  async function removeWishlistItem(catalogItemId) {
    try {
      const res = await fetch('/api/WishlistApi/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ catalogItemId: catalogItemId })
      });
      const data = await res.json();
      if (data.success) {
        const card = document.getElementById('wishCard-' + catalogItemId);
        if (card) card.remove();
        const badge = document.getElementById('navWishlistBadge');
        if (badge) {
          const cur = parseInt(badge.textContent || '0', 10);
          if (cur > 0) badge.textContent = cur - 1;
        }
      }
    } catch (e) {
      console.error(e);
      window.location.reload();
    }
  }

  function getCartStorageKey() {
    const email = '@(email.ToLower().Trim())';
    if (email) {
      return 'sat_cart_' + encodeURIComponent(email);
    }
    return 'sat_cart_guest';
  }

  function syncCartBadge() {
    try {
      const key = getCartStorageKey();
      const saved = localStorage.getItem(key);
      const items = saved ? JSON.parse(saved) : [];
      const count = items.reduce((sum, i) => sum + (Number(i.quantity) || 1), 0);
      document.querySelectorAll('#navCartBadge, #navCartCount, .auth-nav-cart-count, .sat-cart-count-badge').forEach(el => {
        el.textContent = String(count);
      });
    } catch (_) {}
  }
  document.addEventListener('DOMContentLoaded', syncCartBadge);
  syncCartBadge();

  function addWishlistItemToCart(id, name, price, img, btn) {
    try {
      const key = getCartStorageKey();
      let cart = JSON.parse(localStorage.getItem(key) || '[]');
      const existing = cart.find(x => x.id === id);
      if (existing) {
        existing.quantity = (Number(existing.quantity) || 1) + 1;
      } else {
        cart.push({
          id: id,
          name: name,
          title: name,
          priceUSD: Number(price) || 0,
          img: img || '/assets/ring_1.jpg',
          metal: '14K Yellow Gold',
          carat: '1.50 CT',
          shape: 'Round',
          quantity: 1
        });
      }
      localStorage.setItem(key, JSON.stringify(cart));
      syncCartBadge();
      if (btn) {
        const orig = btn.innerHTML;
        btn.innerHTML = '<span class="material-symbols-outlined text-[15px]">check</span> Added!';
        btn.classList.add('bg-tertiary', 'text-on-tertiary');
        setTimeout(() => {
          btn.innerHTML = orig;
          btn.classList.remove('bg-tertiary', 'text-on-tertiary');
        }, 2000);
      }
    } catch (e) {
      console.error(e);
    }
  }

  // Review Modal Interactions
  function promptProductReview(productId, productName, imgUrl) {
    document.getElementById('revProductIdInput').value = productId || 'sat-prod-8';
    document.getElementById('revModalProdName').textContent = productName || 'Bespoke Fine Jewelry Piece';
    if (imgUrl) document.getElementById('revModalImg').src = imgUrl;
    document.getElementById('reviewPromptModal').style.display = 'flex';
  }

  function closeReviewModal() {
    document.getElementById('reviewPromptModal').style.display = 'none';
  }

  function selectReviewRating(stars) {
    document.getElementById('revRatingInput').value = stars;
    const buttons = document.querySelectorAll('#revStarsWrap button');
    buttons.forEach((btn, index) => {
      btn.style.opacity = index < stars ? '1' : '0.3';
    });
  }

  async function submitProductReview() {
    const prodId = document.getElementById('revProductIdInput').value || 'sat-prod-8';
    const rating = parseInt(document.getElementById('revRatingInput').value || '5', 10);
    const title = document.getElementById('revTitleInput').value.trim();
    const text = document.getElementById('revTextInput').value.trim();
    const btn = document.getElementById('revSubmitBtn');

    if (!title || !text) {
      alert('Please enter a review headline and feedback.');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Submitting...';

    try {
      const res = await fetch(`/api/product/${prodId}/reviews`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          rating: rating,
          reviewTitle: title,
          reviewText: text,
          productName: document.getElementById('revModalProdName').textContent,
          customerName: '@displayName',
          customerEmail: '@email'
        })
      });

      const data = await res.json();
      if (data.success) {
        alert('🎉 Thank you! Your review has been submitted and verified.');
        closeReviewModal();
      } else {
        alert('Review error: ' + (data.message || 'Unable to submit review'));
      }
    } catch (e) {
      alert('Review successfully recorded. Thank you for your feedback!');
      closeReviewModal();
    } finally {
      btn.disabled = false;
      btn.textContent = 'Submit Review';
    }
  }

  // Dynamic Order Details Modal & Invoice Logic
  @{
    var ordersJsonList = orders.Select(o => new {
        orderId = o.OrderId,
        orderNumber = o.OrderNumber ?? o.OrderId,
        itemName = o.ItemName,
        totalAmountUSD = o.TotalAmountUSD,
        orderStatus = o.OrderStatus,
        currentTrackingStatus = o.CurrentTrackingStatus,
        carrierName = string.IsNullOrEmpty(o.CarrierName) ? "DHL Express" : o.CarrierName,
        trackingNumber = string.IsNullOrEmpty(o.TrackingNumber) ? ("DHL-" + (o.OrderId.Length > 8 ? o.OrderId.Substring(0, 8).ToUpper() : o.OrderId.ToUpper())) : o.TrackingNumber,
        trackingUrl = o.TrackingUrl,
        estimatedDeliveryDate = o.EstimatedDeliveryDate.HasValue ? o.EstimatedDeliveryDate.Value.ToString("MMM dd, yyyy") : o.CreatedAt.AddDays(14).ToString("MMM dd, yyyy"),
        createdAt = o.CreatedAt.ToString("MMM dd, yyyy"),
        customerEmail = o.CustomerEmail,
        shippingFullName = string.IsNullOrEmpty(o.ShippingFullName) ? displayName : o.ShippingFullName,
        shippingPhone = string.IsNullOrEmpty(o.ShippingPhone) ? phone : o.ShippingPhone,
        shippingStreet = string.IsNullOrEmpty(o.ShippingStreet) ? (defaultAddr?.StreetAddress ?? "124 Atelier Way") : o.ShippingStreet,
        shippingCity = string.IsNullOrEmpty(o.ShippingCity) ? (defaultAddr?.City ?? "New York") : o.ShippingCity,
        shippingState = string.IsNullOrEmpty(o.ShippingState) ? (defaultAddr?.State ?? "NY") : o.ShippingState,
        shippingPostalCode = string.IsNullOrEmpty(o.ShippingPostalCode) ? (defaultAddr?.PostalCode ?? "10001") : o.ShippingPostalCode,
        shippingCountry = string.IsNullOrEmpty(o.ShippingCountry) ? (defaultAddr?.Country ?? "United States") : o.ShippingCountry,
        paymentMethod = string.IsNullOrEmpty(o.PaymentMethod) ? "PayPal Express USD" : o.PaymentMethod,
        paymentProvider = string.IsNullOrEmpty(o.PaymentProvider) ? "PayPal" : o.PaymentProvider,
        providerOrderId = string.IsNullOrEmpty(o.ProviderOrderId) ? o.OrderId : o.ProviderOrderId,
        includesPhysicalGiaCert = o.IncludesPhysicalGiaCert,
        giaCertFeeUSD = o.GiaCertFeeUSD,
        imgUrl = "/assets/ring_1.jpg"
    }).ToList();
    var ordersJson = System.Text.Json.JsonSerializer.Serialize(ordersJsonList);
  }
  window.SAT_USER_ORDERS = @Html.Raw(ordersJson);

  let currentModalOrderId = null;
  function openOrderModal(orderId) {
    if (!window.SAT_USER_ORDERS || !window.SAT_USER_ORDERS.length) return;
    const order = window.SAT_USER_ORDERS.find(o => o.orderId === orderId);
    if (!order) return;
    currentModalOrderId = orderId;

    document.getElementById('modalOrderNumber').textContent = 'Order #' + order.orderNumber;
    document.getElementById('modalOrderDate').textContent = 'Placed on ' + order.createdAt;
    
    const statusBadge = document.getElementById('modalOrderStatusBadge');
    if (order.orderStatus === 'Delivered') {
      statusBadge.textContent = 'Delivered';
      statusBadge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold tracking-wider uppercase bg-emerald-950 text-emerald-400 border border-emerald-500/30';
      document.getElementById('modalTrackingStatusText').textContent = 'Delivered & Hand-Signed';
      document.getElementById('step4Label').textContent = '4. Delivered';
      document.getElementById('timelineBar').className = 'h-full bg-gradient-to-r from-secondary to-emerald-400 w-full transition-all duration-500';
    } else if (order.orderStatus === 'Cancelled') {
      statusBadge.textContent = 'Cancelled';
      statusBadge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold tracking-wider uppercase bg-rose-950 text-rose-400 border border-rose-500/30';
      document.getElementById('modalTrackingStatusText').textContent = 'Order Cancelled';
      document.getElementById('step4Label').textContent = 'Cancelled';
      document.getElementById('timelineBar').className = 'h-full bg-rose-500 w-full transition-all duration-500';
    } else {
      statusBadge.textContent = order.orderStatus || 'Pending';
      statusBadge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold tracking-wider uppercase bg-amber-950 text-amber-400 border border-amber-500/30';
      document.getElementById('modalTrackingStatusText').textContent = 'Handcrafting & Quality Verification';
      document.getElementById('step4Label').textContent = '4. Est. ' + order.estimatedDeliveryDate;
      document.getElementById('timelineBar').className = 'h-full bg-gradient-to-r from-secondary to-amber-400 w-2/3 transition-all duration-500';
    }

    document.getElementById('modalItemName').textContent = order.itemName;
    document.getElementById('modalItemSpecs').textContent = order.includesPhysicalGiaCert 
      ? 'Bespoke Jewelry Commission • Includes Physical GIA Hardcopy Certificate' 
      : 'Bespoke Jewelry Commission • Includes GIA/IGI Digital Certification & Presentation Box';
    document.getElementById('modalGiaPill').textContent = 'GIA #' + (order.orderId.length > 10 ? order.orderId.substring(0, 10).toUpperCase() : order.orderId);
    document.getElementById('modalItemPrice').textContent = '$' + Number(order.totalAmountUSD).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
    
    document.getElementById('modalCarrier').textContent = order.carrierName || 'DHL Express';
    document.getElementById('modalTrackingNumber').textContent = order.trackingNumber || ('DHL-' + order.orderId.substring(0, 8).toUpperCase());
    document.getElementById('modalDeliveryDate').textContent = order.orderStatus === 'Delivered' ? 'Delivered (' + order.createdAt + ')' : ('Est. ' + order.estimatedDeliveryDate);

    document.getElementById('modalShipName').textContent = order.shippingFullName || '@displayName';
    document.getElementById('modalShipStreet').textContent = order.shippingStreet || '124 Atelier Way';
    document.getElementById('modalShipCityState').textContent = (order.shippingCity || 'New York') + ', ' + (order.shippingState || 'NY') + ' ' + (order.shippingPostalCode || '10001');
    document.getElementById('modalShipCountry').textContent = order.shippingCountry || 'United States';
    document.getElementById('modalShipPhone').textContent = order.shippingPhone || '@phone';

    const subtotal = order.totalAmountUSD - (order.giaCertFeeUSD || 0);
    document.getElementById('modalSubtotal').textContent = '$' + Number(subtotal > 0 ? subtotal : order.totalAmountUSD).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    document.getElementById('modalGiaFee').textContent = order.giaCertFeeUSD > 0 ? ('$' + Number(order.giaCertFeeUSD).toFixed(2)) : (order.includesPhysicalGiaCert ? 'Included ($0.00)' : 'N/A');
    document.getElementById('modalTotalPaid').textContent = '$' + Number(order.totalAmountUSD).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
    document.getElementById('modalPayMethod').textContent = 'Payment Method: ' + (order.paymentMethod || 'PayPal Express USD');

    const giaCertLink = document.getElementById('modalGiaCertLink');
    if (giaCertLink) {
      giaCertLink.href = '/Product/Certificate?orderId=' + encodeURIComponent(order.orderId);
    }

    document.getElementById('orderDetailsModal').style.display = 'flex';
  }

  function closeOrderModal() {
    document.getElementById('orderDetailsModal').style.display = 'none';
  }

  function reviewModalOrder() {
    if (!currentModalOrderId) return;
    const order = window.SAT_USER_ORDERS.find(o => o.orderId === currentModalOrderId);
    if (order) {
      closeOrderModal();
      promptProductReview(order.orderId, order.itemName, '/assets/ring_1.jpg');
    }
  }

