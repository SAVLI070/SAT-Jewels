@model SAT1.Models.User
@{
    Layout = null;
    ViewData["Title"] = "Client Account & Vault — SAT Jewel";
    var user = Model;
    var rawName = user?.FullName ?? User.Identity?.Name ?? "Sahil";
    string displayName = !string.IsNullOrWhiteSpace(rawName) && rawName.Trim() != "@" ? rawName.Trim() : "Sahil";
    var email = user?.Email ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "s@gmail.com";
    var phone = !string.IsNullOrWhiteSpace(user?.Phone) ? user.Phone : "+1 (812) 829-1686";
    var initial = (!string.IsNullOrWhiteSpace(displayName) ? displayName.Substring(0, 1) : "S").ToUpper();

    var orders = ViewBag.Orders as List<SAT1.Models.Order> ?? new List<SAT1.Models.Order>();
    var addresses = ViewBag.Addresses as List<SAT1.Models.UserAddress> ?? new List<SAT1.Models.UserAddress>();
    var wishlist = ViewBag.Wishlist as List<SAT1.Models.WishlistItem> ?? new List<SAT1.Models.WishlistItem>();

    var defaultAddr = addresses.FirstOrDefault(a => a.IsDefault) ?? addresses.FirstOrDefault();
    var orderCount = orders.Count;
    var wishlistCount = wishlist.Count;
    var addressCount = addresses.Count;

    var activeOrders = orders.Where(o => o.OrderStatus != "Delivered" && o.OrderStatus != "Cancelled").ToList();
    var pastOrders = orders.Where(o => o.OrderStatus == "Delivered" || o.OrderStatus == "Cancelled").ToList();
}
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <meta content="web_dashboard" name="shell-type">
  <title>@ViewData["Title"]</title>
  <link rel="icon" type="image/png" href="/assets/sat_emblem_clean.png" />
  <link rel="shortcut icon" type="image/png" href="/assets/sat_emblem_clean.png" />
  <link rel="apple-touch-icon" href="/assets/sat_emblem_clean.png" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
