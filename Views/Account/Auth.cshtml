@{
    Layout = null;
    var initialMode = (ViewData["InitialMode"] ?? "signin").ToString();
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
    var error = ViewBag.ErrorMessage as string;
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In & Sign Up — SAT Jewel</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <link rel="stylesheet" href="~/css/style.css" />
  <style>
    body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: radial-gradient(circle at 50% 30%, #0c1833 0%, #030712 100%);
      font-family: var(--font-sans);
      color: var(--cream-ivory);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow-x: hidden;
    }

    .auth-bg-slider {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: 0.18;
      background: url('/assets/sat_jewels_shop_bg.jpg') center/cover no-repeat;
      filter: blur(8px);
    }

    .auth-wrapper {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 480px;
      padding: 24px 20px;
      box-sizing: border-box;
    }

    .auth-card {
      background: rgba(8, 17, 34, 0.82);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border: 1px solid rgba(212, 178, 112, 0.28);
      border-radius: var(--radius-2xl);
      padding: 36px 32px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(212, 178, 112, 0.12);
      animation: authCardFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes authCardFadeIn {
      from { opacity: 0; transform: translateY(20px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .auth-brand-head {
      text-align: center;
      margin-bottom: 24px;
    }

    .auth-logo-badge {
      width: 60px;
      height: 60px;
      margin: 0 auto 12px;
      background: radial-gradient(circle, #0f1e36 0%, #081120 100%);
      border: 1.5px solid #b45309;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 25px rgba(212, 178, 112, 0.35);
    }

    .auth-logo-badge img {
      width: 80%;
      height: 80%;
      object-fit: contain;
    }

    .auth-title {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 700;
      color: var(--cream-ivory);
      margin: 0 0 4px;
    }

    .auth-title span {
      color: var(--champagne-gold);
      font-style: italic;
    }

    .auth-sub {
      font-size: 13px;
      color: var(--taupe-beige);
      margin: 0;
    }

    /* Auth Switcher Tabs */
    .auth-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-full);
      padding: 4px;
      margin-bottom: 24px;
    }

    .auth-tab-btn {
      padding: 10px 0;
      border: none;
      background: transparent;
      color: var(--taupe-beige);
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 700;
      border-radius: var(--radius-full);
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .auth-tab-btn.active {
      background: var(--champagne-gold);
      color: #060d0a;
      box-shadow: 0 4px 14px rgba(212, 178, 112, 0.4);
    }

    .auth-form-pane {
      display: none;
    }

    .auth-form-pane.active {
      display: block;
      animation: tabFadeIn 0.35s ease forwards;
    }

    @@keyframes tabFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .auth-input-group {
      margin-bottom: 16px;
    }

    .auth-label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: var(--champagne-gold);
      margin-bottom: 6px;
      letter-spacing: 0.02em;
    }

    .auth-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .auth-input-wrap i {
      position: absolute;
      left: 14px;
      color: #94a3b8;
      font-size: 14px;
      pointer-events: none;
    }

    .auth-input {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px 12px 40px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: var(--radius-md);
      color: #ffffff;
      font-size: 14px;
      outline: none;
      transition: all 0.25s ease;
    }

    .auth-input:focus {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--champagne-gold);
      box-shadow: 0 0 12px rgba(212, 178, 112, 0.3);
    }

    .auth-row-between {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      color: var(--taupe-beige);
      margin-bottom: 20px;
    }

    .auth-row-between a {
      color: var(--champagne-gold);
      text-decoration: none;
      transition: color 0.2s;
    }

    .auth-row-between a:hover {
      text-decoration: underline;
    }

    .btn-auth-submit {
      width: 100%;
      padding: 13px 0;
      border: none;
      border-radius: var(--radius-full);
      background: linear-gradient(135deg, #d4b270 0%, #b45309 100%);
      color: #060d0a;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 4px 20px rgba(212, 178, 112, 0.35);
    }

    .btn-auth-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 28px rgba(212, 178, 112, 0.6);
      background: linear-gradient(135deg, #fcebc5 0%, #d4b270 100%);
    }

    .auth-divider {
      display: flex;
      align-items: center;
      margin: 22px 0 18px;
      color: #64748b;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .auth-divider::before, .auth-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.12);
    }

    .auth-divider span {
      padding: 0 12px;
    }

    .auth-social-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .btn-social {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-md);
      color: #ffffff;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn-social:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
    }

    .auth-foot-back {
      text-align: center;
      margin-top: 24px;
    }

    .auth-foot-back a {
      color: var(--taupe-beige);
      font-size: 13px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: color 0.2s;
    }

    .auth-foot-back a:hover {
      color: var(--champagne-gold);
    }

    .auth-alert-error {
      background: rgba(220, 38, 38, 0.15);
      border: 1px solid rgba(248, 113, 113, 0.35);
      color: #fca5a5;
      padding: 10px 14px;
      border-radius: var(--radius-md);
      font-size: 13px;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
  </style>
</head>

<body>
  <div class="auth-bg-slider"></div>

  <div class="auth-wrapper">
    <div class="auth-card">
      <!-- Logo Header -->
      <div class="auth-brand-head">
        <a href="/" style="text-decoration:none;">
          <div class="auth-logo-badge">
            <img src="~/assets/sat_emblem_clean.png" alt="SAT Jewel Emblem" />
          </div>
          <h1 class="auth-title">SAT <span>Jewel</span></h1>
          <p class="auth-sub">Client Sanctuary & Bespoke Portal</p>
        </a>
      </div>

      @if (!string.IsNullOrEmpty(error))
      {
        <div class="auth-alert-error">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span>@error</span>
        </div>
      }

      <!-- Tab Switchers: Sign In vs Sign Up -->
      <div class="auth-tabs">
        <button type="button" class="auth-tab-btn @(initialMode == "signin" ? "active" : "")" id="tabSignInBtn" onclick="switchAuthTab('signin')">
          Sign In
        </button>
        <button type="button" class="auth-tab-btn @(initialMode == "signup" ? "active" : "")" id="tabSignUpBtn" onclick="switchAuthTab('signup')">
          Sign Up
        </button>
      </div>

      <!-- 1. SIGN IN FORM -->
      <div class="auth-form-pane @(initialMode == "signin" ? "active" : "")" id="paneSignIn">
        <form method="post" action="/Account/HandleSignIn">
          <input type="hidden" name="returnUrl" value="@returnUrl" />

          <div class="auth-input-group">
            <label class="auth-label">Email or Username</label>
            <div class="auth-input-wrap">
              <i class="fa-regular fa-envelope"></i>
              <input type="text" name="email" class="auth-input" placeholder="e.g. client@satjewels.com" required />
            </div>
          </div>

          <div class="auth-input-group">
            <label class="auth-label">Password</label>
            <div class="auth-input-wrap">
              <i class="fa-solid fa-lock"></i>
              <input type="password" name="password" class="auth-input" placeholder="••••••••" required />
            </div>
          </div>

          <div class="auth-row-between">
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
              <input type="checkbox" name="rememberMe" value="true" checked />
              <span>Remember me</span>
            </label>
            <a href="mailto:concierge@satjewels.com?subject=Password%20Reset%20Request">Forgot password?</a>
          </div>

          <button type="submit" class="btn-auth-submit">
            <i class="fa-solid fa-right-to-bracket"></i> Sign In to Account
          </button>
        </form>

        <div class="auth-divider">
          <span>Or Continue With</span>
        </div>

        <div class="auth-social-grid">
          <button type="button" class="btn-social" onclick="alert('Google authentication connected for SAT Jewel.')">
            <i class="fa-brands fa-google" style="color:#ea4335;"></i> Google
          </button>
          <button type="button" class="btn-social" onclick="alert('Apple ID authentication connected for SAT Jewel.')">
            <i class="fa-brands fa-apple"></i> Apple ID
          </button>
        </div>
      </div>

      <!-- 2. SIGN UP FORM -->
      <div class="auth-form-pane @(initialMode == "signup" ? "active" : "")" id="paneSignUp">
        <form method="post" action="/Account/HandleSignUp">
          <div class="auth-input-group">
            <label class="auth-label">Full Name *</label>
            <div class="auth-input-wrap">
              <i class="fa-regular fa-user"></i>
              <input type="text" name="fullName" class="auth-input" placeholder="e.g. Eleanor Vance" required />
            </div>
          </div>

          <div class="auth-input-group">
            <label class="auth-label">Email Address *</label>
            <div class="auth-input-wrap">
              <i class="fa-regular fa-envelope"></i>
              <input type="email" name="email" class="auth-input" placeholder="e.g. eleanor@example.com" required />
            </div>
          </div>

          <div class="auth-input-group">
            <label class="auth-label">Phone Number (Optional)</label>
            <div class="auth-input-wrap">
              <i class="fa-solid fa-phone"></i>
              <input type="tel" name="phone" class="auth-input" placeholder="+1 (555) 000-0000" />
            </div>
          </div>

          <div class="auth-input-group">
            <label class="auth-label">Create Password *</label>
            <div class="auth-input-wrap">
              <i class="fa-solid fa-lock"></i>
              <input type="password" name="password" class="auth-input" placeholder="At least 6 characters" minlength="6" required />
            </div>
          </div>

          <div class="auth-input-group">
            <label class="auth-label">Confirm Password *</label>
            <div class="auth-input-wrap">
              <i class="fa-solid fa-shield-check"></i>
              <input type="password" name="confirmPassword" class="auth-input" placeholder="Repeat password" required />
            </div>
          </div>

          <div style="font-size:12px;color:var(--taupe-beige);margin-bottom:18px;line-height:1.5;">
            By signing up, you agree to SAT Jewel's GIA Authenticity Guidelines and Privacy Policy.
          </div>

          <button type="submit" class="btn-auth-submit">
            <i class="fa-solid fa-sparkles"></i> Create VIP Account
          </button>
        </form>
      </div>
    </div>

    <!-- Back to Storefront Link -->
    <div class="auth-foot-back">
      <a href="/">
        <i class="fa-solid fa-arrow-left"></i> Return to SAT Jewel Storefront
      </a>
    </div>
  </div>

  <script>
    function switchAuthTab(tab) {
      const tabIn = document.getElementById('tabSignInBtn');
      const tabUp = document.getElementById('tabSignUpBtn');
      const paneIn = document.getElementById('paneSignIn');
      const paneUp = document.getElementById('paneSignUp');

      if (tab === 'signin') {
        tabIn.classList.add('active');
        tabUp.classList.remove('active');
        paneIn.classList.add('active');
        paneUp.classList.remove('active');
      } else {
        tabUp.classList.add('active');
        tabIn.classList.remove('active');
        paneUp.classList.add('active');
        paneIn.classList.remove('active');
      }
    }
  </script>
</body>

</html>
