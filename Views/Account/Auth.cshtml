@{
    Layout = null;
    var initialMode = (ViewData["InitialMode"] ?? "signin").ToString();
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
    var error = ViewBag.ErrorMessage as string;
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Client Sanctuary — SAT Jewel Haute Joaillerie</title>

  <!-- Favicon / Tab Icons -->
  <link rel="icon" type="image/png" href="/assets/sat_logo_transparent.png" />
  <link rel="shortcut icon" type="image/png" href="/assets/sat_logo_transparent.png" />
  <link rel="apple-touch-icon" href="/assets/sat_logo_transparent.png" />

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <style>
    :root {
      --ink: #f1eee8;
      --muted: rgba(241, 238, 232, 0.65);
      --gold: #d4b878;
      --gold-dark: #b8944d;
      --bg: #06070a;
      --glass: rgba(12, 11, 15, 0.88);
      --stroke: rgba(212, 184, 120, 0.35);
      --font-serif-luxury: 'Playfair Display', Georgia, serif;
      --font-sans-luxury: 'Plus Jakarta Sans', system-ui, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow-x: hidden;
      background: var(--bg);
      font-family: var(--font-sans-luxury);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    /* FULLSCREEN LUXURY DIAMOND NECKLACE BACKGROUND */
    .sat-auth-stage {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      background: #000000 url('/assets/auth_luxury_highjewelry.jpg') center center / cover no-repeat;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    /* Artistic Vignette Scrim to Enhance Contrast on the Right Side */
    .sat-auth-stage::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 25% 45%, rgba(0,0,0,0.02) 0%, rgba(6,7,10,0.45) 60%, rgba(6,7,10,0.92) 100%),
                  linear-gradient(90deg, rgba(6,7,10,0.1) 0%, rgba(6,7,10,0.3) 45%, rgba(6,7,10,0.85) 80%, rgba(6,7,10,0.96) 100%);
      pointer-events: none;
      z-index: 2;
    }

    /* Top Left Return to Storefront Button */
    .sat-top-left-back {
      position: fixed;
      top: 28px;
      left: 28px;
      z-index: 20;
    }
    .sat-back-pill-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 20px;
      background: rgba(14, 13, 16, 0.75);
      border: 1px solid rgba(212, 184, 120, 0.35);
      border-radius: 100px;
      color: #ffffff;
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-decoration: none;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
      transition: all 0.25s ease;
    }
    .sat-back-pill-btn i {
      color: var(--gold);
      font-size: 11px;
      transition: transform 0.25s ease;
    }
    .sat-back-pill-btn:hover {
      background: rgba(212, 184, 120, 0.2);
      border-color: var(--gold);
      color: #ffffff;
      transform: translateX(-3px);
    }
    .sat-back-pill-btn:hover i {
      transform: translateX(-3px);
    }

    /* Top Left Haute Joaillerie Tagline */
    .sat-brand-floating-tag {
      position: fixed;
      bottom: 32px;
      left: 32px;
      z-index: 10;
      max-width: 420px;
    }
    .sat-tag-eyebrow {
      font-size: 10.5px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 700;
      margin-bottom: 6px;
    }
    .sat-tag-title {
      font-family: var(--font-serif-luxury);
      font-size: clamp(22px, 2.5vw, 32px);
      color: #ffffff;
      line-height: 1.25;
      font-weight: 600;
    }
    .sat-tag-desc {
      font-size: 12.5px;
      color: rgba(241, 238, 232, 0.7);
      margin-top: 6px;
      line-height: 1.5;
    }

    /* CORNER-DOCKED LUXURY AUTH CARD (BOTTOM-RIGHT) */
    .sat-auth-card-wrap {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 470px;
      margin-right: clamp(24px, 4.5vw, 64px);
      padding: 20px 0;
      max-height: 96vh;
      overflow-y: auto;
      scrollbar-width: none;
    }
    .sat-auth-card-wrap::-webkit-scrollbar {
      display: none;
    }

    .sat-luxury-card {
      background: var(--glass);
      backdrop-filter: blur(32px);
      -webkit-backdrop-filter: blur(32px);
      border: 1px solid var(--stroke);
      border-radius: 26px;
      padding: clamp(28px, 3.5vw, 38px) clamp(24px, 3vw, 34px);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.92), 0 0 45px rgba(212, 184, 120, 0.15);
      position: relative;
    }

    /* Card Header with Golden Logo */
    .sat-card-brand-header {
      text-align: center;
      margin-bottom: 22px;
    }
    .sat-card-logo-slot {
      width: 52px;
      height: 52px;
      margin: 0 auto 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(24, 22, 28, 0.85);
      border: 1px solid rgba(212, 184, 120, 0.4);
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(212, 184, 120, 0.25);
    }
    .sat-card-logo-slot img {
      height: 32px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 2px 6px rgba(212, 184, 120, 0.4));
    }
    .sat-card-title {
      font-family: var(--font-serif-luxury);
      font-size: 23px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: 0.02em;
      line-height: 1.2;
    }
    .sat-card-title span {
      color: var(--gold);
      font-style: italic;
    }
    .sat-card-sub {
      font-size: 11.5px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      margin-top: 4px;
    }

    /* PILL TAB SWITCHER (Sign In vs Sign Up) */
    .sat-auth-pill-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(241, 238, 232, 0.12);
      border-radius: 100px;
      padding: 4px;
      margin-bottom: 22px;
      position: relative;
    }
    .sat-tab-btn {
      background: transparent;
      border: none;
      color: rgba(241, 238, 232, 0.7);
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 0.04em;
      padding: 9px 0;
      border-radius: 100px;
      cursor: pointer;
      transition: all 0.25s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .sat-tab-btn.active {
      background: linear-gradient(135deg, #d4b878 0%, #b8944d 100%);
      color: #06070a;
      box-shadow: 0 4px 16px rgba(212, 184, 120, 0.4);
    }

    /* Inputs and Labels */
    .sat-auth-field {
      margin-bottom: 14px;
    }
    .sat-field-label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      color: var(--gold);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .sat-input-shell {
      position: relative;
      display: flex;
      align-items: center;
    }
    .sat-input-shell i.prefix-icon {
      position: absolute;
      left: 15px;
      color: rgba(212, 184, 120, 0.75);
      font-size: 13px;
      pointer-events: none;
    }
    .sat-input-ctrl {
      width: 100%;
      padding: 12px 14px 12px 42px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(241, 238, 232, 0.16);
      border-radius: 12px;
      color: #ffffff;
      font-size: 13.5px;
      font-family: var(--font-sans-luxury);
      outline: none;
      transition: all 0.25s ease;
    }
    .sat-input-ctrl::placeholder {
      color: rgba(241, 238, 232, 0.32);
    }
    .sat-input-ctrl:focus {
      background: rgba(255, 255, 255, 0.08);
      border-color: var(--gold);
      box-shadow: 0 0 16px rgba(212, 184, 120, 0.35);
    }
    .sat-toggle-pwd {
      position: absolute;
      right: 14px;
      background: none;
      border: none;
      color: rgba(241, 238, 232, 0.5);
      font-size: 13px;
      cursor: pointer;
      padding: 0;
    }
    .sat-toggle-pwd:hover {
      color: var(--gold);
    }

    .sat-auth-options-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 18px;
    }
    .sat-auth-options-row a {
      color: var(--gold);
      text-decoration: none;
      transition: color 0.2s;
    }
    .sat-auth-options-row a:hover {
      text-decoration: underline;
      color: #ffffff;
    }

    /* Champagne Gold Primary Action Button */
    .btn-sat-vault-action {
      width: 100%;
      padding: 13px 0;
      border: none;
      border-radius: 100px;
      background: linear-gradient(135deg, #d4b878 0%, #b8944d 100%);
      color: #06070a;
      font-size: 13.5px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 6px 25px rgba(212, 184, 120, 0.45);
    }
    .btn-sat-vault-action:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(212, 184, 120, 0.65);
      background: linear-gradient(135deg, #f1dfae 0%, #d4b878 100%);
    }

    .sat-auth-divider {
      display: flex;
      align-items: center;
      margin: 18px 0 14px;
      color: rgba(241, 238, 232, 0.4);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }
    .sat-auth-divider::before, .sat-auth-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(241, 238, 232, 0.1);
    }
    .sat-auth-divider span {
      padding: 0 10px;
    }

    .sat-social-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .btn-sat-social {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 9.5px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(241, 238, 232, 0.12);
      border-radius: 10px;
      color: #ffffff;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-sat-social:hover {
      background: rgba(212, 184, 120, 0.14);
      border-color: rgba(212, 184, 120, 0.4);
      transform: translateY(-1px);
    }

    .sat-auth-alert {
      background: rgba(220, 38, 38, 0.15);
      border: 1px solid rgba(248, 113, 113, 0.35);
      color: #fca5a5;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 12px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Form Panes Toggle */
    .sat-pane {
      display: none;
    }
    .sat-pane.active {
      display: block;
      animation: fadeInPane 0.35s ease;
    }
    @@keyframes fadeInPane {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .sat-input-ctrl:-webkit-autofill,
    .sat-input-ctrl:-webkit-autofill:hover, 
    .sat-input-ctrl:-webkit-autofill:focus {
      -webkit-text-fill-color: #ffffff !important;
      -webkit-box-shadow: 0 0 0px 1000px #16141a inset !important;
      box-shadow: 0 0 0px 1000px #16141a inset !important;
      transition: background-color 5000s ease-in-out 0s;
    }

    /* MOBILE RESPONSIVE OVERRIDES */
    @@media (max-width: 900px) {
      html, body {
        min-height: 100%;
        height: auto;
        overflow-y: auto;
      }
      .sat-auth-stage {
        position: relative;
        min-height: 100vh;
        height: auto;
        width: 100%;
        background-attachment: fixed;
        background-position: 28% top;
        background-size: cover;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        padding: 76px 16px 40px;
        box-sizing: border-box;
      }
      .sat-auth-stage::before {
        background: radial-gradient(circle at 50% 20%, rgba(0,0,0,0.1) 0%, rgba(6,7,10,0.7) 45%, rgba(6,7,10,0.96) 90%);
      }
      .sat-brand-floating-tag {
        display: none;
      }
      .sat-auth-card-wrap {
        margin: 0 auto;
        max-width: 440px;
        width: 100%;
        padding: 0;
        max-height: none;
        overflow: visible;
      }
      .sat-luxury-card {
        padding: 26px 20px 30px;
        border-radius: 22px;
      }
      .sat-top-left-back {
        top: 16px;
        left: 16px;
        position: fixed;
        z-index: 100;
      }
      .sat-input-ctrl {
        font-size: 15px; /* Prevents iOS auto-zoom on input focus */
      }
    }
  </style>
</head>

<body>

  <!-- Fullscreen Luxury Stage -->
  <div class="sat-auth-stage">

    <!-- Top Left Floating Back Button -->
    <div class="sat-top-left-back">
      <a href="/" class="sat-back-pill-btn">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Return to Storefront</span>
      </a>
    </div>

    <!-- Bottom Left Haute Joaillerie Tagline (Desktop only) -->
    <div class="sat-brand-floating-tag">
      <div class="sat-tag-eyebrow">SAT JEWEL · HAUTE JOAILLERIE</div>
      <h2 class="sat-tag-title">Heirloom Brilliance,<br/>Crafted for Eternity.</h2>
      <p class="sat-tag-desc">100% Conflict-Free IGI &amp; GIA Certified High-Jewelry Creations.</p>
    </div>

    <!-- CORNER-DOCKED LUXURY AUTH CARD (Bottom-Right / Right Side) -->
    <div class="sat-auth-card-wrap">
      <div class="sat-luxury-card">

        <!-- Card Header -->
        <div class="sat-card-brand-header">
          <div class="sat-card-logo-slot">
            <img src="/assets/sat_logo_transparent.png" alt="SAT Jewel Official Logo" />
          </div>
          <h1 class="sat-card-title">SAT <span style="color:var(--gold);">Jewel</span></h1>
          <div class="sat-card-sub">VIP Vault Sanctuary</div>
        </div>

        <!-- Tab Switcher -->
        <div class="sat-auth-pill-tabs">
          <button type="button" class="sat-tab-btn @(initialMode != "signup" ? "active" : "")" id="tabSignInBtn" onclick="switchAuthTab('signin')">
            <i class="fa-solid fa-right-to-bracket"></i> Sign In
          </button>
          <button type="button" class="sat-tab-btn @(initialMode == "signup" ? "active" : "")" id="tabSignUpBtn" onclick="switchAuthTab('signup')">
            <i class="fa-solid fa-user-plus"></i> Create VIP Account
          </button>
        </div>

        <!-- 1. SIGN IN PANE -->
        <div class="sat-pane @(initialMode != "signup" ? "active" : "")" id="paneSignIn">
          <form method="post" action="/Account/HandleSignIn">
            @if (!string.IsNullOrEmpty(error) && initialMode != "signup")
            {
              <div class="sat-auth-alert">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>@error</span>
              </div>
            }

            <div class="sat-auth-field">
              <label class="sat-field-label">Email or Username</label>
              <div class="sat-input-shell">
                <i class="fa-regular fa-envelope prefix-icon"></i>
                <input type="text" name="email" class="sat-input-ctrl" placeholder="client@satjewels.com" required />
              </div>
            </div>

            <div class="sat-auth-field">
              <label class="sat-field-label">Vault Password</label>
              <div class="sat-input-shell">
                <i class="fa-solid fa-lock prefix-icon"></i>
                <input type="password" name="password" id="inputSignInPassword" class="sat-input-ctrl" placeholder="••••••••" required />
                <button type="button" class="sat-toggle-pwd" onclick="togglePwdVisibility('inputSignInPassword', this)" aria-label="Toggle Password">
                  <i class="fa-regular fa-eye"></i>
                </button>
              </div>
            </div>

            <div class="sat-auth-options-row">
              <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
                <input type="checkbox" name="rememberMe" value="true" style="accent-color: var(--gold);" />
                <span>Remember me</span>
              </label>
              <a href="mailto:concierge@satjewels.com?subject=Password%20Reset%20Request">Forgot password?</a>
            </div>

            <button type="submit" class="btn-sat-vault-action">
              <i class="fa-solid fa-gem"></i> Sign In to Vault
            </button>
          </form>

          <div class="sat-auth-divider">
            <span>Or Continue With</span>
          </div>

          <div class="sat-social-grid">
            <button type="button" class="btn-sat-social" onclick="alert('Google authentication connected for SAT Jewel.')">
              <i class="fa-brands fa-google" style="color:#ea4335;"></i> Google
            </button>
            <button type="button" class="btn-sat-social" onclick="alert('Apple ID authentication connected for SAT Jewel.')">
              <i class="fa-brands fa-apple"></i> Apple ID
            </button>
          </div>
        </div>

        <!-- 2. SIGN UP PANE -->
        <div class="sat-pane @(initialMode == "signup" ? "active" : "")" id="paneSignUp">
          <form method="post" action="/Account/HandleSignUp">
            @if (!string.IsNullOrEmpty(error) && initialMode == "signup")
            {
              <div class="sat-auth-alert">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>@error</span>
              </div>
            }

            <div class="sat-auth-field">
              <label class="sat-field-label">Full Name *</label>
              <div class="sat-input-shell">
                <i class="fa-regular fa-user prefix-icon"></i>
                <input type="text" name="fullName" class="sat-input-ctrl" placeholder="e.g. Eleanor Vance" pattern="^[a-zA-Z\s]{2,50}$" title="Full Name can only contain letters and spaces." required />
              </div>
            </div>

            <div class="sat-auth-field">
              <label class="sat-field-label">Email Address *</label>
              <div class="sat-input-shell">
                <i class="fa-regular fa-envelope prefix-icon"></i>
                <input type="email" name="email" class="sat-input-ctrl" placeholder="eleanor@example.com" required />
              </div>
            </div>

            <div class="sat-auth-field">
              <label class="sat-field-label">Mobile Phone (Optional)</label>
              <div class="sat-input-shell">
                <i class="fa-solid fa-phone prefix-icon"></i>
                <input type="tel" name="phone" class="sat-input-ctrl" placeholder="+1 (555) 000-0000" pattern="^(\+?1\s*[-\.]?)?\(?[2-9]\d{2}\)?\s*[-\.]?\s*\d{3}\s*[-\.]?\s*\d{4}$" title="Mobile number must be a valid 10-digit USA phone number." />
              </div>
            </div>

            <div class="sat-auth-field">
              <label class="sat-field-label">Create Password *</label>
              <div class="sat-input-shell">
                <i class="fa-solid fa-lock prefix-icon"></i>
                <input type="password" name="password" id="inputSignUpPassword" class="sat-input-ctrl" placeholder="Min 8 chars, 1 letter, 1 symbol" minlength="8" pattern="^(?=.*[a-z])(?=.*[A-Za-z])(?=.*[\W_]).{8,}$" title="Password must be at least 8 characters with at least 1 lowercase letter, 1 alphabet letter, and 1 special character." required />
                <button type="button" class="sat-toggle-pwd" onclick="togglePwdVisibility('inputSignUpPassword', this)" aria-label="Toggle Password">
                  <i class="fa-regular fa-eye"></i>
                </button>
              </div>
            </div>

            <div class="sat-auth-field">
              <label class="sat-field-label">Confirm Password *</label>
              <div class="sat-input-shell">
                <i class="fa-solid fa-shield-halved prefix-icon"></i>
                <input type="password" name="confirmPassword" id="inputSignUpConfirmPassword" class="sat-input-ctrl" placeholder="Repeat password" required />
              </div>
            </div>

            <button type="submit" class="btn-sat-vault-action" style="margin-top:10px;">
              <i class="fa-solid fa-sparkles"></i> Join SAT VIP Vault
            </button>
          </form>

          <div class="sat-auth-divider">
            <span>Or Connect With</span>
          </div>

          <div class="sat-social-grid">
            <button type="button" class="btn-sat-social" onclick="alert('Google authentication connected for SAT Jewel.')">
              <i class="fa-brands fa-google" style="color:#ea4335;"></i> Google
            </button>
            <button type="button" class="btn-sat-social" onclick="alert('Apple ID authentication connected for SAT Jewel.')">
              <i class="fa-brands fa-apple"></i> Apple ID
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script>
    function switchAuthTab(mode) {
      const paneSignIn = document.getElementById('paneSignIn');
      const paneSignUp = document.getElementById('paneSignUp');
      const tabSignIn = document.getElementById('tabSignInBtn');
      const tabSignUp = document.getElementById('tabSignUpBtn');

      if (mode === 'signup') {
        paneSignIn.classList.remove('active');
        paneSignUp.classList.add('active');
        tabSignIn.classList.remove('active');
        tabSignUp.classList.add('active');
        history.replaceState(null, '', '/Account/SignUp');
      } else {
        paneSignUp.classList.remove('active');
        paneSignIn.classList.add('active');
        tabSignUp.classList.remove('active');
        tabSignIn.classList.add('active');
        history.replaceState(null, '', '/Account/SignIn');
      }
    }

    function togglePwdVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        btn.innerHTML = '<i class="fa-regular fa-eye-slash"></i>';
      } else {
        input.type = 'password';
        btn.innerHTML = '<i class="fa-regular fa-eye"></i>';
      }
    }
  </script>
</body>
</html>
