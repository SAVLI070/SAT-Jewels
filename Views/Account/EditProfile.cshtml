@model SAT1.Models.User
@{
    Layout = null;
    ViewData["Title"] = "Personal Information & Profile Settings — SAT Jewel";
    var user = Model;
    var rawName = user?.FullName ?? User.Identity?.Name ?? "Sahil Khurana";
    string displayName = !string.IsNullOrWhiteSpace(rawName) && rawName.Trim() != "@" ? rawName.Trim() : "Sahil Khurana";
    var nameParts = displayName.Split(' ');
    var firstName = nameParts.FirstOrDefault() ?? "Sahil";
    var lastName = nameParts.Length > 1 ? string.Join(" ", nameParts.Skip(1)) : "";
    var email = user?.Email ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "s@gmail.com";
    var phone = !string.IsNullOrWhiteSpace(user?.Phone) ? user.Phone : "+1 (812) 829-1686";
    var initial = (!string.IsNullOrWhiteSpace(displayName) ? displayName.Substring(0, 1) : "S").ToUpper();
}
