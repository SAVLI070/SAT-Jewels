<script>
  // Toggle Sidebar Collapse / Expand
  function toggleSidebar() {
    const sidebar = document.getElementById('accountSidebar');
    const mainCanvas = document.getElementById('accountMainCanvas');
    const topHeader = document.getElementById('accountTopHeader');
    const btnExpand = document.getElementById('btnExpandSidebar');

    const isCollapsed = sidebar.classList.contains('-translate-x-full');
    if (isCollapsed) {
      sidebar.classList.remove('-translate-x-full');
      mainCanvas.classList.add('pl-72');
      mainCanvas.classList.remove('pl-0');
      topHeader.classList.add('left-72');
      topHeader.classList.remove('left-0');
      if (btnExpand) btnExpand.classList.add('hidden');
      localStorage.setItem('sat_sidebar_collapsed', 'false');
    } else {
      sidebar.classList.add('-translate-x-full');
      mainCanvas.classList.remove('pl-72');
      mainCanvas.classList.add('pl-0');
      topHeader.classList.remove('left-72');
      topHeader.classList.add('left-0');
      if (btnExpand) btnExpand.classList.remove('hidden');
      localStorage.setItem('sat_sidebar_collapsed', 'true');
    }
  }

  window.addEventListener('DOMContentLoaded', () => {
    if (localStorage.getItem('sat_sidebar_collapsed') === 'true') {
      toggleSidebar();
    }
  });

  async function handleSaveProfile() {
    const saveBtn = document.getElementById('btnSaveProfile');
    const fName = document.getElementById('firstName').value.trim();
    const lName = document.getElementById('lastName').value.trim();
    const full = fName + (lName ? ' ' + lName : '');
    const phone = document.getElementById('phoneField').value.trim();

    const originalHtml = saveBtn ? saveBtn.innerHTML : '';
    if (saveBtn) {
      saveBtn.innerHTML = `
        <span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span>
        <span>Syncing Vault Profile...</span>
      `;
      saveBtn.disabled = true;
    }

    try {
      const res = await fetch('/Account/UpdateProfile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fullName: full, phone: phone })
      });
      const data = await res.json();
      
      const headName = document.getElementById('displayHeaderName');
      if (headName && full) headName.textContent = full;

      if (saveBtn) {
        saveBtn.innerHTML = `
          <span class="material-symbols-outlined text-[18px]">check</span>
          <span>Profile Updated</span>
        `;
        saveBtn.classList.remove('from-secondary', 'to-primary-container');
        saveBtn.classList.add('bg-tertiary-container', 'text-on-tertiary-container');

        setTimeout(() => {
          saveBtn.innerHTML = originalHtml;
          saveBtn.classList.remove('bg-tertiary-container', 'text-on-tertiary-container');
          saveBtn.classList.add('from-secondary', 'to-primary-container');
          saveBtn.disabled = false;
        }, 2200);
      }
    } catch(err) {
      if (saveBtn) {
        saveBtn.innerHTML = originalHtml;
        saveBtn.disabled = false;
      }
      alert('Profile synced locally.');
    }
  }
</script>

