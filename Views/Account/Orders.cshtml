@model List<SAT1.Models.Order>
@{
    ViewData["Title"] = "My Orders";
    var orders = Model ?? new List<SAT1.Models.Order>();
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Orders — SAT Jewel Bespoke Vault</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/style.css" />
  <style>
    body {
      background: radial-gradient(circle at 50% 20%, #16141a 0%, #06070a 100%);
      color: #ffffff;
      font-family: var(--font-sans);
      min-height: 100vh;
      margin: 0;
    }
    .ord-container {
      max-width: 1000px;
      margin: 60px auto;
      padding: 0 20px;
    }
    .ord-card {
      background: rgba(14, 13, 16, 0.88);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(212, 184, 120, 0.35);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.85);
    }
    .ord-title {
      font-family: var(--font-serif);
      font-size: 28px;
      color: #ffffff;
      margin: 0 0 6px;
    }
    .ord-sub {
      color: var(--taupe-beige);
      font-size: 14px;
      margin-bottom: 24px;
    }
    .ord-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }
    .ord-table th {
      background: rgba(10, 20, 38, 0.95);
      color: #fbbf24;
      padding: 14px;
      font-size: 12px;
      text-transform: uppercase;
      border-bottom: 1px solid rgba(212, 178, 112, 0.3);
      text-align: left;
    }
    .ord-table td {
      padding: 16px 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 14px;
    }
    .badge-status {
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      background: rgba(74, 222, 128, 0.15);
      border: 1px solid #4ade80;
      color: #4ade80;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-track-order {
      background: linear-gradient(135deg, #d4b270 0%, #b45309 100%);
      color: #ffffff;
      padding: 7px 16px;
      border-radius: 8px;
      font-size: 12.5px;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 12px rgba(180, 83, 9, 0.25);
    }
    .btn-track-order:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(180, 83, 9, 0.4);
      color: #ffffff;
    }
  </style>
</head>
<body>
  <div class="ord-container">
    <div style="margin-bottom: 20px;">
      <a href="/" style="color: var(--champagne-gold); text-decoration: none; font-size: 14px;"><i class="fa-solid fa-arrow-left"></i> Back to Storefront</a>
    </div>
    <div class="ord-card">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 24px;">
        <div>
          <h1 class="ord-title" style="margin: 0;">My Orders</h1>
          <p class="ord-sub" style="margin: 4px 0 0;">Track your GIA certified jewelry purchases, shipping, and delivery status in real-time.</p>
        </div>
        <a href="/Order/Track" class="btn-primary" style="padding: 9px 18px; font-size: 13px; text-decoration: none; border-radius: 10px; display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-magnifying-glass-location"></i> Direct Tracking Lookup
        </a>
      </div>

      @if (!orders.Any())
      {
        <div style="text-align:center; padding: 50px 20px;">
          <i class="fa-solid fa-box-open" style="font-size:48px; color:var(--champagne-gold); margin-bottom:16px;"></i>
          <h3 style="margin:0 0 8px; font-family:var(--font-serif);">No Orders Found</h3>
          <p style="color:var(--taupe-beige); font-size:14px; margin-bottom:24px;">Explore our catalog to place your first bespoke jewelry order.</p>
          <a href="/Product" class="btn-primary" style="display:inline-flex; padding:12px 28px; border-radius:30px; text-decoration:none;"><i class="fa-solid fa-gem"></i> Shop Jewelry Catalog</a>
        </div>
      }
      else
      {
        <div class="table-responsive" style="overflow-x:auto;">
          <table class="ord-table">
            <thead>
              <tr>
                <th>Order Reference</th>
                <th>Item Purchased</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Order Date</th>
                <th style="text-align: right;">Live Tracking</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var o in orders)
              {
                <tr>
                  <td style="font-weight:700; color:#fbbf24;">@o.OrderId</td>
                  <td>@o.ItemName</td>
                  <td style="font-weight:700;">$@o.Amount.ToString("N0") @o.Currency</td>
                  <td>
                    <span class="badge-status">
                      <i class="fa-solid fa-circle-check"></i> @o.Status
                    </span>
                  </td>
                  <td style="color:var(--taupe-beige); font-size:12px;">@o.CreatedAt.ToString("MMM dd, yyyy")</td>
                  <td style="text-align: right;">
                    <a href="/Order/Track?orderId=@Uri.EscapeDataString(o.OrderId)" class="btn-track-order">
                      <i class="fa-solid fa-truck-fast"></i> Track Shipment
                    </a>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
  </div>
</body>
</html>
