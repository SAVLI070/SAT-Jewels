@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Track Your Order - SAT Fine Jewelry";
    var errorMessage = ViewBag.ErrorMessage as string;
}

<div style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 60px 20px; background: #faf9f6;">
  <div style="background: #ffffff; border-radius: 20px; border: 1px solid #e2e8f0; max-width: 480px; width: 100%; padding: 40px 32px; box-shadow: 0 20px 40px -15px rgba(0,0,0,0.06); text-align: center;">
    
    <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(212, 178, 112, 0.15); color: #b45309; display: inline-flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 20px;">
      <i class="fa-solid fa-truck-fast"></i>
    </div>

    <h1 style="font-size: 24px; font-weight: 800; color: #0f172a; margin: 0 0 8px;">Track Your SAT Order</h1>
    <p style="font-size: 14px; color: #64748b; margin: 0 0 28px; line-height: 1.5;">Enter your Order Reference Number or AWB Tracking Number to see live journey status.</p>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
      <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 12px 16px; border-radius: 10px; font-size: 13px; margin-bottom: 20px; text-align: left;">
        <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i> @errorMessage
      </div>
    }

    <form method="get" action="/Order/Track" style="display: flex; flex-direction: column; gap: 16px; text-align: left;">
      <div>
        <label style="display: block; font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Order Number / Order ID</label>
        <input type="text" name="orderId" required placeholder="e.g. SAT-ORD-ABC12345 or SAT-20260827-1234" 
               style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 14px; outline: none;" />
      </div>

      <button type="submit" style="background: linear-gradient(135deg, #d4b270 0%, #b45309 100%); color: #ffffff; border: none; padding: 14px; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; margin-top: 8px; box-shadow: 0 4px 14px rgba(180, 83, 9, 0.25);">
        Track Shipment Live
      </button>
    </form>

    <div style="margin-top: 24px; font-size: 12px; color: #94a3b8;">
      Questions about your delivery? <a href="mailto:concierge@satjewel.com" style="color: #b45309; text-decoration: none; font-weight: 600;">Contact Concierge</a>
    </div>
  </div>
</div>
