@model SAT1.Models.Order
@{
    ViewData["Title"] = "Order Confirmed — SAT Jewel Haute Joaillerie";
    var order = Model;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmed — SAT Jewel Luxury Sanctuary</title>
  <link rel="icon" type="image/png" href="/assets/sat_emblem_clean.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <style>
    :root {
      --bg: #07080b;
      --card-bg: rgba(18, 17, 23, 0.95);
      --gold: #d4b878;
      --gold-light: #f3dfa2;
      --ink: #f7f6f2;
      --muted: rgba(247, 246, 242, 0.65);
      --border: rgba(212, 184, 120, 0.25);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg) radial-gradient(circle at 50% 10%, rgba(212, 184, 120, 0.08) 0%, rgba(7, 8, 11, 0.98) 70%);
      color: var(--ink);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 16px;
      padding-bottom: max(32px, env(safe-area-inset-bottom, 32px));
    }
    .confirmation-wrap {
      max-width: 680px;
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 44px 36px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65);
      text-align: center;
    }
    .emblem-slot {
      width: 72px;
      height: 72px;
      margin: 0 auto 20px;
      background: rgba(212, 184, 120, 0.12);
      border: 1px solid var(--gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
      font-size: 32px;
    }
    h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 30px;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 8px;
    }
    .sub-title {
      color: var(--gold);
      font-size: 14px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 24px;
    }
    .order-box {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 24px;
      text-align: left;
      margin-bottom: 28px;
    }
    .order-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 14px;
    }
    .order-row:last-child {
      border-bottom: none;
      padding-top: 14px;
      font-size: 16px;
      font-weight: 700;
      color: var(--gold-light);
    }
    .order-label {
      color: var(--muted);
    }
    .order-val {
      color: #ffffff;
      font-weight: 500;
      text-align: right;
      max-width: 60%;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      justify-content: center;
    }
    .btn-gold {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, #d4b878 0%, #b8944d 100%);
      color: #07080b;
      font-weight: 700;
      font-size: 14px;
      padding: 14px 28px;
      border-radius: 100px;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .btn-gold:hover { opacity: 0.9; }
    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: transparent;
      border: 1px solid var(--border);
      color: var(--ink);
      font-weight: 600;
      font-size: 14px;
      padding: 14px 26px;
      border-radius: 100px;
      text-decoration: none;
      transition: background 0.2s;
    }
    .btn-outline:hover { background: rgba(255, 255, 255, 0.05); }
    @@media (max-width: 600px) {
      .confirmation-wrap { padding: 32px 20px; }
      h1 { font-size: 24px; }
      .actions { flex-direction: column; }
      .btn-gold, .btn-outline { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

  <div class="confirmation-wrap">
    <div class="emblem-slot">
      <i class="fa-solid fa-gem"></i>
    </div>
    
    <h1>Thank You for Your Order</h1>
    <div class="sub-title">Bespoke Fine Jewelry Crafting Scheduled</div>

    <p style="color: var(--muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px;">
      Your order has been verified and securely registered in our bespoke atelier vault. An official confirmation email with your order summary has been dispatched.
    </p>

    <div class="order-box">
      <div class="order-row">
        <span class="order-label">Order Number</span>
        <span class="order-val" style="font-family: monospace; color: var(--gold); font-size: 15px;">@(order?.OrderNumber ?? order?.OrderId ?? "SAT-CONFIRMED")</span>
      </div>
      <div class="order-row">
        <span class="order-label">Creation / Items</span>
        <span class="order-val">@(order?.ItemName ?? "Bespoke Haute Joaillerie")</span>
      </div>
      <div class="order-row">
        <span class="order-label">Client Name</span>
        <span class="order-val">@(order?.ShippingFullName ?? "Valued Client")</span>
      </div>
      <div class="order-row">
        <span class="order-label">Dispatch Destination</span>
        <span class="order-val">@($"{order?.ShippingCity}, {order?.ShippingState} {order?.ShippingPostalCode}, {order?.ShippingCountry}")</span>
      </div>
      <div class="order-row">
        <span class="order-label">Insured Logistics</span>
        <span class="order-val"><i class="fa-solid fa-shield-halved" style="color:#22c55e;"></i> Fully Insured Armored Home Delivery</span>
      </div>
      <div class="order-row">
        <span class="order-label">Total Amount Paid</span>
        <span class="order-val">$@((order?.AmountPaid > 0 ? order.AmountPaid : (order?.TotalAmountUSD ?? 0)).ToString("F2")) USD</span>
      </div>
    </div>

    <div class="actions">
      <a href="/Account/MyAccount?tab=orders#orders" class="btn-gold">
        <i class="fa-solid fa-box-open"></i> Track in My Account
      </a>
      <a href="/" class="btn-outline">
        <i class="fa-solid fa-arrow-left"></i> Continue Shopping
      </a>
      <a href="https://wa.me/918320972779?text=Hello%20SAT%20Jewel!%20I%20have%20an%20inquiry%20regarding%20my%20order%20@(order?.OrderNumber ?? order?.OrderId)" target="_blank" rel="noopener" class="btn-outline">
        <i class="fa-brands fa-whatsapp" style="color:#22c55e;"></i> Atelier Concierge
      </a>
    </div>
  </div>

</body>
</html>
