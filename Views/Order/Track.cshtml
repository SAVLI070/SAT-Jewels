@model SAT1.Models.Order
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"Live Order Tracking #{Model.OrderNumber} - SAT Fine Jewelry";
    var history = ViewBag.History as List<SAT1.Models.OrderTrackingHistory> ?? new List<SAT1.Models.OrderTrackingHistory>();

    // Determine current progress index (1 to 7)
    int currentStep = 3;
    var rawStatus = (Model.CurrentTrackingStatus ?? Model.OrderStatus ?? "").ToLower();
    if (rawStatus.Contains("delivered") || rawStatus.Contains("completed")) currentStep = 7;
    else if (rawStatus.Contains("outfordelivery") || rawStatus.Contains("out for delivery")) currentStep = 6;
    else if (rawStatus.Contains("customs") || rawStatus.Contains("us customs")) currentStep = 5;
    else if (rawStatus.Contains("intransit") || rawStatus.Contains("in transit") || rawStatus.Contains("air") || rawStatus.Contains("shipped")) currentStep = 4;
    else if (rawStatus.Contains("booked") || rawStatus.Contains("dispatched")) currentStep = 3;
    else if (rawStatus.Contains("processing") || rawStatus.Contains("crafting") || rawStatus.Contains("qc")) currentStep = 2;
    else if (rawStatus.Contains("placed") || rawStatus.Contains("pending")) currentStep = 1;
}

<style>
  .sat-track-hero {
    padding: 60px 24px 30px;
    background: radial-gradient(circle at center, #16141a 0%, #06070a 100%);
    color: #ffffff;
    text-align: center;
  }

  .sat-track-card {
    max-width: 900px;
    margin: -30px auto 60px;
    background: rgba(14, 13, 16, 0.92);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(212, 184, 120, 0.35);
    overflow: hidden;
    color: #ffffff;
  }

  /* Multi-Step Progress Tracker */
  .stepper-wrapper {
    display: flex;
    justify-content: space-between;
    position: relative;
    margin: 40px 0;
    padding: 0 10px;
  }

  .stepper-wrapper::before {
    content: '';
    position: absolute;
    top: 20px;
    left: 40px;
    right: 40px;
    height: 4px;
    background: rgba(255, 255, 255, 0.12);
    z-index: 1;
  }

  .stepper-progress-bar {
    position: absolute;
    top: 20px;
    left: 40px;
    height: 4px;
    background: linear-gradient(90deg, #d4b270, #b45309);
    z-index: 2;
    transition: width 0.4s ease;
  }

  .step-item {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
  }

  .step-circle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #06070a;
    border: 2px solid rgba(255, 255, 255, 0.2);
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .step-item.completed .step-circle {
    background: #059669;
    border-color: #10b981;
    color: #ffffff;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.4);
  }

  .step-item.active .step-circle {
    background: linear-gradient(135deg, #d4b270 0%, #b45309 100%);
    border-color: #d4b270;
    color: #ffffff;
    box-shadow: 0 0 16px rgba(212, 178, 112, 0.4);
    transform: scale(1.1);
  }

  .step-title {
    margin-top: 10px;
    font-size: 11.5px;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    max-width: 100px;
  }

  .step-item.active .step-title,
  .step-item.completed .step-title {
    color: #ffffff;
    font-weight: 800;
  }
</style>

<div class="sat-track-hero">
  <div style="font-size: 12px; font-weight: 700; color: #d4b270; text-transform: uppercase; letter-spacing: 2px;">SAT Fine Jewelry Fulfillment</div>
  <h1 style="font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; margin: 8px 0 6px; color: #ffffff;">Live Parcel Tracking</h1>
  <p style="font-size: 14px; color: #94a3b8; margin: 0;">Tracking Order <strong style="color: #fbbf24;">#@Model.OrderNumber</strong></p>
</div>

<div class="sat-track-card">
  <!-- Header Info Bar -->
  <div style="background: rgba(14, 28, 48, 0.85); padding: 24px; border-bottom: 1px solid rgba(212, 178, 112, 0.25); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;">
    <div>
      <div style="font-size: 11.5px; color: #d4b270; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Carrier & AWB Tracking</div>
      <div style="font-size: 18px; font-weight: 800; color: #ffffff; font-family: monospace; margin-top: 2px;">
        @(string.IsNullOrWhiteSpace(Model.TrackingNumber) ? "SAT-EXP-" + Model.OrderId : Model.TrackingNumber)
      </div>
      <div style="font-size: 12px; color: #4ade80; font-weight: 600; margin-top: 4px;">
        <i class="fa-solid fa-plane-departure"></i> @(string.IsNullOrWhiteSpace(Model.CarrierName) ? "FedEx / BlueDart Priority Express" : Model.CarrierName)
      </div>
    </div>

    <div>
      <div style="font-size: 11.5px; color: #d4b270; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Estimated Delivery</div>
      <div style="font-size: 18px; font-weight: 800; color: #fbbf24; margin-top: 2px;">
        @(Model.EstimatedDeliveryDate?.ToString("MMMM dd, yyyy") ?? "In 3-5 Business Days")
      </div>
      <div style="font-size: 12px; color: #94a3b8; margin-top: 4px;">
        Destination: @Model.ShippingCity, @Model.ShippingCountry
      </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.TrackingUrl))
    {
      <div>
        <a href="@Model.TrackingUrl" target="_blank" style="display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #d4b270 0%, #b45309 100%); color: #ffffff; padding: 10px 20px; border-radius: 10px; font-size: 13px; font-weight: 700; text-decoration: none; box-shadow: 0 4px 12px rgba(180,83,9,0.35);">
          Carrier Tracking Portal <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 11px;"></i>
        </a>
      </div>
    }
  </div>

  <div style="padding: 32px 24px;">

    <!-- 7-Stage Progress Stepper -->
    @{
      double progressPct = ((currentStep - 1) / 6.0) * 100.0;
    }
    <div class="stepper-wrapper">
      <div class="stepper-progress-bar" style="width: @progressPct%;"></div>

      <div class="step-item @(currentStep > 1 ? "completed" : (currentStep == 1 ? "active" : ""))">
        <div class="step-circle">@(currentStep > 1 ? "✓" : "1")</div>
        <div class="step-title">Order Placed</div>
      </div>

      <div class="step-item @(currentStep > 2 ? "completed" : (currentStep == 2 ? "active" : ""))">
        <div class="step-circle">@(currentStep > 2 ? "✓" : "2")</div>
        <div class="step-title">Crafting & QC</div>
      </div>

      <div class="step-item @(currentStep > 3 ? "completed" : (currentStep == 3 ? "active" : ""))">
        <div class="step-circle">@(currentStep > 3 ? "✓" : "3")</div>
        <div class="step-title">Dispatched</div>
      </div>

      <div class="step-item @(currentStep > 4 ? "completed" : (currentStep == 4 ? "active" : ""))">
        <div class="step-circle">@(currentStep > 4 ? "✓" : "4")</div>
        <div class="step-title">Air Transit</div>
      </div>

      <div class="step-item @(currentStep > 5 ? "completed" : (currentStep == 5 ? "active" : ""))">
        <div class="step-circle">@(currentStep > 5 ? "✓" : "5")</div>
        <div class="step-title">US Customs</div>
      </div>

      <div class="step-item @(currentStep > 6 ? "completed" : (currentStep == 6 ? "active" : ""))">
        <div class="step-circle">@(currentStep > 6 ? "✓" : "6")</div>
        <div class="step-title">Out for Delivery</div>
      </div>

      <div class="step-item @(currentStep >= 7 ? "completed active" : "")">
        <div class="step-circle">@(currentStep >= 7 ? "✓" : "7")</div>
        <div class="step-title">Delivered</div>
      </div>
    </div>

    <!-- Timeline History Feed -->
    <div style="margin-top: 40px; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 28px;">
      <h3 style="font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: #ffffff; margin: 0 0 20px;">Detailed Journey Updates</h3>

      @if (history.Count == 0)
      {
        <div style="padding: 20px; background: rgba(255, 255, 255, 0.04); border-radius: 12px; color: #cbd5e1; font-size: 13.5px; border: 1px solid rgba(255,255,255,0.08);">
          <i class="fa-solid fa-clock-rotate-left" style="color: #d4b270; margin-right: 8px;"></i> Shipment booked. Carrier is preparing international air cargo dispatch from Surat Diamond Hub, India.
        </div>
      }
      else
      {
        <div style="display: flex; flex-direction: column; gap: 20px; position: relative; padding-left: 28px; border-left: 2px solid rgba(212, 178, 112, 0.35); margin-left: 12px;">
          @foreach (var ev in history.OrderByDescending(h => h.CreatedAt))
          {
            <div style="position: relative;">
              <div style="position: absolute; left: -35px; top: 2px; width: 12px; height: 12px; border-radius: 50%; background: #d4b270; border: 2px solid #050b14; box-shadow: 0 0 8px rgba(212,178,112,0.6);"></div>
              <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 10px;">
                <strong style="font-size: 14px; color: #ffffff;">@ev.Status</strong>
                <span style="font-size: 11px; color: #94a3b8;">@ev.CreatedAt.ToString("MMM dd, yyyy • HH:mm")</span>
              </div>
              <div style="font-size: 13px; color: #cbd5e1; margin-top: 4px;">@ev.StatusNote</div>
              @if (!string.IsNullOrWhiteSpace(ev.Location))
              {
                <div style="font-size: 11.5px; color: #d4b270; margin-top: 3px;">
                  <i class="fa-solid fa-location-dot" style="margin-right: 4px;"></i> @ev.Location
                </div>
              }
            </div>
          }
        </div>
      }
    </div>

  </div>
</div>
